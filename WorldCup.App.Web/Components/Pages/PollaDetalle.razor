    private void SeleccionarCantidadPremios(int cantidad)
    {
        puestosPremiados = Math.Clamp(cantidad, 1, 3);

        if (puestosPremiados < 3)
        {
            premioTercerLugarEdit = null;
        }

        if (puestosPremiados < 2)
        {
            premioSegundoLugarEdit = null;
        }

        mensajePremios = null;
        errorPremios = false;
    }

    private void CalcularPremiosSugeridos()
    {
        var bolsa = TotalBolsaEstimada;
        if (bolsa <= 0)
        {
            mensajePremios = "Define un valor de participacion para calcular la bolsa estimada.";
            errorPremios = true;
            return;
        }

        if (puestosPremiados == 1)
        {
            premioPrimerLugarEdit = bolsa;
            premioSegundoLugarEdit = null;
            premioTercerLugarEdit = null;
        }
        else if (puestosPremiados == 2)
        {
            premioPrimerLugarEdit = RedondearPremio(bolsa * .70m);
            premioSegundoLugarEdit = bolsa - premioPrimerLugarEdit;
            premioTercerLugarEdit = null;
        }
        else
        {
            premioPrimerLugarEdit = RedondearPremio(bolsa * .60m);
            premioSegundoLugarEdit = RedondearPremio(bolsa * .25m);
            premioTercerLugarEdit = bolsa - premioPrimerLugarEdit - premioSegundoLugarEdit;
        }

        mensajePremios = "Calculamos una distribucion sugerida. Puedes modificar cualquier valor antes de guardar.";
        errorPremios = false;
    }

    private async Task GuardarPremios()
    {
        if (polla == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var primero = premioPrimerLugarEdit.GetValueOrDefault();
        var segundo = puestosPremiados >= 2
            ? premioSegundoLugarEdit.GetValueOrDefault()
            : 0;
        var tercero = puestosPremiados >= 3
            ? premioTercerLugarEdit.GetValueOrDefault()
            : 0;

        if (primero <= 0 ||
            (puestosPremiados >= 2 && segundo <= 0) ||
            (puestosPremiados >= 3 && tercero <= 0))
        {
            mensajePremios = "Completa con un valor mayor que cero cada puesto que deseas premiar.";
            errorPremios = true;
            return;
        }

        if (PremiosExcedenBolsa)
        {
            mensajePremios = "Los premios no pueden superar la bolsa estimada.";
            errorPremios = true;
            return;
        }

        try
        {
            guardandoPremios = true;
            await PollasService.ActualizarPremiosPollaAsync(
                PollaId,
                Sesion.UsuarioId.Value,
                primero,
                puestosPremiados >= 2 ? segundo : null,
                puestosPremiados >= 3 ? tercero : null);

            polla = await PollasService.GetPollaAsync(PollaId, Sesion.UsuarioId.Value);
            PrepararDatosPolla();
            await CargarRanking();

            mensajePremios = "Premios guardados y publicados en el ranking.";
            errorPremios = false;
        }
        catch (Exception ex)
        {
            mensajePremios = ex.Message;
            errorPremios = true;
        }
        finally
        {
            guardandoPremios = false;
        }
    }

    private static decimal RedondearPremio(decimal valor)
    {
        return Math.Floor(valor / 1000m) * 1000m;
    }

    private static string FormatoPrecio(decimal? valor)
    {
        return valor.HasValue && valor.Value > 0
            ? $"${valor.Value:N0}"
            : "No definido";
    }

    private static string FormatoSaldoPendiente(decimal valor)
    {
        return valor > 0
            ? $"${valor:N0}"
            : "";
    }

    private static string FormaPagoSeleccionada(PollaPagoParticipanteDto pago)
    {
        var nota = (pago.NotaPago ?? "").Trim();
        if (string.IsNullOrWhiteSpace(nota))
        {
            return "";
        }

        if (string.Equals(nota, "Transferencia", StringComparison.OrdinalIgnoreCase))
        {
            return "Transferencia";
        }

        if (string.Equals(nota, "Efectivo", StringComparison.OrdinalIgnoreCase))
        {
            return "Efectivo";
        }

        return "Otra";
    }

    private static void CambiarFormaPago(PollaPagoParticipanteDto pago, string? formaPago)
    {
        formaPago = (formaPago ?? "").Trim();
        var actual = (pago.NotaPago ?? "").Trim();

        pago.NotaPago = formaPago switch
        {
            "Transferencia" => "Transferencia",
            "Efectivo" => "Efectivo",
            "Otra" when string.Equals(actual, "Transferencia", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(actual, "Efectivo", StringComparison.OrdinalIgnoreCase) => "",
            "Otra" => actual,
            _ => ""
        };
    }

