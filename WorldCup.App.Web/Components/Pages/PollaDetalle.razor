@page "/polla/{PollaId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="d-flex align-items-start gap-3 mb-4 flex-wrap">
    <button class="btn btn-outline-primary btn-lg"
            @onclick="VolverADashboard">
        ⬅ Mis pollas
    </button>

    <div class="flex-grow-1">
        <h2 class="mb-0">🏆 Detalle de la Polla</h2>
        <small class="text-muted">
            Estás viendo el detalle de esta polla
        </small>

        @if (polla != null)
        {
            <div class="mt-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold">Nombre:</span>
                    <span class="fs-5">@polla.Nombre</span>

                    @if (EsCreador && !editandoNombrePolla)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="EditarNombrePolla">
                            Editar nombre
                        </button>
                    }
                </div>

                @if (editandoNombrePolla)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-md-7">
                            <input class="form-control"
                                   maxlength="120"
                                   @bind="nombrePollaEdit"
                                   @bind:event="oninput"
                                   placeholder="Nombre de la polla" />
                        </div>
                        <div class="col-md-5 d-flex align-items-center gap-2">
                            <button class="btn btn-success btn-sm"
                                    @onclick="GuardarNombrePolla">
                                Guardar nombre
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="CancelarNombrePolla">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (polla == null)
{
    <div class="alert alert-info">
        Cargando información de la polla...
    </div>
}
else
{
    @* ===== SOLO EL CREADOR VE ESTO ===== *@
    @if (EsCreador)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Invitar a la polla</h5>

                <input class="form-control mb-2"
                       placeholder="Correo del invitado"
                       @bind="emailInvitado" />

                <button class="btn btn-primary"
                        @onclick="Invitar">
                    Invitar
                </button>

                @if (!string.IsNullOrEmpty(linkInvitacion))
                {
                    <div class="alert alert-success mt-3">
                        <strong>🔗 Link de invitación</strong><br />
                        <code>@linkInvitacion</code>
                    </div>
                }

                @if (!string.IsNullOrEmpty(polla.PinIngreso))
                {
                    <div class="alert alert-warning mt-3">
                        <strong>🔐 PIN de acceso:</strong>
                        <span class="ms-2 fw-bold">@polla.PinIngreso</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="mt-3">
            <label class="form-label fw-bold">✏️ Cambiar PIN</label>
            <input class="form-control mb-2"
                   maxlength="4"
                   @bind="nuevoPin"
                   placeholder="Nuevo PIN (4 dígitos)" />

            <button class="btn btn-warning btn-sm"
                    @onclick="CambiarPin">
                Guardar nuevo PIN
            </button>
        </div>
    }

    <div class="card mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h5 class="mb-1">Reglas de pago de la polla</h5>
                    <small class="text-muted">Valor de participación y método definido por el creador.</small>
                </div>

                @if (EsCreador && !editandoPolla)
                {
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="EditarDatosPolla">
                        Editar
                    </button>
                }
            </div>

            @if (editandoPolla)
            {
                <div class="row g-3 mt-2">
                    <div class="col-12">
                        <label class="form-label fw-bold">Nombre de la polla</label>
                        <input class="form-control"
                               maxlength="120"
                               @bind="nombrePollaEdit"
                               @bind:event="oninput"
                               placeholder="Nombre de la polla" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Precio</label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               step="1000"
                               @bind="valorInscripcionEdit" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Descripción de la polla</label>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Ej: Reglas internas, notas para los participantes o información general de esta polla"
                                  @bind="descripcionEdit"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Método de pago</label>
                        <textarea class="form-control"
                                  rows="3"
                                  @bind="metodoPagoEdit"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success btn-sm"
                            @onclick="GuardarDatosPolla">
                        Guardar cambios
                    </button>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="CancelarDatosPolla">
                        Cancelar
                    </button>
                </div>
            }
            else
            {
                <div class="payment-summary mt-3">
                    <div class="payment-price">
                        <span>Precio</span>
                        <strong>@FormatoPrecio(polla.ValorInscripcion)</strong>
                    </div>
                    <div class="payment-description">
                        <span>Descripción</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.Descripcion) ? "Sin descripción por ahora." : polla.Descripcion)</p>
                    </div>
                    <div class="payment-method">
                        <span>Método de pago</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.MetodoPago) ? "No definido todavía." : polla.MetodoPago)</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mt-4">

        <!-- 📊 Ranking -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">📊 Ranking</h5>
                    <hr />

                    @if (!ranking.Any())
                    {
                        <div class="alert alert-info">
                            Aún no hay predicciones en esta polla.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Usuario</th>
                                    <th class="text-end">Puntos</th>
                                    <th style="width:140px;"></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var r in ranking)
                                {
                                    <tr>
                                        <td>
                                            @(ranking.IndexOf(r) + 1)
                                        </td>

                                        <td class="fw-bold">
                                            @r.Usuario
                                        </td>

                                        <td class="text-end fw-bold">
                                            @r.Puntos
                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ToggleDetalleUsuario(r.Usuario)">

                                                @(usuarioDetalleAbierto == r.Usuario
                                                    ? "Ocultar detalle"
                                                    : "Ver detalle")

                                            </button>

                                        </td>
                                    </tr>

                                    @if (usuarioDetalleAbierto == r.Usuario)
                                    {
                                        <tr>
                                            <td colspan="4">

                                                <div class="table-responsive mt-2 mb-3 detalle-ranking-scroll">

                                                    <div class="detalle-filtros-panel">
                                                        <div>
                                                            <label>Equipo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleEquipoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var equipo in EquiposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@equipo">@equipo</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Grupo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleGrupoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var grupoFiltro in GruposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@grupoFiltro">Grupo @grupoFiltro</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Fecha</label>
                                                            <input class="form-control form-control-sm"
                                                                   type="date"
                                                                   @bind="detalleFechaFiltro" />
                                                        </div>
                                                        <div>
                                                            <label>Resumen por fase</label>
                                                            <select class="form-select form-select-sm" @bind="detalleFaseResumenFiltro">
                                                                <option value="">Ver partidos</option>
                                                                @foreach (var faseFiltro in FasesDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@faseFiltro">@NombreFase(faseFiltro)</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        @if (HayFiltrosDetalle())
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    @onclick="LimpiarFiltrosDetalle">
                                                                Limpiar
                                                            </button>
                                                        }
                                                    </div>

                                                    <table class="table table-bordered table-hover table-sm align-middle detalle-ranking-table">

                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th>Partido</th>
                                                                <th>Fase</th>
                                                                <th>Pronóstico</th>
                                                                <th>Resultado</th>

                                                                <th class="text-center">Exacto</th>
                                                                <th class="text-center">Ganador</th>
                                                                <th class="text-center">Diferencia</th>
                                                                <th class="text-center">Goles</th>
                                                                <th class="text-center">Clasificación</th>
                                                                <th class="text-center">Extras</th>
                                                                <th class="text-center">Podio</th>
                                                                <th class="text-center">Total</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>

                                                            @{
                                                                var detallesFiltrados = DetallesUsuarioFiltrados(r.Usuario).ToList();
                                                                var resumenFaseActivo = !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
                                                            }

                                                            @if (!detallesFiltrados.Any())
                                                            {
                                                                <tr>
                                                                    <td colspan="12" class="text-center text-muted fw-bold">
                                                                        No hay registros con esos filtros.
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else if (resumenFaseActivo)
                                                            {
                                                                <tr class="detalle-resumen-row">
                                                                    <td>
                                                                        <strong>Resumen</strong><br />
                                                                        <small>@detallesFiltrados.Count partido(s)</small>
                                                                    </td>
                                                                    <td><span class="badge bg-light text-dark">@NombreFase(detalleFaseResumenFiltro!)</span></td>
                                                                    <td>-</td>
                                                                    <td>-</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExacto), "bg-success")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGanador), "bg-info text-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosDiferencia), "bg-secondary")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGoles), "bg-primary")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosClasificacion), "bg-warning text-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExtras), "bg-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosPodio), "bg-danger")</td>
                                                                    <td class="text-center fw-bold">@detallesFiltrados.Sum(x => x.Total)</td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var faseDetalle in detallesFiltrados
                                                                    .GroupBy(x => x.Fase)
                                                                    .OrderBy(g => OrdenFase(g.Key)))
                                                                {
                                                                    var faseNombre = faseDetalle.Key;
                                                                    var faseMinimizada = FaseDetalleMinimizada(r.Usuario, faseNombre);

                                                                    <tr class="detalle-fase-row">
                                                                        <td colspan="12">
                                                                            <div class="detalle-fase-header">
                                                                                <div>
                                                                                    <strong>@faseNombre</strong>
                                                                                    <span>@faseDetalle.Count() partidos | @faseDetalle.Sum(x => x.Total) puntos</span>
                                                                                </div>
                                                                                <button type="button"
                                                                                        class="detalle-fase-btn"
                                                                                        @onclick="() => ToggleFaseDetalle(r.Usuario, faseNombre)">
                                                                                    @(faseMinimizada ? "Mostrar" : "Minimizar")
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>

                                                                    @if (!faseMinimizada)
                                                                    {
                                                                        @foreach (var d in faseDetalle.OrderBy(x => x.Fecha).ThenBy(x => x.Local))
                                                                        {
                                                                            <tr>

                                                                                <td>
                                                                                    <strong>@d.Local</strong>
                                                                                    vs
                                                                                    <strong>@d.Visitante</strong>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-light text-dark">
                                                                                        @d.Fase
                                                                                    </span>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-primary">
                                                                                        @d.PronosticoLocal - @d.PronosticoVisitante
                                                                                    </span>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-dark">
                                                                                        @d.ResultadoLocal - @d.ResultadoVisitante
                                                                                    </span>
                                                                                </td>

                                                                                <td class="text-center">@BadgePuntos(d.PuntosExacto, "bg-success")</td>
                                                                                <td class="text-center">@BadgePuntos(d.PuntosGanador, "bg-info text-dark")</td>
                                                                                <td class="text-center">@BadgePuntos(d.PuntosDiferencia, "bg-secondary")</td>
                                                                                <td class="text-center">@BadgePuntos(d.PuntosGoles, "bg-primary")</td>

                                                                                <td class="text-center">

                                                                                    @if (d.PuntosClasificacion > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-warning text-dark detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Clasificacion", d.PuntosClasificacion, "bg-warning text-dark", d.DetalleClasificacion, d)'>
                                                                                            +@d.PuntosClasificacion
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center">

                                                                                    @if (d.PuntosExtras > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-dark detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Extras", d.PuntosExtras, "bg-dark", d.DetalleExtras, d)'>
                                                                                            +@d.PuntosExtras
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center">

                                                                                    @if (d.PuntosPodio > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-danger detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Podio", d.PuntosPodio, "bg-danger", d.DetallePodio, d)'>
                                                                                            +@d.PuntosPodio
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center fw-bold">
                                                                                    @d.Total
                                                                                </td>

                                                                            </tr>
                                                                        }
                                                                    }
                                                                }
                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>
                    }

                 

                    <button class="btn btn-primary btn-sm"
                            @onclick="IrAPredicciones">
                        🎯 Ir a predicciones
                    </button>
                </div>
            </div>
        </div>

        <!-- 👥 Participantes -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">👥 Participantes</h5>

                    <ul class="list-group list-group-flush">
                        @foreach (var u in participantes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>👤 @u.Nombre</span>

                                @* ❌ SOLO EL CREADOR VE EL BOTÓN *@
                                @if (EsCreador && u.Id != polla.CreadorId)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmarEliminar(u.Id, u.Nombre)">
                                        ❌ Eliminar Usuario
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>

    @if (mostrarConfirmacion)
    {
        <div class="alert alert-warning mt-3">
            <p>
                ¿Seguro que deseas expulsar a
                <strong>@usuarioAEliminarNombre</strong>?
            </p>

            <button class="btn btn-danger me-2"
                    @onclick="EliminarConfirmadoAsync">
                Sí, expulsar
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelarEliminar">
                Cancelar
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3">
            @mensaje
        </div>
    }

}

@if (detallePuntosVisible)
{
    <div class="detalle-puntos-modal-backdrop" @onclick="CerrarDetallePuntos">
        <div class="detalle-puntos-modal" @onclick:stopPropagation="true">
            <button type="button"
                    class="detalle-puntos-modal-close"
                    aria-label="Cerrar"
                    @onclick="CerrarDetallePuntos">
                x
            </button>

            <div class="detalle-puntos-modal-head">
                <span class="badge @detallePuntosClase">+@detallePuntosValor</span>
                <div>
                    <h5>@detallePuntosTitulo</h5>
                    <small>@detallePuntosContexto</small>
                </div>
            </div>

            <p>@detallePuntosTexto</p>
        </div>
    </div>
}

<style>
    .detalle-ranking-scroll {
        max-height: 520px;
        overflow: auto;
    }

    .detalle-ranking-table thead th {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #212529;
        color: #fff;
    }

    .detalle-filtros-panel {
        display: grid;
        grid-template-columns: repeat(4, minmax(150px, 1fr)) auto;
        gap: .65rem;
        align-items: end;
        margin-bottom: .75rem;
        padding: .8rem;
        border: 1px solid #dce8e1;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 6px 16px rgba(16, 24, 40, .06);
    }

    .detalle-filtros-panel label {
        display: block;
        margin-bottom: .2rem;
        color: #667085;
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .detalle-resumen-row {
        background: #fff8df;
    }

    .detalle-resumen-row small {
        color: #667085;
        font-weight: 700;
    }

    .payment-summary {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: .75rem;
        align-items: start;
    }

    .payment-summary > div {
        border: 1px solid #e4e7ec;
        border-radius: 8px;
        background: #fbfcfd;
        padding: .72rem .85rem;
    }

    .payment-summary span {
        display: block;
        color: #667085;
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .payment-summary strong {
        display: block;
        margin-top: .2rem;
        color: #146c43;
        font-size: 1rem;
        line-height: 1.2;
    }

    .payment-summary p {
        margin: .25rem 0 0;
        color: #182230;
        line-height: 1.45;
        white-space: pre-line;
    }

    .payment-price {
        background: #f4fbf7 !important;
        border-color: #cfe8da !important;
    }

    .payment-description {
        min-height: 0;
    }

    .payment-method {
        grid-column: 1 / -1;
    }

    @@media (max-width: 768px) {
        .payment-summary {
            grid-template-columns: 1fr;
        }

        .payment-method {
            grid-column: auto;
        }
    }

    .detalle-fase-row td {
        background: #eef6f1;
        padding: .55rem .75rem !important;
    }

    .detalle-fase-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
    }

    .detalle-fase-header strong {
        display: block;
        color: #146c43;
        font-weight: 800;
    }

    .detalle-fase-header span {
        color: #667085;
        font-size: .82rem;
        font-weight: 700;
    }

    .detalle-fase-btn {
        border: 1px solid #badbcc;
        border-radius: 999px;
        background: #fff;
        color: #146c43;
        padding: .22rem .65rem;
        font-size: .8rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .detalle-puntos-btn {
        border: 0;
        cursor: pointer;
        font: inherit;
        line-height: 1;
    }

    .detalle-puntos-btn:hover,
    .detalle-puntos-btn:focus-visible {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, .18);
        transform: translateY(-1px);
    }

    .detalle-puntos-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: grid;
        place-items: center;
        padding: 1rem;
        background: rgba(20, 24, 30, .52);
    }

    .detalle-puntos-modal {
