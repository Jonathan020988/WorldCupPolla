    {
        if (polla != null)
        {
            await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
        }

        Navigation.NavigateTo("/predicciones");
    }

    private void VolverADashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }

    private void PrepararDatosPolla()
    {
        nombrePollaEdit = polla?.Nombre ?? "";
        valorInscripcionEdit = polla?.ValorInscripcion;
        descripcionEdit = polla?.Descripcion ?? "";
        metodoPagoEdit = polla?.MetodoPago ?? "";
    }

    private void EditarNombrePolla()
    {
        PrepararDatosPolla();
        editandoPolla = false;
        editandoNombrePolla = true;
    }

    private void CancelarNombrePolla()
    {
        editandoNombrePolla = false;
        nombrePollaEdit = polla?.Nombre ?? "";
    }

    private async Task GuardarNombrePolla()
    {
        if (polla == null || !Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para editar el nombre de la polla.";
            esError = true;
            return;
        }

        var nombre = nombrePollaEdit.Trim();
        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "El nombre de la polla es obligatorio.";
            esError = true;
            return;
        }

        try
        {
            await PollasService.ActualizarNombrePollaAsync(
                PollaId,
                Sesion.UsuarioId.Value,
                nombre);

            polla = await PollasService.GetPollaAsync(PollaId);
            PrepararDatosPolla();
            editandoNombrePolla = false;

            if (polla != null)
            {
                await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
            }

            mensaje = "Nombre de la polla actualizado.";
            esError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }

    private void EditarDatosPolla()
    {
        PrepararDatosPolla();
        editandoNombrePolla = false;
        editandoPolla = true;
    }

    private void CancelarDatosPolla()
    {
        editandoPolla = false;
        PrepararDatosPolla();
    }

    private async Task GuardarDatosPolla()
    {
        if (polla == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            var nombre = nombrePollaEdit.Trim();
            if (string.IsNullOrWhiteSpace(nombre))
            {
                mensaje = "El nombre de la polla es obligatorio.";
                esError = true;
                return;
            }

            await PollasService.ActualizarPollaAsync(
                PollaId,
                new CrearPollaDto
                {
                    Nombre = nombre,
                    Descripcion = descripcionEdit,
                    CreadorId = Sesion.UsuarioId.Value,
                    MaximoMiembros = polla.MaximoMiembros,
                    PermitirEmpatesEnEliminatoria = polla.PermitirEmpatesEnEliminatoria,
                    PinIngreso = polla.PinIngreso ?? "0000",
                    ValorInscripcion = valorInscripcionEdit,
                    MetodoPago = metodoPagoEdit
                });

            polla = await PollasService.GetPollaAsync(PollaId);
            PrepararDatosPolla();
            editandoPolla = false;
            await CargarControlPagos();

            if (polla != null)
            {
                await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
            }

            mensaje = "Datos de la polla actualizados.";
            esError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }

    private static string FormatoPrecio(decimal? valor)
    {
        return valor.HasValue && valor.Value > 0
            ? $"${valor.Value:N0}"
            : "No definido";
    }

    private async Task Invitar()
    {
        if (string.IsNullOrWhiteSpace(emailInvitado))
        {
            mensaje = "Debes indicar el correo del invitado.";
            esError = true;
            return;
        }

        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para invitar usuarios.";
            esError = true;
            return;
        }

        try
        {
            var link = $"{Navigation.BaseUri}unirse-polla/{PollaId}";
            linkInvitacion = await PollasService.CrearInvitacionAsync(
                PollaId,
                new CrearInvitacionPollaDto
                {
                    RemitenteId = Sesion.UsuarioId.Value,
                    EmailInvitado = emailInvitado,
                    LinkInvitacion = link
                });

            mensaje = $"Invitación enviada a {emailInvitado}.";
            esError = false;
            emailInvitado = "";
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }

    private async Task SolicitarAmpliacion()
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            mensajeCupos = "Debes iniciar sesión para solicitar ampliación.";
            errorCupos = true;
            return;
        }

        try
        {
            procesandoCupos = true;
            mensajeCupos = await PollasService.SolicitarAmpliacionCuposAsync(new SolicitarAmpliacionCuposDto
            {
                UsuarioId = Sesion.UsuarioId.Value,
                Celular = celularAmpliacion,
                CantidadUsuarios = cantidadAmpliacion
            });
            errorCupos = false;
            cuposUsuario = await PollasService.GetCuposUsuarioAsync(Sesion.UsuarioId.Value);
        }
        catch (Exception ex)
        {
            mensajeCupos = ex.Message;
            errorCupos = true;
        }
        finally
        {
            procesandoCupos = false;
        }
    }

    private async Task ActivarCodigoCupos()
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            mensajeCupos = "Debes iniciar sesión para activar el código.";
            errorCupos = true;
            return;
        }

        try
        {
            procesandoCupos = true;
            mensajeCupos = await PollasService.ActivarCuposAsync(new ActivarCuposDto
            {
                UsuarioId = Sesion.UsuarioId.Value,
                Codigo = codigoCupos
            });
            errorCupos = false;
            codigoCupos = "";
            cuposUsuario = await PollasService.GetCuposUsuarioAsync(Sesion.UsuarioId.Value);
            polla = await PollasService.GetPollaAsync(PollaId);
            PrepararDatosPolla();
        }
        catch (Exception ex)
        {
            mensajeCupos = ex.Message;
            errorCupos = true;
        }
        finally
        {
            procesandoCupos = false;
        }
    }

    private string nuevoPin = "";

    private async Task CambiarPin()
    {
        if (string.IsNullOrWhiteSpace(nuevoPin) || nuevoPin.Length != 4)
            return;

        await PollasService.ActualizarPinAsync(PollaId, nuevoPin);

        // refrescar la polla para ver el nuevo PIN
        polla = await PollasService.GetPollaAsync(PollaId);

        nuevoPin = "";
    }

    private bool mostrarConfirmacion = false;
    private int usuarioAEliminarId;
    private string? usuarioAEliminarNombre;
    private string? mensaje;
    private bool esError;

    private void ConfirmarEliminar(int usuarioId, string nombre)
    {
        usuarioAEliminarId = usuarioId;
        usuarioAEliminarNombre = nombre;
        mostrarConfirmacion = true;
    }

    private async Task EliminarConfirmadoAsync()
    {
        try
        {
            await PollasService.EliminarMiembroAsync(
                PollaId,
                usuarioAEliminarId,
                Sesion.UsuarioId!.Value
            );

            await CargarParticipantes();
            await CargarRanking();
            await CargarControlPagos();

            mensaje = $"❌ {usuarioAEliminarNombre} fue expulsado de la polla.";
            esError = false;
        }
        catch
        {
            mensaje = "Error al expulsar el usuario.";
            esError = true;
        }
        finally
        {
            mostrarConfirmacion = false;
        }

    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task CargarParticipantes()
    {
        participantes = await PollasService.GetParticipantesAsync(PollaId);
    }

    private async Task CargarRanking()
    {
        ranking = await PollasService.GetRankingAsync(
            PollaId,
            EsCreador ? Sesion.UsuarioId : null);
    }

    private async Task GuardarObservacionRanking(RankingPollaDto participante)
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para editar observaciones.";
            esError = true;
            return;
        }

        try
        {
            observacionGuardandoUsuarioId = participante.UsuarioId;

            var actualizado = await PollasService.ActualizarObservacionParticipanteAsync(
                PollaId,
                participante.UsuarioId,
                new ActualizarObservacionParticipanteDto
                {
                    SolicitanteId = Sesion.UsuarioId.Value,
                    Observacion = participante.ObservacionAdmin
                });

            participante.ObservacionAdmin = actualizado.ObservacionAdmin;
            mensaje = $"Observación de {participante.Usuario} guardada.";
            esError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            observacionGuardandoUsuarioId = null;
        }
    }

    private async Task CargarControlPagos()
    {
        if (!EsCreador || !Sesion.UsuarioId.HasValue)
        {
            controlPagos = null;
            return;
        }

        try
        {
            cargandoControlPagos = true;
            controlPagos = await PollasService.GetControlPagosAsync(PollaId, Sesion.UsuarioId.Value);
        }
        finally
        {
            cargandoControlPagos = false;
        }
    }

    private async Task GuardarPago(PollaPagoParticipanteDto pago)
    {
        var guardado = await GuardarPagoInterno(pago);

        if (guardado)
        {
            mensaje = $"Pago de {pago.Nombre} actualizado.";
            esError = false;
        }
    }

    private async Task<bool> GuardarPagoInterno(PollaPagoParticipanteDto pago)
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para actualizar pagos.";
            esError = true;
            return false;
        }

        try
        {
            pagoGuardandoUsuarioId = pago.UsuarioId;

            await PollasService.ActualizarPagoParticipanteAsync(
                PollaId,
                pago.UsuarioId,
                new ActualizarPagoParticipanteDto
                {
                    SolicitanteId = Sesion.UsuarioId.Value,
                    ValorAPagar = pago.ValorAPagar,
                    AbonoPagado = pago.AbonoPagado,
                    NotaPago = pago.NotaPago
                });

            await CargarControlPagos();
            return true;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
            return false;
        }
        finally
        {
            pagoGuardandoUsuarioId = null;
        }
    }

    private async Task NotificarPagoPendiente(PollaPagoParticipanteDto pago)
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para enviar avisos de pago.";
            esError = true;
            return;
        }

        try
        {
            pagoNotificandoUsuarioId = pago.UsuarioId;

            var guardado = await GuardarPagoInterno(pago);
            if (!guardado)
            {
                return;
            }

            mensaje = await PollasService.NotificarPagoPendienteAsync(
                PollaId,
                pago.UsuarioId,
                new NotificarPagoPendienteDto
                {
                    SolicitanteId = Sesion.UsuarioId.Value
                });

            await CargarControlPagos();
            esError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            pagoNotificandoUsuarioId = null;
        }
    }

    private bool PagoEnProceso(int usuarioId)
    {
        return pagoGuardandoUsuarioId == usuarioId ||
               pagoNotificandoUsuarioId == usuarioId ||
               cargandoControlPagos;
    }

    private static string ClaseEstadoPago(string estado)
    {
        return estado switch
        {
            "Pagado" => "bg-success",
            "Abono" => "bg-warning text-dark",
            "Pendiente" => "bg-danger",
            "Sin valor" => "bg-secondary",
            _ => "bg-secondary"
        };
    }



