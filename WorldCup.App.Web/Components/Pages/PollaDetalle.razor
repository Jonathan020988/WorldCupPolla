@page "/polla/{PollaId:int}"
@rendermode InteractiveServer

@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject NavigationManager Navigation

<h2 class="mb-1">🏆 Detalle de la Polla</h2>
<p class="text-muted mb-4">
    Polla seleccionada: @PollaId
</p>

<div class="row g-3">

    <!-- 📊 Ranking -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">📊 Ranking</h5>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th class="text-end">Puntos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ranking)
                        {
                            <tr>
                                <td>@(ranking.IndexOf(r) + 1)</td>
                                <td>@r.Usuario</td>
                                <td class="text-end fw-bold">@r.Puntos</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <button class="btn btn-primary btn-sm"
                        @onclick="IrAPredicciones">
                    🎯 Ir a predicciones
                </button>

                <button class="btn btn-sm btn-outline-success"
                        @onclick="() => Invitar(2)">
                    ➕ Invitar usuario 2
                </button>

            </div>
        </div>
    </div>

    <!-- 👥 Participantes -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">👥 Participantes</h5>

                <ul class="list-group list-group-flush">
                    @foreach (var u in participantes)
                    {
                        <li class="list-group-item px-0">
                            👤 @u
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

</div>

@code {

    [Parameter]
    public int PollaId { get; set; }

    private List<RankingPollaDto> ranking = new();
    private List<string> participantes = new();

    protected override async Task OnInitializedAsync()
    {
        ranking = await PollasService.GetRankingAsync(PollaId);
        participantes = await PollasService.GetParticipantesAsync(PollaId);
    }

    private void IrAPredicciones()
    {
        Navigation.NavigateTo("/predicciones");
    }

    private async Task Invitar(int usuarioId)
    {
        await PollasService.InvitarUsuarioAsync(PollaId, usuarioId);
        participantes = await PollasService.GetParticipantesAsync(PollaId);
    }

}
