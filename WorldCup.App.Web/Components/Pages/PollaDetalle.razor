    private ParticipanteDto? UsuarioFormatoSeleccionado()
    {
        var texto = NormalizarBusqueda(usuarioFormatoFiltro);
        if (string.IsNullOrWhiteSpace(texto))
        {
            return null;
        }

        var exacto = participantes.FirstOrDefault(p =>
            NormalizarBusqueda(p.Nombre) == texto);
        if (exacto != null)
        {
            return exacto;
        }

        var coincidencias = ParticipantesFormatoFiltrados().ToList();
        return coincidencias.Count == 1 ? coincidencias[0] : null;
    }

    private IEnumerable<ParticipanteDto> ParticipantesFormatoFiltrados()
    {
        var texto = NormalizarBusqueda(usuarioFormatoFiltro);
        if (string.IsNullOrWhiteSpace(texto))
        {
            return Enumerable.Empty<ParticipanteDto>();
        }

        return participantes
            .Where(p => NormalizarBusqueda(p.Nombre).Contains(texto, StringComparison.Ordinal))
            .OrderBy(p => p.Nombre)
            .Take(8);
    }

