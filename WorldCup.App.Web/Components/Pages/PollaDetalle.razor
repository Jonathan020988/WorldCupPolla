    private string NombreArchivoFormatoManual(string tipo)
    {
        return tipo switch
        {
            "partidos-grupos" => $"polla-{PollaId}-72-partidos.pdf",
            "clasificacion-grupos" => $"polla-{PollaId}-clasificacion-grupos.pdf",
            "fase-dieciseisavos" => $"polla-{PollaId}-dieciseisavos.pdf",
            "fase-octavos" => $"polla-{PollaId}-octavos.pdf",
            "fase-cuartos" => $"polla-{PollaId}-cuartos.pdf",
            "fase-semifinales" => $"polla-{PollaId}-semifinales.pdf",
            "fase-tercer-puesto" => $"polla-{PollaId}-tercer-puesto.pdf",
            "fase-final" => $"polla-{PollaId}-final.pdf",
            _ => $"polla-{PollaId}-formato-manual.pdf"
        };
    }

    private string NombreArchivoFormatoUsuario(string tipo, string usuario)
    {
        var usuarioSlug = SlugArchivo(usuario);
        return tipo switch
        {
            "partidos-grupos" => $"polla-{PollaId}-{usuarioSlug}-72-partidos.pdf",
            "clasificacion-grupos" => $"polla-{PollaId}-{usuarioSlug}-clasificacion-grupos.pdf",
            "fase-dieciseisavos" => $"polla-{PollaId}-{usuarioSlug}-dieciseisavos.pdf",
            "fase-octavos" => $"polla-{PollaId}-{usuarioSlug}-octavos.pdf",
            "fase-cuartos" => $"polla-{PollaId}-{usuarioSlug}-cuartos.pdf",
            "fase-semifinales" => $"polla-{PollaId}-{usuarioSlug}-semifinales.pdf",
            "fase-tercer-puesto" => $"polla-{PollaId}-{usuarioSlug}-tercer-puesto.pdf",
            "fase-final" => $"polla-{PollaId}-{usuarioSlug}-final.pdf",
            _ => $"polla-{PollaId}-{usuarioSlug}-formato.pdf"
        };
    }

    private static string SlugArchivo(string texto)
    {
        var normalizado = NormalizarBusqueda(texto);
        var caracteres = normalizado
            .Select(c => char.IsLetterOrDigit(c) ? c : '-')
            .ToArray();

        var slug = new string(caracteres)
            .Trim('-')
            .Replace("--", "-", StringComparison.Ordinal);

        while (slug.Contains("--", StringComparison.Ordinal))
        {
            slug = slug.Replace("--", "-", StringComparison.Ordinal);
        }

        return string.IsNullOrWhiteSpace(slug)
            ? "usuario"
            : slug;
    }

