@page "/polla/{PollaId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="d-flex align-items-center gap-3 mb-4">
    <button class="btn btn-outline-primary btn-lg"
            @onclick="VolverADashboard">
        ⬅ Mis pollas
    </button>

    <div>
        <h2 class="mb-0">🏆 Detalle de la Polla</h2>
        <small class="text-muted">
            Estás viendo el detalle de esta polla
        </small>
    </div>
</div>

@if (polla == null)
{
    <div class="alert alert-info">
        Cargando información de la polla...
    </div>
}
else
{
    @* ===== SOLO EL CREADOR VE ESTO ===== *@
    @if (EsCreador)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Invitar a la polla</h5>

                <input class="form-control mb-2"
                       placeholder="Correo del invitado"
                       @bind="emailInvitado" />

                <button class="btn btn-primary"
                        @onclick="Invitar">
                    Invitar
                </button>

                @if (!string.IsNullOrEmpty(linkInvitacion))
                {
                    <div class="alert alert-success mt-3">
                        <strong>🔗 Link de invitación</strong><br />
                        <code>@linkInvitacion</code>
                    </div>
                }

                @if (!string.IsNullOrEmpty(polla.PinIngreso))
                {
                    <div class="alert alert-warning mt-3">
                        <strong>🔐 PIN de acceso:</strong>
                        <span class="ms-2 fw-bold">@polla.PinIngreso</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="mt-3">
            <label class="form-label fw-bold">✏️ Cambiar PIN</label>
            <input class="form-control mb-2"
                   maxlength="4"
                   @bind="nuevoPin"
                   placeholder="Nuevo PIN (4 dígitos)" />

            <button class="btn btn-warning btn-sm"
                    @onclick="CambiarPin">
                Guardar nuevo PIN
            </button>
        </div>
    }

    <div class="row g-3 mt-4">

        <!-- 📊 Ranking -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">📊 Ranking</h5>
                    <hr />

                    @if (!ranking.Any())
                    {
                        <div class="alert alert-info">
                            Aún no hay predicciones en esta polla.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Usuario</th>
                                    <th class="text-end">Puntos</th>
                                    <th style="width:140px;"></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var r in ranking)
                                {
                                    <tr>
                                        <td>
                                            @(ranking.IndexOf(r) + 1)
                                        </td>

                                        <td class="fw-bold">
                                            @r.Usuario
                                        </td>

                                        <td class="text-end fw-bold">
                                            @r.Puntos
                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ToggleDetalleUsuario(r.Usuario)">

                                                @(usuarioDetalleAbierto == r.Usuario
                                                    ? "Ocultar detalle"
                                                    : "Ver detalle")

                                            </button>

                                        </td>
                                    </tr>

                                    @if (usuarioDetalleAbierto == r.Usuario)
                                    {
                                        <tr>
                                            <td colspan="4">

                                                <div class="table-responsive mt-2 mb-3 detalle-ranking-scroll">

                                                    <table class="table table-bordered table-hover table-sm align-middle detalle-ranking-table">

                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th>Partido</th>
                                                                <th>Fase</th>
                                                                <th>Pronóstico</th>
                                                                <th>Resultado</th>

                                                                <th class="text-center">Exacto</th>
                                                                <th class="text-center">Ganador</th>
                                                                <th class="text-center">Diferencia</th>
                                                                <th class="text-center">Goles</th>
                                                                <th class="text-center">Clasificación</th>
                                                                <th class="text-center">Extras</th>
                                                                <th class="text-center">Podio</th>
                                                                <th class="text-center">Total</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>

                                                            @foreach (var faseDetalle in rankingDetalle
                                                           .Where(x => x.Usuario == r.Usuario)
                                                           .GroupBy(x => x.Fase)
                                                           .OrderBy(g => OrdenFase(g.Key)))
                                                            {
                                                                var faseNombre = faseDetalle.Key;
                                                                var faseMinimizada = FaseDetalleMinimizada(r.Usuario, faseNombre);

                                                                <tr class="detalle-fase-row">
                                                                    <td colspan="12">
                                                                        <div class="detalle-fase-header">
                                                                            <div>
                                                                                <strong>@faseNombre</strong>
                                                                                <span>@faseDetalle.Count() partidos | @faseDetalle.Sum(x => x.Total) puntos</span>
                                                                            </div>
                                                                            <button type="button"
                                                                                    class="detalle-fase-btn"
                                                                                    @onclick="() => ToggleFaseDetalle(r.Usuario, faseNombre)">
                                                                                @(faseMinimizada ? "Mostrar" : "Minimizar")
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                @if (!faseMinimizada)
                                                                {
                                                                    @foreach (var d in faseDetalle.OrderBy(x => x.Local))
                                                                    {
                                                                        <tr>

                                                                            <td>
                                                                                <strong>@d.Local</strong>
                                                                                vs
                                                                                <strong>@d.Visitante</strong>
                                                                            </td>

                                                                            <td>
                                                                                <span class="badge bg-light text-dark">
                                                                                    @d.Fase
                                                                                </span>
                                                                            </td>

                                                                            <td>
                                                                                <span class="badge bg-primary">
                                                                                    @d.PronosticoLocal - @d.PronosticoVisitante
                                                                                </span>
                                                                            </td>

                                                                            <td>
                                                                                <span class="badge bg-dark">
                                                                                    @d.ResultadoLocal - @d.ResultadoVisitante
                                                                                </span>
                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosExacto > 0)
                                                                                {
                                                                                    <span class="badge bg-success">
                                                                                        +@d.PuntosExacto
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosGanador > 0)
                                                                                {
                                                                                    <span class="badge bg-info text-dark">
                                                                                        +@d.PuntosGanador
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosDiferencia > 0)
                                                                                {
                                                                                    <span class="badge bg-secondary">
                                                                                        +@d.PuntosDiferencia
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosGoles > 0)
                                                                                {
                                                                                    <span class="badge bg-primary">
                                                                                        +@d.PuntosGoles
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosClasificacion > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="badge bg-warning text-dark detalle-puntos-btn"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Clasificacion", d.PuntosClasificacion, "bg-warning text-dark", d.DetalleClasificacion, d)'>
                                                                                        +@d.PuntosClasificacion
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosExtras > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="badge bg-dark detalle-puntos-btn"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Extras", d.PuntosExtras, "bg-dark", d.DetalleExtras, d)'>
                                                                                        +@d.PuntosExtras
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center">

                                                                                @if (d.PuntosPodio > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="badge bg-danger detalle-puntos-btn"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Podio", d.PuntosPodio, "bg-danger", d.DetallePodio, d)'>
                                                                                        +@d.PuntosPodio
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }

                                                                            </td>

                                                                            <td class="text-center fw-bold">
                                                                                @d.Total
                                                                            </td>

                                                                        </tr>
                                                                    }
                                                                }
                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>
                    }

                 

                    <button class="btn btn-primary btn-sm"
                            @onclick="IrAPredicciones">
                        🎯 Ir a predicciones
                    </button>
                </div>
            </div>
        </div>

        <!-- 👥 Participantes -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">👥 Participantes</h5>

                    <ul class="list-group list-group-flush">
                        @foreach (var u in participantes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>👤 @u.Nombre</span>

                                @* ❌ SOLO EL CREADOR VE EL BOTÓN *@
                                @if (EsCreador && u.Id != polla.CreadorId)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmarEliminar(u.Id, u.Nombre)">
                                        ❌ Eliminar Usuario
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>

    @if (mostrarConfirmacion)
    {
        <div class="alert alert-warning mt-3">
            <p>
                ¿Seguro que deseas expulsar a
                <strong>@usuarioAEliminarNombre</strong>?
            </p>

            <button class="btn btn-danger me-2"
                    @onclick="EliminarConfirmadoAsync">
                Sí, expulsar
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelarEliminar">
                Cancelar
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3">
            @mensaje
        </div>
    }

}

@if (detallePuntosVisible)
{
    <div class="detalle-puntos-modal-backdrop" @onclick="CerrarDetallePuntos">
        <div class="detalle-puntos-modal" @onclick:stopPropagation="true">
            <button type="button"
                    class="detalle-puntos-modal-close"
                    aria-label="Cerrar"
                    @onclick="CerrarDetallePuntos">
                x
            </button>

            <div class="detalle-puntos-modal-head">
                <span class="badge @detallePuntosClase">+@detallePuntosValor</span>
                <div>
                    <h5>@detallePuntosTitulo</h5>
                    <small>@detallePuntosContexto</small>
                </div>
            </div>

            <p>@detallePuntosTexto</p>
        </div>
    </div>
}

<style>
    .detalle-ranking-scroll {
        max-height: 520px;
        overflow: auto;
    }

    .detalle-ranking-table thead th {
        position: sticky;
        top: 0;
        z-index: 3;
        background: #212529;
        color: #fff;
    }

    .detalle-fase-row td {
        background: #eef6f1;
        padding: .55rem .75rem !important;
    }

    .detalle-fase-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
    }

    .detalle-fase-header strong {
        display: block;
        color: #146c43;
        font-weight: 800;
    }

    .detalle-fase-header span {
        color: #667085;
        font-size: .82rem;
        font-weight: 700;
    }

    .detalle-fase-btn {
        border: 1px solid #badbcc;
        border-radius: 999px;
        background: #fff;
        color: #146c43;
        padding: .22rem .65rem;
        font-size: .8rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .detalle-puntos-btn {
        border: 0;
        cursor: pointer;
        font: inherit;
        line-height: 1;
    }

    .detalle-puntos-btn:hover,
    .detalle-puntos-btn:focus-visible {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, .18);
        transform: translateY(-1px);
    }

    .detalle-puntos-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: grid;
        place-items: center;
        padding: 1rem;
        background: rgba(20, 24, 30, .52);
    }

    .detalle-puntos-modal {
        position: relative;
        width: min(430px, 100%);
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 24px 60px rgba(20, 24, 30, .28);
        padding: 1.2rem;
        color: #212529;
    }

    .detalle-puntos-modal-close {
        position: absolute;
        top: .65rem;
        right: .65rem;
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        background: #f8f9fa;
        color: #6c757d;
        font-weight: 800;
    }

    .detalle-puntos-modal-head {
        display: flex;
        gap: .8rem;
        align-items: center;
        padding-right: 2rem;
    }

    .detalle-puntos-modal h5 {
        margin: 0;
        font-weight: 800;
    }

    .detalle-puntos-modal small {
        color: #6c757d;
        font-weight: 700;
    }

    .detalle-puntos-modal p {
        margin: .9rem 0 0;
        color: #344054;
        line-height: 1.45;
        white-space: pre-line;
    }
</style>

@code {

    [Parameter]
    public int PollaId { get; set; }

    private PollaDto? polla;
    private List<RankingPollaDto> ranking = new();
    private List<DetalleRankingDto> rankingDetalle = new();
    private string? usuarioDetalleAbierto;
    private bool detallePuntosVisible;
    private string detallePuntosTitulo = "";
    private string detallePuntosTexto = "";
    private string detallePuntosContexto = "";
    private string detallePuntosClase = "";
    private int detallePuntosValor;
    private HashSet<string> fasesDetalleMinimizadas = new(StringComparer.OrdinalIgnoreCase);

    private void ToggleDetalleUsuario(string usuario)
    {
        if (usuarioDetalleAbierto == usuario)
        {
            usuarioDetalleAbierto = null;
        }
        else
        {
            usuarioDetalleAbierto = usuario;
        }
    }

    private void AbrirDetallePuntos(
        string titulo,
        int puntos,
        string clase,
        string? detalle,
        DetalleRankingDto detalleRanking)
    {
        detallePuntosTitulo = titulo;
        detallePuntosValor = puntos;
        detallePuntosClase = clase;
        detallePuntosTexto = string.IsNullOrWhiteSpace(detalle)
            ? $"Estos puntos corresponden a {titulo.ToLowerInvariant()}."
            : detalle;
        detallePuntosContexto = $"{detalleRanking.Local} vs {detalleRanking.Visitante} | {detalleRanking.Fase}";
        detallePuntosVisible = true;
    }

    private void CerrarDetallePuntos()
    {
        detallePuntosVisible = false;
    }

    private static int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private bool FaseDetalleMinimizada(string usuario, string fase)
    {
        return fasesDetalleMinimizadas.Contains(ClaveFaseDetalle(usuario, fase));
    }

    private void ToggleFaseDetalle(string usuario, string fase)
    {
        var clave = ClaveFaseDetalle(usuario, fase);
        if (!fasesDetalleMinimizadas.Add(clave))
        {
            fasesDetalleMinimizadas.Remove(clave);
        }
    }

    private static string ClaveFaseDetalle(string usuario, string fase)
    {
        return $"{usuario}|{fase}";
    }

    private List<ParticipanteDto> participantes = new();

    private string emailInvitado = "";
    private string? linkInvitacion;

    private bool EsCreador =>
        polla != null && Sesion.UsuarioId == polla.CreadorId;

    protected override async Task OnInitializedAsync()
    {
        polla = await PollasService.GetPollaAsync(PollaId);
        ranking = await PollasService.GetRankingAsync(PollaId);
        rankingDetalle =
            await Http.GetFromJsonAsync<List<DetalleRankingDto>>(
                $"api/Polla/{PollaId}/ranking-detalle"
            ) ?? new();
        participantes = await PollasService.GetParticipantesAsync(PollaId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo($"/login?returnUrl=/polla/{PollaId}", true);
            return;
        }

        if (polla != null)
        {
            await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
            StateHasChanged();
        }
    }

    private async Task IrAPredicciones()
    {
        if (polla != null)
        {
            await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
        }

        Navigation.NavigateTo("/predicciones");
    }

    private void VolverADashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }

    private async Task Invitar()
    {
        if (string.IsNullOrWhiteSpace(emailInvitado))
        {
            mensaje = "Debes indicar el correo del invitado.";
            esError = true;
            return;
        }

        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para invitar usuarios.";
            esError = true;
            return;
        }

        try
        {
            var link = $"{Navigation.BaseUri}unirse-polla/{PollaId}";
            linkInvitacion = await PollasService.CrearInvitacionAsync(
                PollaId,
                new CrearInvitacionPollaDto
                {
                    RemitenteId = Sesion.UsuarioId.Value,
                    EmailInvitado = emailInvitado,
                    LinkInvitacion = link
                });

            mensaje = $"Invitación enviada a {emailInvitado}.";
            esError = false;
            emailInvitado = "";
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
    }

    private string nuevoPin = "";

    private async Task CambiarPin()
    {
        if (string.IsNullOrWhiteSpace(nuevoPin) || nuevoPin.Length != 4)
            return;

        await PollasService.ActualizarPinAsync(PollaId, nuevoPin);

        // refrescar la polla para ver el nuevo PIN
        polla = await PollasService.GetPollaAsync(PollaId);

        nuevoPin = "";
    }

    private bool mostrarConfirmacion = false;
    private int usuarioAEliminarId;
    private string? usuarioAEliminarNombre;
    private string? mensaje;
    private bool esError;

    private void ConfirmarEliminar(int usuarioId, string nombre)
    {
        usuarioAEliminarId = usuarioId;
        usuarioAEliminarNombre = nombre;
        mostrarConfirmacion = true;
    }

    private async Task EliminarConfirmadoAsync()
    {
        try
        {
            await PollasService.EliminarMiembroAsync(
                PollaId,
                usuarioAEliminarId,
                Sesion.UsuarioId!.Value
            );

            // refrescar lista
            participantes = await PollasService.GetParticipantesAsync(PollaId);

            mensaje = $"❌ {usuarioAEliminarNombre} fue expulsado de la polla.";
            esError = false;
        }
        catch
        {
            mensaje = "Error al expulsar el usuario.";
            esError = true;
        }
        finally
        {
            mostrarConfirmacion = false;
        }

    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }



}




