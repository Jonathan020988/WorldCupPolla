    private string nuevoPin = "";

    private async Task CambiarPin()
    {
        if (string.IsNullOrWhiteSpace(nuevoPin) || nuevoPin.Length != 4)
            return;

        if (!Sesion.UsuarioId.HasValue)
        {
            mensaje = "Debes iniciar sesión para cambiar el PIN.";
            esError = true;
            return;
        }

        await PollasService.ActualizarPinAsync(PollaId, nuevoPin, Sesion.UsuarioId.Value);

        // refrescar la polla para ver el nuevo PIN
        polla = await PollasService.GetPollaAsync(PollaId, Sesion.UsuarioId.Value);

        nuevoPin = "";
