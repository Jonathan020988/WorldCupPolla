@page "/polla/{PollaId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="d-flex align-items-start gap-3 mb-4 flex-wrap">
    <button class="btn btn-outline-primary btn-lg"
            @onclick="VolverADashboard">
        ⬅ Mis pollas
    </button>

    <div class="flex-grow-1">
        <h2 class="mb-0">🏆 Detalle de la Polla</h2>
        <small class="text-muted">
            Estás viendo el detalle de esta polla
        </small>

        @if (polla != null)
        {
            <div class="mt-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold">Nombre:</span>
                    <span class="fs-5">@polla.Nombre</span>

                    @if (EsCreador && !editandoNombrePolla)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="EditarNombrePolla">
                            Editar nombre
                        </button>
                    }
                </div>

                @if (editandoNombrePolla)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-md-7">
                            <input class="form-control"
                                   maxlength="120"
                                   @bind="nombrePollaEdit"
                                   @bind:event="oninput"
                                   placeholder="Nombre de la polla" />
                        </div>
                        <div class="col-md-5 d-flex align-items-center gap-2">
                            <button class="btn btn-success btn-sm"
                                    @onclick="GuardarNombrePolla">
                                Guardar nombre
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="CancelarNombrePolla">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (polla == null)
{
    <div class="alert alert-info">
        Cargando información de la polla...
    </div>
}
else
{
    @* ===== SOLO EL CREADOR VE ESTO ===== *@
    @if (EsCreador)
    {
        <div class="card mt-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Capacidad de la polla</h5>
                        <small class="text-muted">
                            @participantes.Count participante@(participantes.Count == 1 ? "" : "s") / @TextoCupoPolla
                        </small>
                    </div>
                    <span class="badge @(polla.CuposIlimitados ? "bg-success" : "bg-secondary")">
                        @(polla.CuposIlimitados ? "Cupos ilimitados" : "Plan actual")
                    </span>
                </div>

                @if (!polla.CuposIlimitados && (polla.MaximoMiembros ?? 5) <= 5)
                {
                    <div class="cupos-panel cupos-panel-warning mt-3">
                        <div class="d-flex justify-content-between gap-3 flex-wrap">
                            <div>
                                <div class="fw-bold">Solo pueden ingresar 5 usuarios gratis</div>
                                <small>Para ampliar esta polla, solicita uno de estos planes.</small>
                            </div>
                            <span class="cupos-badge">Ampliación</span>
                        </div>

                        <div class="cupos-plan-grid mt-3">
                            <div class="cupos-plan">
                                <span>20 usuarios</span>
                                <strong>$30.000</strong>
                            </div>
                            <div class="cupos-plan">
                                <span>50 usuarios</span>
                                <strong>$70.000</strong>
                            </div>
                            <div class="cupos-plan cupos-plan-featured">
                                <span>50 o más</span>
                                <strong>$120.000</strong>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(mensajeCupos))
                {
                    <div class="alert @(errorCupos ? "alert-danger" : "alert-success") mt-3">
                        @mensajeCupos
                    </div>
                }

                <div class="cupos-panel mt-3">
                    <div class="d-flex justify-content-between gap-3 align-items-start flex-wrap">
                        <div>
                            <h6 class="fw-bold mb-1">Ampliar cupos</h6>
                            <small class="text-muted">Envía la solicitud al administrador y activa el código cuando lo recibas.</small>
                        </div>
                        <span class="cupos-badge cupos-badge-soft">Admin</span>
                    </div>

                <div class="row g-2 mt-3">
                    <div class="col-md-4">
                        <label class="form-label">Celular</label>
                        <input class="form-control"
                               placeholder="Ej: 3001234567"
                               @bind="celularAmpliacion" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cantidad de usuarios</label>
                        <input type="number"
                               class="form-control"
                               min="6"
                               @bind="cantidadAmpliacion" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-outline-primary w-100"
                                disabled="@procesandoCupos"
                                @onclick="SolicitarAmpliacion">
                            Enviar correo
                        </button>
                    </div>
                </div>

                <div class="codigo-cupos mt-3">
                    <label class="form-label">Código alfanumérico de 10 caracteres</label>
                    <div class="input-group">
                        <input class="form-control"
                               maxlength="10"
                               placeholder="Ej: A1B2C3D4E5"
                               @bind="codigoCupos"
                               @bind:event="oninput" />
                        <button class="btn btn-success"
                                disabled="@procesandoCupos"
                                @onclick="ActivarCodigoCupos">
                            Activar código
                        </button>
                    </div>
                </div>
                </div>
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5>Invitar a la polla</h5>

                <input class="form-control mb-2"
                       placeholder="Correo del invitado"
                       @bind="emailInvitado" />

                <button class="btn btn-primary"
                        @onclick="Invitar">
                    Invitar
                </button>

                @if (!string.IsNullOrEmpty(linkInvitacion))
                {
                    <div class="alert alert-success mt-3">
                        <strong>🔗 Link de invitación</strong><br />
                        <code>@linkInvitacion</code>
                    </div>
                }

                @if (!string.IsNullOrEmpty(polla.PinIngreso))
                {
                    <div class="alert alert-warning mt-3">
                        <strong>🔐 PIN de acceso:</strong>
                        <span class="ms-2 fw-bold">@polla.PinIngreso</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="mt-3">
            <label class="form-label fw-bold">✏️ Cambiar PIN</label>
            <input class="form-control mb-2"
                   maxlength="4"
                   @bind="nuevoPin"
                   placeholder="Nuevo PIN (4 dígitos)" />

            <button class="btn btn-warning btn-sm"
                    @onclick="CambiarPin">
                Guardar nuevo PIN
            </button>
        </div>
    }

    <div class="card mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h5 class="mb-1">Reglas de pago de la polla</h5>
                    <small class="text-muted">Valor de participación y método definido por el creador.</small>
                </div>

                @if (EsCreador && !editandoPolla)
                {
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="EditarDatosPolla">
                        Editar
                    </button>
                }
            </div>

            @if (editandoPolla)
            {
                <div class="row g-3 mt-2">
                    <div class="col-12">
                        <label class="form-label fw-bold">Nombre de la polla</label>
                        <input class="form-control"
                               maxlength="120"
                               @bind="nombrePollaEdit"
                               @bind:event="oninput"
                               placeholder="Nombre de la polla" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Precio</label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               step="1000"
                               @bind="valorInscripcionEdit" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Descripción de la polla</label>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Ej: Reglas internas, notas para los participantes o información general de esta polla"
                                  @bind="descripcionEdit"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Método de pago</label>
                        <textarea class="form-control"
                                  rows="3"
                                  @bind="metodoPagoEdit"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success btn-sm"
                            @onclick="GuardarDatosPolla">
                        Guardar cambios
                    </button>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="CancelarDatosPolla">
                        Cancelar
                    </button>
                </div>
            }
            else
            {
                <div class="payment-summary mt-3">
                    <div class="payment-price">
                        <span>Precio</span>
                        <strong>@FormatoPrecio(polla.ValorInscripcion)</strong>
                    </div>
                    <div class="payment-description">
                        <span>Descripción</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.Descripcion) ? "Sin descripción por ahora." : polla.Descripcion)</p>
                    </div>
                    <div class="payment-method">
                        <span>Método de pago</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.MetodoPago) ? "No definido todavía." : polla.MetodoPago)</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (EsCreador)
    {
        <div class="card mt-3 payment-control-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Control de pagos</h5>
                        <small class="text-muted">Seguimiento de valor, abonos, saldo y avisos por participante.</small>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@cargandoControlPagos"
                            @onclick="CargarControlPagos">
                        Actualizar
                    </button>
                </div>

                @if (cargandoControlPagos)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Cargando control de pagos...
                    </div>
                }
                else if (controlPagos == null)
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        El control se cargará al iniciar sesión como creador de la polla.
                    </div>
                }
                else
                {
                    <div class="payment-kpis mt-3">
                        <div>
                            <span>Total esperado</span>
                            <strong>@FormatoPrecio(controlPagos.TotalEsperado)</strong>
                        </div>
                        <div>
                            <span>Total recibido</span>
                            <strong>@FormatoPrecio(controlPagos.TotalPagado)</strong>
                        </div>
                        <div>
                            <span>Total pendiente</span>
                            <strong>@FormatoPrecio(controlPagos.TotalPendiente)</strong>
                        </div>
                        <div>
                            <span>Estado</span>
                            <strong>@controlPagos.ParticipantesPagados pagados / @controlPagos.TotalParticipantes</strong>
                        </div>
                    </div>

                    <div class="table-responsive mt-3 payment-control-scroll">
                        <table class="table table-sm align-middle payment-control-table">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Valor</th>
                                    <th>Abono / pagado</th>
                                    <th>Debe</th>
                                    <th>Estado</th>
                                    <th>Nota</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in controlPagos.Participantes)
                                {
                                    <tr>
                                        <td class="fw-bold">@pago.Nombre</td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm payment-money-input"
                                                   min="0"
                                                   step="1000"
                                                   @bind="pago.ValorAPagar" />
                                        </td>
                                        <td>
                                            <input type="number"
                                                   class="form-control form-control-sm payment-money-input"
                                                   min="0"
                                                   step="1000"
                                                   @bind="pago.AbonoPagado" />
                                        </td>
                                        <td class="fw-bold">@FormatoPrecio(pago.SaldoPendiente)</td>
                                        <td>
                                            <span class="badge @ClaseEstadoPago(pago.EstadoPago)">
                                                @pago.EstadoPago
                                            </span>
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm payment-note-input"
                                                   maxlength="180"
                                                   placeholder="Ej: pagó por Nequi"
                                                   @bind="pago.NotaPago" />
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <button class="btn btn-sm btn-success"
                                                        disabled="@PagoEnProceso(pago.UsuarioId)"
                                                        @onclick="() => GuardarPago(pago)">
                                                    Guardar
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning"
                                                        disabled="@(PagoEnProceso(pago.UsuarioId) || pago.SaldoPendiente <= 0)"
                                                        @onclick="() => NotificarPagoPendiente(pago)">
                                                    Avisar pago
                                                </button>
                                            </div>
                                            @if (pago.PagoNotificadoEn.HasValue)
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    Último aviso: @pago.PagoNotificadoEn.Value.ToString("dd/MM/yyyy hh:mm tt")
                                                </small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-3 mt-4 @(usuarioDetalleAbierto == null ? "" : "polla-detail-open")">

        <!-- 📊 Ranking -->
        <div class="ranking-col @(usuarioDetalleAbierto == null ? "col-md-8" : "col-12")">
            <div class="card shadow-sm">
                <div class="card-body ranking-card-body">
                    <h5 class="mb-3">📊 Ranking</h5>
                    <hr />

                    @if (!ranking.Any())
                    {
                        <div class="alert alert-info">
                            Aún no hay predicciones en esta polla.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle ranking-table">
                            <thead>
                                <tr>
                                    <th class="ranking-position-col">#</th>
                                    <th>Usuario</th>
                                    @if (EsCreador)
                                    {
                                        <th class="ranking-observation-col">Observación</th>
                                    }
                                    <th class="text-end ranking-points-col">Puntos</th>
                                    <th class="ranking-action-col"></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var r in ranking)
                                {
                                    <tr>
                                        <td>
                                            @(ranking.IndexOf(r) + 1)
                                        </td>

                                        <td class="fw-bold ranking-user-col">
                                            @r.Usuario
                                        </td>

                                        @if (EsCreador)
                                        {
                                            <td class="ranking-observation-col">
                                                <div class="ranking-observation-editor">
                                                    <input class="form-control form-control-sm"
                                                           maxlength="160"
                                                           placeholder="Observación"
                                                           @bind="r.ObservacionAdmin"
                                                           @bind:event="oninput" />
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            disabled="@(observacionGuardandoUsuarioId == r.UsuarioId)"
                                                            @onclick="() => GuardarObservacionRanking(r)">
                                                        @(observacionGuardandoUsuarioId == r.UsuarioId ? "..." : "Guardar")
                                                    </button>
                                                </div>
                                            </td>
                                        }

                                        <td class="text-end fw-bold">
                                            @r.Puntos
                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ToggleDetalleUsuario(r.Usuario)">

                                                @(usuarioDetalleAbierto == r.Usuario
                                                    ? "Ocultar detalle"
                                                    : "Ver detalle")

                                            </button>

                                        </td>
                                    </tr>

                                    @if (usuarioDetalleAbierto == r.Usuario)
                                    {
                                        <tr>
                                            <td colspan="@RankingColspan" class="ranking-detail-cell">

                                                <div class="table-responsive mt-2 mb-3 detalle-ranking-scroll">

                                                    <div class="detalle-filtros-panel">
                                                        <div>
                                                            <label>Equipo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleEquipoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var equipo in EquiposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@equipo">@equipo</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Grupo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleGrupoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var grupoFiltro in GruposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@grupoFiltro">Grupo @grupoFiltro</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Fecha</label>
                                                            <input class="form-control form-control-sm"
                                                                   type="date"
                                                                   @bind="detalleFechaFiltro" />
                                                        </div>
                                                        <div>
                                                            <label>Resumen por fase</label>
                                                            <select class="form-select form-select-sm" @bind="detalleFaseResumenFiltro">
                                                                <option value="">Ver partidos</option>
                                                                @foreach (var faseFiltro in FasesDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@faseFiltro">@NombreFase(faseFiltro)</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        @if (HayFiltrosDetalle())
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    @onclick="LimpiarFiltrosDetalle">
                                                                Limpiar
                                                            </button>
                                                        }
                                                    </div>

                                                    <table class="table table-bordered table-hover table-sm align-middle detalle-ranking-table">

                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th>Partido</th>
                                                                <th>Fase</th>
                                                                <th>Pronóstico</th>
                                                                <th>Resultado</th>

                                                                <th class="text-center">Exacto</th>
                                                                <th class="text-center">Ganador</th>
                                                                <th class="text-center">Diferencia</th>
                                                                <th class="text-center">Goles</th>
                                                                <th class="text-center">Clasificación</th>
                                                                <th class="text-center">Extras</th>
                                                                <th class="text-center">Podio</th>
                                                                <th class="text-center">Total</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>

                                                            @{
                                                                var detallesFiltrados = DetallesUsuarioFiltrados(r.Usuario).ToList();
                                                                var resumenFaseActivo = !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
                                                            }

                                                            @if (!detallesFiltrados.Any())
                                                            {
                                                                <tr>
                                                                    <td colspan="12" class="text-center text-muted fw-bold">
                                                                        No hay registros con esos filtros.
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else if (resumenFaseActivo)
                                                            {
                                                                <tr class="detalle-resumen-row">
                                                                    <td>
                                                                        <strong>Resumen</strong><br />
                                                                        <small>@detallesFiltrados.Count partido(s)</small>
                                                                    </td>
                                                                    <td><span class="badge bg-light text-dark">@NombreFase(detalleFaseResumenFiltro!)</span></td>
                                                                    <td>-</td>
                                                                    <td>-</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExacto), "bg-success")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGanador), "bg-info text-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosDiferencia), "bg-secondary")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGoles), "bg-primary")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosClasificacion), "bg-warning text-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExtras), "bg-dark")</td>
                                                                    <td class="text-center">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosPodio), "bg-danger")</td>
                                                                    <td class="text-center fw-bold">@detallesFiltrados.Sum(x => x.Total)</td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var faseDetalle in detallesFiltrados
                                                                    .GroupBy(x => x.Fase)
                                                                    .OrderBy(g => OrdenFase(g.Key)))
                                                                {
                                                                    var faseNombre = faseDetalle.Key;
                                                                    var faseMinimizada = FaseDetalleMinimizada(r.Usuario, faseNombre);

                                                                    <tr class="detalle-fase-row">
                                                                        <td colspan="12">
                                                                            <div class="detalle-fase-header">
                                                                                <div>
                                                                                    <strong>@faseNombre</strong>
                                                                                    <span>@faseDetalle.Count() partidos | @faseDetalle.Sum(x => x.Total) puntos</span>
                                                                                </div>
                                                                                <button type="button"
                                                                                        class="detalle-fase-btn"
                                                                                        @onclick="() => ToggleFaseDetalle(r.Usuario, faseNombre)">
                                                                                    @(faseMinimizada ? "Mostrar" : "Minimizar")
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>

                                                                    @if (!faseMinimizada)
                                                                    {
                                                                        @foreach (var d in faseDetalle.OrderBy(x => x.Fecha).ThenBy(x => x.Local))
                                                                        {
                                                                            <tr>

                                                                                <td>
                                                                                    <strong>@d.Local</strong>
                                                                                    vs
                                                                                    <strong>@d.Visitante</strong>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-light text-dark">
                                                                                        @d.Fase
                                                                                    </span>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-primary">
                                                                                        @d.PronosticoLocal - @d.PronosticoVisitante
                                                                                    </span>
                                                                                </td>

                                                                                <td>
                                                                                    <span class="badge bg-dark">
                                                                                        @d.ResultadoLocal - @d.ResultadoVisitante
                                                                                    </span>
                                                                                </td>

                                                                                <td class="text-center">@BadgePuntos(d.PuntosExacto, "bg-success")</td>
