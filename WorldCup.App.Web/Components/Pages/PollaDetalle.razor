    private async Task CargarDetalleSeguroAsync()
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            accesoDenegado = true;
            mensajeAcceso = "Debes iniciar sesión para ver esta polla.";
            return;
        }

        try
        {
            accesoDenegado = false;
            mensajeAcceso = null;

            var usuarioId = Sesion.UsuarioId.Value;
            polla = await PollasService.GetPollaAsync(PollaId, usuarioId);

            if (polla == null)
            {
                accesoDenegado = true;
                mensajeAcceso = "No encontramos esta polla o ya no está disponible.";
                return;
            }

            PrepararDatosPolla();
            await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);
            await CargarRanking();
            rankingDetalle = await PollasService.GetRankingDetalleAsync(PollaId, usuarioId);
            await CargarParticipantes();

            if (EsCreador)
            {
                cuposUsuario = await PollasService.GetCuposUsuarioAsync(usuarioId);
                cantidadAmpliacion = Math.Max(20, (polla.MaximoMiembros ?? 5) + 1);
                await CargarControlPagos();
                await CargarPartidosRecordatorio();
            }
        }
        catch (Exception ex)
        {
            polla = null;
            ranking.Clear();
            rankingDetalle.Clear();
            participantes.Clear();
            controlPagos = null;
            accesoDenegado = true;
            mensajeAcceso = MensajeAccesoSeguro(ex.Message);
        }
    }

