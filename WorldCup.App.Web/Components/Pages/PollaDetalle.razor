@page "/polla/{PollaId:int}"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@implements IAsyncDisposable
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<div class="polla-detail-header d-flex align-items-start gap-3 mb-4 flex-wrap">
    <button class="btn btn-outline-primary btn-lg polla-back-btn"
            @onclick="VolverADashboard">
        ⬅ Mis pollas
    </button>

    <div class="flex-grow-1 polla-title-box">
        <h2 class="mb-0">🏆 Detalle de la Polla</h2>
        <small class="text-muted">
            Estás viendo el detalle de esta polla
        </small>

        @if (polla != null)
        {
            <div class="mt-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold">Nombre:</span>
                    <span class="fs-5">@polla.Nombre</span>

                    @if (EsCreador && !editandoNombrePolla)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="EditarNombrePolla">
                            Editar nombre
                        </button>
                    }
                </div>

                @if (editandoNombrePolla)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-md-7">
                            <input class="form-control"
                                   maxlength="120"
                                   @bind="nombrePollaEdit"
                                   @bind:event="oninput"
                                   placeholder="Nombre de la polla" />
                        </div>
                        <div class="col-md-5 d-flex align-items-center gap-2">
                            <button class="btn btn-success btn-sm"
                                    @onclick="GuardarNombrePolla">
                                Guardar nombre
                            </button>
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="CancelarNombrePolla">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (accesoDenegado)
{
    <div class="alert alert-danger">
        <strong>Acceso no permitido.</strong>
        <div>@mensajeAcceso</div>
        <button class="btn btn-outline-primary btn-sm mt-3"
                @onclick="VolverADashboard">
            Volver a mis pollas
        </button>
    </div>
}
else if (polla == null)
{
    <div class="alert alert-info">
        Cargando información de la polla...
    </div>
}
else
{
    <div class="polla-sections @(polla.InscripcionesAbiertas ? "inscripciones-abiertas" : "inscripciones-cerradas")">
    @* ===== SOLO EL CREADOR VE ESTO ===== *@
    @if (EsCreador)
    {
        <div class="card mt-3 capacity-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Capacidad de la polla</h5>
                        <small class="text-muted">
                            @participantes.Count participante@(participantes.Count == 1 ? "" : "s") / @TextoCupoPolla
                        </small>
                    </div>
                    <span class="badge @(polla.CuposIlimitados ? "bg-success" : "bg-secondary")">
                        @(polla.CuposIlimitados ? "Cupos ilimitados" : "Plan actual")
                    </span>
                </div>

                <div class="registration-state-panel mt-3">
                    <div>
                        <span>Inscripciones</span>
                        <strong>@(polla.InscripcionesAbiertas ? "Abiertas" : "Cerradas")</strong>
                        <small>
                            @(polla.InscripcionesAbiertas
                                ? "Los usuarios pueden ingresar si tienen cupo y PIN válido."
                                : "No se aceptan usuarios nuevos hasta que las abras de nuevo.")
                        </small>
                    </div>

                    <button class="btn btn-sm @(polla.InscripcionesAbiertas ? "btn-outline-danger" : "btn-success")"
                            disabled="@procesandoInscripciones"
                            @onclick="CambiarEstadoInscripciones">
                        @(procesandoInscripciones
                            ? "Procesando..."
                            : polla.InscripcionesAbiertas
                                ? "Cerrar inscripciones"
                                : "Abrir inscripciones")
                    </button>
                </div>

                @if (!polla.CuposIlimitados && (polla.MaximoMiembros ?? 5) <= 5)
                {
                    <div class="cupos-panel cupos-panel-warning mt-3">
                        <div class="d-flex justify-content-between gap-3 flex-wrap">
                            <div>
                                <div class="fw-bold">Solo pueden ingresar 5 usuarios gratis</div>
                                <small>Para ampliar esta polla, solicita uno de estos planes.</small>
                            </div>
                            <span class="cupos-badge">Ampliación</span>
                        </div>

                        <div class="cupos-plan-grid mt-3">
                            <div class="cupos-plan">
                                <span>20 usuarios</span>
                                <strong>$30.000</strong>
                            </div>
                            <div class="cupos-plan">
                                <span>50 usuarios</span>
                                <strong>$70.000</strong>
                            </div>
                            <div class="cupos-plan cupos-plan-featured">
                                <span>100 usuarios</span>
                                <strong>$120.000</strong>
                            </div>
                            <div class="cupos-plan">
                                <span>Más de 100</span>
                                <strong>Cotización</strong>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(mensajeCupos))
                {
                    <div class="alert @(errorCupos ? "alert-danger" : "alert-success") mt-3">
                        @mensajeCupos
                    </div>
                }

                <div class="cupos-panel mt-3">
                    <div class="d-flex justify-content-between gap-3 align-items-start flex-wrap">
                        <div>
                            <h6 class="fw-bold mb-1">Ampliar cupos</h6>
                            <small class="text-muted">Envía la solicitud al administrador y activa el código cuando lo recibas.</small>
                        </div>
                        <span class="cupos-badge cupos-badge-soft">Admin</span>
                    </div>

                <div class="row g-2 mt-3">
                    <div class="col-md-4">
                        <label class="form-label">Celular</label>
                        <input class="form-control"
                               placeholder="Ej: 3001234567"
                               @bind="celularAmpliacion" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cantidad de usuarios</label>
                        <input type="number"
                               class="form-control"
                               min="6"
                               @bind="cantidadAmpliacion" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-outline-primary w-100"
                                disabled="@procesandoCupos"
                                @onclick="SolicitarAmpliacion">
                            Enviar correo
                        </button>
                    </div>
                </div>

                <div class="codigo-cupos mt-3">
                    <label class="form-label">Código alfanumérico de 10 caracteres</label>
                    <div class="input-group">
                        <input class="form-control"
                               maxlength="10"
                               placeholder="Ej: A1B2C3D4E5"
                               @bind="codigoCupos"
                               @bind:event="oninput" />
                        <button class="btn btn-success"
                                disabled="@procesandoCupos"
                                @onclick="ActivarCodigoCupos">
                            Activar código
                        </button>
                    </div>
                </div>
                </div>
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="card mt-3 invite-section">
            <div class="card-body">
                <h5>Invitar a la polla</h5>

                <input class="form-control mb-2"
                       placeholder="Correo del invitado"
                       @bind="emailInvitado" />

                <button class="btn btn-primary"
                        disabled="@(!polla.InscripcionesAbiertas)"
                        @onclick="Invitar">
                    Invitar
                </button>

                @if (!polla.InscripcionesAbiertas)
                {
                    <small class="text-muted d-block mt-2">
                        Las inscripciones están cerradas. Ábrelas para permitir nuevos ingresos.
                    </small>
                }

                @if (!string.IsNullOrEmpty(linkInvitacion))
                {
                    <div class="alert alert-success mt-3">
                        <strong>🔗 Link de invitación</strong><br />
                        <code>@linkInvitacion</code>
                    </div>
                }

                @if (!string.IsNullOrEmpty(polla.PinIngreso))
                {
                    <div class="alert alert-warning mt-3">
                        <strong>🔐 PIN de acceso:</strong>
                        <span class="ms-2 fw-bold">@polla.PinIngreso</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="mt-3 pin-section">
            <label class="form-label fw-bold">✏️ Cambiar PIN</label>
            <input class="form-control mb-2"
                   maxlength="4"
                   @bind="nuevoPin"
                   placeholder="Nuevo PIN (4 dígitos)" />

            <button class="btn btn-warning btn-sm"
                    @onclick="CambiarPin">
                Guardar nuevo PIN
            </button>
        </div>
    }

    <div class="card mt-3 rules-section">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h5 class="mb-1">Reglas de pago de la polla</h5>
                    <small class="text-muted">Valor de participación y método definido por el creador.</small>
                </div>

                @if (EsCreador && !editandoPolla)
                {
                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="EditarDatosPolla">
                        Editar
                    </button>
                }
            </div>

            @if (editandoPolla)
            {
                <div class="row g-3 mt-2">
                    <div class="col-12">
                        <label class="form-label fw-bold">Nombre de la polla</label>
                        <input class="form-control"
                               maxlength="120"
                               @bind="nombrePollaEdit"
                               @bind:event="oninput"
                               placeholder="Nombre de la polla" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Precio</label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               step="1000"
                               @bind="valorInscripcionEdit" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Descripción de la polla</label>
                        <textarea class="form-control"
                                  rows="3"
                                  placeholder="Ej: Reglas internas, notas para los participantes o información general de esta polla"
                                  @bind="descripcionEdit"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Método de pago</label>
                        <textarea class="form-control"
                                  rows="3"
                                  @bind="metodoPagoEdit"></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-success btn-sm"
                            @onclick="GuardarDatosPolla">
                        Guardar cambios
                    </button>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="CancelarDatosPolla">
                        Cancelar
                    </button>
                </div>
            }
            else
            {
                <div class="payment-summary mt-3">
                    <div class="payment-price">
                        <span>Precio</span>
                        <strong>@FormatoPrecio(polla.ValorInscripcion)</strong>
                    </div>
                    <div class="payment-description">
                        <span>Descripción</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.Descripcion) ? "Sin descripción por ahora." : polla.Descripcion)</p>
                    </div>
                    <div class="payment-method">
                        <span>Método de pago</span>
                        <p>@(string.IsNullOrWhiteSpace(polla.MetodoPago) ? "No definido todavía." : polla.MetodoPago)</p>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (EsCreador)
    {
        <div class="card mt-3 prizes-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Premios de la polla</h5>
                        <small class="text-muted">
                            Define si premiaras uno, dos o tres lugares y publica los valores en el ranking.
                        </small>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@(TotalBolsaEstimada <= 0)"
                            @onclick="CalcularPremiosSugeridos">
                        Calcular sugerencia
                    </button>
                </div>

                <div class="prize-kpis mt-3">
                    <div>
                        <span>Participantes</span>
                        <strong>@participantes.Count</strong>
                    </div>
                    <div>
                        <span>Valor por persona</span>
                        <strong>@FormatoPrecio(polla.ValorInscripcion)</strong>
                    </div>
                    <div>
                        <span>Bolsa estimada</span>
                        <strong>@FormatoPrecio(TotalBolsaEstimada)</strong>
                    </div>
                    <div>
                        <span>Premios asignados</span>
                        <strong>@FormatoPrecio(TotalPremiosAsignados)</strong>
                    </div>
                </div>

                <div class="prize-place-selector mt-3" role="group" aria-label="Cantidad de puestos premiados">
                    @for (var cantidad = 1; cantidad <= 3; cantidad++)
                    {
                        var puestos = cantidad;
                        <button type="button"
                                class="@(puestosPremiados == puestos ? "active" : "")"
                                @onclick="() => SeleccionarCantidadPremios(puestos)">
                            @puestos puesto@(puestos == 1 ? "" : "s")
                        </button>
                    }
                </div>

                <div class="prize-input-grid mt-3">
                    <label>
                        <span>1.er lugar</span>
                        <input type="number"
                               class="form-control"
                               min="0"
                               step="1000"
                               @bind="premioPrimerLugarEdit" />
                    </label>

                    @if (puestosPremiados >= 2)
                    {
                        <label>
                            <span>2.º lugar</span>
                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   step="1000"
                                   @bind="premioSegundoLugarEdit" />
                        </label>
                    }

                    @if (puestosPremiados >= 3)
                    {
                        <label>
                            <span>3.er lugar</span>
                            <input type="number"
                                   class="form-control"
                                   min="0"
                                   step="1000"
                                   @bind="premioTercerLugarEdit" />
                        </label>
                    }
                </div>

                <div class="prize-balance @(PremiosExcedenBolsa ? "over" : "") mt-3">
                    <span>@(PremiosExcedenBolsa ? "Exceso sobre la bolsa" : "Disponible sin asignar")</span>
                    <strong>@FormatoPrecio(Math.Abs(SaldoBolsaPremios))</strong>
                </div>

                @if (PremiosExcedenBolsa)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        Los premios superan la bolsa estimada. Puedes corregirlos antes de guardar.
                    </div>
                }

                <div class="d-flex justify-content-end mt-3">
                    <button type="button"
                            class="btn btn-success"
                            disabled="@guardandoPremios"
                            @onclick="GuardarPremios">
                        @(guardandoPremios ? "Guardando..." : "Guardar premios")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajePremios))
                {
                    <div class="alert @(errorPremios ? "alert-danger" : "alert-success") mt-3 mb-0">
                        @mensajePremios
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="card mt-3 manual-formats-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Formatos manuales PDF</h5>
                        <small class="text-muted">
                            Descarga planillas compactas para imprimir y llenar a mano.
                        </small>
                    </div>
                    <span class="manual-format-pill">PDF</span>
                </div>

                <div class="manual-formats-grid mt-3">
                    @foreach (var formato in FormatosManuales)
                    {
                        <button type="button"
                                class="manual-format-btn"
                                disabled="@FormatoManualProcesando"
                                @onclick="() => DescargarFormatoManualPdf(formato.Tipo)">
                            <span>@formato.Etiqueta</span>
                            <strong>
                                @(descargandoFormatoManual && formatoManualEnDescarga == formato.Tipo
                                    ? "Generando..."
                                    : formato.Titulo)
                            </strong>
                            <small>@formato.Descripcion</small>
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeFormatoManual))
                {
                    <div class="alert @(errorFormatoManual ? "alert-danger" : "alert-success") mt-3 mb-0">
                        @mensajeFormatoManual
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="card mt-3 reminders-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Recordatorios de marcadores</h5>
                        <small class="text-muted">
                            Elige un partido para ver quiénes aún no lo han llenado y enviarles una alerta.
                        </small>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@cargandoRecordatorios"
                            @onclick="CargarPartidosRecordatorio">
                        Actualizar
                    </button>
                </div>

                @if (cargandoRecordatorios)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Revisando marcadores pendientes...
                    </div>
                }
                else if (!partidosRecordatorio.Any())
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        No hay partidos abiertos para enviar recordatorios.
                    </div>
                }
                else
                {
                    <div class="reminder-match-picker mt-3">
                        <label>
                            <span>Buscar partido</span>
                            <input class="form-control"
                                   placeholder="Equipo o fase..."
                                   @bind="recordatorioPartidoFiltro"
                                   @bind:event="oninput" />
                        </label>

                        <label>
                            <span>Partido</span>
                            <select class="form-select"
                                    value="@partidoRecordatorioId"
                                    @onchange="SeleccionarPartidoRecordatorio">
                                <option value="">Selecciona un partido</option>
                                @foreach (var partido in PartidosRecordatorioFiltrados())
                                {
                                    <option value="@partido.PartidoId">
                                        @partido.Local vs @partido.Visitante · @partido.TotalPendientes pendiente(s)
                                    </option>
                                }
                            </select>
                        </label>
                    </div>

                    @if (partidoRecordatorioId.HasValue)
                    {
                        var partidoSeleccionado = PartidoRecordatorioSeleccionado();

                        @if (partidoSeleccionado != null)
                        {
                            <div class="reminder-match-summary mt-3">
                                <div>
                                    <span>@partidoSeleccionado.Fase</span>
                                    <strong>@partidoSeleccionado.Local vs @partidoSeleccionado.Visitante</strong>
                                    <small>
                                        @partidoSeleccionado.Fecha.ToString("dd/MM/yyyy · HH:mm")
                                    </small>
                                </div>

                                <button class="btn btn-warning"
                                        disabled="@(enviandoRecordatorioMasivo || !usuariosRecordatorio.Any())"
                                        @onclick="EnviarRecordatorioATodos">
                                    @(enviandoRecordatorioMasivo
                                        ? "Enviando..."
                                        : $"Avisar a los {usuariosRecordatorio.Count} pendientes")
                                </button>
                            </div>
                        }

                        @if (cargandoUsuariosRecordatorio)
                        {
                            <div class="alert alert-info mt-3 mb-0">
                                Cargando participantes pendientes...
                            </div>
                        }
                        else if (!usuariosRecordatorio.Any())
                        {
                            <div class="alert alert-success mt-3 mb-0">
                                Todos los participantes ya completaron este marcador.
                            </div>
                        }
                        else
                        {
                            <div class="reminder-user-list mt-3">
                                @foreach (var usuario in usuariosRecordatorio)
                                {
                                    <div class="reminder-user-row">
                                        <div>
                                            <strong>@usuario.Usuario</strong>
                                            <small>Participante con marcador pendiente</small>
                                        </div>

                                        <div class="reminder-user-actions">
                                            @if (usuario.AlertaPendiente)
                                            {
                                                <span class="reminder-sent">Alerta pendiente</span>
                                            }

                                            <button class="btn btn-sm btn-outline-primary"
                                                    disabled="@recordatoriosEnProceso.Contains(usuario.UsuarioId)"
                                                    @onclick="() => EnviarRecordatorioUsuario(usuario)">
                                                @(recordatoriosEnProceso.Contains(usuario.UsuarioId)
                                                    ? "Enviando..."
                                                    : usuario.AlertaPendiente
                                                        ? "Reenviar"
                                                        : "Enviar alerta")
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                }

                @if (!string.IsNullOrWhiteSpace(mensajeRecordatorio))
                {
                    <div class="alert @(errorRecordatorio ? "alert-danger" : "alert-success") mt-3 mb-0">
                        @mensajeRecordatorio
                    </div>
                }
            </div>
        </div>
    }

    @if (EsCreador)
    {
        <div class="card mt-3 payment-control-card payment-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Control de pagos</h5>
                        <small class="text-muted">Seguimiento de valor, abonos, saldo y avisos por participante.</small>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@cargandoControlPagos"
                            @onclick="CargarControlPagos">
                        Actualizar
                    </button>
                </div>

                @if (cargandoControlPagos)
                {
                    <div class="alert alert-info mt-3 mb-0">
                        Cargando control de pagos...
                    </div>
                }
                else if (controlPagos == null)
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        El control se cargará al iniciar sesión como creador de la polla.
                    </div>
                }
                else
                {
                    <div class="payment-kpis mt-3">
                        <div>
                            <span>Total esperado</span>
                            <strong>@FormatoPrecio(controlPagos.TotalEsperado)</strong>
                        </div>
                        <div>
                            <span>Total recibido</span>
                            <strong>@FormatoPrecio(controlPagos.TotalPagado)</strong>
                        </div>
                        <div>
                            <span>Total pendiente</span>
                            <strong>@FormatoPrecio(controlPagos.TotalPendiente)</strong>
                        </div>
                        <div>
                            <span>Estado</span>
                            <strong>@controlPagos.ParticipantesPagados pagados / @controlPagos.TotalParticipantes</strong>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!cargandoControlPagos && controlPagos != null)
        {
            <div class="card mt-3 payment-list-section">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h5 class="mb-1">Detalle de pagos por usuario</h5>
                            <small class="text-muted">Lista completa para ajustar valores, abonos y avisos.</small>
                        </div>
                    </div>

                    <div class="table-responsive mt-3 payment-control-scroll">
                        <table class="table table-sm align-middle payment-control-table">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Valor</th>
                                    <th>Abono / pagado</th>
                                    <th>Debe</th>
                                    <th>Estado</th>
                                    <th>Forma de pago</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pago in controlPagos.Participantes)
                                {
                                    <tr>
                                        <td class="fw-bold" data-label="Usuario">@pago.Nombre</td>
                                        <td data-label="Valor">
                                            <input type="number"
                                                   class="form-control form-control-sm payment-money-input"
                                                   min="0"
                                                   step="1000"
                                                   @bind="pago.ValorAPagar" />
                                        </td>
                                        <td data-label="Abono">
                                            <input type="number"
                                                   class="form-control form-control-sm payment-money-input"
                                                   min="0"
                                                   step="1000"
                                                   @bind="pago.AbonoPagado" />
                                        </td>
                                        <td class="fw-bold" data-label="Debe">@FormatoSaldoPendiente(pago.SaldoPendiente)</td>
                                        <td data-label="Estado">
                                            <span class="badge @ClaseEstadoPago(pago.EstadoPago)">
                                                @pago.EstadoPago
                                            </span>
                                        </td>
                                        <td data-label="Forma de pago">
                                            <div class="payment-method-cell">
                                                <select class="form-select form-select-sm payment-method-select"
                                                        value="@FormaPagoSeleccionada(pago)"
                                                        @onchange="e => CambiarFormaPago(pago, e.Value?.ToString())">
                                                    <option value="">Sin definir</option>
                                                    <option value="Transferencia">Transferencia</option>
                                                    <option value="Efectivo">Efectivo</option>
                                                    <option value="Otra">Otra</option>
                                                </select>

                                                @if (FormaPagoSeleccionada(pago) == "Otra")
                                                {
                                                    <input class="form-control form-control-sm payment-other-input"
                                                           maxlength="180"
                                                           placeholder="¿Cuál?"
                                                           @bind="pago.NotaPago" />
                                                }
                                            </div>
                                        </td>
                                        <td data-label="Acciones">
                                            <div class="d-flex gap-2 flex-wrap">
                                                <button class="btn btn-sm btn-success"
                                                        disabled="@PagoEnProceso(pago.UsuarioId)"
                                                        @onclick="() => GuardarPago(pago)">
                                                    Guardar
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning"
                                                        disabled="@(PagoEnProceso(pago.UsuarioId) || pago.SaldoPendiente <= 0)"
                                                        @onclick="() => NotificarPagoPendiente(pago)">
                                                    Avisar pago
                                                </button>
                                            </div>
                                            @if (pago.PagoNotificadoEn.HasValue)
                                            {
                                                <small class="text-muted d-block mt-1">
                                                    Último aviso: @pago.PagoNotificadoEn.Value.ToString("dd/MM/yyyy hh:mm tt")
                                                </small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    @if (EsCreador)
    {
        var usuarioResumen = UsuarioResumenSeleccionado();
        var pagoResumen = PagoResumenSeleccionado();
        var rankingResumen = RankingResumenSeleccionado();

        <div class="card mt-3 quick-user-section">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">Buscar usuario</h5>
                        <small class="text-muted">Selecciona un participante para ver pago, ranking y acciones sin bajar a buscarlo.</small>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(usuarioResumenFiltro))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="LimpiarUsuarioResumen">
                            Limpiar
                        </button>
                    }
                </div>

                <div class="quick-user-picker mt-3">
                    <label class="form-label">Buscar o seleccionar usuario</label>
                    <input class="form-control"
                           list="participantes-polla-list"
                           placeholder="Escribe o pega el nombre del usuario"
                           @bind="usuarioResumenFiltro"
                           @bind:event="oninput" />
                    <datalist id="participantes-polla-list">
                        @foreach (var participante in participantes.OrderBy(p => p.Nombre))
                        {
                            <option value="@participante.Nombre"></option>
                        }
                    </datalist>

                    @if (!string.IsNullOrWhiteSpace(usuarioResumenFiltro) &&
                        usuarioResumen == null &&
                        ParticipantesResumenFiltrados().Any())
                    {
                        <div class="quick-user-results">
                            @foreach (var participante in ParticipantesResumenFiltrados())
                            {
                                <button type="button"
                                        @onclick="() => SeleccionarUsuarioResumen(participante)">
                                    @participante.Nombre
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (usuarioResumen == null)
                {
                    <div class="alert alert-light border mt-3 mb-0">
                        Elige un usuario para cargar su información principal.
                    </div>
                }
                else
                {
                    <div class="quick-user-grid mt-3">
                        <div class="quick-user-card">
                            <span>Participante</span>
                            <strong>@usuarioResumen.Nombre</strong>
                            @if (usuarioResumen.Id == polla.CreadorId)
                            {
                                <small class="text-muted">Creador de la polla</small>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger mt-2"
                                        @onclick="() => ConfirmarEliminar(usuarioResumen.Id, usuarioResumen.Nombre)">
                                    Eliminar usuario
                                </button>
                            }
                        </div>

                        <div class="quick-user-card">
                            <span>Pago</span>
                            @if (pagoResumen == null)
                            {
                                <strong>Sin datos</strong>
                            }
                            else
                            {
                                <div class="quick-payment-fields">
                                    <label>Valor</label>
                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           step="1000"
                                           @bind="pagoResumen.ValorAPagar" />

                                    <label>Abono</label>
                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           step="1000"
                                           @bind="pagoResumen.AbonoPagado" />

                                    <label>Forma de pago</label>
                                    <select class="form-select form-select-sm"
                                            value="@FormaPagoSeleccionada(pagoResumen)"
                                            @onchange="e => CambiarFormaPago(pagoResumen, e.Value?.ToString())">
                                        <option value="">Sin definir</option>
                                        <option value="Transferencia">Transferencia</option>
                                        <option value="Efectivo">Efectivo</option>
                                        <option value="Otra">Otra</option>
                                    </select>

                                    @if (FormaPagoSeleccionada(pagoResumen) == "Otra")
                                    {
                                        <input class="form-control form-control-sm"
                                               maxlength="180"
                                               placeholder="¿Cuál?"
                                               @bind="pagoResumen.NotaPago" />
                                    }
                                </div>

                                <div class="quick-user-mini mt-2">
                                    <span>Debe</span>
                                    <strong>@FormatoSaldoPendiente(pagoResumen.SaldoPendiente)</strong>
                                    <span class="badge @ClaseEstadoPago(pagoResumen.EstadoPago)">
                                        @pagoResumen.EstadoPago
                                    </span>
                                </div>

                                <div class="quick-actions mt-2">
                                    <button class="btn btn-sm btn-success"
                                            disabled="@PagoEnProceso(pagoResumen.UsuarioId)"
                                            @onclick="() => GuardarPago(pagoResumen)">
                                        Guardar pago
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning"
                                            disabled="@(PagoEnProceso(pagoResumen.UsuarioId) || pagoResumen.SaldoPendiente <= 0)"
                                            @onclick="() => NotificarPagoPendiente(pagoResumen)">
                                        Avisar pago
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="quick-user-card">
                            <span>Ranking</span>
                            @if (rankingResumen == null)
                            {
                                <strong>Sin predicciones</strong>
                            }
                            else
                            {
                                <div class="quick-user-mini">
                                    <span>Posición</span>
                                    <strong>#@PosicionRanking(rankingResumen)</strong>
                                    <span>Puntos</span>
                                    <strong>@rankingResumen.Puntos</strong>
                                    @if (rankingResumen.Premio.HasValue && rankingResumen.Premio.Value > 0)
                                    {
                                        <span>Premio</span>
                                        <strong>@FormatoPrecio(rankingResumen.Premio)</strong>
                                    }
                                </div>

                                <div class="ranking-observation-editor mt-2">
                                    <input class="form-control form-control-sm"
                                           maxlength="160"
                                           placeholder="Observación"
                                           @bind="rankingResumen.ObservacionAdmin"
                                           @bind:event="oninput" />
                                    <button class="btn btn-sm btn-outline-primary"
                                            disabled="@(observacionGuardandoUsuarioId == rankingResumen.UsuarioId)"
                                            @onclick="() => GuardarObservacionRanking(rankingResumen)">
                                        @(observacionGuardandoUsuarioId == rankingResumen.UsuarioId ? "..." : "Guardar")
                                    </button>
                                </div>

                                <button class="btn btn-sm btn-outline-primary mt-2 w-100"
                                        @onclick="() => ToggleDetalleUsuario(rankingResumen.Usuario)">
                                    Ver detalle de puntos
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="row g-3 mt-4 ranking-section @(usuarioDetalleAbierto == null ? "" : "polla-detail-open")">

        <!-- 📊 Ranking -->
        <div class="ranking-col @(usuarioDetalleAbierto == null ? "col-lg-8" : "col-12")">
            <div class="card shadow-sm">
                <div class="card-body ranking-card-body">
                    <h5 class="mb-3">📊 Ranking</h5>
                    <hr />

                    @if (!ranking.Any())
                    {
                        <div class="alert alert-info">
                            Aún no hay predicciones en esta polla.
                        </div>
                    }
                    else
                    {
                        <div class="ranking-table-scroll">
                            <table class="table table-sm align-middle ranking-table">
                                <thead>
                                    <tr>
                                        <th class="ranking-position-col">#</th>
                                        <th>Usuario</th>
                                        @if (EsCreador)
                                        {
                                            <th class="ranking-observation-col">Observación</th>
                                        }
                                        <th class="text-end ranking-points-col">Puntos</th>
                                        <th class="ranking-action-col"></th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var r in ranking)
                                    {
                                        <tr class="ranking-row @(usuarioDetalleAbierto == r.Usuario ? "open" : "")">
                                            <td class="ranking-rank-cell" data-label="#">
                                                @(ranking.IndexOf(r) + 1)
                                            </td>

                                            <td class="fw-bold ranking-user-col ranking-user-cell" data-label="Usuario">
                                                <span>@r.Usuario</span>
                                                @if (r.Premio.HasValue && r.Premio.Value > 0)
                                                {
                                                    <small class="ranking-prize-label">
                                                        Premio @FormatoPrecio(r.Premio)
                                                    </small>
                                                }
                                            </td>

                                            @if (EsCreador)
                                            {
                                                <td class="ranking-observation-col ranking-observation-cell" data-label="Observación">
                                                    <div class="ranking-observation-editor">
                                                        <input class="form-control form-control-sm"
                                                               maxlength="160"
                                                               placeholder="Observación"
                                                               @bind="r.ObservacionAdmin"
                                                               @bind:event="oninput" />
                                                        <button class="btn btn-sm btn-outline-primary"
                                                                disabled="@(observacionGuardandoUsuarioId == r.UsuarioId)"
                                                                @onclick="() => GuardarObservacionRanking(r)">
                                                            @(observacionGuardandoUsuarioId == r.UsuarioId ? "..." : "Guardar")
                                                        </button>
                                                    </div>
                                                </td>
                                            }

                                            <td class="text-end fw-bold ranking-points-cell" data-label="Puntos">
                                                @r.Puntos
                                            </td>

                                            <td class="text-end ranking-action-cell" data-label="Detalle">

                                                <button class="btn btn-sm btn-outline-primary ranking-detail-toggle"
                                                        @onclick="() => ToggleDetalleUsuario(r.Usuario)">

                                                    @(usuarioDetalleAbierto == r.Usuario
                                                        ? "Ocultar"
                                                        : "Detalle")

                                                </button>

                                            </td>
                                        </tr>

                                        @if (usuarioDetalleAbierto == r.Usuario)
                                        {
                                            <tr class="ranking-detail-row">
                                                <td colspan="@RankingColspan" class="ranking-detail-cell">

                                                <div class="table-responsive mt-2 mb-3 detalle-ranking-scroll">

                                                    <div class="detalle-filtros-panel">
                                                        <div>
                                                            <label>Equipo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleEquipoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var equipo in EquiposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@equipo">@equipo</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Grupo</label>
                                                            <select class="form-select form-select-sm" @bind="detalleGrupoFiltro">
                                                                <option value="">Todos</option>
                                                                @foreach (var grupoFiltro in GruposDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@grupoFiltro">Grupo @grupoFiltro</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div>
                                                            <label>Fecha</label>
                                                            <input class="form-control form-control-sm"
                                                                   type="date"
                                                                   @bind="detalleFechaFiltro" />
                                                        </div>
                                                        <div>
                                                            <label>Resumen por fase</label>
                                                            <select class="form-select form-select-sm" @bind="detalleFaseResumenFiltro">
                                                                <option value="">Ver partidos</option>
                                                                @foreach (var faseFiltro in FasesDetalleDisponibles(r.Usuario))
                                                                {
                                                                    <option value="@faseFiltro">@NombreFase(faseFiltro)</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        @if (HayFiltrosDetalle())
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    @onclick="LimpiarFiltrosDetalle">
                                                                Limpiar
                                                            </button>
                                                        }
                                                    </div>

                                                    <table class="table table-bordered table-hover table-sm align-middle detalle-ranking-table">

                                                        <thead class="table-dark">
                                                            <tr>
                                                                <th>Partido</th>
                                                                <th>Fase</th>
                                                                <th>Pronóstico</th>
                                                                <th>Resultado</th>

                                                                <th class="text-center">Exacto</th>
                                                                <th class="text-center">Ganador</th>
                                                                <th class="text-center">Diferencia</th>
                                                                <th class="text-center">Goles</th>
                                                                <th class="text-center">Clasificación</th>
                                                                <th class="text-center">Extras</th>
                                                                <th class="text-center">Podio</th>
                                                                <th class="text-center">Total</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>

                                                            @{
                                                                var detallesFiltrados = DetallesUsuarioFiltrados(r.Usuario).ToList();
                                                                var resumenFaseActivo = !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
                                                            }

                                                            @if (!detallesFiltrados.Any())
                                                            {
                                                                <tr>
                                                                    <td colspan="12" class="text-center text-muted fw-bold">
                                                                        No hay registros con esos filtros.
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else if (resumenFaseActivo)
                                                            {
                                                                <tr class="detalle-resumen-row">
                                                                    <td data-label="Partido">
                                                                        <strong>Resumen</strong><br />
                                                                        <small>@detallesFiltrados.Count partido(s)</small>
                                                                    </td>
                                                                    <td data-label="Fase"><span class="badge bg-light text-dark">@NombreFase(detalleFaseResumenFiltro!)</span></td>
                                                                    <td data-label="Pronóstico">-</td>
                                                                    <td data-label="Resultado">-</td>
                                                                    <td class="text-center" data-label="Exacto">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExacto), "bg-success")</td>
                                                                    <td class="text-center" data-label="Ganador">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGanador), "bg-info text-dark")</td>
                                                                    <td class="text-center" data-label="Diferencia">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosDiferencia), "bg-secondary")</td>
                                                                    <td class="text-center" data-label="Goles">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosGoles), "bg-primary")</td>
                                                                    <td class="text-center" data-label="Clasificación">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosClasificacion), "bg-warning text-dark")</td>
                                                                    <td class="text-center" data-label="Extras">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosExtras), "bg-dark")</td>
                                                                    <td class="text-center" data-label="Podio">@BadgePuntos(detallesFiltrados.Sum(x => x.PuntosPodio), "bg-danger")</td>
                                                                    <td class="text-center fw-bold" data-label="Total">@detallesFiltrados.Sum(x => x.Total)</td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var faseDetalle in detallesFiltrados
                                                                    .GroupBy(x => x.Fase)
                                                                    .OrderBy(g => OrdenFase(g.Key)))
                                                                {
                                                                    var faseNombre = faseDetalle.Key;
                                                                    var faseMinimizada = FaseDetalleMinimizada(r.Usuario, faseNombre);

                                                                    <tr class="detalle-fase-row">
                                                                        <td colspan="12">
                                                                            <div class="detalle-fase-header">
                                                                                <div>
                                                                                    <strong>@faseNombre</strong>
                                                                                    <span>@faseDetalle.Count() partidos | @faseDetalle.Sum(x => x.Total) puntos</span>
                                                                                </div>
                                                                                <button type="button"
                                                                                        class="detalle-fase-btn"
                                                                                        @onclick="() => ToggleFaseDetalle(r.Usuario, faseNombre)">
                                                                                    @(faseMinimizada ? "Mostrar" : "Minimizar")
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>

                                                                    @if (!faseMinimizada)
                                                                    {
                                                                        @foreach (var d in faseDetalle.OrderBy(x => x.Fecha).ThenBy(x => x.Local))
                                                                        {
                                                                            <tr data-track-prediction-view="@(DebeRegistrarVista(d) ? "true" : "false")"
                                                                                data-polla-id="@PollaId"
                                                                                data-owner-id="@d.UsuarioId"
                                                                                data-match-id="@d.PartidoId">

                                                                                <td data-label="Partido">
                                                                                    <strong>@d.Local</strong>
                                                                                    vs
                                                                                    <strong>@d.Visitante</strong>
                                                                                </td>

                                                                                <td data-label="Fase">
                                                                                    <span class="badge bg-light text-dark">
                                                                                        @d.Fase
                                                                                    </span>
                                                                                </td>

                                                                                <td data-label="Pronóstico">
                                                                                    @BadgePronostico(d)
                                                                                </td>

                                                                                <td data-label="Resultado">
                                                                                    <span class="badge bg-dark">
                                                                                        @d.ResultadoLocal - @d.ResultadoVisitante
                                                                                    </span>
                                                                                </td>

                                                                                <td class="text-center" data-label="Exacto">@BadgePuntos(d.PuntosExacto, "bg-success")</td>
                                                                                <td class="text-center" data-label="Ganador">@BadgePuntos(d.PuntosGanador, "bg-info text-dark")</td>
                                                                                <td class="text-center" data-label="Diferencia">@BadgePuntos(d.PuntosDiferencia, "bg-secondary")</td>
                                                                                <td class="text-center" data-label="Goles">@BadgePuntos(d.PuntosGoles, "bg-primary")</td>

                                                                                <td class="text-center" data-label="Clasificación">

                                                                                    @if (d.PuntosClasificacion > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-warning text-dark detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Clasificacion", d.PuntosClasificacion, "bg-warning text-dark", d.DetalleClasificacion, d)'>
                                                                                            +@d.PuntosClasificacion
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center" data-label="Extras">

                                                                                    @if (d.PuntosExtras > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-dark detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Extras", d.PuntosExtras, "bg-dark", d.DetalleExtras, d)'>
                                                                                            +@d.PuntosExtras
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center" data-label="Podio">

                                                                                    @if (d.PuntosPodio > 0)
                                                                                    {
                                                                                        <button type="button"
                                                                                                class="badge bg-danger detalle-puntos-btn"
                                                                                                title="Ver detalle"
                                                                                                @onclick='() => AbrirDetallePuntos("Podio", d.PuntosPodio, "bg-danger", d.DetallePodio, d)'>
                                                                                            +@d.PuntosPodio
                                                                                        </button>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="text-muted">0</span>
                                                                                    }

                                                                                </td>

                                                                                <td class="text-center fw-bold" data-label="Total">
                                                                                    @d.Total
                                                                                </td>

                                                                            </tr>
                                                                        }
                                                                    }
                                                                }
                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                                </td>
                                            </tr>
                                        }
                                    }

                                </tbody>

                            </table>
                        </div>
                    }

                 

                    <button class="btn btn-primary btn-sm"
                            @onclick="IrAPredicciones">
                        🎯 Ir a predicciones
                    </button>
                </div>
            </div>
        </div>

        <!-- 👥 Participantes -->
        <div class="participants-col @(usuarioDetalleAbierto == null ? "col-lg-4" : "col-12")">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">👥 Participantes</h5>

                    <ul class="list-group list-group-flush">
                        @foreach (var u in participantes)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2 px-0 participant-item">
                                <span class="participant-name">👤 @u.Nombre</span>

                                @if (EsCreador && u.Id != polla.CreadorId)
                                {
                                    <button class="btn btn-sm btn-outline-danger participant-delete-btn"
                                            @onclick="() => ConfirmarEliminar(u.Id, u.Nombre)">
                                        ❌ Eliminar Usuario
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

    </div>

    @if (mostrarConfirmacion)
    {
        <div class="alert alert-warning mt-3">
            <p>
                ¿Seguro que deseas expulsar a
                <strong>@usuarioAEliminarNombre</strong>?
            </p>

            <button class="btn btn-danger me-2"
                    @onclick="EliminarConfirmadoAsync">
                Sí, expulsar
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelarEliminar">
                Cancelar
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3">
            @mensaje
        </div>
    }

    </div>
}

@if (detallePuntosVisible)
{
