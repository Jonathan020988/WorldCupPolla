    private IEnumerable<PollaRecordatorioPartidoDto> PartidosRecordatorioFiltrados()
    {
        var texto = NormalizarBusqueda(recordatorioPartidoFiltro);
        var query = partidosRecordatorio.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            query = query.Where(p =>
                NormalizarBusqueda($"{p.Local} {p.Visitante} {p.Fase}")
                    .Contains(texto, StringComparison.Ordinal));
        }

        return query
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.PartidoId);
    }

    private PollaRecordatorioPartidoDto? PartidoRecordatorioSeleccionado()
    {
        return partidoRecordatorioId.HasValue
            ? partidosRecordatorio.FirstOrDefault(
                p => p.PartidoId == partidoRecordatorioId.Value)
            : null;
    }

    private async Task CargarPartidosRecordatorio()
    {
        if (!EsCreador || !Sesion.UsuarioId.HasValue)
        {
            partidosRecordatorio.Clear();
            usuariosRecordatorio.Clear();
            partidoRecordatorioId = null;
            return;
        }

        try
        {
            cargandoRecordatorios = true;
            partidosRecordatorio =
                await PollasService.GetPartidosParaRecordatorioAsync(
                    PollaId,
                    Sesion.UsuarioId.Value);

            if (partidoRecordatorioId.HasValue &&
                partidosRecordatorio.All(
                    p => p.PartidoId != partidoRecordatorioId.Value))
            {
                partidoRecordatorioId = null;
                usuariosRecordatorio.Clear();
            }
        }
        catch (Exception ex)
        {
            mensajeRecordatorio = ex.Message;
            errorRecordatorio = true;
        }
        finally
        {
            cargandoRecordatorios = false;
        }
    }

    private async Task SeleccionarPartidoRecordatorio(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var partidoId))
        {
            partidoRecordatorioId = partidoId;
            await CargarUsuariosRecordatorio();
            return;
        }

        partidoRecordatorioId = null;
        usuariosRecordatorio.Clear();
    }

    private async Task CargarUsuariosRecordatorio()
    {
        if (!partidoRecordatorioId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            usuariosRecordatorio.Clear();
            return;
        }

        try
        {
            cargandoUsuariosRecordatorio = true;
            usuariosRecordatorio =
                await PollasService.GetUsuariosPendientesPartidoAsync(
                    PollaId,
                    partidoRecordatorioId.Value,
                    Sesion.UsuarioId.Value);
        }
        catch (Exception ex)
        {
            usuariosRecordatorio.Clear();
            mensajeRecordatorio = ex.Message;
            errorRecordatorio = true;
        }
        finally
        {
            cargandoUsuariosRecordatorio = false;
        }
    }

    private async Task EnviarRecordatorioUsuario(
        PollaRecordatorioUsuarioDto usuario)
    {
        if (!partidoRecordatorioId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            recordatoriosEnProceso.Add(usuario.UsuarioId);
            var resultado = await PollasService.EnviarRecordatorioPartidoAsync(
                PollaId,
                partidoRecordatorioId.Value,
                usuario.UsuarioId,
                Sesion.UsuarioId.Value);

            usuario.AlertaPendiente = true;
            mensajeRecordatorio = resultado.Mensaje;
            errorRecordatorio = false;
        }
        catch (Exception ex)
        {
            mensajeRecordatorio = ex.Message;
            errorRecordatorio = true;
        }
        finally
        {
            recordatoriosEnProceso.Remove(usuario.UsuarioId);
        }
    }

    private async Task EnviarRecordatorioATodos()
    {
        if (!partidoRecordatorioId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            enviandoRecordatorioMasivo = true;
            var resultado =
                await PollasService.EnviarRecordatorioPartidoATodosAsync(
                    PollaId,
                    partidoRecordatorioId.Value,
                    Sesion.UsuarioId.Value);

            foreach (var usuario in usuariosRecordatorio)
            {
                usuario.AlertaPendiente = true;
            }

            mensajeRecordatorio = resultado.Mensaje;
            errorRecordatorio = false;
        }
        catch (Exception ex)
        {
            mensajeRecordatorio = ex.Message;
            errorRecordatorio = true;
        }
        finally
        {
            enviandoRecordatorioMasivo = false;
        }
    }

