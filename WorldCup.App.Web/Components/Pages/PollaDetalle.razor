@code {

    [Parameter]
    public int PollaId { get; set; }

    private PollaDto? polla;
    private List<RankingPollaDto> ranking = new();
    private List<DetalleRankingDto> rankingDetalle = new();
    private string? usuarioDetalleAbierto;
    private bool detallePuntosVisible;
    private string detallePuntosTitulo = "";
    private string detallePuntosTexto = "";
    private string detallePuntosContexto = "";
    private string detallePuntosClase = "";
    private int detallePuntosValor;
    private HashSet<string> fasesDetalleMinimizadas = new(StringComparer.OrdinalIgnoreCase);
    private string? detalleEquipoFiltro;
    private string? detalleGrupoFiltro;
    private DateTime? detalleFechaFiltro;
    private string? detalleFaseResumenFiltro;
    private bool editandoNombrePolla;
    private string nombrePollaEdit = "";
    private bool editandoPolla;
    private decimal? valorInscripcionEdit;
    private string descripcionEdit = "";
    private string metodoPagoEdit = "";
    private CuposUsuarioDto? cuposUsuario;
    private string celularAmpliacion = "";
    private int cantidadAmpliacion = 20;
    private string codigoCupos = "";
    private string? mensajeCupos;
    private bool errorCupos;
    private bool procesandoCupos;

    private string TextoCupoPolla =>
        polla?.CuposIlimitados == true
            ? "ilimitado"
            : (polla?.MaximoMiembros ?? 5).ToString();

    private int RankingColspan => EsCreador ? 5 : 4;

    private void ToggleDetalleUsuario(string usuario)
    {
        if (usuarioDetalleAbierto == usuario)
        {
            usuarioDetalleAbierto = null;
        }
        else
        {
            LimpiarFiltrosDetalle();
            usuarioDetalleAbierto = usuario;
        }
    }

    private IEnumerable<DetalleRankingDto> DetallesUsuarioFiltrados(string usuario)
    {
        var query = rankingDetalle
            .Where(x => x.Usuario == usuario)
            .AsEnumerable();

        if (!string.IsNullOrWhiteSpace(detalleEquipoFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Local, detalleEquipoFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Visitante, detalleEquipoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(detalleGrupoFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Grupo, detalleGrupoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (detalleFechaFiltro.HasValue)
        {
            query = query.Where(x => x.Fecha.Date == detalleFechaFiltro.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(detalleFaseResumenFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Fase, detalleFaseResumenFiltro, StringComparison.OrdinalIgnoreCase));
        }

        return query
            .OrderBy(x => OrdenFase(x.Fase))
            .ThenBy(x => x.Fecha)
            .ThenBy(x => x.Local);
    }

    private List<string> EquiposDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .SelectMany(x => new[] { x.Local, x.Visitante })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private List<string> GruposDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .Select(x => x.Grupo)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private List<string> FasesDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .Select(x => x.Fase)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(OrdenFase)
            .ToList();
    }

    private bool HayFiltrosDetalle()
    {
        return !string.IsNullOrWhiteSpace(detalleEquipoFiltro) ||
               !string.IsNullOrWhiteSpace(detalleGrupoFiltro) ||
               detalleFechaFiltro.HasValue ||
               !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
    }

    private void LimpiarFiltrosDetalle()
    {
        detalleEquipoFiltro = null;
        detalleGrupoFiltro = null;
        detalleFechaFiltro = null;
        detalleFaseResumenFiltro = null;
    }

    private void AbrirDetallePuntos(
        string titulo,
        int puntos,
        string clase,
        string? detalle,
        DetalleRankingDto detalleRanking)
    {
        detallePuntosTitulo = titulo;
        detallePuntosValor = puntos;
        detallePuntosClase = clase;
        detallePuntosTexto = string.IsNullOrWhiteSpace(detalle)
            ? $"Estos puntos corresponden a {titulo.ToLowerInvariant()}."
            : detalle;
        detallePuntosContexto = $"{detalleRanking.Local} vs {detalleRanking.Visitante} | {detalleRanking.Fase}";
        detallePuntosVisible = true;
    }

    private void CerrarDetallePuntos()
    {
        detallePuntosVisible = false;
    }

    private static int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private static string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

    private MarkupString BadgePuntos(int puntos, string clase)
    {
        return puntos > 0
            ? new MarkupString($"<span class=\"badge {clase}\">+{puntos}</span>")
            : new MarkupString("<span class=\"text-muted\">0</span>");
    }

    private bool FaseDetalleMinimizada(string usuario, string fase)
    {
        return fasesDetalleMinimizadas.Contains(ClaveFaseDetalle(usuario, fase));
    }

    private void ToggleFaseDetalle(string usuario, string fase)
    {
        var clave = ClaveFaseDetalle(usuario, fase);
        if (!fasesDetalleMinimizadas.Add(clave))
        {
            fasesDetalleMinimizadas.Remove(clave);
        }
    }

    private static string ClaveFaseDetalle(string usuario, string fase)
    {
        return $"{usuario}|{fase}";
    }

    private List<ParticipanteDto> participantes = new();
    private PollaPagosResumenDto? controlPagos;
    private bool cargandoControlPagos;
    private int? pagoGuardandoUsuarioId;
    private int? pagoNotificandoUsuarioId;
    private int? observacionGuardandoUsuarioId;

    private string emailInvitado = "";
    private string? linkInvitacion;

    private bool EsCreador =>
        polla != null && Sesion.UsuarioId == polla.CreadorId;

    protected override async Task OnInitializedAsync()
    {
        polla = await PollasService.GetPollaAsync(PollaId);
        PrepararDatosPolla();
        await CargarRanking();
        rankingDetalle =
            await Http.GetFromJsonAsync<List<DetalleRankingDto>>(
                $"api/Polla/{PollaId}/ranking-detalle"
            ) ?? new();
        await CargarParticipantes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo($"/login?returnUrl=/polla/{PollaId}", true);
            return;
        }

        if (polla != null)
        {
            await Sesion.SeleccionarPollaAsync(PollaId, polla.Nombre);

            if (EsCreador)
            {
                cuposUsuario = await PollasService.GetCuposUsuarioAsync(Sesion.UsuarioId.GetValueOrDefault());
                cantidadAmpliacion = Math.Max(20, (polla.MaximoMiembros ?? 5) + 1);
                await CargarRanking();
                await CargarParticipantes();
                await CargarControlPagos();
            }

            StateHasChanged();
        }
    }

