    private async Task DescargarFormatoManualPdf(string tipo)
    {
        if (!EsCreador || !Sesion.UsuarioId.HasValue)
        {
            mensajeFormatoManual = "Solo el creador de la polla puede descargar estos formatos.";
            errorFormatoManual = true;
            return;
        }

        try
        {
            descargandoFormatoManual = true;
            formatoManualEnDescarga = tipo;
            mensajeFormatoManual = null;
            errorFormatoManual = false;

            var url = $"api/Polla/{PollaId}/formatos-manuales/pdf?solicitanteId={Sesion.UsuarioId.Value}&tipo={Uri.EscapeDataString(tipo)}";
            using var response = await Http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                mensajeFormatoManual = string.IsNullOrWhiteSpace(detalle)
                    ? "No fue posible generar el formato manual."
                    : detalle;
                errorFormatoManual = true;
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            var nombreArchivo = NombreArchivoFormatoManual(tipo);
            await JS.InvokeVoidAsync(
                "worldCupDownloadFile",
                nombreArchivo,
                "application/pdf",
                Convert.ToBase64String(bytes));

            mensajeFormatoManual = "Formato generado. Revisa la descarga del navegador.";
            errorFormatoManual = false;
        }
        catch (Exception ex)
        {
            mensajeFormatoManual = ex.Message;
            errorFormatoManual = true;
        }
        finally
        {
            descargandoFormatoManual = false;
            formatoManualEnDescarga = null;
        }
    }

