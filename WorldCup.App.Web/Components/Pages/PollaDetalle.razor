    private ParticipanteDto? UsuarioResumenSeleccionado()
    {
        var texto = NormalizarBusqueda(usuarioResumenFiltro);
        if (string.IsNullOrWhiteSpace(texto))
        {
            return null;
        }

        if (int.TryParse(usuarioResumenFiltro, out var usuarioId))
        {
            var porId = participantes.FirstOrDefault(p => p.Id == usuarioId);
            if (porId != null)
            {
                return porId;
            }
        }

        var exacto = participantes.FirstOrDefault(p =>
            NormalizarBusqueda(p.Nombre) == texto);
        if (exacto != null)
        {
            return exacto;
        }

        var coincidencias = ParticipantesResumenFiltrados().ToList();
        return coincidencias.Count == 1 ? coincidencias[0] : null;
    }

    private PollaPagoParticipanteDto? PagoResumenSeleccionado()
    {
        var usuarioId = UsuarioResumenSeleccionadoId;
        return usuarioId.HasValue
            ? controlPagos?.Participantes.FirstOrDefault(p => p.UsuarioId == usuarioId.Value)
            : null;
    }

    private RankingPollaDto? RankingResumenSeleccionado()
    {
        var usuarioId = UsuarioResumenSeleccionadoId;
        return usuarioId.HasValue
            ? ranking.FirstOrDefault(r => r.UsuarioId == usuarioId.Value)
            : null;
    }

    private int PosicionRanking(RankingPollaDto participante)
    {
        var index = ranking.FindIndex(r => r.UsuarioId == participante.UsuarioId);
