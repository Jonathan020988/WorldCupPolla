@page "/polla/{PollaId:int}"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService



<h2 class="mb-1">🏆 Detalle de la Polla</h2>
<p class="text-muted mb-4">
    Polla seleccionada: @PollaId
</p>

<div class="row g-3">

    <!-- Ranking (mock) -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">📊 Ranking </h5>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th class="text-end">Puntos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ranking)
                        {
                            <tr>
                                <td>@(ranking.IndexOf(r) + 1)</td>
                                <td>@r.Usuario</td>
                                <td class="text-end fw-bold">@r.Puntos</td>
                                                               
                            </tr>
                        }
                    </tbody>
                </table>

                <button class="btn btn-primary btn-sm"
                        @onclick="IrAPredicciones">
                    🎯 Ir a predicciones
                </button>
            </div>
        </div>
    </div>

    <!-- Participantes (mock) -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="mb-3">👥 Participantes</h5>

                <ul class="list-group list-group-flush">
                    @foreach (var u in participantes)
                    {
                        <li class="list-group-item px-0">
                            👤 @u.Nombre
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>


</div>

@code {

    [Parameter]
    public int PollaId { get; set; }

    private List<RankingPollaDto> ranking = new();

    protected override async Task OnInitializedAsync()
    {
        ranking = await PollasService.GetRankingAsync(PollaId);
    }


    // private List<RankingItem> ranking = new()
    // {
    //     new RankingItem { Posicion = 1, Usuario = "Jonathan", Puntos = 42 },
    //     new RankingItem { Posicion = 2, Usuario = "Carlos", Puntos = 35 },
    //     new RankingItem { Posicion = 3, Usuario = "Laura", Puntos = 28 }
    // };

    // private List<string> participantes = new()
    // {
    //         participantes = await PollasService.GetParticipantesAsync(PollaId);

    // };

    private void IrAPredicciones()
    {
        Navigation.NavigateTo("/predicciones");
    }

    private class RankingItem
    {
        public int Posicion { get; set; }
        public string Usuario { get; set; } = "";
        public int Puntos { get; set; }
    }

    private List<ParticipanteDto> participantes = new();

}
