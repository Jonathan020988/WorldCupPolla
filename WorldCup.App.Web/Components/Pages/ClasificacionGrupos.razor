    private async Task CargarEstadoClasificacion()
    {
        try
        {
            var estado = await Http.GetFromJsonAsync<EstadoDto>(
                "api/Predicciones/estado-clasificacion");

            if (estado != null)
            {
                clasificacionCerrada = estado.cerrado;
                fechaCierre = estado.fechaCierre;
            }
        }
        catch
        {
            mensajeClasificacion = "No se pudo cargar el estado de cierre de la clasificación.";
            clasificacionConError = true;
        }
    }

    private async Task CargarReaperturaClasificacion()
    {
        clasificacionReabierta = false;

        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            var reaperturas = await Http.GetFromJsonAsync<List<ReaperturaDto>>(
                $"api/Predicciones/reaperturas?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}") ?? new();

            clasificacionReabierta = reaperturas.Any(r =>
                r.Activa &&
                string.Equals(r.Fase, "Grupos", StringComparison.OrdinalIgnoreCase) &&
                string.Equals(r.Tipo, "Clasificacion", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            clasificacionReabierta = false;
        }
    }

    public class EstadoDto
    {
        public bool cerrado { get; set; }
        public DateTime fechaCierre { get; set; }
    }

    private class ReaperturaDto
    {
        public string Fase { get; set; } = "";
        public string Tipo { get; set; } = "";
        public bool Activa { get; set; }
    }

    
    private void IniciarContador()
    {
        timer = new System.Timers.Timer(1000);
        timer.Elapsed += (s, e) =>
        {
            if (!clasificacionCerrada)
            {
                var restante = fechaCierre - HoraColombiaActual();

                if (restante.TotalSeconds <= 0)
                {
                    clasificacionCerrada = true;
                    contador = "⛔ Cerrado";
                }
                else
                {
                    contador = $"{restante.Days}d {restante.Hours}h {restante.Minutes}m {restante.Seconds}s";
                }

                InvokeAsync(StateHasChanged);
            }
        };

        timer.Start();
    }

    private void DetenerContador()
    {
        timer?.Stop();
        timer?.Dispose();
        timer = null;
    }

    private static DateTime HoraColombiaActual()
    {
        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time"));
        }
        catch
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"));
        }
    }
