@code {

    private bool clasificacionCerrada = false;
    private bool clasificacionReabierta = false;
    private DateTime fechaCierre;
    private string contador = "";
    private System.Timers.Timer? timer;

    private Dictionary<string, List<EquipoGrupo>>? grupos;
    private List<PollaDto> pollas = new();
    private bool cargandoContexto = true;
    private string? mensajeClasificacion;
    private bool clasificacionConError;
    private bool PuedeEditarClasificacion => !clasificacionCerrada || clasificacionReabierta;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login?returnUrl=/clasificacion-grupos", true);
            return;
        }

        pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);

        if (Sesion.PollaActivaId.HasValue &&
            !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
        {
            await Sesion.LimpiarPollaActivaAsync();
        }

        if (Sesion.PollaActivaId.HasValue)
        {
            await CargarDatosAsync();
        }

        cargandoContexto = false;
        StateHasChanged();
    }

    private async Task SeleccionarPolla(PollaDto polla)
    {
        cargandoContexto = true;
        StateHasChanged();

        await Sesion.SeleccionarPollaAsync(polla.Id, polla.Nombre);
        await CargarDatosAsync();

        cargandoContexto = false;
        StateHasChanged();
    }

    private async Task CambiarPolla()
    {
        await Sesion.LimpiarPollaActivaAsync();
        grupos = null;
        gruposTercero.Clear();
        clasificados.Clear();
        primeros.Clear();
        segundos.Clear();
        terceros.Clear();
        clasificacionReabierta = false;
        DetenerContador();
    }

    private async Task CargarDatosAsync()
    {
        DetenerContador();

        grupos = new(StringComparer.OrdinalIgnoreCase);
        gruposTercero.Clear();
        clasificados.Clear();
        primeros.Clear();
        segundos.Clear();
        terceros.Clear();

        var letras = new[]
        {
            "A","B","C","D","E","F",
            "G","H","I","J","K","L"
        };

        foreach (var letra in letras)
        {
            var tabla = await Http.GetFromJsonAsync<List<EquipoGrupo>>(
                $"api/Partidos/posiciones/{letra}"
            );

            if (tabla != null)
            {
                grupos.Add(letra, tabla);
            }
        }

        await CargarClasificacionGuardada();
        await CargarTerceros();
        CalcularClasificados();
        await CargarEstadoClasificacion();
        await CargarReaperturaClasificacion();
        IniciarContador();
    }

    private async Task CargarClasificacionGuardada()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            var guardadas = await Http.GetFromJsonAsync<List<ClasificacionGuardadaDto>>(
                $"api/Predicciones/clasificacion?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}");

            if (guardadas == null || grupos == null)
                return;

            gruposTercero.Clear(); // 🔥 IMPORTANTE

            foreach (var clasificacion in guardadas)
            {
                if (!grupos.ContainsKey(clasificacion.grupo))
                    continue;

                var grupo = grupos[clasificacion.grupo];

                // ❌ ELIMINADO: gruposTercero.Add(...)

                foreach (var equipo in grupo)
                {
                    if (equipo.equipoId == clasificacion.primeroId)
                        equipo.posicion = 1;
                    else if (equipo.equipoId == clasificacion.segundoId)
                        equipo.posicion = 2;
                    else if (equipo.equipoId == clasificacion.terceroId)
                        equipo.posicion = 3;
                    else
                        equipo.posicion = 4;

                    equipo.bloqueado = true;
                    equipo.grupoGuardado = true;
                }
            }

            CalcularClasificados();
        }
        catch
        {
            mensajeClasificacion = "No se pudo cargar la clasificación guardada.";
            clasificacionConError = true;
        }
    }

    public class EquipoGrupo
    {
        public int equipoId { get; set; }
        public string equipo { get; set; } = string.Empty;

        public int posicion { get; set; }

        public bool bloqueado { get; set; } = false;

        public bool grupoGuardado { get; set; }
    }


    private bool PosicionOcupada(List<EquipoGrupo> grupo, int posicion, EquipoGrupo actual)
    {
        return grupo.Any(e => e != actual && e.posicion == posicion && e.bloqueado);
    }


    private void VerificarPosiciones(List<EquipoGrupo> grupo)
    {
        var usados = new HashSet<int>();

        foreach (var equipo in grupo.OrderBy(e => e.posicion))
        {
            if (!usados.Contains(equipo.posicion))
            {
                usados.Add(equipo.posicion);
                continue;
            }

            for (int i = 1; i <= 4; i++)
            {
                if (!usados.Contains(i))
                {
                    equipo.posicion = i;
                    usados.Add(i);
                    break;
                }
            }
        }

        StateHasChanged();
    }

    private void EditarGrupo(List<EquipoGrupo> grupo)
    {
        if (!PuedeEditarClasificacion)
        {
            mensajeClasificacion = "La clasificación de grupos está cerrada y ya no se puede editar.";
            clasificacionConError = true;
            return;
        }

        foreach (var equipo in grupo)
        {
            equipo.bloqueado = false;
            equipo.posicion = 0;
        }

        StateHasChanged();
    }

    private async Task GuardarTerceros()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync(
            $"api/Predicciones/guardar-terceros?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}",
            gruposTercero.ToList()
        );

        response.EnsureSuccessStatusCode();
    }

    private HashSet<string> gruposTercero = new(StringComparer.OrdinalIgnoreCase);


    private async void ToggleTercero(string grupo)
    {
        if (!PuedeEditarClasificacion)
        {
            mensajeClasificacion = "La clasificación de grupos está cerrada y ya no se puede editar.";
            clasificacionConError = true;
            StateHasChanged();
            return;
        }

        grupo = NormalizarGrupo(grupo);

        if (gruposTercero.Contains(grupo))
        {
            gruposTercero.Remove(grupo);
        }
        else
        {
            if (gruposTercero.Count >= 8)
            {
                mensajeClasificacion = "Solo se permiten 8 mejores terceros.";
                clasificacionConError = true;
                return;
            }

            gruposTercero.Add(grupo);
        }

        await GuardarTerceros(); // 🔥 CLAVE
        CalcularClasificados();

        StateHasChanged();
    }

    private async Task CargarTerceros()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var grupos = await Http.GetFromJsonAsync<List<string>>(
            $"api/Predicciones/terceros?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}");

        if (grupos != null)
        {
            gruposTercero = grupos
                .Where(g => !string.IsNullOrWhiteSpace(g))
                .Select(NormalizarGrupo)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            CalcularClasificados();
        }
    }

    private static string NormalizarGrupo(string grupo)
    {
        return grupo.Trim().ToUpperInvariant();
    }
 

    private bool CheckboxBloqueado(string grupo)
    {
        return !gruposTercero.Contains(grupo) && gruposTercero.Count >= 8;
    }

    private async Task GuardarGrupo(string grupoNombre, List<EquipoGrupo> equipos)
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (!PuedeEditarClasificacion)
        {
            erroresGrupo[grupoNombre] = "La clasificación de grupos está cerrada y ya no se puede editar.";
            clasificacionConError = true;
            StateHasChanged();
            return;
        }

        var posiciones = equipos.Select(e => e.posicion).ToList();

        if (posiciones.Distinct().Count() != posiciones.Count)
        {
            erroresGrupo[grupoNombre] = "No se pueden repetir posiciones en el grupo";
            StateHasChanged();
            return;
        }

        erroresGrupo[grupoNombre] = null;

        var primero = equipos.FirstOrDefault(x => x.posicion == 1);
        var segundo = equipos.FirstOrDefault(x => x.posicion == 2);
        var tercero = equipos.FirstOrDefault(x => x.posicion == 3);

        if (primero == null || segundo == null || tercero == null)
        {
            erroresGrupo[grupoNombre] = "Debes definir las posiciones 1, 2 y 3 del grupo";
            StateHasChanged();
            return;
        }

        var dto = new
        {
            pollaId = Sesion.PollaActivaId.Value,
            usuarioId = Sesion.UsuarioId.Value,
            grupo = grupoNombre,
            primeroId = primero.equipoId,
            segundoId = segundo.equipoId,
            terceroId = tercero.equipoId
        };

        try
        {
            erroresGrupo[grupoNombre] = null;

            var response = await Http.PostAsJsonAsync(
                "api/Predicciones/guardar-clasificacion",
                dto);

            response.EnsureSuccessStatusCode();

            foreach (var e in equipos)
            {
                e.bloqueado = true;
            }

            CalcularClasificados();
            mensajeClasificacion = $"Grupo {grupoNombre} guardado correctamente.";
            clasificacionConError = false;
        }
        catch (Exception ex)
        {
            erroresGrupo[grupoNombre] = $"No se pudo guardar: {ex.Message}";
            mensajeClasificacion = erroresGrupo[grupoNombre];
            clasificacionConError = true;
            StateHasChanged();
        }
    }

    private void CalcularClasificados()
    {
        clasificados.Clear();
        primeros.Clear();
        segundos.Clear();
        terceros.Clear();

        if (grupos == null)
            return;

        foreach (var grupo in grupos)
        {
            if (!grupo.Value.First().bloqueado)
                continue;

            var primero = grupo.Value.FirstOrDefault(e => e.posicion == 1);
            var segundo = grupo.Value.FirstOrDefault(e => e.posicion == 2);

            if (primero != null)
            {
                clasificados.Add(primero);
                primeros.Add(primero);
            }

            if (segundo != null)
            {
                clasificados.Add(segundo);
                segundos.Add(segundo);
            }
        }

        foreach (var grupoKey in gruposTercero)
        {
            if (!grupos.TryGetValue(grupoKey, out var grupo))
                continue;

            if (!grupo.First().bloqueado)
                continue;

            var tercero = grupo.FirstOrDefault(e => e.posicion == 3);

            if (tercero != null)
            {
                clasificados.Add(tercero);
                terceros.Add(tercero);
            }
        }

        StateHasChanged();
    }


    private Dictionary<string, string?> erroresGrupo = new();

    private List<EquipoGrupo> clasificados = new();
    private List<EquipoGrupo> primeros = new();
    private List<EquipoGrupo> segundos = new();
    private List<EquipoGrupo> terceros = new();

    private int GruposGuardados()
    {
        if (grupos == null)
            return 0;

        return grupos.Count(g => g.Value.First().bloqueado);
    }

    private List<string> GruposPendientes
    {
        get
        {
            if (grupos == null)
                return new();

            return grupos
                .Where(g => !g.Value.First().bloqueado)
                .Select(g => g.Key)
                .OrderBy(g => g)
                .ToList();
        }
    }

    private List<string> GruposConPosicionesIncompletas
    {
        get
        {
            if (grupos == null)
                return new();

            return grupos
                .Where(g => !GrupoTienePosicionesValidas(g.Value))
                .Select(g => g.Key)
                .OrderBy(g => g)
                .ToList();
        }
    }

    private int MejoresTercerosFaltantes => Math.Max(0, 8 - gruposTercero.Count);

    private List<string> TercerosSeleccionadosSinGuardar
    {
        get
        {
            if (grupos == null)
                return new();

            return gruposTercero
                .Where(g => grupos.TryGetValue(g, out var grupo) && !grupo.First().bloqueado)
                .OrderBy(g => g)
                .ToList();
        }
    }

    private bool ClasificacionCompleta =>
        grupos != null &&
        grupos.Count == 12 &&
        GruposGuardados() == 12 &&
        gruposTercero.Count == 8 &&
        !GruposConPosicionesIncompletas.Any() &&
        !TercerosSeleccionadosSinGuardar.Any();

    private bool GrupoTienePosicionesValidas(List<EquipoGrupo> equipos)
    {
        var posiciones = equipos.Select(e => e.posicion).ToList();
        return posiciones.Count == 4 &&
            posiciones.All(p => p >= 1 && p <= 4) &&
            posiciones.Distinct().Count() == 4 &&
            posiciones.Contains(1) &&
            posiciones.Contains(2) &&
            posiciones.Contains(3);
    }

    private string GrupoEstadoCss(string grupo, List<EquipoGrupo> equipos)
    {
        if (!GrupoTienePosicionesValidas(equipos))
            return "incompleto";

        return equipos.First().bloqueado
            ? "guardado"
            : "pendiente";
    }

