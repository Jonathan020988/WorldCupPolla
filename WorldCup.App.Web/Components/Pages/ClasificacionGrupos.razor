@page "/clasificacion-grupos"
@rendermode InteractiveServer
@inject HttpClient Http
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

<h3 class="mb-4">📊 Clasificación de Grupos</h3>

@if (cargandoContexto)
{
    <p>Cargando clasificación...</p>
}
else if (!Sesion.PollaActivaId.HasValue)
{
    <div class="card shadow-sm mb-4" style="max-width:520px">
        <div class="card-body">
            <h5 class="mb-3">Selecciona la polla</h5>
            <p class="text-muted">
                La clasificación de grupos se guardará en la polla que elijas.
            </p>

            @if (!pollas.Any())
            {
                <div class="alert alert-info">
                    No tienes pollas disponibles todavía.
                </div>

                <a class="btn btn-success" href="/dashboard">
                    Ir a mis pollas
                </a>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var polla in pollas)
                    {
                        <button class="btn btn-outline-primary text-start"
                                @onclick="() => SeleccionarPolla(polla)">
                            🏆 @polla.Nombre
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-success d-flex justify-content-between align-items-center">
        <span>
            Trabajando en la polla:
            <strong>@Sesion.PollaActivaNombre</strong>
        </span>

        <button class="btn btn-sm btn-outline-success"
                @onclick="CambiarPolla">
            Cambiar polla
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeClasificacion))
    {
        <div class="alert @(clasificacionConError ? "alert-danger" : "alert-success")">
            @mensajeClasificacion
        </div>
    }

    <div class="mb-4">

    <div class="d-flex justify-content-between mb-1">

        <span class="fw-bold">
            Progreso de clasificación
        </span>

        <span>
            @GruposGuardados() / 12 grupos
        </span>

    </div>

    <div class="progress">
        <div class="progress-bar bg-success"
             role="progressbar"
             style="width:@(GruposGuardados()*100/12)%"
             aria-valuenow="@(GruposGuardados()*100/12)"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
    </div>

    <div class="classification-checklist mt-3">
        <div class="checklist-header">
            <div>
                <span class="checklist-kicker">Revision antes de continuar</span>
                <h5>Estado de tu clasificacion</h5>
            </div>
            <span class="checklist-pill @(ClasificacionCompleta ? "complete" : "pending")">
                @(ClasificacionCompleta ? "Completa" : "Pendiente")
            </span>
        </div>

        <div class="checklist-grid">
            <div class="checklist-metric">
                <span>Grupos guardados</span>
                <strong>@GruposGuardados() / 12</strong>
            </div>
            <div class="checklist-metric">
                <span>Mejores terceros</span>
                <strong>@gruposTercero.Count / 8</strong>
            </div>
            <div class="checklist-metric">
                <span>Clasificados visibles</span>
                <strong>@clasificados.Count / 32</strong>
            </div>
        </div>

        @if (!ClasificacionCompleta)
        {
            <div class="pending-list">
                @if (GruposPendientes.Any())
                {
                    <div class="pending-item">
                        <strong>Falta guardar posiciones</strong>
                        <span>@string.Join(", ", GruposPendientes.Select(g => $"Grupo {g}"))</span>
                    </div>
                }

                @if (GruposConPosicionesIncompletas.Any())
                {
                    <div class="pending-item warning">
                        <strong>Revisa posiciones repetidas o incompletas</strong>
                        <span>@string.Join(", ", GruposConPosicionesIncompletas.Select(g => $"Grupo {g}"))</span>
                    </div>
                }

                @if (MejoresTercerosFaltantes > 0)
                {
                    <div class="pending-item">
                        <strong>Faltan mejores terceros</strong>
                        <span>Debes seleccionar @MejoresTercerosFaltantes grupo(s) mas como mejor tercero.</span>
                    </div>
                }

                @if (TercerosSeleccionadosSinGuardar.Any())
                {
                    <div class="pending-item warning">
                        <strong>Mejores terceros sin grupo guardado</strong>
                        <span>Guarda primero @string.Join(", ", TercerosSeleccionadosSinGuardar.Select(g => $"Grupo {g}")).</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="complete-message">
                Todo esta listo: ya guardaste los 12 grupos y elegiste los 8 mejores terceros.
            </div>
        }
    </div>

    @{
        var claseAlerta = clasificacionCerrada
            ? (clasificacionReabierta ? "alert-warning" : "alert-danger")
            : "alert-info";
    }
    <div class="alert @claseAlerta">

        @if (clasificacionCerrada && clasificacionReabierta)
        {
            <strong>Reapertura activa por administrador</strong>
        }
        else if (clasificacionCerrada)
        {
            <strong>⛔ Clasificaciones cerradas</strong>
        }
        else
        {
            <strong>⏳ Cierre en: @contador</strong>
        }

    </div>

</div>

@if (grupos == null)
{
    <p>Cargando grupos...</p>
}
else
{
    <div class="row">

        @foreach (var grupo in grupos)
        {
            <div class="col-md-6 mb-4">


                <div class="card shadow-sm grupo-card @GrupoEstadoCss(grupo.Key, grupo.Value)">


                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                        <div class="d-flex align-items-center gap-2">
                            <strong>Grupo @grupo.Key</strong>
                            <span class="grupo-status @(grupo.Value.First().bloqueado ? "saved" : "pending")">
                                @(grupo.Value.First().bloqueado ? "Guardado" : "Pendiente")
                            </span>
                        </div>

                        <div class="d-flex align-items-center gap-2">

                            <div class="form-check text-white">
                                <input class="form-check-input"
                                type="checkbox"
                                checked="@gruposTercero.Contains(grupo.Key)"
                                disabled="@(CheckboxBloqueado(grupo.Key) || !PuedeEditarClasificacion)"
                                @onchange="(e => ToggleTercero(grupo.Key))" />

                                <label class="form-check-label">
                                    Mejor 3°
                                </label>
                            </div>

                            <button class="btn btn-success btn-sm"
                            disabled="@(grupo.Value.First().bloqueado || !PuedeEditarClasificacion)"
                            @onclick="() => GuardarGrupo(grupo.Key, grupo.Value)">

                                @(grupo.Value.First().bloqueado ? "✔ Guardado" : "💾 Guardar")

                            </button>

                            <button class="btn btn-warning btn-sm"
                            disabled="@(!PuedeEditarClasificacion)"
                            @onclick="() => EditarGrupo(grupo.Value)">
                                ✏ Editar
                            </button>

                        </div>

                    </div>

                    @if (erroresGrupo.ContainsKey(grupo.Key) &&
                  !string.IsNullOrEmpty(erroresGrupo[grupo.Key]))
                    {
                        <div class="alert alert-danger m-2">
                            ⚠ @erroresGrupo[grupo.Key]
                        </div>
                    }               


                    <div class="card-body p-0">

                        <table class="table table-striped table-hover mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th style="padding-left:15px">Equipo</th>
                                    <th style="width:120px">Posición</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var equipo in grupo.Value)
                                {
                                    <tr>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:10px;">
                                                <img src="@GetBandera(equipo.equipo)" width="28" />
                                                <span>@equipo.equipo</span>
                                            </div>
                                        </td>

                                        <td>
                                            <div style="display:flex;align-items:center;gap:10px;">

                                                <select class="form-select form-select-sm"
                                                style="width:70px"
                                                @bind="equipo.posicion"
                                                disabled="@(equipo.bloqueado  || !PuedeEditarClasificacion)">

                                                    <option value="1" disabled="@PosicionOcupada(grupo.Value,1,equipo)">1</option>
                                                    <option value="2" disabled="@PosicionOcupada(grupo.Value,2,equipo)">2</option>
                                                    <option value="3" disabled="@PosicionOcupada(grupo.Value,3,equipo)">3</option>
                                                    <option value="4" disabled="@PosicionOcupada(grupo.Value,4,equipo)">4</option>

                                                </select>

                                            </div>                                           

                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }

        @if (clasificados.Count > 0)
        {
            <div class="card mt-4 shadow">

                <div class="card-header text-white fw-bold"
                style="background:linear-gradient(90deg,#0d6efd,#20c997);">
                    🏆 Equipos clasificados a Octavos
                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- PRIMEROS -->
                        <div class="col-md-4">

                            <h5 class="text-center mb-3">🥇 Primeros</h5>

                            @foreach (var equipo in primeros)
                            {
                                <div class="border rounded p-2 mb-2 d-flex align-items-center gap-2">

                                    <img src="@GetBandera(equipo.equipo)" width="26" />

                                    <strong>@equipo.equipo</strong>

                                </div>
                            }

                        </div>


                        <!-- SEGUNDOS -->
                        <div class="col-md-4">

                            <h5 class="text-center mb-3">🥈 Segundos</h5>

                            @foreach (var equipo in segundos)
                            {
                                <div class="border rounded p-2 mb-2 d-flex align-items-center gap-2">

                                    <img src="@GetBandera(equipo.equipo)" width="26" />

                                    <strong>@equipo.equipo</strong>

                                </div>
                            }

                        </div>


                        <!-- TERCEROS -->
                        <div class="col-md-4">

                            <h5 class="text-center mb-3">🥉 Mejores terceros</h5>

                            @foreach (var equipo in terceros)
                            {
                                <div class="border rounded p-2 mb-2 d-flex align-items-center gap-2">

                                    <img src="@GetBandera(equipo.equipo)" width="26" />

                                    <strong>@equipo.equipo</strong>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
}

