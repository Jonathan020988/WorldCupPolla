@page "/notificaciones"
@rendermode InteractiveServer

@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation

<h2>Notificaciones</h2>

@if (cargando)
{
    <p>Cargando notificaciones...</p>
}
else if (!Sesion.EstaLogueado)
{
    <div class="alert alert-warning">
        Debes iniciar sesion para ver tus notificaciones.
    </div>
}
else if (notificaciones.Count == 0)
{
    <div class="alert alert-info">
        No tienes notificaciones.
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var notificacion in notificaciones)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="fw-bold">
                            @TituloNotificacion(notificacion)
                        </div>

                        <div>
                            @notificacion.Mensaje
                        </div>
                    </div>

                    <span class="badge @ClaseTipo(notificacion.Tipo) align-self-start">
                        @EtiquetaTipo(notificacion.Tipo)
                    </span>
                </div>

                <small class="text-muted">
                    @notificacion.FechaSolicitud.ToString("dd/MM/yyyy hh:mm tt")
                </small>

                <div class="mt-2">
                    <span class="badge @ClaseEstado(notificacion.Estado)">
                        @notificacion.Estado
                    </span>
                </div>

                @if (notificacion.Tipo == "SolicitudIngreso" && notificacion.Estado == "Pendiente")
                {
                    <div class="mt-2">
                        <button class="btn btn-success btn-sm me-2"
                                @onclick="() => AceptarSolicitud(notificacion.Id)">
                            Aprobar
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => RechazarSolicitud(notificacion.Id)">
                            Rechazar
                        </button>
                    </div>
                }
                else if (notificacion.Tipo == "Invitacion" && notificacion.Estado == "Pendiente")
                {
                    <div class="mt-2">
                        <button class="btn btn-success btn-sm me-2"
                                @onclick="() => AceptarInvitacion(notificacion)">
                            Aceptar invitacion
                        </button>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => RechazarInvitacion(notificacion.Id)">
                            Rechazar
                        </button>
                    </div>
                }
                else if (notificacion.Tipo == "PrediccionPendiente")
                {
                    <button class="btn btn-primary btn-sm mt-2"
                            @onclick="() => IrAPredicciones(notificacion)">
                        Ir a predicciones
                    </button>
                }
                else if (notificacion.Tipo == "PagoPendiente")
                {
                    <button class="btn btn-warning btn-sm mt-2"
                            @onclick="() => IrAPolla(notificacion)">
                        Ver detalle de pago
                    </button>
                }

                @if (notificacion.Tipo == "SolicitudIngreso")
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2"
                            @onclick="() => EliminarSolicitud(notificacion.Id)">
                        Eliminar
                    </button>
                }
            </li>
        }
    </ul>
}

@code {
    private bool cargando = true;
    private List<NotificacionDto> notificaciones = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (Sesion.EstaLogueado && Sesion.UsuarioId != null)
        {
            await Cargar();
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task Cargar()
    {
        notificaciones = await PollasService.GetNotificacionesAsync(Sesion.UsuarioId!.Value);
    }

    private async Task AceptarSolicitud(int id)
    {
        await PollasService.AprobarSolicitudAsync(id);
        await ActualizarEstadoLocal(id, "Aprobada", "SolicitudIngreso");
    }

    private async Task RechazarSolicitud(int id)
    {
        await PollasService.RechazarSolicitudAsync(id);
        await ActualizarEstadoLocal(id, "Rechazada", "SolicitudIngreso");
    }

    private async Task EliminarSolicitud(int id)
    {
        await PollasService.EliminarSolicitudAsync(id);
        notificaciones = notificaciones
            .Where(x => x.Tipo != "SolicitudIngreso" || x.Id != id)
            .ToList();
    }

    private async Task AceptarInvitacion(NotificacionDto notificacion)
    {
        await PollasService.AceptarInvitacionAsync(
            notificacion.Id,
            Sesion.UsuarioId!.Value);

        await ActualizarEstadoLocal(notificacion.Id, "Aceptada", "Invitacion");

        if (notificacion.PollaId.HasValue)
        {
            await Sesion.SeleccionarPollaAsync(
                notificacion.PollaId.Value,
                notificacion.PollaNombre);

            Navigation.NavigateTo($"/polla/{notificacion.PollaId.Value}");
        }
    }

    private async Task RechazarInvitacion(int id)
    {
        await PollasService.RechazarInvitacionAsync(id, Sesion.UsuarioId!.Value);
        await ActualizarEstadoLocal(id, "Rechazada", "Invitacion");
    }

    private async Task IrAPredicciones(NotificacionDto notificacion)
    {
        if (notificacion.PollaId.HasValue)
        {
            await Sesion.SeleccionarPollaAsync(
                notificacion.PollaId.Value,
                notificacion.PollaNombre);
        }

        Navigation.NavigateTo("/predicciones");
    }

    private async Task IrAPolla(NotificacionDto notificacion)
    {
        if (!notificacion.PollaId.HasValue)
        {
            return;
        }

        await Sesion.SeleccionarPollaAsync(
            notificacion.PollaId.Value,
            notificacion.PollaNombre);

        Navigation.NavigateTo($"/polla/{notificacion.PollaId.Value}");
    }

    private Task ActualizarEstadoLocal(int id, string estado, string tipo)
    {
        var notificacion = notificaciones.FirstOrDefault(x =>
            x.Id == id &&
            x.Tipo == tipo);

        if (notificacion != null)
        {
            notificacion.Estado = estado;
        }

        return Task.CompletedTask;
    }

    private static string TituloNotificacion(NotificacionDto notificacion) =>
        notificacion.Tipo switch
        {
            "SolicitudIngreso" => "Solicitud de ingreso",
            "Invitacion" => "Invitacion a una polla",
            "PrediccionPendiente" => "Prediccion pendiente",
            "PagoPendiente" => "Pago pendiente",
            _ => "Notificacion"
        };

    private static string EtiquetaTipo(string tipo) =>
        tipo switch
        {
            "SolicitudIngreso" => "Solicitud",
            "Invitacion" => "Invitacion",
            "PrediccionPendiente" => "Alerta",
            "PagoPendiente" => "Pago",
            _ => "Aviso"
        };

    private static string ClaseTipo(string tipo) =>
        tipo switch
        {
            "SolicitudIngreso" => "bg-primary",
            "Invitacion" => "bg-success",
            "PrediccionPendiente" => "bg-warning text-dark",
            "PagoPendiente" => "bg-danger",
            _ => "bg-secondary"
        };

    private static string ClaseEstado(string estado) =>
        estado switch
        {
            "Pendiente" => "bg-warning text-dark",
            "Aprobada" or "Aceptada" => "bg-success",
            "Rechazada" => "bg-danger",
            _ => "bg-secondary"
        };
}
