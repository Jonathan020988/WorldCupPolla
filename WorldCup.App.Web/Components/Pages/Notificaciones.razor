@page "/notificaciones"
@rendermode InteractiveServer

@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

@inject PollasService PollasService
@inject SesionService Sesion

<h2>🔔 Notificaciones</h2>

@if (!Sesion.EstaLogueado)
{
    <div class="alert alert-warning">
        Debes iniciar sesión para ver tus notificaciones.
    </div>
}
else if (solicitudes.Count == 0)
{
    <div class="alert alert-info">
        No tienes notificaciones.
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var solicitud in solicitudes)
        {
            <li class="list-group-item">
                <div class="fw-bold">
                    👤 @solicitud.UsuarioNombre quiere unirse a
                    <strong>@solicitud.PollaNombre</strong>
                </div>

                <small class="text-muted">
                    @solicitud.FechaSolicitud.ToString("dd/MM/yyyy hh:mm tt")
                </small>

                <div class="mt-2">
                    <span class="badge @ClaseEstado(solicitud.Estado)">
                        @solicitud.Estado
                    </span>
                </div>

                @if (solicitud.Estado == "Pendiente")
                {
                    <div class="mt-2">
                        <button class="btn btn-success btn-sm me-2"
                                @onclick="() => Aceptar(solicitud.Id)">
                            ✔ Aprobar
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Rechazar(solicitud.Id)">
                            ✖ Rechazar
                        </button>
                    </div>
                }

                <button class="btn btn-sm btn-outline-secondary mt-2"
                        @onclick="() => Eliminar(solicitud.Id)">
                    🗑 Eliminar
                </button>
            </li>
        }
    </ul>
}

@code {
    private List<SolicitudIngresoDto> solicitudes = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(50);

        if (Sesion.EstaLogueado && Sesion.UsuarioId != null)
        {
            await Cargar();
        }
    }

    private async Task Cargar()
    {
        solicitudes = await PollasService.GetNotificacionesAsync(Sesion.UsuarioId!.Value);
    }

    private async Task Aceptar(int id)
    {
        await PollasService.AprobarSolicitudAsync(id);
        await ActualizarEstadoLocal(id, "Aprobada");
    }

    private async Task Rechazar(int id)
    {
        await PollasService.RechazarSolicitudAsync(id);
        await ActualizarEstadoLocal(id, "Rechazada");
    }

    private async Task Eliminar(int id)
    {
        await PollasService.EliminarSolicitudAsync(id);
        solicitudes = solicitudes.Where(x => x.Id != id).ToList();
    }

    private Task ActualizarEstadoLocal(int id, string estado)
    {
        var solicitud = solicitudes.FirstOrDefault(x => x.Id == id);
        if (solicitud != null)
        {
            solicitud.Estado = estado;
        }

        return Task.CompletedTask;
    }

    private static string ClaseEstado(string estado) =>
        estado switch
        {
            "Pendiente" => "bg-warning",
            "Aprobada" => "bg-success",
            _ => "bg-danger"
        };
}
