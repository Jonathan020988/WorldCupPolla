    private static string EstadoMarcador(DetalleRankingDto detalle)
    {
        if (!ResultadoDisponible(detalle))
        {
            return "Pendiente";
        }

        if (detalle.PuntosExacto > 0)
        {
            return "Exacto";
        }

        return detalle.Total > 0 ? "Con puntos" : "Sin puntos";
    }

    private static string EstadoMarcadorCss(DetalleRankingDto detalle)
    {
        if (!ResultadoDisponible(detalle))
        {
            return "pending";
        }

        if (detalle.PuntosExacto > 0)
        {
            return "ok";
        }

        return detalle.Total > 0 ? "partial" : "miss";
    }

    private static string TextoPosicion(int posicion)
    {
        return posicion <= 0 ? "-" : posicion.ToString();
    }

    private static string TextoPosicionReal(EquipoComparadoDto equipo)
    {
        return equipo.RealDisponible
            ? TextoPosicion(equipo.PosicionReal)
            : "-";
    }

    private static string EstadoClasificacion(EquipoComparadoDto equipo)
