        }

        .compare-summary,
        .compare-filters,
        .thirds-box,
        .group-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private static readonly string[] LetrasGrupos =
    {
        "A", "B", "C", "D", "E", "F",
        "G", "H", "I", "J", "K", "L"
    };

    private List<PollaDto> pollas = new();
    private List<DetalleRankingDto> detalleUsuario = new();
    private List<ClasificacionGuardadaDto> clasificacionUsuario = new();
    private HashSet<string> tercerosUsuario = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<TablaGrupoRealDto>> tablasReales = new(StringComparer.OrdinalIgnoreCase);
    private bool cargando = true;
    private string vista = "marcadores";
    private string? equipoFiltro;
    private string? faseFiltro;
    private DateTime? fechaFiltro;
    private string? grupoFiltro;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login?returnUrl=/comparar", true);
            return;
        }

        pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);

        if (Sesion.PollaActivaId.HasValue &&
            !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
        {
            await Sesion.LimpiarPollaActivaAsync();
        }

        if (Sesion.PollaActivaId.HasValue)
        {
            await CargarComparacionAsync();
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task SeleccionarPolla(PollaDto polla)
    {
        cargando = true;
        StateHasChanged();

        await Sesion.SeleccionarPollaAsync(polla.Id, polla.Nombre);
        await CargarComparacionAsync();

        cargando = false;
        StateHasChanged();
    }

    private async Task CambiarPolla()
    {
        await Sesion.LimpiarPollaActivaAsync();
        detalleUsuario.Clear();
        clasificacionUsuario.Clear();
        tercerosUsuario.Clear();
        tablasReales.Clear();
        LimpiarFiltrosMarcadores();
        grupoFiltro = null;
    }

    private async Task CargarComparacionAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var detalle = await PollasService.GetRankingDetalleAsync(
            Sesion.PollaActivaId.Value,
            Sesion.UsuarioId.Value);
        detalleUsuario = detalle
            .Where(d => d.UsuarioId == Sesion.UsuarioId.Value)
            .OrderBy(d => OrdenFase(d.Fase))
            .ThenBy(d => d.Fecha)
            .ThenBy(d => d.Local)
            .ToList();

        clasificacionUsuario = await Http.GetFromJsonAsync<List<ClasificacionGuardadaDto>>(
            $"api/Predicciones/clasificacion?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}") ?? new();

        var terceros = await Http.GetFromJsonAsync<List<string>>(
            $"api/Predicciones/terceros?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}") ?? new();

        tercerosUsuario = terceros
            .Select(NormalizarGrupo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        await CargarTablasRealesAsync();
    }

    private async Task CargarTablasRealesAsync()
    {
        tablasReales.Clear();

        foreach (var grupo in LetrasGrupos)
        {
            var tabla = await Http.GetFromJsonAsync<List<TablaGrupoRealDto>>(
                $"api/Partidos/posiciones/{grupo}") ?? new();

            tablasReales[grupo] = tabla
                .Select((e, index) =>
                {
                    e.PosicionReal = index + 1;
                    e.Grupo = grupo;
                    return e;
                })
                .ToList();
        }
    }

    private IEnumerable<DetalleRankingDto> MarcadoresFiltrados()
    {
        var query = detalleUsuario.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(equipoFiltro))
        {
            query = query.Where(d =>
                string.Equals(d.Local, equipoFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.Visitante, equipoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(faseFiltro))
        {
            query = query.Where(d =>
                string.Equals(d.Fase, faseFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (fechaFiltro.HasValue)
        {
            query = query.Where(d => d.Fecha.Date == fechaFiltro.Value.Date);
        }

        return query;
    }

    private List<GrupoComparadoDto> GruposComparados()
    {
        var tercerosReales = TercerosReales().ToHashSet(StringComparer.OrdinalIgnoreCase);
        var grupos = string.IsNullOrWhiteSpace(grupoFiltro)
            ? LetrasGrupos
            : new[] { grupoFiltro };

        return grupos
            .Select(grupo =>
            {
                var prediccion = clasificacionUsuario.FirstOrDefault(c =>
                    string.Equals(NormalizarGrupo(c.grupo), grupo, StringComparison.OrdinalIgnoreCase));

                tablasReales.TryGetValue(grupo, out var tabla);
                tabla ??= new();

                return new GrupoComparadoDto
                {
                    Grupo = grupo,
                    TienePrediccion = prediccion != null,
                    Equipos = tabla
                        .Select(e =>
                        {
                            var posPredicha = PosicionPredicha(e.EquipoId, prediccion);
                            var clasificaPredicha = posPredicha <= 2 ||
                                (posPredicha == 3 && tercerosUsuario.Contains(grupo));
                            var clasificaReal = e.PosicionReal <= 2 ||
                                (e.PosicionReal == 3 && tercerosReales.Contains(grupo));

                            return new EquipoComparadoDto
                            {
                                Equipo = e.Equipo,
                                PosicionPredicha = posPredicha,
                                PosicionReal = e.PosicionReal,
                                ClasificacionCoincide = clasificaPredicha == clasificaReal
                            };
                        })
                        .ToList()
                };
            })
            .ToList();
    }

    private List<string> TercerosReales()
    {
        return tablasReales
            .SelectMany(g => g.Value.Where(e => e.PosicionReal == 3))
            .OrderByDescending(e => e.Puntos)
            .ThenByDescending(e => e.DG)
            .ThenByDescending(e => e.GF)
            .ThenBy(e => e.Equipo)
            .Take(8)
            .Select(e => e.Grupo)
            .ToList();
    }

    private static int PosicionPredicha(int equipoId, ClasificacionGuardadaDto? prediccion)
    {
        if (prediccion == null)
        {
            return 0;
        }

        if (prediccion.primeroId == equipoId)
        {
            return 1;
        }

        if (prediccion.segundoId == equipoId)
        {
            return 2;
        }

        return prediccion.terceroId == equipoId ? 3 : 4;
    }

    private List<string> EquiposDisponibles()
    {
        return detalleUsuario
            .SelectMany(d => new[] { d.Local, d.Visitante })
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(e => e)
            .ToList();
    }

    private List<string> FasesDisponibles()
    {
        return detalleUsuario
            .Select(d => d.Fase)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(OrdenFase)
            .ToList();
    }

    private bool HayFiltrosMarcadores()
    {
        return !string.IsNullOrWhiteSpace(equipoFiltro) ||
               !string.IsNullOrWhiteSpace(faseFiltro) ||
               fechaFiltro.HasValue;
    }

    private void LimpiarFiltrosMarcadores()
    {
        equipoFiltro = null;
        faseFiltro = null;
        fechaFiltro = null;
    }

    private static bool ResultadoDisponible(DetalleRankingDto detalle)
    {
        return detalle.ResultadoLocal.HasValue && detalle.ResultadoVisitante.HasValue;
    }

    private static string EstadoMarcador(DetalleRankingDto detalle)
    {
        if (!ResultadoDisponible(detalle))
        {
            return "Pendiente";
        }

        if (detalle.PuntosExacto > 0)
        {
            return "Exacto";
        }

        return detalle.Total > 0 ? "Con puntos" : "Sin puntos";
    }

    private static string EstadoMarcadorCss(DetalleRankingDto detalle)
    {
        if (!ResultadoDisponible(detalle))
        {
            return "pending";
        }

        if (detalle.PuntosExacto > 0)
        {
            return "ok";
        }

        return detalle.Total > 0 ? "partial" : "miss";
    }

    private static string TextoPosicion(int posicion)
    {
        return posicion <= 0 ? "-" : posicion.ToString();
    }

    private static string TextoGrupos(IEnumerable<string> grupos)
    {
        var lista = grupos
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Select(NormalizarGrupo)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g)
            .ToList();

        return lista.Any()
            ? string.Join(", ", lista.Select(g => $"Grupo {g}"))
            : "Sin datos";
    }

    private static MarkupString Marcador(int? local, int? visitante, string clase)
    {
        var texto = local.HasValue && visitante.HasValue
            ? $"{local} - {visitante}"
            : "--";

        return new MarkupString($"<span class=\"{clase}\">{texto}</span>");
    }

    private static string FechaCorta(DateTime fecha)
    {
        return fecha == default ? "-" : fecha.ToString("dd/MM/yyyy");
    }

    private static string NormalizarGrupo(string grupo)
    {
        return grupo.Replace("Grupo", "", StringComparison.OrdinalIgnoreCase)
            .Trim()
            .ToUpperInvariant();
    }

    private static int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private static string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

    private class ClasificacionGuardadaDto
    {
        public string grupo { get; set; } = "";
        public int primeroId { get; set; }
        public int segundoId { get; set; }
        public int terceroId { get; set; }
        public bool bloqueada { get; set; }
    }

    private class TablaGrupoRealDto
    {
        public int EquipoId { get; set; }
        public string Equipo { get; set; } = "";
        public int PJ { get; set; }
        public int GF { get; set; }
        public int GC { get; set; }
        public int DG => GF - GC;
        public int Puntos { get; set; }
        public string Grupo { get; set; } = "";
        public int PosicionReal { get; set; }
    }

    private class GrupoComparadoDto
    {
        public string Grupo { get; set; } = "";
        public bool TienePrediccion { get; set; }
        public List<EquipoComparadoDto> Equipos { get; set; } = new();
    }

    private class EquipoComparadoDto
    {
        public string Equipo { get; set; } = "";
        public int PosicionPredicha { get; set; }
        public int PosicionReal { get; set; }
        public bool ClasificacionCoincide { get; set; }
    }
}
