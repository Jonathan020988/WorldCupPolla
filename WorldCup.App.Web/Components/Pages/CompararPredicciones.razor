        .panel-title,
        .active-polla {
            align-items: flex-start;
            flex-direction: column;
        }

        .compare-summary,
        .compare-filters,
        .score-finder-form,
        .podium-finder-form,
        .finder-result-summary,
        .finder-results-grid,
        .thirds-box,
        .group-grid,
        .view-audit-filters,
        .view-audit-selection,
        .view-audit-summary,
        .view-audit-list {
            grid-template-columns: 1fr;
        }

        .score-finder-heading,
        .view-audit-head {
            align-items: flex-start;
            flex-direction: column;
        }
