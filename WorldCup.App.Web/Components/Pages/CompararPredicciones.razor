@page "/comparar"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Models
@using WorldCup.App.Shared.Services
@inject PollasService PollasService
@inject PartidosService PartidosService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http

<section class="compare-page">
    <div class="compare-hero">
        <div>
            <span class="compare-kicker">Mi comparacion</span>
            <h1>Prediccion vs realidad</h1>
            <p>
                Revisa tus marcadores, tus clasificados de grupos y lo que paso realmente.
            </p>
        </div>

        @if (Sesion.PollaActivaId.HasValue)
        {
            <button class="switch-btn" @onclick="CambiarPolla">
                Cambiar polla
            </button>
        }
    </div>

    @if (cargando)
    {
        <div class="compare-panel">
            Cargando comparacion...
        </div>
    }
    else if (!Sesion.PollaActivaId.HasValue)
    {
        <div class="compare-panel selector-panel">
            <h2>Selecciona la polla</h2>

            @if (!pollas.Any())
            {
                <div class="empty-state">No tienes pollas disponibles todavia.</div>
            }
            else
            {
                <div class="polla-grid">
                    @foreach (var polla in pollas)
                    {
                        <button class="polla-option"
                                @onclick="() => SeleccionarPolla(polla)">
                            <span class="polla-icon">&#x1F3C6;</span>
                            <span>
                                <strong>@polla.Nombre</strong>
                                <small>
                                    @(Sesion.EsAdmin
                                        ? "Consultar marcadores de la polla"
                                        : "Comparar mis predicciones")
                                </small>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="active-polla">
            <span>Trabajando en la polla:</span>
            <strong>@Sesion.PollaActivaNombre</strong>
        </div>

        <div class="compare-summary">
            <div>
                <span>Marcadores guardados</span>
                <strong>@detalleUsuario.Count</strong>
            </div>
            <div>
                <span>Partidos con resultado</span>
                <strong>@detalleUsuario.Count(ResultadoDisponible)</strong>
            </div>
            <div>
                <span>Marcadores exactos</span>
                <strong>@detalleUsuario.Count(d => d.PuntosExacto > 0)</strong>
            </div>
            <div>
                <span>Puntos visibles</span>
                <strong>@detalleUsuario.Sum(d => d.Total)</strong>
            </div>
        </div>

        <section class="score-finder">
            <div class="score-finder-heading">
                <div>
                    <span class="finder-kicker">Consulta de la polla</span>
                    <h2>¿Quién puso este marcador?</h2>
                    <p>
                        @if (Sesion.EsAdmin)
                        {
                            <span>
                                Selecciona cualquier partido y escribe un resultado para conocer
                                qué participantes lo pronosticaron y sus puntos actuales.
                            </span>
                        }
                        else
                        {
                            <span>
                                Selecciona un partido finalizado y escribe un resultado para conocer
                                qué participantes lo pronosticaron y cuántos puntos obtuvieron.
                            </span>
                        }
                    </p>
                </div>
                <span class="finder-lock @(Sesion.EsAdmin ? "admin" : "")">
                    @(Sesion.EsAdmin ? "Acceso administrador" : "Visible después del final")
                </span>
            </div>

            <div class="score-finder-form">
                <div class="finder-match-field">
                    <label>Partido</label>
                    <select @bind="partidoBusquedaId" @bind:after="CambiarPartidoBusqueda">
                        <option value="0">Selecciona un partido</option>
                        @foreach (var partido in PartidosParaBusqueda())
                        {
                            <option value="@partido.Id">@EtiquetaPartidoBusqueda(partido)</option>
                        }
                    </select>
                </div>

                <div class="finder-score-field">
                    <label>Marcador a buscar</label>
                    <div class="finder-score-inputs">
                        <div>
                            <span>@(PartidoBusquedaSeleccionado()?.Local ?? "Local")</span>
                            <input type="number"
                                   min="0"
                                   max="99"
                                   inputmode="numeric"
                                   @bind="golesLocalBusqueda" />
                        </div>
                        <strong>-</strong>
                        <div>
                            <span>@(PartidoBusquedaSeleccionado()?.Visitante ?? "Visitante")</span>
                            <input type="number"
                                   min="0"
                                   max="99"
                                   inputmode="numeric"
                                   @bind="golesVisitanteBusqueda" />
                        </div>
                    </div>
                </div>

                <button class="finder-search-btn"
                        disabled="@(!PuedeBuscarMarcador())"
                        @onclick="BuscarMarcadorAsync">
                    @(buscandoMarcador ? "Buscando..." : "Buscar jugadores")
                </button>
            </div>

            @if (PartidoBusquedaSeleccionado() is { Finalizado: false } partidoPendiente)
            {
                @if (Sesion.EsAdmin)
                {
                    <div class="finder-message admin">
                        Acceso de administrador: puedes consultar este partido antes de que finalice.
                        Los puntos se muestran con el cálculo disponible en este momento.
                    </div>
                }
                else
                {
                    <div class="finder-message pending">
                        @partidoPendiente.Local vs @partidoPendiente.Visitante todavía no ha finalizado.
                        La consulta se habilitará cuando el resultado y los puntos sean oficiales.
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(errorBusquedaMarcador))
            {
                <div class="finder-message error">@errorBusquedaMarcador</div>
            }

            @if (resultadoBusquedaMarcador != null)
            {
                <div class="finder-result-summary">
                    <div>
                        <span>Partido</span>
                        <strong>
                            @resultadoBusquedaMarcador.Partido.Local
                            vs
                            @resultadoBusquedaMarcador.Partido.Visitante
                        </strong>
                    </div>
                    <div>
                        <span>Resultado real</span>
                        <strong>@TextoResultadoBusqueda(resultadoBusquedaMarcador.Partido)</strong>
                    </div>
                    <div>
                        <span>Marcador consultado</span>
                        <strong>
                            @resultadoBusquedaMarcador.MarcadorBuscado.Local
                            -
                            @resultadoBusquedaMarcador.MarcadorBuscado.Visitante
                        </strong>
                    </div>
                    <div>
                        <span>Coincidencias</span>
                        <strong>@resultadoBusquedaMarcador.TotalJugadores</strong>
                    </div>
                </div>

                @if (!resultadoBusquedaMarcador.Jugadores.Any())
                {
                    <div class="finder-empty">
                        Ningún participante de esta polla pronosticó ese marcador.
                    </div>
                }
                else
                {
                    <div class="finder-results-grid">
                        @for (var indice = 0; indice < resultadoBusquedaMarcador.Jugadores.Count; indice++)
                        {
                            var jugador = resultadoBusquedaMarcador.Jugadores[indice];
                            <article class="finder-player">
                                <div class="finder-player-position">@(indice + 1)</div>
                                <div class="finder-player-main">
                                    <strong>@jugador.Usuario</strong>
                                    <span>
                                        Pronóstico:
                                        @resultadoBusquedaMarcador.MarcadorBuscado.Local
                                        -
                                        @resultadoBusquedaMarcador.MarcadorBuscado.Visitante
                                    </span>
                                </div>
                                <div class="finder-player-points">
                                    <strong>@jugador.Puntos</strong>
                                    <span>puntos</span>
                                </div>
                                <div class="finder-player-breakdown">
                                    Marcador: @jugador.PuntosMarcador
                                    @if (jugador.PuntosBonificacion > 0)
                                    {
                                        <span> · Bonos: @jugador.PuntosBonificacion</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>

        <section class="score-finder podium-finder">
            <div class="score-finder-heading">
                <div>
                    <span class="finder-kicker">Podio de la polla</span>
                    <h2>Quien tiene este equipo en el podio?</h2>
                    <p>
                        Selecciona un equipo para ver que participantes lo pusieron como
                        campeon, subcampeon o tercer puesto en esta polla.
                    </p>
                </div>
                <span class="finder-lock podium">
                    @PodioEquipoBadge()
                </span>
            </div>

            <div class="podium-finder-form">
                <div>
                    <label>Equipo</label>
                    <select @bind="equipoPodioBusquedaId"
                            @bind:after="CambiarEquipoPodioBusqueda">
                        <option value="0">Selecciona un equipo</option>
                        @foreach (var equipo in equiposPodioBusqueda)
                        {
                            <option value="@equipo.Id">@equipo.Nombre</option>
                        }
                    </select>
                </div>

                <button class="finder-search-btn"
                        disabled="@(!PuedeBuscarPodioEquipo())"
                        @onclick="BuscarPodioEquipoAsync">
                    @(buscandoPodioEquipo ? "Buscando..." : "Buscar en podios")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorBusquedaPodioEquipo))
            {
                <div class="finder-message error">@errorBusquedaPodioEquipo</div>
            }

            @if (resultadoBusquedaPodioEquipo != null)
            {
                <div class="finder-result-summary podium-summary">
                    <div>
                        <span>Equipo</span>
                        <strong>@resultadoBusquedaPodioEquipo.Equipo.Nombre</strong>
                    </div>
                    <div>
                        <span>Total</span>
                        <strong>@resultadoBusquedaPodioEquipo.TotalJugadores</strong>
                    </div>
                    <div>
                        <span>Campeon</span>
                        <strong>@resultadoBusquedaPodioEquipo.TotalCampeon</strong>
                    </div>
                    <div>
                        <span>Subcampeon</span>
                        <strong>@resultadoBusquedaPodioEquipo.TotalSubcampeon</strong>
                    </div>
                    <div>
                        <span>Tercer puesto</span>
                        <strong>@resultadoBusquedaPodioEquipo.TotalTercerPuesto</strong>
                    </div>
                </div>

                @if (!resultadoBusquedaPodioEquipo.Jugadores.Any())
                {
                    <div class="finder-empty">
                        Ningun participante de esta polla tiene a
                        @resultadoBusquedaPodioEquipo.Equipo.Nombre en el podio.
                    </div>
                }
                else
                {
                    <div class="finder-results-grid podium-results-grid">
                        @for (var indice = 0; indice < resultadoBusquedaPodioEquipo.Jugadores.Count; indice++)
                        {
                            var jugador = resultadoBusquedaPodioEquipo.Jugadores[indice];
                            <article class="finder-player podium-player">
                                <div class="finder-player-position">@(indice + 1)</div>
                                <div class="finder-player-main">
                                    <strong>@jugador.Usuario</strong>
                                    <span>Lo puso como @jugador.Posicion</span>
                                </div>
                                <div class="podium-position-badge @PodioPosicionCss(jugador.PosicionOrden)">
                                    @jugador.Posicion
                                </div>
                            </article>
                        }
                    </div>
                }
            }
        </section>

        <div class="compare-tabs">
            <button class="@(vista == "marcadores" ? "active" : "")"
                    @onclick='() => vista = "marcadores"'>
                Marcadores
            </button>
            <button class="@(vista == "grupos" ? "active" : "")"
                    @onclick='() => vista = "grupos"'>
                Clasificacion grupos
            </button>
        </div>

        @if (vista == "marcadores")
        {
            <div class="compare-panel">
                <div class="panel-title">
                    <div>
                        <h2>Mis marcadores vs resultados reales</h2>
                        <span>@MarcadoresFiltrados().Count() registro(s)</span>
                    </div>
                </div>

                <div class="compare-filters">
                    <div>
                        <label>Equipo</label>
                        <select @bind="equipoFiltro">
                            <option value="">Todos</option>
                            @foreach (var equipo in EquiposDisponibles())
                            {
                                <option value="@equipo">@equipo</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Fase</label>
                        <select @bind="faseFiltro">
                            <option value="">Todas</option>
                            @foreach (var fase in FasesDisponibles())
                            {
                                <option value="@fase">@NombreFase(fase)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label>Fecha</label>
                        <input type="date" @bind="fechaFiltro" />
                    </div>

                    @if (HayFiltrosMarcadores())
                    {
                        <button class="clear-btn" @onclick="LimpiarFiltrosMarcadores">
                            Limpiar
                        </button>
                    }
                </div>

                <div class="table-wrap">
                    <table class="compare-table">
                        <thead>
                            <tr>
                                <th>Partido</th>
                                <th>Fase</th>
                                <th>Fecha</th>
                                <th>Mi marcador</th>
                                <th>Real</th>
                                <th>Estado</th>
                                <th class="text-end">Puntos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!MarcadoresFiltrados().Any())
                            {
                                <tr>
                                    <td colspan="7" class="empty-row">
                                        No hay marcadores con esos filtros.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var d in MarcadoresFiltrados())
                                {
                                    <tr>
                                        <td data-label="Partido">
                                            <strong>@d.Local</strong> vs <strong>@d.Visitante</strong>
                                        </td>
                                        <td data-label="Fase"><span class="phase-pill">@NombreFase(d.Fase)</span></td>
                                        <td data-label="Fecha">@FechaCorta(d.Fecha)</td>
                                        <td data-label="Mi marcador">@MarcadorPronostico(d)</td>
                                        <td data-label="Real">@Marcador(d.ResultadoLocal, d.ResultadoVisitante, "result-pill")</td>
                                        <td data-label="Estado">
                                            <span class="status-pill @EstadoMarcadorCss(d)">
                                                @EstadoMarcador(d)
                                            </span>
                                        </td>
                                        <td class="text-end" data-label="Puntos">
                                            <strong>@d.Total</strong>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="compare-panel">
                <div class="panel-title">
                    <div>
                        <h2>Clasificacion de grupos</h2>
                        <span>Lo que pusiste contra la tabla real</span>
                    </div>
                </div>

                <div class="compare-filters compact">
                    <div>
                        <label>Grupo</label>
                        <select @bind="grupoFiltro">
                            <option value="">Todos</option>
                            @foreach (var grupo in LetrasGrupos)
                            {
                                <option value="@grupo">Grupo @grupo</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="thirds-box">
                    <div>
                        <span>Mis mejores terceros</span>
                        <strong>@TextoGrupos(tercerosUsuario)</strong>
                    </div>
                    <div>
                        <span>Mejores terceros reales</span>
                        <strong>@TextoTercerosReales()</strong>
                    </div>
                </div>

                <div class="group-grid">
                    @foreach (var grupo in GruposComparados())
                    {
                        <div class="group-card">
                            <div class="group-title">
                                <strong>Grupo @grupo.Grupo</strong>
                                <span>@(grupo.TienePrediccion ? "Prediccion guardada" : "Sin prediccion")</span>
                            </div>

                            <table class="group-table">
                                <thead>
                                    <tr>
                                        <th>Equipo</th>
                                        <th>Mi pos.</th>
                                        <th>Real</th>
                                        <th>Clasifica</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var equipo in grupo.Equipos)
                                    {
                                        <tr>
                                            <td data-label="Equipo"><strong>@equipo.Equipo</strong></td>
                                            <td data-label="Mi pos.">@TextoPosicion(equipo.PosicionPredicha)</td>
                                            <td data-label="Real">@TextoPosicionReal(equipo)</td>
                                            <td data-label="Clasifica">
                                                <span class="status-pill @EstadoClasificacionCss(equipo)">
                                                    @EstadoClasificacion(equipo)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Sesion.EsAdmin)
        {
            <section class="view-audit">
                <div class="view-audit-head">
                    <div>
                        <span class="view-audit-kicker">Control administrativo</span>
                        <h2>Historial de visualización de marcadores</h2>
                        <p>
                            Selecciona un participante y uno de sus partidos para consultar quién
                            vio el pronóstico y todas las horas registradas.
                        </p>
                    </div>
                    <span class="view-audit-badge">Solo administrador</span>
                </div>

                <div class="view-audit-filters">
                    <div>
                        <label>Usuario de la predicción</label>
                        <select @bind="usuarioAuditoriaId"
                                @bind:after="CambiarUsuarioAuditoria">
                            <option value="0">Selecciona un usuario</option>
                            @foreach (var usuario in UsuariosAuditoria())
                            {
                                <option value="@usuario.Id">@usuario.Nombre</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label>Partido y marcador</label>
                        <select @bind="partidoAuditoriaId"
                                @bind:after="CambiarPartidoAuditoria"
                                disabled="@(usuarioAuditoriaId <= 0)">
                            <option value="0">Selecciona un partido</option>
                            @foreach (var partido in PartidosAuditoria())
                            {
                                <option value="@partido.PartidoId">
                                    @EtiquetaPartidoAuditoria(partido)
                                </option>
                            }
                        </select>
                    </div>

                    <button class="view-audit-search"
                            disabled="@(consultandoAuditoria || partidoAuditoriaId <= 0)"
                            @onclick="ConsultarAuditoriaAsync">
                        @(consultandoAuditoria ? "Consultando..." : "Ver historial")
                    </button>
                </div>

                @if (DetalleAuditoriaSeleccionado() is { } detalleAuditoria)
                {
                    <div class="view-audit-selection">
                        <div>
                            <span>Pronóstico seleccionado</span>
                            <strong>
                                @detalleAuditoria.Local
                                @detalleAuditoria.PronosticoLocal
                                -
                                @detalleAuditoria.PronosticoVisitante
                                @detalleAuditoria.Visitante
                            </strong>
                        </div>
                        <div>
                            <span>Cierre de edición</span>
                            <strong>@FechaColombia(detalleAuditoria.Fecha).AddHours(-1).ToString("dd/MM/yyyy h:mm tt")</strong>
                        </div>
                        <div>
                            <span>Estado</span>
                            <strong class="@(PartidoCerradoAuditoria(detalleAuditoria) ? "closed" : "open")">
                                @(PartidoCerradoAuditoria(detalleAuditoria)
                                    ? "Registro activo"
                                    : "Aún no inicia el registro")
                            </strong>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(errorAuditoria))
                {
                    <div class="view-audit-message error">@errorAuditoria</div>
                }

                @if (resultadoAuditoria != null)
                {
                    <div class="view-audit-summary">
                        <div>
                            <span>Visualizaciones</span>
                            <strong>@resultadoAuditoria.TotalVistas</strong>
                        </div>
                        <div>
                            <span>Usuarios únicos</span>
                            <strong>@resultadoAuditoria.UsuariosUnicos</strong>
                        </div>
                        <div>
                            <span>Marcador</span>
                            <strong>
                                @resultadoAuditoria.Prediccion.GolesLocal
                                -
                                @resultadoAuditoria.Prediccion.GolesVisitante
                            </strong>
                        </div>
                    </div>

                    @if (!resultadoAuditoria.Visualizadores.Any())
                    {
                        <div class="view-audit-empty">
                            Todavía no hay visualizaciones registradas para este marcador.
                        </div>
                    }
                    else
                    {
                        <div class="view-audit-list">
                            @foreach (var visualizador in resultadoAuditoria.Visualizadores)
                            {
                                <article class="viewer-history">
                                    <div class="viewer-history-head">
                                        <div class="viewer-avatar">@InicialAuditoria(visualizador.Usuario)</div>
                                        <div>
                                            <strong>@visualizador.Usuario</strong>
                                            <span>
                                                @visualizador.TotalVistas
                                                @(visualizador.TotalVistas == 1 ? "visualización" : "visualizaciones")
                                            </span>
                                        </div>
                                        <div class="viewer-last">
                                            <span>Última vez</span>
                                            <strong>@FechaHoraAuditoria(visualizador.UltimaVista)</strong>
                                        </div>
                                    </div>

                                    <div class="viewer-timeline">
                                        @foreach (var fecha in visualizador.Vistas)
                                        {
                                            <div>
                                                <span class="timeline-dot"></span>
                                                <time>@FechaHoraAuditoria(fecha)</time>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }
    }
</section>

<style>
    .compare-page {
        --ink: #13201c;
        --muted: #667085;
        --line: #d9e5df;
        --green: #116b4f;
        --soft: #f6faf8;
        color: var(--ink);
    }

    .compare-hero {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        padding: 1.2rem 1.4rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #10251e, #167456 62%, #d7a21a);
        color: white;
        margin-bottom: 1rem;
        box-shadow: 0 12px 28px rgba(16, 37, 30, .16);
    }

    .compare-hero h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 850;
    }

    .compare-hero p {
        margin: .25rem 0 0;
        color: rgba(255, 255, 255, .82);
    }

    .compare-kicker {
        display: block;
        color: #f6d779;
        font-size: .76rem;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .switch-btn,
    .clear-btn {
        border: 1px solid rgba(255, 255, 255, .55);
        border-radius: 999px;
        background: white;
        color: var(--green);
        padding: .42rem .85rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .compare-panel,
    .active-polla,
    .compare-summary,
    .compare-tabs,
    .thirds-box {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: white;
        box-shadow: 0 8px 22px rgba(16, 24, 40, .05);
    }

    .compare-panel {
        overflow: hidden;
    }

    .active-polla {
        display: flex;
        gap: .45rem;
        align-items: center;
        margin-bottom: .85rem;
        padding: .75rem 1rem;
        background: #f2fbf5;
        color: #163c27;
    }

    .compare-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        padding: .85rem;
        margin-bottom: .85rem;
    }

    .compare-summary div {
        padding: .75rem;
        border-radius: 8px;
