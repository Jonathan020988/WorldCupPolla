        detallePollaCompleto = detalle
            .OrderBy(d => d.Usuario)
            .ThenBy(d => OrdenFase(d.Fase))
            .ThenBy(d => d.Fecha)
            .ToList();
        detalleUsuario = detalle
            .Where(d => d.UsuarioId == Sesion.UsuarioId.Value)
            .OrderBy(d => OrdenFase(d.Fase))
            .ThenBy(d => d.Fecha)
            .ThenBy(d => d.Local)
            .ToList();

        partidosBusqueda = await PartidosService.GetPartidosAsync();
        await CargarEquiposPodioBusquedaAsync();

