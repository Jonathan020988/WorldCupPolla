        if (Sesion.PollaActivaId.HasValue &&
            !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
        {
            await Sesion.LimpiarPollaActivaAsync();
        }

        if (Sesion.PollaActivaId.HasValue)
        {
            await CargarComparacionAsync();
        }

        cargando = false;
