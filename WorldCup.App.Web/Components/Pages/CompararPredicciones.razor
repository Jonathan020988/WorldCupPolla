        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        padding: 1.2rem 1.4rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #10251e, #167456 62%, #d7a21a);
        color: white;
        margin-bottom: 1rem;
        box-shadow: 0 12px 28px rgba(16, 37, 30, .16);
    }

    .compare-hero h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 850;
    }

    .compare-hero p {
        margin: .25rem 0 0;
        color: rgba(255, 255, 255, .82);
    }

    .compare-kicker {
        display: block;
        color: #f6d779;
        font-size: .76rem;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .switch-btn,
    .clear-btn {
        border: 1px solid rgba(255, 255, 255, .55);
        border-radius: 999px;
        background: white;
        color: var(--green);
        padding: .42rem .85rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .compare-panel,
    .active-polla,
    .compare-summary,
    .compare-tabs,
    .thirds-box {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: white;
        box-shadow: 0 8px 22px rgba(16, 24, 40, .05);
    }

    .compare-panel {
        overflow: hidden;
    }

    .active-polla {
        display: flex;
        gap: .45rem;
        align-items: center;
        margin-bottom: .85rem;
        padding: .75rem 1rem;
        background: #f2fbf5;
        color: #163c27;
    }

    .compare-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        padding: .85rem;
        margin-bottom: .85rem;
    }

    .compare-summary div {
        padding: .75rem;
        border-radius: 8px;
        background: var(--soft);
    }

