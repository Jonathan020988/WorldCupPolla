            ? $"{partido.ResultadoLocal.Value} - {partido.ResultadoVisitante.Value}"
            : "Pendiente";
    }

    private async Task CargarTablasRealesAsync()
    {
        tablasReales.Clear();

        foreach (var grupo in LetrasGrupos)
        {
            var tabla = await Http.GetFromJsonAsync<List<TablaGrupoRealDto>>(
                $"api/Partidos/posiciones/{grupo}") ?? new();

            tablasReales[grupo] = tabla
                .Select((e, index) =>
                {
                    e.PosicionReal = index + 1;
                    e.Grupo = grupo;
                    return e;
                })
                .ToList();
        }
    }

    private IEnumerable<DetalleRankingDto> MarcadoresFiltrados()
    {
        var query = detalleUsuario.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(equipoFiltro))
        {
            query = query.Where(d =>
                string.Equals(d.Local, equipoFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(d.Visitante, equipoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(faseFiltro))
        {
            query = query.Where(d =>
                string.Equals(d.Fase, faseFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (fechaFiltro.HasValue)
        {
            query = query.Where(d => d.Fecha.Date == fechaFiltro.Value.Date);
        }

        return query;
    }

    private List<GrupoComparadoDto> GruposComparados()
    {
        var tercerosReales = TercerosReales().ToHashSet(StringComparer.OrdinalIgnoreCase);
        var grupos = string.IsNullOrWhiteSpace(grupoFiltro)
            ? LetrasGrupos
            : new[] { grupoFiltro };

        return grupos
            .Select(grupo =>
            {
                var prediccion = clasificacionUsuario.FirstOrDefault(c =>
                    string.Equals(NormalizarGrupo(c.grupo), grupo, StringComparison.OrdinalIgnoreCase));

                tablasReales.TryGetValue(grupo, out var tabla);
                tabla ??= new();
                var realDisponible = GrupoRealCompleto(tabla);

                return new GrupoComparadoDto
                {
                    Grupo = grupo,
                    TienePrediccion = prediccion != null,
                    Equipos = tabla
                        .Select(e =>
                        {
                            var posPredicha = PosicionPredicha(e.EquipoId, prediccion);
                            var clasificaPredicha = posPredicha <= 2 ||
                                (posPredicha == 3 && tercerosUsuario.Contains(grupo));
                            var clasificaReal = realDisponible && (e.PosicionReal <= 2 ||
                                (e.PosicionReal == 3 && tercerosReales.Contains(grupo)));

                            return new EquipoComparadoDto
                            {
                                Equipo = e.Equipo,
                                PosicionPredicha = posPredicha,
                                PosicionReal = realDisponible ? e.PosicionReal : 0,
                                RealDisponible = realDisponible,
                                ClasificacionCoincide = realDisponible && clasificaPredicha == clasificaReal
                            };
                        })
                        .ToList()
                };
            })
            .ToList();
    }

    private List<string> TercerosReales()
    {
        if (!ClasificacionRealCompleta())
        {
            return new();
        }

        return tablasReales
            .SelectMany(g => g.Value.Where(e => e.PosicionReal == 3))
            .OrderByDescending(e => e.Puntos)
            .ThenByDescending(e => e.DG)
            .ThenByDescending(e => e.GF)
            .ThenBy(e => e.Equipo)
            .Take(8)
            .Select(e => e.Grupo)
            .ToList();
    }

    private bool ClasificacionRealCompleta()
    {
        return LetrasGrupos.All(g =>
            tablasReales.TryGetValue(g, out var tabla) &&
            GrupoRealCompleto(tabla));
    }

    private static bool GrupoRealCompleto(List<TablaGrupoRealDto> tabla)
    {
        return tabla.Count >= 4 && tabla.All(e => e.PJ >= 3);
    }

    private static int PosicionPredicha(int equipoId, ClasificacionGuardadaDto? prediccion)
    {
        if (prediccion == null)
        {
            return 0;
        }

        if (prediccion.primeroId == equipoId)
        {
            return 1;
        }

        if (prediccion.segundoId == equipoId)
        {
            return 2;
        }

        return prediccion.terceroId == equipoId ? 3 : 4;
    }

    private List<string> EquiposDisponibles()
    {
        return detalleUsuario
            .SelectMany(d => new[] { d.Local, d.Visitante })
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(e => e)
            .ToList();
    }

    private List<string> FasesDisponibles()
    {
        return detalleUsuario
            .Select(d => d.Fase)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(OrdenFase)
            .ToList();
    }

