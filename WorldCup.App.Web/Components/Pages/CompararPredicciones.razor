    private static string TextoGrupos(IEnumerable<string> grupos)
    {
        var lista = grupos
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Select(NormalizarGrupo)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g)
            .ToList();

        return lista.Any()
            ? string.Join(", ", lista.Select(g => $"Grupo {g}"))
            : "Sin datos";
    }

    private string TextoTercerosReales()
    {
        return ClasificacionRealCompleta()
            ? TextoGrupos(TercerosReales())
            : "Pendiente";
    }

    private static MarkupString Marcador(int? local, int? visitante, string clase)
    {
        var texto = local.HasValue && visitante.HasValue
            ? $"{local} - {visitante}"
            : "--";

        return new MarkupString($"<span class=\"{clase}\">{texto}</span>");
    }

    private MarkupString MarcadorPronostico(DetalleRankingDto detalle)
    {
        if (!PuedeMostrarPronostico(detalle))
        {
            return new MarkupString("<span class=\"prediction-pill locked-prediction\">Oculto</span>");
        }

        if (!detalle.PronosticoLocal.HasValue ||
            !detalle.PronosticoVisitante.HasValue)
        {
            return new MarkupString("<span class=\"missing-prediction\">No pronostico</span>");
        }

        var definicion = DefinicionEliminatoriaPronostico(detalle);
        if (string.IsNullOrWhiteSpace(definicion))
        {
            return Marcador(detalle.PronosticoLocal, detalle.PronosticoVisitante, "prediction-pill");
        }

        var marcador = $"{detalle.PronosticoLocal} - {detalle.PronosticoVisitante}";
        return new MarkupString(
            $"<span class=\"prediction-ko-wrap\"><span class=\"prediction-pill\">{marcador}</span><small>{definicion}</small></span>");
    }

    private static string DefinicionEliminatoriaPronostico(DetalleRankingDto detalle)
    {
        if (detalle.Fase == "Grupos" ||
            !detalle.PronosticoLocal.HasValue ||
            !detalle.PronosticoVisitante.HasValue ||
            detalle.PronosticoLocal != detalle.PronosticoVisitante)
        {
            return "";
        }

        var clasificado = string.IsNullOrWhiteSpace(detalle.PrediceClasificado)
            ? "clasificado no definido"
            : $"clasifica {System.Net.WebUtility.HtmlEncode(detalle.PrediceClasificado)}";
        var definicion = detalle.PredicePenales
            ? "por penales"
            : detalle.PrediceTiempoExtra
                ? "en tiempo extra"
                : "definicion no indicada";

        return $"{clasificado} {definicion}";
    }

    private bool PuedeMostrarPronostico(DetalleRankingDto detalle)
    {
        return detalle.PronosticoVisible &&
               (
                   Sesion.EsAdmin ||
                   Sesion.UsuarioId.HasValue &&
                   detalle.UsuarioId == Sesion.UsuarioId.Value ||
                   PartidoCerradoParaVisibilidad(detalle)
               );
    }

    private static bool PartidoCerradoParaVisibilidad(DetalleRankingDto detalle)
    {
        return detalle.ResultadoLocal.HasValue &&
               detalle.ResultadoVisitante.HasValue ||
               AhoraColombia() >= FechaColombia(detalle.Fecha).AddHours(-1);
    }

    private static string FechaCorta(DateTime fecha)
    {
        return fecha == default ? "-" : fecha.ToString("dd/MM/yyyy");
    }

    private static string NormalizarGrupo(string grupo)
    {
        return grupo.Replace("Grupo", "", StringComparison.OrdinalIgnoreCase)
            .Trim()
            .ToUpperInvariant();
    }

    private static int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private static string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

