    private void PrepararPosicionesPorGrupo()
    {
        posicionesPorGrupo.Clear();

        if (partidos == null)
        {
            return;
        }

        foreach (var grupo in partidos
            .GroupBy(p => NormalizarGrupo(p.Grupo))
            .OrderBy(g => g.Key))
        {
            var equipos = grupo
                .SelectMany(p => new[] { p.Local, p.Visitante })
                .Where(e => !string.IsNullOrWhiteSpace(e))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(e => e)
                .Select((equipo, index) => new SimuladorEquipoPosicion
                {
                    Grupo = grupo.Key,
                    Equipo = equipo,
                    Posicion = index + 1
                })
                .ToList();

            posicionesPorGrupo[grupo.Key] = equipos;
        }
