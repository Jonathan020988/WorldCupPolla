    private static readonly int[][] CrucesCuartosDesdeOctavos =
    {
        new[] { 89, 90 },
        new[] { 93, 94 },
        new[] { 91, 92 },
        new[] { 95, 96 }
    };

    private void GenerarOctavos()
    {
        octavos.Clear();

        var ganadores = ObtenerGanadoresPorNumero(dieciseisavos, 73);

        for (var i = 0; i < CrucesOctavosDesdeDieciseisavos.Length; i++)
        {
            var cruce = CrucesOctavosDesdeDieciseisavos[i];

            octavos.Add(new PartidoEliminacionDto
                {
                    NumeroPartido = 89 + i,
                    Local = ganadores[cruce[0]],
                    Visitante = ganadores[cruce[1]]
                });
        }
    }

    private void GenerarCuartos()
    {
        cuartos.Clear();

        var ganadores = ObtenerGanadoresPorNumero(octavos, 89);

        for (var i = 0; i < CrucesCuartosDesdeOctavos.Length; i++)
        {
            var cruce = CrucesCuartosDesdeOctavos[i];

            cuartos.Add(new PartidoEliminacionDto
                {
                    NumeroPartido = 97 + i,
                    Local = ganadores[cruce[0]],
                    Visitante = ganadores[cruce[1]]
                });
        }
    }

    private Dictionary<int, string> ObtenerGanadoresPorNumero(
        List<PartidoEliminacionDto> partidos,
        int primerNumero)
    {
        return partidos
            .Select((partido, index) => new
            {
                Numero = partido.NumeroPartido > 0
                    ? partido.NumeroPartido
                    : primerNumero + index,
                Ganador = ObtenerGanador(partido)
            })
            .ToDictionary(x => x.Numero, x => x.Ganador);
    }

    private List<string> ObtenerGanadores(
        List<PartidoEliminacionDto> partidos)
    {
        var ganadores = new List<string>();

        foreach (var partido in partidos)
        {
            ganadores.Add(ObtenerGanador(partido));
        }

        return ganadores;
    }

    private string ObtenerGanador(PartidoEliminacionDto partido)
    {
        if (partido.GolesLocal > partido.GolesVisitante)
            return partido.Local;

        if (partido.GolesVisitante > partido.GolesLocal)
            return partido.Visitante;

        return partido.GanadorPenales!;
    }

    protected override async Task OnInitializedAsync()
    {
        partidos = await Http.GetFromJsonAsync<List<SimuladorPartidoDto>>(
            "api/Partidos/simulador"
        );

        PrepararPosicionesPorGrupo();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || partidos == null)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();
        await CargarSimulacionesGuardadas();
        await RestaurarBorradorSimulador();
        StateHasChanged();
    }

    private async Task GuardarPartido(SimuladorPartidoDto partido)
    {
        await GuardarBorradorSimulador("Marcador guardado en tu simulación. No modifica resultados oficiales.");
    }

    private Task GuardarBorradorSimulador()
    {
        return GuardarBorradorSimulador("Simulación guardada correctamente. Puedes cerrar la página y volver después.");
    }

    private SimuladorBorrador CrearBorradorSimulador(DateTime guardadoEnUtc)
    {
        return new SimuladorBorrador
        {
            Version = "1",
            ModoSimulador = modoSimulador,
            GuardadoEnUtc = guardadoEnUtc,
            Partidos = partidos?
                .Select(p => new SimuladorPartidoGuardado
                {
                    Id = p.Id,
                    Grupo = p.Grupo,
                    LocalId = p.LocalId,
                    Local = p.Local,
                    VisitanteId = p.VisitanteId,
                    Visitante = p.Visitante,
                    GolesLocal = p.GolesLocal,
                    GolesVisitante = p.GolesVisitante
                })
                .ToList() ?? new(),
            PosicionesPorGrupo = posicionesPorGrupo.ToDictionary(
                g => g.Key,
                g => g.Value
                    .Select(e => new SimuladorEquipoPosicionGuardado
                    {
                        Grupo = e.Grupo,
                        Equipo = e.Equipo,
                        Posicion = e.Posicion
                    })
                    .ToList(),
                StringComparer.OrdinalIgnoreCase),
            GruposTerceroSimulador = gruposTerceroSimulador.ToList(),
            TablasMarcadoresVisibles = tablasMarcadoresVisibles.ToList(),
            MejoresTercerosMarcadores = mejoresTercerosMarcadores,
            TablasMarcadoresCalculadas = tablasMarcadoresCalculadas,
            MostrarMejoresTercerosMarcadores = mostrarMejoresTercerosMarcadores,
            Clasificados = clasificados,
            MejoresTerceros = mejoresTerceros,
            TablasPorGrupo = tablasPorGrupo,
            Dieciseisavos = dieciseisavos,
            Octavos = octavos,
            Cuartos = cuartos,
            Semifinales = semifinales,
            TercerPuesto = tercerPuesto,
            Final = final
        };
    }

    private async Task GuardarBorradorSimulador(string mensajeExito)
    {
        if (partidos == null)
        {
            return;
        }

        try
        {
            guardandoBorrador = true;

            var guardadoEnUtc = DateTime.UtcNow;
            var borrador = CrearBorradorSimulador(guardadoEnUtc);

            var json = System.Text.Json.JsonSerializer.Serialize(borrador, BorradorJsonOptions);
            await JS.InvokeVoidAsync("localStorage.setItem", SimuladorStorageKey, json);
            await ActualizarSimulacionActivaSiExiste(borrador, guardadoEnUtc);

            borradorGuardadoEnUtc = guardadoEnUtc;
            simuladorConError = false;
            mensajeSimulador = mensajeExito;
        }
        catch
        {
            simuladorConError = true;
            mensajeSimulador = "No se pudo guardar la simulación en este navegador. Intenta de nuevo.";
        }
        finally
        {
            guardandoBorrador = false;
        }
    }

    private void AplicarBorradorSimulador(SimuladorBorrador borrador)
    {
        if (partidos == null)
        {
            return;
        }

        modoSimulador = borrador.ModoSimulador == "posiciones"
            ? "posiciones"
            : "marcadores";

        foreach (var guardado in borrador.Partidos)
        {
            var partido = partidos.FirstOrDefault(p =>
                p.Id == guardado.Id ||
                (string.Equals(NormalizarGrupo(p.Grupo), NormalizarGrupo(guardado.Grupo), StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(p.Local, guardado.Local, StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(p.Visitante, guardado.Visitante, StringComparison.OrdinalIgnoreCase)));

            if (partido == null)
            {
                continue;
            }

            partido.GolesLocal = guardado.GolesLocal;
            partido.GolesVisitante = guardado.GolesVisitante;
        }

        PrepararPosicionesPorGrupo();
        foreach (var grupoGuardado in borrador.PosicionesPorGrupo)
        {
            var grupo = NormalizarGrupo(grupoGuardado.Key);
            if (!posicionesPorGrupo.TryGetValue(grupo, out var posicionesActuales))
            {
                continue;
            }

            foreach (var equipoGuardado in grupoGuardado.Value)
            {
                var equipo = posicionesActuales.FirstOrDefault(e =>
                    string.Equals(e.Equipo, equipoGuardado.Equipo, StringComparison.OrdinalIgnoreCase));

                if (equipo != null)
                {
                    equipo.Posicion = equipoGuardado.Posicion;
                }
            }
        }

        gruposTerceroSimulador = borrador.GruposTerceroSimulador
            .Select(NormalizarGrupo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        tablasMarcadoresVisibles = borrador.TablasMarcadoresVisibles
            .Select(NormalizarGrupo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        clasificados = borrador.Clasificados ?? new();
        mejoresTerceros = borrador.MejoresTerceros ?? new();
        tablasPorGrupo = borrador.TablasPorGrupo ?? new(StringComparer.OrdinalIgnoreCase);
        mejoresTercerosMarcadores = borrador.MejoresTercerosMarcadores ?? new();
        tablasMarcadoresCalculadas = borrador.TablasMarcadoresCalculadas ?? new(StringComparer.OrdinalIgnoreCase);
        mostrarMejoresTercerosMarcadores = borrador.MostrarMejoresTercerosMarcadores &&
            mejoresTercerosMarcadores.Any();
        dieciseisavos = borrador.Dieciseisavos ?? new();
        octavos = borrador.Octavos ?? new();
        cuartos = borrador.Cuartos ?? new();
        semifinales = borrador.Semifinales ?? new();
        tercerPuesto = borrador.TercerPuesto ?? new();
        final = borrador.Final ?? new();

        borradorGuardadoEnUtc = borrador.GuardadoEnUtc == default
            ? null
            : borrador.GuardadoEnUtc;
    }

    private async Task RestaurarBorradorSimulador()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SimuladorStorageKey);
            if (string.IsNullOrWhiteSpace(json) || partidos == null)
            {
                return;
            }

            var borrador = System.Text.Json.JsonSerializer.Deserialize<SimuladorBorrador>(
                json,
                BorradorJsonOptions);

            if (borrador == null)
            {
                return;
            }

            AplicarBorradorSimulador(borrador);
            simuladorConError = false;
            mensajeSimulador = "Se restauró tu simulación guardada en este navegador.";
        }
        catch
        {
            simuladorConError = true;
            mensajeSimulador = "No se pudo restaurar la simulación guardada. Puedes limpiar y empezar de nuevo.";
        }
    }

    private async Task CargarSimulacionesGuardadas()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SimulacionesStorageKey);
            simulacionesGuardadas = string.IsNullOrWhiteSpace(json)
                ? new()
                : System.Text.Json.JsonSerializer.Deserialize<List<SimulacionGuardada>>(json, BorradorJsonOptions) ?? new();

            simulacionesGuardadas = simulacionesGuardadas
                .Where(s => s.Borrador != null && !string.IsNullOrWhiteSpace(s.Nombre))
                .OrderByDescending(s => s.ActualizadoEnUtc)
                .ToList();

            await MigrarBorradorAnteriorComoSimulacion();
        }
        catch
        {
            simulacionesGuardadas = new();
            simuladorConError = true;
            mensajeSimulador = "No se pudo cargar la lista de simulaciones guardadas en este navegador.";
        }
    }

    private async Task MigrarBorradorAnteriorComoSimulacion()
    {
        if (simulacionesGuardadas.Any(s => s.MigradaDesdeBorradorAnterior))
        {
            return;
        }

        var json = await JS.InvokeAsync<string?>("localStorage.getItem", SimuladorStorageKey);
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }

        var borrador = System.Text.Json.JsonSerializer.Deserialize<SimuladorBorrador>(
            json,
            BorradorJsonOptions);

        if (borrador == null)
        {
            return;
        }

        var fecha = borrador.GuardadoEnUtc == default
            ? DateTime.UtcNow
            : borrador.GuardadoEnUtc;

        simulacionesGuardadas.Add(new SimulacionGuardada
        {
            Id = Guid.NewGuid().ToString("N"),
            Nombre = $"Simulación anterior {FechaColombia(fecha)}",
            CreadoEnUtc = fecha,
            ActualizadoEnUtc = fecha,
            MigradaDesdeBorradorAnterior = true,
            Borrador = borrador
        });

        await GuardarListaSimulaciones();
    }

    private async Task GuardarListaSimulaciones()
    {
        simulacionesGuardadas = simulacionesGuardadas
            .OrderByDescending(s => s.ActualizadoEnUtc)
            .ToList();

        var json = System.Text.Json.JsonSerializer.Serialize(simulacionesGuardadas, BorradorJsonOptions);
        await JS.InvokeVoidAsync("localStorage.setItem", SimulacionesStorageKey, json);
    }

    private async Task GuardarSimulacionNombrada()
    {
        if (partidos == null)
        {
            return;
        }

        var nombre = (nombreSimulacion ?? "").Trim();
        if (string.IsNullOrWhiteSpace(nombre))
        {
            simuladorConError = true;
            mensajeSimulador = "Escribe un nombre para guardar la simulación.";
            return;
        }

        try
        {
            guardandoBorrador = true;
            var ahora = DateTime.UtcNow;
            var borrador = CrearBorradorSimulador(ahora);
            var existente = simulacionesGuardadas.FirstOrDefault(s => s.Id == simulacionActivaId);

            if (existente == null)
            {
                existente = new SimulacionGuardada
                {
                    Id = Guid.NewGuid().ToString("N"),
                    CreadoEnUtc = ahora
                };
                simulacionesGuardadas.Add(existente);
            }

            existente.Nombre = nombre;
            existente.ActualizadoEnUtc = ahora;
            existente.Borrador = borrador;
            simulacionActivaId = existente.Id;

            await GuardarListaSimulaciones();

            var json = System.Text.Json.JsonSerializer.Serialize(borrador, BorradorJsonOptions);
            await JS.InvokeVoidAsync("localStorage.setItem", SimuladorStorageKey, json);

            borradorGuardadoEnUtc = ahora;
            simuladorConError = false;
            mensajeSimulador = $"Simulación \"{existente.Nombre}\" guardada correctamente.";
        }
        catch
        {
            simuladorConError = true;
            mensajeSimulador = "No se pudo guardar la simulación con nombre. Intenta de nuevo.";
        }
        finally
        {
            guardandoBorrador = false;
        }
    }

    private async Task ActualizarSimulacionActivaSiExiste(SimuladorBorrador borrador, DateTime actualizadoEnUtc)
    {
        if (string.IsNullOrWhiteSpace(simulacionActivaId))
        {
            return;
        }

        var simulacion = simulacionesGuardadas.FirstOrDefault(s => s.Id == simulacionActivaId);
        if (simulacion == null)
        {
            simulacionActivaId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(nombreSimulacion))
        {
            simulacion.Nombre = nombreSimulacion.Trim();
        }

        simulacion.ActualizadoEnUtc = actualizadoEnUtc;
        simulacion.Borrador = borrador;
        await GuardarListaSimulaciones();
    }

    private async Task CargarSimulacionGuardada(string id)
    {
        var simulacion = simulacionesGuardadas.FirstOrDefault(s => s.Id == id);
        if (simulacion?.Borrador == null)
        {
            simuladorConError = true;
            mensajeSimulador = "No se encontró esa simulación guardada.";
            return;
        }

        AplicarBorradorSimulador(simulacion.Borrador);
        simulacionActivaId = simulacion.Id;
        nombreSimulacion = simulacion.Nombre;

        var json = System.Text.Json.JsonSerializer.Serialize(simulacion.Borrador, BorradorJsonOptions);
        await JS.InvokeVoidAsync("localStorage.setItem", SimuladorStorageKey, json);

        simuladorConError = false;
        mensajeSimulador = $"Simulación \"{simulacion.Nombre}\" cargada. Puedes editarla y guardar cambios.";
    }

    private async Task EliminarSimulacionGuardada(string id)
    {
        var simulacion = simulacionesGuardadas.FirstOrDefault(s => s.Id == id);
        if (simulacion == null)
        {
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Eliminar la simulación \"{simulacion.Nombre}\"?");

        if (!confirmar)
        {
            return;
        }

        simulacionesGuardadas.Remove(simulacion);

        if (simulacionActivaId == simulacion.Id)
        {
            simulacionActivaId = null;
            nombreSimulacion = "";
        }

        await GuardarListaSimulaciones();
        simuladorConError = false;
        mensajeSimulador = $"Simulación \"{simulacion.Nombre}\" eliminada.";
    }

    private static string FechaColombia(DateTime fechaUtc)
    {
        if (fechaUtc == default)
        {
            return "";
        }

        return fechaUtc.AddHours(-5).ToString("dd/MM/yyyy HH:mm");
    }

    private async Task LimpiarBorradorSimulador()
    {
        if (partidos != null)
        {
            foreach (var partido in partidos)
            {
                partido.GolesLocal = null;
                partido.GolesVisitante = null;
            }
        }

        modoSimulador = "marcadores";
        gruposTerceroSimulador.Clear();
        PrepararPosicionesPorGrupo();
        LimpiarSimulacionDesdeGrupos();
        borradorGuardadoEnUtc = null;
        simulacionActivaId = null;
        nombreSimulacion = "";

        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", SimuladorStorageKey);
            simuladorConError = false;
            mensajeSimulador = "Simulación limpia. Ya puedes empezar de nuevo.";
        }
        catch
        {
            simuladorConError = true;
            mensajeSimulador = "Se limpió la pantalla, pero no se pudo borrar el borrador guardado del navegador.";
        }
    }

    private bool GrupoConMarcadoresCompletos(IEnumerable<SimuladorPartidoDto> partidosGrupo)
    {
        return partidosGrupo.All(p => p.GolesLocal.HasValue && p.GolesVisitante.HasValue);
    }

    private void MostrarTablaMarcadoresGrupo(string grupo)
    {
        var grupoNormalizado = NormalizarGrupo(grupo);
        tablasMarcadoresVisibles.Add(grupoNormalizado);
        simuladorConError = false;
        mensajeSimulador = $"Tabla del Grupo {grupoNormalizado} actualizada con los marcadores del simulador.";
    }

    private void MostrarMejoresTercerosPorMarcadores()
    {
        var calculo = CalcularClasificacionPorMarcadores();

        if (!calculo.EstaCompleto)
        {
            mejoresTercerosMarcadores.Clear();
            tablasMarcadoresCalculadas.Clear();
            mostrarMejoresTercerosMarcadores = false;
            mejoresTercerosMarcadoresConError = true;
            mensajeMejoresTercerosMarcadores = calculo.GruposIncompletos.Any()
                ? $"Faltan marcadores completos en: {string.Join(", ", calculo.GruposIncompletos.Select(g => $"Grupo {g}"))}."
                : "No hay marcadores suficientes para calcular los mejores terceros.";
            return;
        }

        tablasMarcadoresCalculadas = calculo.Tablas;
        mejoresTercerosMarcadores = calculo.MejoresTerceros;
        mostrarMejoresTercerosMarcadores = true;
        mejoresTercerosMarcadoresConError = false;
        mensajeMejoresTercerosMarcadores = "Mejores terceros calculados con los marcadores del simulador.";
    }

    private async Task CopiarGruposMejoresTercerosMarcadores()
    {
        if (!mejoresTercerosMarcadores.Any())
        {
            return;
        }

        var texto = string.Join(", ", mejoresTercerosMarcadores.Select(t => $"Grupo {t.Grupo}"));

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
            mejoresTercerosMarcadoresConError = false;
            mensajeMejoresTercerosMarcadores = $"Grupos copiados: {texto}.";
        }
        catch
        {
            mejoresTercerosMarcadoresConError = true;
            mensajeMejoresTercerosMarcadores = $"No se pudo copiar automáticamente. Grupos: {texto}.";
        }
    }

    private void LlevarMejoresTercerosAClasificacion()
    {
        var pollaId = Sesion.PollaActivaId ?? PollaId;

        if (!pollaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            mejoresTercerosMarcadoresConError = true;
            mensajeMejoresTercerosMarcadores = "Para llevar esta clasificación debes ingresar a una polla con tu usuario.";
            return;
        }

        var calculo = CalcularClasificacionPorMarcadores();

        if (!calculo.EstaCompleto)
        {
            mejoresTercerosMarcadoresConError = true;
            mensajeMejoresTercerosMarcadores = calculo.GruposIncompletos.Any()
                ? $"Antes de llevarlo faltan marcadores en: {string.Join(", ", calculo.GruposIncompletos.Select(g => $"Grupo {g}"))}."
                : "No hay marcadores suficientes para llevar esta clasificación.";
            return;
        }

        if (calculo.Tablas.SelectMany(g => g.Value).Any(e => e.EquipoId <= 0))
        {
            mejoresTercerosMarcadoresConError = true;
            mensajeMejoresTercerosMarcadores = "No se pudo identificar uno de los equipos. Actualiza la página e intenta de nuevo.";
            return;
        }

        ClasificacionDraft.Set(new ClasificacionDraftDto
        {
            PollaId = pollaId.Value,
            UsuarioId = Sesion.UsuarioId.Value,
            Origen = "Simulador",
            Grupos = calculo.Tablas
                .OrderBy(g => g.Key)
                .Select(g => new GrupoClasificacionDraftDto
                {
                    Grupo = g.Key,
                    Equipos = g.Value
                        .Select((equipo, index) => new EquipoClasificacionDraftDto
                        {
                            EquipoId = equipo.EquipoId,
                            Equipo = equipo.Nombre,
                            Posicion = index + 1
                        })
                        .ToList()
                })
                .ToList(),
            MejoresTerceros = calculo.MejoresTerceros
                .Select(t => t.Grupo)
                .ToList()
        });

        Navigation.NavigateTo("/clasificacion-grupos");
    }

    private CalculoMarcadoresClasificacion CalcularClasificacionPorMarcadores()
    {
        var resultado = new CalculoMarcadoresClasificacion();

        if (partidos == null || !partidos.Any())
        {
            return resultado;
        }

        var grupos = partidos
            .GroupBy(p => NormalizarGrupo(p.Grupo))
            .OrderBy(g => g.Key)
            .ToList();

        foreach (var grupo in grupos)
        {
            var partidosGrupo = grupo.ToList();

            if (!GrupoConMarcadoresCompletos(partidosGrupo))
            {
                resultado.GruposIncompletos.Add(grupo.Key);
                continue;
            }

            resultado.Tablas[grupo.Key] = CalcularTablaMarcadoresGrupo(partidosGrupo, grupo.Key);
        }

        if (resultado.GruposIncompletos.Any() || !resultado.Tablas.Any())
        {
            resultado.Tablas.Clear();
            return resultado;
        }

        resultado.MejoresTerceros = resultado.Tablas
            .Select(g => g.Value.Skip(2).FirstOrDefault())
            .Where(e => e != null)
            .Cast<EquipoGrupoDto>()
            .OrderByDescending(e => e.Puntos)
            .ThenByDescending(e => e.Diferencia)
            .ThenByDescending(e => e.GolesFavor)
            .ThenBy(e => e.Nombre)
            .Take(8)
            .ToList();

        return resultado;
    }

    private void LimpiarVistaMejoresTercerosMarcadores()
    {
        if (!mostrarMejoresTercerosMarcadores && !mejoresTercerosMarcadores.Any())
        {
            return;
        }

        mostrarMejoresTercerosMarcadores = false;
        mejoresTercerosMarcadores.Clear();
        tablasMarcadoresCalculadas.Clear();
        mensajeMejoresTercerosMarcadores = null;
        mejoresTercerosMarcadoresConError = false;
    }

    private List<EquipoGrupoDto> CalcularTablaMarcadoresGrupo(
        IEnumerable<SimuladorPartidoDto> partidosGrupo,
        string grupo)
    {
        var equipos = new Dictionary<string, EquipoGrupoDto>(StringComparer.OrdinalIgnoreCase);
        var grupoNormalizado = NormalizarGrupo(grupo);

        foreach (var partido in partidosGrupo)
        {
            if (!equipos.ContainsKey(partido.Local))
            {
                equipos.Add(partido.Local, new EquipoGrupoDto
                    {
                        EquipoId = partido.LocalId,
                        Nombre = partido.Local,
                        Grupo = grupoNormalizado
                    });
            }

            if (!equipos.ContainsKey(partido.Visitante))
            {
                equipos.Add(partido.Visitante, new EquipoGrupoDto
                    {
                        EquipoId = partido.VisitanteId,
                        Nombre = partido.Visitante,
                        Grupo = grupoNormalizado
                    });
            }

            var local = equipos[partido.Local];
            var visitante = equipos[partido.Visitante];
            var golesLocal = partido.GolesLocal ?? 0;
            var golesVisitante = partido.GolesVisitante ?? 0;

            local.GolesFavor += golesLocal;
            local.GolesContra += golesVisitante;
            visitante.GolesFavor += golesVisitante;
            visitante.GolesContra += golesLocal;

            if (golesLocal > golesVisitante)
            {
                local.Puntos += 3;
            }
            else if (golesVisitante > golesLocal)
            {
                visitante.Puntos += 3;
            }
            else
            {
                local.Puntos += 1;
                visitante.Puntos += 1;
            }
        }

        return equipos.Values
            .OrderByDescending(x => x.Puntos)
            .ThenByDescending(x => x.Diferencia)
            .ThenByDescending(x => x.GolesFavor)
            .ThenBy(x => x.Nombre)
            .ToList();
    }



    private void Simular16avos()
    {
        clasificados.Clear();
        mejoresTerceros.Clear();
        tablasPorGrupo.Clear();
        dieciseisavos.Clear();
        octavos.Clear();
        cuartos.Clear();
        semifinales.Clear();
        tercerPuesto.Clear();
        final.Clear();

        if (modoSimulador == "posiciones")
        {
            if (!ConstruirTablasDesdePosiciones())
            {
                return;
            }

            GenerarCrucesDieciseisavos();
            return;
        }

        var terceros = new List<EquipoGrupoDto>();

        var grupos = partidos!
            .GroupBy(x => x.Grupo)
            .OrderBy(x => x.Key);

        foreach (var grupo in grupos)
        {
            var equipos = new Dictionary<string, EquipoGrupoDto>();

            foreach (var partido in grupo)
            {
                if (!equipos.ContainsKey(partido.Local))
                {
                    equipos.Add(partido.Local, new EquipoGrupoDto
                        {
                            EquipoId = partido.LocalId,
                            Nombre = partido.Local,
                            Grupo = NormalizarGrupo(grupo.Key)
                        });
                }

                if (!equipos.ContainsKey(partido.Visitante))
                {
                    equipos.Add(partido.Visitante, new EquipoGrupoDto
                        {
                            EquipoId = partido.VisitanteId,
                            Nombre = partido.Visitante,
                            Grupo = NormalizarGrupo(grupo.Key)
                        });
                }

                var local = equipos[partido.Local];
                var visitante = equipos[partido.Visitante];

                int gl = partido.GolesLocal ?? 0;
                int gv = partido.GolesVisitante ?? 0;

                local.GolesFavor += gl;
                local.GolesContra += gv;

                visitante.GolesFavor += gv;
                visitante.GolesContra += gl;

                if (gl > gv)
                {
                    local.Puntos += 3;
                }
                else if (gv > gl)
                {
                    visitante.Puntos += 3;
                }
                else
                {
                    local.Puntos += 1;
                    visitante.Puntos += 1;
                }
            }

            var ordenados = equipos.Values
                .OrderByDescending(x => x.Puntos)
                .ThenByDescending(x => x.Diferencia)
                .ThenByDescending(x => x.GolesFavor)
                .ToList();

            tablasPorGrupo[NormalizarGrupo(grupo.Key)] = ordenados;

            clasificados.Add(ordenados[0]);
            clasificados.Add(ordenados[1]);

            terceros.Add(ordenados[2]);
        }

        mejoresTerceros = terceros
            .OrderByDescending(x => x.Puntos)
            .ThenByDescending(x => x.Diferencia)
            .ThenByDescending(x => x.GolesFavor)
            .Take(8)
            .ToList();

        GenerarCrucesDieciseisavos();
    }

