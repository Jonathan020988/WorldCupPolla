@page "/simulador"
@page "/simulador/{PollaId:int}"
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services
@using WorldCup.App.Web.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject SesionService Sesion
@inject ClasificacionDraftService ClasificacionDraft
@rendermode InteractiveServer

<h2 class="mb-4">🌎 Simulador Mundial</h2>

@if (partidos == null)
{
    <p>Cargando partidos...</p>
}
else
{
    var grupos = partidos
        .GroupBy(x => x.Grupo)
        .OrderBy(x => x.Key)
        .ToList();

    <div class="container-fluid">

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <label class="form-label fw-bold">Simular fase de grupos por</label>
                    <select class="form-select"
                            style="min-width:230px"
                            value="@modoSimulador"
                            @onchange="CambiarModoSimulador">
                        <option value="marcadores">Marcadores</option>
                        <option value="posiciones">Posición en tabla</option>
                    </select>
                </div>

                <div class="text-muted small">
                    Por marcadores calcula la tabla automáticamente. Por posición te deja ordenar cada grupo manualmente.
                </div>

                <div class="sim-draft-actions">
                    <label class="sim-save-name">
                        <span>Nombre de la simulación</span>
                        <input class="form-control"
                               placeholder="Ej: Escenario México primero"
                               @bind="nombreSimulacion" />
                    </label>

                    <button class="btn btn-primary"
                            disabled="@(guardandoBorrador || partidos == null)"
                            @onclick="GuardarSimulacionNombrada">
                        💾 @TextoBotonGuardarSimulacion
                    </button>

                    <button class="btn btn-outline-danger"
                            disabled="@(guardandoBorrador || partidos == null)"
                            @onclick="LimpiarBorradorSimulador">
                        Nueva / limpiar
                    </button>

                    @if (!string.IsNullOrWhiteSpace(UltimoGuardadoTexto))
                    {
                        <small>@UltimoGuardadoTexto</small>
                    }
                </div>
            </div>
        </div>

        @if (simulacionesGuardadas.Any())
        {
            <div class="sim-saved-panel card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="sim-saved-head">
                        <div>
                            <span class="sim-third-kicker">Mis simulaciones</span>
                            <h3>Simulaciones guardadas</h3>
                            <p>Carga una simulación para verla o editarla. Eliminar una simulación no borra tus predicciones ni resultados oficiales.</p>
                        </div>
                        <span class="sim-saved-count">@simulacionesGuardadas.Count guardada(s)</span>
                    </div>

                    <div class="sim-saved-list">
                        @foreach (var simulacion in simulacionesGuardadas.OrderByDescending(s => s.ActualizadoEnUtc))
                        {
                            <div class="sim-saved-item @(simulacion.Id == simulacionActivaId ? "active" : "")">
                                <div>
                                    <strong>@simulacion.Nombre</strong>
                                    <span>Creada: @FechaColombia(simulacion.CreadoEnUtc) · Actualizada: @FechaColombia(simulacion.ActualizadoEnUtc)</span>
                                </div>
                                <div class="sim-saved-actions">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => CargarSimulacionGuardada(simulacion.Id)">
                                        Cargar / editar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => EliminarSimulacionGuardada(simulacion.Id)">
                                        Eliminar
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(mensajeSimulador))
        {
            <div class="alert @(simuladorConError ? "alert-danger" : "alert-success")">
                @mensajeSimulador
            </div>
        }

        @if (modoSimulador == "marcadores")
        {
            <div class="sim-third-preview card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="sim-third-preview-head">
                        <div>
                            <span class="sim-third-kicker">Clasificación calculada</span>
                            <h3>8 mejores terceros por marcadores</h3>
                            <p>
                                Calcula los terceros con los resultados que escribiste en todos los grupos y llévalos como borrador a Clasificación Grupos.
                            </p>
                        </div>

                        <button class="btn btn-warning fw-bold"
                                @onclick="MostrarMejoresTercerosPorMarcadores">
                            Ver mejores terceros
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensajeMejoresTercerosMarcadores))
                    {
                        <div class="alert @(mejoresTercerosMarcadoresConError ? "alert-warning" : "alert-success") mb-3">
                            @mensajeMejoresTercerosMarcadores
                        </div>
                    }

                    @if (mejoresTercerosMarcadores.Any())
                    {
                        <div class="sim-third-summary">
                            @foreach (var tercero in mejoresTercerosMarcadores)
                            {
                                <span>Grupo @tercero.Grupo</span>
                            }
                        </div>

                        <div class="table-responsive sim-third-desktop-table">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Equipo</th>
                                        <th>Grupo</th>
                                        <th>Pts</th>
                                        <th>GF</th>
                                        <th>GC</th>
                                        <th>DG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < mejoresTercerosMarcadores.Count; i++)
                                    {
                                        var tercero = mejoresTercerosMarcadores[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td class="fw-bold">@tercero.Nombre</td>
                                            <td>Grupo @tercero.Grupo</td>
                                            <td><strong>@tercero.Puntos</strong></td>
                                            <td>@tercero.GolesFavor</td>
                                            <td>@tercero.GolesContra</td>
                                            <td>@tercero.Diferencia</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="sim-third-mobile-list">
                            @for (var i = 0; i < mejoresTercerosMarcadores.Count; i++)
                            {
                                var tercero = mejoresTercerosMarcadores[i];
                                <div class="sim-third-mobile-card">
                                    <div>
                                        <strong>@(i + 1). @tercero.Nombre</strong>
                                        <span>Grupo @tercero.Grupo</span>
                                    </div>
                                    <div>
                                        <b>@tercero.Puntos pts</b>
                                        <small>DG @tercero.Diferencia · GF @tercero.GolesFavor</small>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="sim-third-actions">
                            <button class="btn btn-outline-secondary"
                                    @onclick="CopiarGruposMejoresTercerosMarcadores">
                                Copiar grupos
                            </button>

                            <button class="btn btn-success"
                                    @onclick="LlevarMejoresTercerosAClasificacion">
                                Llevar a Clasificación Grupos
                            </button>
                        </div>
                    }
                </div>
            </div>

            @for (int i = 0; i < grupos.Count; i += 2)
            {
                <div class="row mb-3">

                    @foreach (var grupo in grupos.Skip(i).Take(2))
                    {
                        var partidosGrupo = grupo.ToList();
                        var grupoNormalizado = NormalizarGrupo(grupo.Key);
                        var grupoCompleto = GrupoConMarcadoresCompletos(partidosGrupo);
                        var tablaVisible = tablasMarcadoresVisibles.Contains(grupoNormalizado) && grupoCompleto;

                        <div class="col-lg-6">

                            <div class="card shadow-sm mb-3 border-0">

                                <div class="card-header bg-dark text-white fw-bold py-2">
                                    🏆 @grupo.Key
                                </div>

                                <div class="card-body p-2">

                                    @foreach (var partido in partidosGrupo)
                                    {
                                        <div class="border rounded p-2 mb-2 bg-light">

                                            <div class="row align-items-center text-center small">

                                                <div class="col-4 fw-bold">
                                                    @partido.Local
                                                </div>

                                                <div class="col-2">
                                                    <input type="number"
                                                           min="0"
                                                           class="form-control form-control-sm text-center"
                                                           @bind="partido.GolesLocal"
                                                           @bind:after="LimpiarVistaMejoresTercerosMarcadores" />
                                                </div>

                                                <div class="col-1 fw-bold">
                                                    VS
                                                </div>

                                                <div class="col-2">
                                                    <input type="number"
                                                           min="0"
                                                           class="form-control form-control-sm text-center"
                                                           @bind="partido.GolesVisitante"
                                                           @bind:after="LimpiarVistaMejoresTercerosMarcadores" />
                                                </div>

                                                <div class="col-3 fw-bold">
                                                    @partido.Visitante
                                                </div>

                                            </div>

                                            <div class="text-end mt-1">

                                                <button class="btn btn-success btn-sm py-0 px-2"
                                                        @onclick="() => GuardarPartido(partido)">
                                                    💾 Guardar
                                                </button>

                                            </div>

                                        </div>
                                    }

                                    <div class="sim-group-actions">
                                        <button class="btn btn-outline-primary btn-sm"
                                                disabled="@(!grupoCompleto)"
                                                @onclick="() => MostrarTablaMarcadoresGrupo(grupo.Key)">
                                            @(tablaVisible ? "Actualizar tabla" : "Ver tabla del grupo")
                                        </button>

                                        @if (!grupoCompleto)
                                        {
                                            <small>Completa todos los marcadores para ver la tabla.</small>
                                        }
                                    </div>

                                    @if (tablaVisible)
                                    {
                                        var tablaGrupo = CalcularTablaMarcadoresGrupo(partidosGrupo, grupoNormalizado);
                                        var posicion = 1;

                                        <div class="sim-group-table mt-3">
                                            <div class="sim-group-table-title">
                                                Tabla Grupo @grupoNormalizado
                                            </div>

                                            <table class="table table-sm mb-0 align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Equipo</th>
                                                        <th>Pts</th>
                                                        <th>GF</th>
                                                        <th>GC</th>
                                                        <th>DG</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var equipo in tablaGrupo)
                                                    {
                                                        <tr class="@(posicion <= 2 ? "sim-qualified" : posicion == 3 ? "sim-third" : "")">
                                                            <td>@posicion</td>
                                                            <td class="sim-team-cell">@equipo.Nombre</td>
                                                            <td><strong>@equipo.Puntos</strong></td>
                                                            <td>@equipo.GolesFavor</td>
                                                            <td>@equipo.GolesContra</td>
                                                            <td>@equipo.Diferencia</td>
                                                        </tr>

                                                        posicion++;
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
        }
        else
        {
            <div class="row">
                @foreach (var grupo in posicionesPorGrupo.OrderBy(x => x.Key))
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <strong>Grupo @grupo.Key</strong>

                                <label class="form-check text-white mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@gruposTerceroSimulador.Contains(grupo.Key)"
                                           disabled="@TerceroSimuladorBloqueado(grupo.Key)"
                                           @onchange="(_ => ToggleTerceroSimulador(grupo.Key))" />
                                    <span class="form-check-label">Mejor 3°</span>
                                </label>
                            </div>

                            <div class="card-body p-0">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="padding-left:15px">Equipo</th>
                                            <th style="width:120px">Posición</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var equipo in grupo.Value)
                                        {
                                            <tr>
                                                <td style="padding-left:15px">
                                                    <strong>@equipo.Equipo</strong>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            style="width:76px"
                                                            value="@equipo.Posicion"
                                                            @onchange="e => CambiarPosicionSimulador(grupo.Value, equipo, e)">
                                                        <option value="1">1</option>
                                                        <option value="2">2</option>
                                                        <option value="3">3</option>
                                                        <option value="4">4</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="text-center mt-4 mb-5">

            <button class="btn btn-primary btn-lg"
                    @onclick="Simular16avos">
                ⚽ Simular 16avos
            </button>

        </div>

        @if (tablasPorGrupo.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    📊 Tabla de Posiciones
                </h3>

                <div class="row">

                    @foreach (var grupo in tablasPorGrupo.OrderBy(x => x.Key))
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow-sm border-0">

                                <div class="card-header bg-dark text-white fw-bold">
                                    🏆 @grupo.Key
                                </div>

                                <div class="card-body p-0">

                                    <table class="table table-sm table-striped mb-0">

                                        <thead class="table-dark">

                                            <tr>
                                                <th>#</th>
                                                <th>Equipo</th>
                                                <th>Pts</th>
                                                <th>GF</th>
                                                <th>GC</th>
                                                <th>DG</th>
                                            </tr>

                                        </thead>

                                        <tbody>

                                            @{
                                                int pos = 1;
                                            }

                                            @foreach (var equipo in grupo.Value)
                                            {
                                                string clase = "";

                                                if (pos <= 2)
                                                {
                                                    clase = "table-success";
                                                }
                                                else if (mejoresTerceros.Any(x =>
                                                x.Nombre == equipo.Nombre))
                                                {
                                                    clase = "table-warning";
                                                }
                                                else
                                                {
                                                    clase = "table-danger";
                                                }

                                                <tr class="@clase">

                                                    <td>@pos</td>

                                                    <td>@equipo.Nombre</td>

                                                    <td>
                                                        <strong>@equipo.Puntos</strong>
                                                    </td>

                                                    <td>@equipo.GolesFavor</td>

                                                    <td>@equipo.GolesContra</td>

                                                    <td>@equipo.Diferencia</td>

                                                </tr>

                                                pos++;
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (mejoresTerceros.Any())
        {
            <div class="card shadow-sm mb-5 border-0">

                <div class="card-header bg-warning fw-bold">
                    ⭐ Mejores Terceros
                </div>

                <div class="card-body p-0">

                    <table class="table table-striped mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>#</th>
                                <th>Equipo</th>
                                <th>Grupo</th>
                                <th>Puntos</th>
                                <th>DG</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int pos = 1;
                            }

                            @foreach (var equipo in mejoresTerceros)
                            {
                                <tr>

                                    <td>@pos</td>

                                    <td>@equipo.Nombre</td>

                                    <td>@equipo.Grupo</td>

                                    <td>@equipo.Puntos</td>

                                    <td>@equipo.Diferencia</td>

                                </tr>

                                pos++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

        @* ========================= 16AVOS ========================= *@

        @if (dieciseisavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    ⚔️ Cruces 16avos
                </h3>

                <div class="row">

                    @foreach (var partido in dieciseisavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-dark text-white text-center fw-bold">
                                    ⚔️ Partido @partido.NumeroPartido
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            @if (string.IsNullOrWhiteSpace(partido.Visitante))
                                            {
                                                <select class="form-select form-select-sm mb-2"
                                                        @bind="partido.Visitante">

                                                    <option value="">
                                                        Mejor tercero
                                                    </option>

                                                    @foreach (var tercero in TercerosDisponiblesPara(partido))
                                                    {
                                                        <option value="@tercero.Nombre">
                                                            @tercero.Nombre (@tercero.Grupo)
                                                        </option>
                                                    }

                                                </select>
                                            }
                                            else
                                            {
                                                <div class="fw-bold mb-2">
                                                    @partido.Visitante
                                                </div>
                                            }

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                

                <div class="text-center mt-4">

                    <button class="btn btn-success btn-lg"
                            @onclick="GenerarOctavos">
                        ▶️ Generar Octavos
                    </button>

                </div>

            </div>
        }

        @* ========================= OCTAVOS ========================= *@

        @if (octavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Octavos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in octavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-success text-white text-center fw-bold">
                                    ⚔️ Octavos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center mt-4">

                    <button class="btn btn-warning btn-lg"
                            @onclick="GenerarCuartos">
                        ▶️ Generar Cuartos
                    </button>

                </div>

            </div>
        }

        @* ========================= CUARTOS ========================= *@

        @if (cuartos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Cuartos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in cuartos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-primary text-white text-center fw-bold">
                                    ⚽ Cuartos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-danger btn-lg"
                            @onclick="GenerarSemifinales">
                        ▶️ Generar Semifinales
                    </button>

                </div>

            </div>
        }

        @* ========================= SEMIFINALES ========================= *@

        @if (semifinales.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🔥 Semifinales
                </h3>

                <div class="row justify-content-center">

                    @foreach (var partido in semifinales)
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow border-0">

                                <div class="card-header bg-danger text-white text-center fw-bold">
                                    🏆 Semifinal
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-dark btn-lg"
                            @onclick="GenerarFinal">
                        ▶️ Generar Final
                    </button>

                </div>

            </div>
        }

        @* ========================= TERCER PUESTO ========================= *@

        @if (tercerPuesto.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🥉 Tercer Puesto
                </h3>

                @foreach (var partido in tercerPuesto)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-5">

                            <div class="card shadow border-0">

                                <div class="card-header bg-warning text-dark text-center fw-bold">
                                    🥉 Tercer Lugar
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        @* ========================= FINAL ========================= *@

        @if (final.Any())
        {
            <div class="mt-5 mb-5">

                <h2 class="text-center mb-4">
                    🏆 GRAN FINAL
                </h2>

                @foreach (var partido in final)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-6">

                            <div class="card shadow-lg border-0">

                                <div class="card-header bg-success text-white text-center fw-bold fs-4">
                                    🌎 Final Mundial
                                </div>

                                <div class="card-body p-5">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-2">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-5">

                                            <label class="fw-bold fs-5">
                                                🥅 Campeón por penales
                                            </label>

                                            <select class="form-select form-select-lg"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione campeón
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ObtenerCampeon()))
                {
                    <div class="text-center mt-5">

                        <div class="card shadow-lg border-0 bg-warning">

                            <div class="card-body p-5">

                                <h1 class="display-3">
                                    🏆
                                </h1>

                                <h1 class="fw-bold">
