@page "/simulador"
@using WorldCup.App.Shared.DTOs
@inject HttpClient Http
@rendermode InteractiveServer

<h2 class="mb-4">🌎 Simulador Mundial</h2>

@if (partidos == null)
{
    <p>Cargando partidos...</p>
}
else
{
    var grupos = partidos
        .GroupBy(x => x.Grupo)
        .OrderBy(x => x.Key)
        .ToList();

    <div class="container-fluid">

        @for (int i = 0; i < grupos.Count; i += 2)
        {
            <div class="row mb-3">

                @foreach (var grupo in grupos.Skip(i).Take(2))
                {
                    <div class="col-lg-6">

                        <div class="card shadow-sm mb-3 border-0">

                            <div class="card-header bg-dark text-white fw-bold py-2">
                                🏆 @grupo.Key
                            </div>

                            <div class="card-body p-2">

                                @foreach (var partido in grupo)
                                {
                                    <div class="border rounded p-2 mb-2 bg-light">

                                        <div class="row align-items-center text-center small">

                                            <div class="col-4 fw-bold">
                                                @partido.Local
                                            </div>

                                            <div class="col-2">
                                                <input type="number"
                                                       min="0"
                                                       class="form-control form-control-sm text-center"
                                                       @bind="partido.GolesLocal" />
                                            </div>

                                            <div class="col-1 fw-bold">
                                                VS
                                            </div>

                                            <div class="col-2">
                                                <input type="number"
                                                       min="0"
                                                       class="form-control form-control-sm text-center"
                                                       @bind="partido.GolesVisitante" />
                                            </div>

                                            <div class="col-3 fw-bold">
                                                @partido.Visitante
                                            </div>

                                        </div>

                                        <div class="text-end mt-1">

                                            <button class="btn btn-success btn-sm py-0 px-2"
                                                    @onclick="() => GuardarPartido(partido)">
                                                💾 Guardar
                                            </button>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        <div class="text-center mt-4 mb-5">

            <button class="btn btn-primary btn-lg"
                    @onclick="Simular16avos">
                ⚽ Simular 16avos
            </button>

        </div>

        @if (tablasPorGrupo.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    📊 Tabla de Posiciones
                </h3>

                <div class="row">

                    @foreach (var grupo in tablasPorGrupo.OrderBy(x => x.Key))
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow-sm border-0">

                                <div class="card-header bg-dark text-white fw-bold">
                                    🏆 @grupo.Key
                                </div>

                                <div class="card-body p-0">

                                    <table class="table table-sm table-striped mb-0">

                                        <thead class="table-dark">

                                            <tr>
                                                <th>#</th>
                                                <th>Equipo</th>
                                                <th>Pts</th>
                                                <th>GF</th>
                                                <th>GC</th>
                                                <th>DG</th>
                                            </tr>

                                        </thead>

                                        <tbody>

                                            @{
                                                int pos = 1;
                                            }

                                            @foreach (var equipo in grupo.Value)
                                            {
                                                string clase = "";

                                                if (pos <= 2)
                                                {
                                                    clase = "table-success";
                                                }
                                                else if (mejoresTerceros.Any(x =>
                                                x.Nombre == equipo.Nombre))
                                                {
                                                    clase = "table-warning";
                                                }
                                                else
                                                {
                                                    clase = "table-danger";
                                                }

                                                <tr class="@clase">

                                                    <td>@pos</td>

                                                    <td>@equipo.Nombre</td>

                                                    <td>
                                                        <strong>@equipo.Puntos</strong>
                                                    </td>

                                                    <td>@equipo.GolesFavor</td>

                                                    <td>@equipo.GolesContra</td>

                                                    <td>@equipo.Diferencia</td>

                                                </tr>

                                                pos++;
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (mejoresTerceros.Any())
        {
            <div class="card shadow-sm mb-5 border-0">

                <div class="card-header bg-warning fw-bold">
                    ⭐ Mejores Terceros
                </div>

                <div class="card-body p-0">

                    <table class="table table-striped mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>#</th>
                                <th>Equipo</th>
                                <th>Grupo</th>
                                <th>Puntos</th>
                                <th>DG</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int pos = 1;
                            }

                            @foreach (var equipo in mejoresTerceros)
                            {
                                <tr>

                                    <td>@pos</td>

                                    <td>@equipo.Nombre</td>

                                    <td>@equipo.Grupo</td>

                                    <td>@equipo.Puntos</td>

                                    <td>@equipo.Diferencia</td>

                                </tr>

                                pos++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

        @* ========================= 16AVOS ========================= *@

        @if (dieciseisavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    ⚔️ Cruces 16avos
                </h3>

                <div class="row">

                    @foreach (var partido in dieciseisavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-dark text-white text-center fw-bold">
                                    ⚔️ Partido
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                

                <div class="text-center mt-4">

                    <button class="btn btn-success btn-lg"
                            @onclick="GenerarOctavos">
                        ▶️ Generar Octavos
                    </button>

                </div>

            </div>
        }

        @* ========================= OCTAVOS ========================= *@

        @if (octavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Octavos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in octavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-success text-white text-center fw-bold">
                                    ⚔️ Octavos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center mt-4">

                    <button class="btn btn-warning btn-lg"
                            @onclick="GenerarCuartos">
                        ▶️ Generar Cuartos
                    </button>

                </div>

            </div>
        }

        @* ========================= CUARTOS ========================= *@

        @if (cuartos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Cuartos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in cuartos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-primary text-white text-center fw-bold">
                                    ⚽ Cuartos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-danger btn-lg"
                            @onclick="GenerarSemifinales">
                        ▶️ Generar Semifinales
                    </button>

                </div>

            </div>
        }

        @* ========================= SEMIFINALES ========================= *@

        @if (semifinales.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🔥 Semifinales
                </h3>

                <div class="row justify-content-center">

                    @foreach (var partido in semifinales)
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow border-0">

                                <div class="card-header bg-danger text-white text-center fw-bold">
                                    🏆 Semifinal
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-dark btn-lg"
                            @onclick="GenerarFinal">
                        ▶️ Generar Final
                    </button>

                </div>

            </div>
        }

        @* ========================= TERCER PUESTO ========================= *@

        @if (tercerPuesto.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🥉 Tercer Puesto
                </h3>

                @foreach (var partido in tercerPuesto)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-5">

                            <div class="card shadow border-0">

                                <div class="card-header bg-warning text-dark text-center fw-bold">
                                    🥉 Tercer Lugar
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        @* ========================= FINAL ========================= *@

        @if (final.Any())
        {
            <div class="mt-5 mb-5">

                <h2 class="text-center mb-4">
                    🏆 GRAN FINAL
                </h2>

                @foreach (var partido in final)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-6">

                            <div class="card shadow-lg border-0">

                                <div class="card-header bg-success text-white text-center fw-bold fs-4">
                                    🌎 Final Mundial
                                </div>

                                <div class="card-body p-5">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-2">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-5">

                                            <label class="fw-bold fs-5">
                                                🥅 Campeón por penales
                                            </label>

                                            <select class="form-select form-select-lg"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione campeón
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ObtenerCampeon()))
                {
                    <div class="text-center mt-5">

                        <div class="card shadow-lg border-0 bg-warning">

                            <div class="card-body p-5">

                                <h1 class="display-3">
                                    🏆
                                </h1>

                                <h1 class="fw-bold">
                                    CAMPEÓN MUNDIAL
                                </h1>

                                <h2 class="mt-3 text-dark">
                                    @ObtenerCampeon()
                                </h2>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
       

    </div>
}

@code {

    private List<SimuladorPartidoDto>? partidos;

    private List<EquipoGrupoDto> clasificados = new();

    private List<EquipoGrupoDto> mejoresTerceros = new();

    private Dictionary<string, List<EquipoGrupoDto>> tablasPorGrupo = new();


    private List<PartidoEliminacionDto> dieciseisavos = new();
    private List<PartidoEliminacionDto> octavos = new();
    private List<PartidoEliminacionDto> cuartos = new();
    private List<PartidoEliminacionDto> semifinales = new();
    private List<PartidoEliminacionDto> tercerPuesto = new();
    private List<PartidoEliminacionDto> final = new();

    private void GenerarOctavos()
    {
        octavos.Clear();

        var ganadores = ObtenerGanadores(dieciseisavos);

        for (int i = 0; i < ganadores.Count; i += 2)
        {
            if (i + 1 < ganadores.Count)
            {
                octavos.Add(new PartidoEliminacionDto
                    {
                        Local = ganadores[i],
                        Visitante = ganadores[i + 1]
                    });
            }
        }
    }

    private void GenerarCuartos()
    {
        cuartos.Clear();

        var ganadores = ObtenerGanadores(octavos);

        for (int i = 0; i < ganadores.Count; i += 2)
        {
            if (i + 1 < ganadores.Count)
            {
                cuartos.Add(new PartidoEliminacionDto
                    {
                        Local = ganadores[i],
                        Visitante = ganadores[i + 1]
                    });
            }
        }
    }

    private List<string> ObtenerGanadores(
        List<PartidoEliminacionDto> partidos)
    {
        var ganadores = new List<string>();

        foreach (var partido in partidos)
        {
            if (partido.GolesLocal > partido.GolesVisitante)
            {
                ganadores.Add(partido.Local);
            }
            else if (partido.GolesVisitante > partido.GolesLocal)
            {
                ganadores.Add(partido.Visitante);
            }
            else
            {
                ganadores.Add(partido.GanadorPenales!);
            }
        }

        return ganadores;
    }

    protected override async Task OnInitializedAsync()
    {
        partidos = await Http.GetFromJsonAsync<List<SimuladorPartidoDto>>(
            "api/Partidos/simulador"
        );
    }

    private async Task GuardarPartido(SimuladorPartidoDto partido)
    {
        await Http.PutAsJsonAsync(
            $"api/Partidos/simulador/{partido.Id}",
            partido
        );
    }

    private void Simular16avos()
    {
        clasificados.Clear();
        mejoresTerceros.Clear();
        tablasPorGrupo.Clear();
        dieciseisavos.Clear();

        var terceros = new List<EquipoGrupoDto>();

        var grupos = partidos!
            .GroupBy(x => x.Grupo);

        foreach (var grupo in grupos)
        {
            var equipos = new Dictionary<string, EquipoGrupoDto>();

            foreach (var partido in grupo)
            {
                if (!equipos.ContainsKey(partido.Local))
                {
                    equipos.Add(partido.Local, new EquipoGrupoDto
                        {
                            Nombre = partido.Local,
                            Grupo = grupo.Key
                        });
                }

                if (!equipos.ContainsKey(partido.Visitante))
                {
                    equipos.Add(partido.Visitante, new EquipoGrupoDto
                        {
                            Nombre = partido.Visitante,
                            Grupo = grupo.Key
                        });
                }

                var local = equipos[partido.Local];
                var visitante = equipos[partido.Visitante];

                int gl = partido.GolesLocal ?? 0;
                int gv = partido.GolesVisitante ?? 0;

                local.GolesFavor += gl;
                local.GolesContra += gv;

                visitante.GolesFavor += gv;
                visitante.GolesContra += gl;

                if (gl > gv)
                {
                    local.Puntos += 3;
                }
                else if (gv > gl)
                {
                    visitante.Puntos += 3;
                }
                else
                {
                    local.Puntos += 1;
                    visitante.Puntos += 1;
                }
            }

            var ordenados = equipos.Values
                .OrderByDescending(x => x.Puntos)
                .ThenByDescending(x => x.Diferencia)
                .ThenByDescending(x => x.GolesFavor)
                .ToList();

            tablasPorGrupo[grupo.Key] = ordenados;

            clasificados.Add(ordenados[0]);
            clasificados.Add(ordenados[1]);

            if (ordenados.Count > 2)
            {
                terceros.Add(ordenados[2]);
            }
        }

        mejoresTerceros = terceros
            .OrderByDescending(x => x.Puntos)
            .ThenByDescending(x => x.Diferencia)
            .ThenByDescending(x => x.GolesFavor)
            .Take(8)
            .ToList();

        clasificados.AddRange(mejoresTerceros);

        for (int i = 0; i < clasificados.Count; i += 2)
        {
            if (i + 1 < clasificados.Count)
            {
                dieciseisavos.Add(new PartidoEliminacionDto
                    {
                        Local = clasificados[i].Nombre,
                        Visitante = clasificados[i + 1].Nombre
                    });
            }
        }
    }

    private void GenerarSemifinales()
    {
        semifinales.Clear();

        var ganadores = ObtenerGanadores(cuartos);

        for (int i = 0; i < ganadores.Count; i += 2)
        {
            if (i + 1 < ganadores.Count)
            {
                semifinales.Add(new PartidoEliminacionDto
                    {
                        Local = ganadores[i],
                        Visitante = ganadores[i + 1]
                    });
            }
        }
    }

    private void GenerarFinal()
    {
        final.Clear();
        tercerPuesto.Clear();

        var ganadores = new List<string>();
        var perdedores = new List<string>();

        foreach (var partido in semifinales)
        {
            string ganador;
            string perdedor;

            if (partido.GolesLocal > partido.GolesVisitante)
            {
                ganador = partido.Local;
                perdedor = partido.Visitante;
            }
            else if (partido.GolesVisitante > partido.GolesLocal)
            {
                ganador = partido.Visitante;
                perdedor = partido.Local;
            }
            else
            {
                ganador = partido.GanadorPenales!;
                perdedor = ganador == partido.Local
                    ? partido.Visitante
                    : partido.Local;
            }

            ganadores.Add(ganador);
            perdedores.Add(perdedor);
        }

        final.Add(new PartidoEliminacionDto
            {
                Local = ganadores[0],
                Visitante = ganadores[1]
            });

        tercerPuesto.Add(new PartidoEliminacionDto
            {
                Local = perdedores[0],
                Visitante = perdedores[1]
            });
    }

    private string ObtenerCampeon()
    {
        if (!final.Any())
            return "";

        var partido = final.First();

        if (partido.GolesLocal > partido.GolesVisitante)
            return partido.Local;

        if (partido.GolesVisitante > partido.GolesLocal)
            return partido.Visitante;

        return partido.GanadorPenales ?? "";
    }

    
