    private Dictionary<int, string> ObtenerGanadoresPorNumero(
        List<PartidoEliminacionDto> partidos,
        int primerNumero)
    {
        return partidos
            .Select((partido, index) => new
            {
                Numero = partido.NumeroPartido > 0
                    ? partido.NumeroPartido
                    : primerNumero + index,
                Ganador = ObtenerGanador(partido)
            })
            .ToDictionary(x => x.Numero, x => x.Ganador);
    }

    private List<string> ObtenerGanadores(
        List<PartidoEliminacionDto> partidos)
    {
        var ganadores = new List<string>();

        foreach (var partido in partidos)
        {
            ganadores.Add(ObtenerGanador(partido));
        }

        return ganadores;
    }

    private string ObtenerGanador(PartidoEliminacionDto partido)
    {
        if (partido.GolesLocal > partido.GolesVisitante)
            return partido.Local;

        if (partido.GolesVisitante > partido.GolesLocal)
            return partido.Visitante;

        return partido.GanadorPenales!;
    }

    protected override async Task OnInitializedAsync()
    {
        partidos = await Http.GetFromJsonAsync<List<SimuladorPartidoDto>>(
