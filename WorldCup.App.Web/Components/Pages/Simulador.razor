@page "/simulador"
@page "/simulador/{PollaId:int}"
@using WorldCup.App.Shared.DTOs
@inject HttpClient Http
@rendermode InteractiveServer

<h2 class="mb-4">🌎 Simulador Mundial</h2>

@if (partidos == null)
{
    <p>Cargando partidos...</p>
}
else
{
    var grupos = partidos
        .GroupBy(x => x.Grupo)
        .OrderBy(x => x.Key)
        .ToList();

    <div class="container-fluid">

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-end gap-3">
                <div>
                    <label class="form-label fw-bold">Simular fase de grupos por</label>
                    <select class="form-select"
                            style="min-width:230px"
                            value="@modoSimulador"
                            @onchange="CambiarModoSimulador">
                        <option value="marcadores">Marcadores</option>
                        <option value="posiciones">Posición en tabla</option>
                    </select>
                </div>

                <div class="text-muted small">
                    Por marcadores calcula la tabla automáticamente. Por posición te deja ordenar cada grupo manualmente.
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeSimulador))
        {
            <div class="alert @(simuladorConError ? "alert-danger" : "alert-success")">
                @mensajeSimulador
            </div>
        }

        @if (modoSimulador == "marcadores")
        {
            @for (int i = 0; i < grupos.Count; i += 2)
            {
                <div class="row mb-3">

                    @foreach (var grupo in grupos.Skip(i).Take(2))
                    {
                        <div class="col-lg-6">

                            <div class="card shadow-sm mb-3 border-0">

                                <div class="card-header bg-dark text-white fw-bold py-2">
                                    🏆 @grupo.Key
                                </div>

                                <div class="card-body p-2">

                                    @foreach (var partido in grupo)
                                    {
                                        <div class="border rounded p-2 mb-2 bg-light">

                                            <div class="row align-items-center text-center small">

                                                <div class="col-4 fw-bold">
                                                    @partido.Local
                                                </div>

                                                <div class="col-2">
                                                    <input type="number"
                                                           min="0"
                                                           class="form-control form-control-sm text-center"
                                                           @bind="partido.GolesLocal" />
                                                </div>

                                                <div class="col-1 fw-bold">
                                                    VS
                                                </div>

                                                <div class="col-2">
                                                    <input type="number"
                                                           min="0"
                                                           class="form-control form-control-sm text-center"
                                                           @bind="partido.GolesVisitante" />
                                                </div>

                                                <div class="col-3 fw-bold">
                                                    @partido.Visitante
                                                </div>

                                            </div>

                                            <div class="text-end mt-1">

                                                <button class="btn btn-success btn-sm py-0 px-2"
                                                        @onclick="() => GuardarPartido(partido)">
                                                    💾 Guardar
                                                </button>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
        }
        else
        {
            <div class="row">
                @foreach (var grupo in posicionesPorGrupo.OrderBy(x => x.Key))
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <strong>Grupo @grupo.Key</strong>

                                <label class="form-check text-white mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@gruposTerceroSimulador.Contains(grupo.Key)"
                                           disabled="@TerceroSimuladorBloqueado(grupo.Key)"
                                           @onchange="(_ => ToggleTerceroSimulador(grupo.Key))" />
                                    <span class="form-check-label">Mejor 3°</span>
                                </label>
                            </div>

                            <div class="card-body p-0">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="padding-left:15px">Equipo</th>
                                            <th style="width:120px">Posición</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var equipo in grupo.Value)
                                        {
                                            <tr>
                                                <td style="padding-left:15px">
                                                    <strong>@equipo.Equipo</strong>
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm"
                                                            style="width:76px"
                                                            @bind="equipo.Posicion">
                                                        <option value="1" disabled="@PosicionOcupadaSimulador(grupo.Value, 1, equipo)">1</option>
                                                        <option value="2" disabled="@PosicionOcupadaSimulador(grupo.Value, 2, equipo)">2</option>
                                                        <option value="3" disabled="@PosicionOcupadaSimulador(grupo.Value, 3, equipo)">3</option>
                                                        <option value="4" disabled="@PosicionOcupadaSimulador(grupo.Value, 4, equipo)">4</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="text-center mt-4 mb-5">

            <button class="btn btn-primary btn-lg"
                    @onclick="Simular16avos">
                ⚽ Simular 16avos
            </button>

        </div>

        @if (tablasPorGrupo.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    📊 Tabla de Posiciones
                </h3>

                <div class="row">

                    @foreach (var grupo in tablasPorGrupo.OrderBy(x => x.Key))
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow-sm border-0">

                                <div class="card-header bg-dark text-white fw-bold">
                                    🏆 @grupo.Key
                                </div>

                                <div class="card-body p-0">

                                    <table class="table table-sm table-striped mb-0">

                                        <thead class="table-dark">

                                            <tr>
                                                <th>#</th>
                                                <th>Equipo</th>
                                                <th>Pts</th>
                                                <th>GF</th>
                                                <th>GC</th>
                                                <th>DG</th>
                                            </tr>

                                        </thead>

                                        <tbody>

                                            @{
                                                int pos = 1;
                                            }

                                            @foreach (var equipo in grupo.Value)
                                            {
                                                string clase = "";

                                                if (pos <= 2)
                                                {
                                                    clase = "table-success";
                                                }
                                                else if (mejoresTerceros.Any(x =>
                                                x.Nombre == equipo.Nombre))
                                                {
                                                    clase = "table-warning";
                                                }
                                                else
                                                {
                                                    clase = "table-danger";
                                                }

                                                <tr class="@clase">

                                                    <td>@pos</td>

                                                    <td>@equipo.Nombre</td>

                                                    <td>
                                                        <strong>@equipo.Puntos</strong>
                                                    </td>

                                                    <td>@equipo.GolesFavor</td>

                                                    <td>@equipo.GolesContra</td>

                                                    <td>@equipo.Diferencia</td>

                                                </tr>

                                                pos++;
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }

        @if (mejoresTerceros.Any())
        {
            <div class="card shadow-sm mb-5 border-0">

                <div class="card-header bg-warning fw-bold">
                    ⭐ Mejores Terceros
                </div>

                <div class="card-body p-0">

                    <table class="table table-striped mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>#</th>
                                <th>Equipo</th>
                                <th>Grupo</th>
                                <th>Puntos</th>
                                <th>DG</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int pos = 1;
                            }

                            @foreach (var equipo in mejoresTerceros)
                            {
                                <tr>

                                    <td>@pos</td>

                                    <td>@equipo.Nombre</td>

                                    <td>@equipo.Grupo</td>

                                    <td>@equipo.Puntos</td>

                                    <td>@equipo.Diferencia</td>

                                </tr>

                                pos++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

        @* ========================= 16AVOS ========================= *@

        @if (dieciseisavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    ⚔️ Cruces 16avos
                </h3>

                <div class="row">

                    @foreach (var partido in dieciseisavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-dark text-white text-center fw-bold">
                                    ⚔️ Partido @partido.NumeroPartido
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            @if (string.IsNullOrWhiteSpace(partido.Visitante))
                                            {
                                                <select class="form-select form-select-sm mb-2"
                                                        @bind="partido.Visitante">

                                                    <option value="">
                                                        Mejor tercero
                                                    </option>

                                                    @foreach (var tercero in TercerosDisponiblesPara(partido))
                                                    {
                                                        <option value="@tercero.Nombre">
                                                            @tercero.Nombre (@tercero.Grupo)
                                                        </option>
                                                    }

                                                </select>
                                            }
                                            else
                                            {
                                                <div class="fw-bold mb-2">
                                                    @partido.Visitante
                                                </div>
                                            }

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                

                <div class="text-center mt-4">

                    <button class="btn btn-success btn-lg"
                            @onclick="GenerarOctavos">
                        ▶️ Generar Octavos
                    </button>

                </div>

            </div>
        }

        @* ========================= OCTAVOS ========================= *@

        @if (octavos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Octavos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in octavos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-success text-white text-center fw-bold">
                                    ⚔️ Octavos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2">

                                            <div class="fw-bold fs-5 mt-4">
                                                VS
                                            </div>

                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="form-label fw-bold">
                                                🥅 Ganador por penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center mt-4">

                    <button class="btn btn-warning btn-lg"
                            @onclick="GenerarCuartos">
                        ▶️ Generar Cuartos
                    </button>

                </div>

            </div>
        }

        @* ========================= CUARTOS ========================= *@

        @if (cuartos.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🏆 Cuartos de Final
                </h3>

                <div class="row">

                    @foreach (var partido in cuartos)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-header bg-primary text-white text-center fw-bold">
                                    ⚽ Cuartos
                                </div>

                                <div class="card-body">

                                    <div class="row align-items-center text-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-danger btn-lg"
                            @onclick="GenerarSemifinales">
                        ▶️ Generar Semifinales
                    </button>

                </div>

            </div>
        }

        @* ========================= SEMIFINALES ========================= *@

        @if (semifinales.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🔥 Semifinales
                </h3>

                <div class="row justify-content-center">

                    @foreach (var partido in semifinales)
                    {
                        <div class="col-lg-4 mb-4">

                            <div class="card shadow border-0">

                                <div class="card-header bg-danger text-white text-center fw-bold">
                                    🏆 Semifinal
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="text-center">

                    <button class="btn btn-dark btn-lg"
                            @onclick="GenerarFinal">
                        ▶️ Generar Final
                    </button>

                </div>

            </div>
        }

        @* ========================= TERCER PUESTO ========================= *@

        @if (tercerPuesto.Any())
        {
            <div class="mt-5">

                <h3 class="mb-4">
                    🥉 Tercer Puesto
                </h3>

                @foreach (var partido in tercerPuesto)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-5">

                            <div class="card shadow border-0">

                                <div class="card-header bg-warning text-dark text-center fw-bold">
                                    🥉 Tercer Lugar
                                </div>

                                <div class="card-body">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-5">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold mb-2">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-4">

                                            <label class="fw-bold">
                                                🥅 Penales
                                            </label>

                                            <select class="form-select"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione ganador
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

        @* ========================= FINAL ========================= *@

        @if (final.Any())
        {
            <div class="mt-5 mb-5">

                <h2 class="text-center mb-4">
                    🏆 GRAN FINAL
                </h2>

                @foreach (var partido in final)
                {
                    <div class="row justify-content-center">

                        <div class="col-lg-6">

                            <div class="card shadow-lg border-0">

                                <div class="card-header bg-success text-white text-center fw-bold fs-4">
                                    🌎 Final Mundial
                                </div>

                                <div class="card-body p-5">

                                    <div class="row text-center align-items-center">

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Local
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesLocal" />

                                        </div>

                                        <div class="col-2 fw-bold fs-2">
                                            VS
                                        </div>

                                        <div class="col-5">

                                            <div class="fw-bold fs-4 mb-3">
                                                @partido.Visitante
                                            </div>

                                            <input type="number"
                                                   min="0"
                                                   class="form-control form-control-lg text-center"
                                                   @bind="partido.GolesVisitante" />

                                        </div>

                                    </div>

                                    @if (partido.GolesLocal == partido.GolesVisitante)
                                    {
                                        <div class="mt-5">

                                            <label class="fw-bold fs-5">
                                                🥅 Campeón por penales
                                            </label>

                                            <select class="form-select form-select-lg"
                                                    @bind="partido.GanadorPenales">

                                                <option value="">
                                                    Seleccione campeón
                                                </option>

                                                <option value="@partido.Local">
                                                    @partido.Local
                                                </option>

                                                <option value="@partido.Visitante">
                                                    @partido.Visitante
                                                </option>

                                            </select>

                                        </div>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ObtenerCampeon()))
                {
                    <div class="text-center mt-5">

                        <div class="card shadow-lg border-0 bg-warning">

                            <div class="card-body p-5">

                                <h1 class="display-3">
                                    🏆
                                </h1>

                                <h1 class="fw-bold">
                                    CAMPEÓN MUNDIAL
                                </h1>

                                <h2 class="mt-3 text-dark">
                                    @ObtenerCampeon()
                                </h2>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
       

    </div>
}

@code {

    [Parameter]
    public int? PollaId { get; set; }

    private List<SimuladorPartidoDto>? partidos;

    private List<EquipoGrupoDto> clasificados = new();

    private List<EquipoGrupoDto> mejoresTerceros = new();

    private Dictionary<string, List<EquipoGrupoDto>> tablasPorGrupo = new();

    private string modoSimulador = "marcadores";
    private string? mensajeSimulador;
    private bool simuladorConError;
    private Dictionary<string, List<SimuladorEquipoPosicion>> posicionesPorGrupo = new();
    private HashSet<string> gruposTerceroSimulador = new(StringComparer.OrdinalIgnoreCase);

    private List<PartidoEliminacionDto> dieciseisavos = new();
    private List<PartidoEliminacionDto> octavos = new();
    private List<PartidoEliminacionDto> cuartos = new();
    private List<PartidoEliminacionDto> semifinales = new();
