        cuartos.Clear();
        semifinales.Clear();
        tercerPuesto.Clear();
        final.Clear();
    }

    private void CambiarPosicionSimulador(
        List<SimuladorEquipoPosicion> grupo,
        SimuladorEquipoPosicion equipo,
        ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var nuevaPosicion) ||
            nuevaPosicion < 1 ||
            nuevaPosicion > grupo.Count ||
            nuevaPosicion == equipo.Posicion)
        {
            return;
        }

        var posicionAnterior = equipo.Posicion;
        var equipoEnNuevaPosicion = grupo
            .FirstOrDefault(x => x != equipo && x.Posicion == nuevaPosicion);

        equipo.Posicion = nuevaPosicion;

        if (equipoEnNuevaPosicion != null)
        {
            equipoEnNuevaPosicion.Posicion = posicionAnterior;
        }

        LimpiarSimulacionDesdeGrupos();
        mensajeSimulador = null;
        simuladorConError = false;
    }

    private void ToggleTerceroSimulador(string grupo)
    {
        grupo = NormalizarGrupo(grupo);

        if (gruposTerceroSimulador.Contains(grupo))
        {
            gruposTerceroSimulador.Remove(grupo);
        }
        else if (gruposTerceroSimulador.Count < 8)
        {
            gruposTerceroSimulador.Add(grupo);
        }
    }

    private bool TerceroSimuladorBloqueado(string grupo)
    {
        grupo = NormalizarGrupo(grupo);
        return !gruposTerceroSimulador.Contains(grupo) &&
               gruposTerceroSimulador.Count >= 8;
    }

    private bool ConstruirTablasDesdePosiciones()
    {
        if (posicionesPorGrupo.Count == 0)
        {
            mensajeSimulador = "No hay grupos disponibles para simular por posiciones.";
            simuladorConError = true;
            return false;
        }

        if (gruposTerceroSimulador.Count != 8)
        {
            mensajeSimulador = "Debes marcar exactamente 8 grupos como mejores terceros.";
            simuladorConError = true;
            return false;
        }

        foreach (var grupo in posicionesPorGrupo)
        {
            if (grupo.Value.Select(e => e.Posicion).Distinct().Count() != grupo.Value.Count)
            {
                mensajeSimulador = $"El grupo {grupo.Key} tiene posiciones repetidas.";
                simuladorConError = true;
                return false;
            }
        }

        foreach (var grupo in posicionesPorGrupo.OrderBy(g => g.Key))
        {
            var tabla = grupo.Value
                .OrderBy(e => e.Posicion)
                .Select(e => new EquipoGrupoDto
                {
                    Nombre = e.Equipo,
                    Grupo = grupo.Key,
                    Puntos = PuntosSimuladosPorPosicion(e.Posicion),
                    GolesFavor = 0,
                    GolesContra = 0
                })
                .ToList();

            tablasPorGrupo[grupo.Key] = tabla;
            clasificados.Add(tabla[0]);
            clasificados.Add(tabla[1]);

            if (gruposTerceroSimulador.Contains(grupo.Key))
            {
                mejoresTerceros.Add(tabla[2]);
            }
        }

        mensajeSimulador = null;
        simuladorConError = false;
        return true;
    }

    private static int PuntosSimuladosPorPosicion(int posicion)
    {
        return posicion switch
        {
            1 => 9,
            2 => 6,
            3 => 3,
            _ => 0
        };
    }

    private IEnumerable<EquipoGrupoDto> TercerosDisponiblesPara(
        PartidoEliminacionDto partido)
    {
        var gruposPermitidos = partido.GruposTerceroPermitidos
            .Select(NormalizarGrupo)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return mejoresTerceros
            .Where(t => gruposPermitidos.Contains(NormalizarGrupo(t.Grupo)))
            .Where(t =>
                partido.Visitante == t.Nombre ||
                !dieciseisavos.Any(d =>
                    d != partido &&
                    string.Equals(d.Visitante, t.Nombre, StringComparison.OrdinalIgnoreCase)));
    }

    private static string NormalizarGrupo(string grupo)
    {
        return grupo.Replace("Grupo", "", StringComparison.OrdinalIgnoreCase)
            .Trim()
            .ToUpperInvariant();
    }

    private void GenerarSemifinales()
    {
        semifinales.Clear();

        var ganadores = ObtenerGanadores(cuartos);

        for (int i = 0; i < ganadores.Count; i += 2)
        {
            if (i + 1 < ganadores.Count)
            {
                semifinales.Add(new PartidoEliminacionDto
                    {
                        NumeroPartido = 101 + (i / 2),
                        Local = ganadores[i],
                        Visitante = ganadores[i + 1]
                    });
            }
        }
    }

    private void GenerarFinal()
    {
        final.Clear();
        tercerPuesto.Clear();

        var ganadores = new List<string>();
        var perdedores = new List<string>();

        foreach (var partido in semifinales)
        {
            string ganador;
            string perdedor;

            if (partido.GolesLocal > partido.GolesVisitante)
            {
                ganador = partido.Local;
                perdedor = partido.Visitante;
            }
            else if (partido.GolesVisitante > partido.GolesLocal)
            {
                ganador = partido.Visitante;
                perdedor = partido.Local;
            }
            else
            {
                ganador = partido.GanadorPenales!;
                perdedor = ganador == partido.Local
                    ? partido.Visitante
                    : partido.Local;
            }

            ganadores.Add(ganador);
            perdedores.Add(perdedor);
        }

        final.Add(new PartidoEliminacionDto
            {
                NumeroPartido = 104,
                Local = ganadores[0],
                Visitante = ganadores[1]
            });

        tercerPuesto.Add(new PartidoEliminacionDto
            {
                NumeroPartido = 103,
                Local = perdedores[0],
                Visitante = perdedores[1]
            });
    }

    private string ObtenerCampeon()
    {
        if (!final.Any())
            return "";

        var partido = final.First();

        if (partido.GolesLocal > partido.GolesVisitante)
            return partido.Local;

        if (partido.GolesVisitante > partido.GolesLocal)
            return partido.Visitante;

        return partido.GanadorPenales ?? "";
    }

    private class SimuladorEquipoPosicion
    {
        public string Grupo { get; set; } = "";
        public string Equipo { get; set; } = "";
        public int Posicion { get; set; }
    }

    
