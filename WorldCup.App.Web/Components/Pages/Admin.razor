    private void AbrirAlertaContactoCupos(SolicitudCuposAdminDto solicitud)
    {
        var saludo = string.IsNullOrWhiteSpace(PrimerNombre(solicitud.UsuarioNombre))
            ? "Hola,"
            : $"Hola {PrimerNombre(solicitud.UsuarioNombre)},";

        solicitudContactoSeleccionada = solicitud;
        mensajeContactoCupos =
            $"{saludo} estamos revisando tu solicitud para ampliar la polla a {solicitud.CantidadUsuariosSolicitada} usuarios, pero no hemos podido contactarte con el celular registrado ({solicitud.Celular}). Por favor responde el correo que te enviamos o escríbenos con un número de WhatsApp válido para poder atender tu solicitud y coordinar la habilitación de cupos.";
    }

    private void CerrarAlertaContactoCupos()
    {
        if (enviandoAlertaContacto)
            return;

        solicitudContactoSeleccionada = null;
        mensajeContactoCupos = "";
    }

    private async Task EnviarAlertaContactoCupos()
    {
        if (!Sesion.UsuarioId.HasValue || solicitudContactoSeleccionada == null)
            return;

        if (string.IsNullOrWhiteSpace(mensajeContactoCupos) || mensajeContactoCupos.Trim().Length < 10)
        {
            mensaje = "Escribe un mensaje claro antes de enviar la alerta.";
            return;
        }

        try
        {
            enviandoAlertaContacto = true;
            procesandoSolicitudCupos = solicitudContactoSeleccionada.Id;

            var response = await Http.PostAsJsonAsync(
                $"api/Admin/cupos/solicitudes/{solicitudContactoSeleccionada.Id}/alerta-contacto",
                new AdminEnviarAlertaContactoCuposRequestDto
                {
                    AdminUsuarioId = Sesion.UsuarioId.Value,
                    Mensaje = mensajeContactoCupos.Trim()
                });

            mensaje = await LeerMensajeRespuesta(response);

            if (response.IsSuccessStatusCode)
            {
                solicitudContactoSeleccionada = null;
                mensajeContactoCupos = "";
                await CargarPanel();
            }
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo enviar la alerta: {ex.Message}";
        }
        finally
        {
            enviandoAlertaContacto = false;
            procesandoSolicitudCupos = null;
        }
    }

