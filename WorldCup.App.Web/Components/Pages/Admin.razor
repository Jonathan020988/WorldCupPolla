@page "/admin"
@rendermode InteractiveServer
@inject HttpClient Http
@inject WorldCup.App.Shared.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h2 class="mb-4 admin-title">Panel administrador</h2>

@if (cargando)
{
    <p>Cargando panel...</p>
}
else if (!Sesion.EsAdmin)
{
    <div class="alert alert-danger">
        No tienes permisos para entrar al panel administrador.
    </div>
}
else
{
    <section class="admin-page" id="admin-inicio">
    <div class="row g-3 mb-4 admin-summary">
        <div class="col-md-3">
            <div class="card admin-stat-card">
                <div class="card-body">
                    <small class="text-muted">Usuarios</small>
                    <h3>@resumen?.Usuarios</h3>
                    <small class="text-muted">@resumen?.UsuariosActivos activos / @resumen?.UsuariosInactivos inactivos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card">
                <div class="card-body">
                    <small class="text-muted">Pollas</small>
                    <h3>@resumen?.Pollas</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card">
                <div class="card-body">
                    <small class="text-muted">Finalizados</small>
                    <h3>@resumen?.PartidosFinalizados</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card admin-stat-card">
                <div class="card-body">
                    <small class="text-muted">Pendientes</small>
                    <h3>@resumen?.PartidosPendientes</h3>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info">@mensaje</div>
    }

    <nav class="admin-quick-nav" aria-label="Accesos rapidos del panel administrador">
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-alerta-masiva")'>Alerta masiva</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-cupos")'>Solicitudes cupos</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-fases")'>Fases torneo</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-calendario")'>Calendario</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-usuarios")'>Usuarios</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-pollas")'>Predicciones</button>
        <button type="button" class="admin-quick-link" @onclick='() => ScrollAdminSection("admin-pollas")'>Pollas</button>
    </nav>

    <div class="card mb-4">
        <div class="card-header fw-bold">Prueba de correo SMTP</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Correo destino</label>
                    <input class="form-control"
                           placeholder="correo@ejemplo.com"
                           @bind="correoPrueba" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary w-100"
                            @onclick="EnviarCorreoPrueba">
                        Enviar prueba
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 admin-anchor alert-mass-card" id="admin-alerta-masiva">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Alerta masiva de pendientes</span>
            <small class="text-muted">Solo se envia a usuarios activos con ese dato pendiente</small>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(alertaMasivaMensaje))
            {
                <div class="alert @(alertaMasivaError ? "alert-danger" : "alert-success")">
                    @alertaMasivaMensaje
                </div>
            }

            <div class="mass-alert-grid">
                <div>
                    <label class="form-label">Polla</label>
                    <select class="form-select" @bind="alertaMasiva.PollaId">
                        <option value="">Todas las pollas</option>
                        @foreach (var polla in pollas)
                        {
                            <option value="@polla.Id">@polla.Nombre</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label">Pendiente</label>
                    <select class="form-select" @bind="alertaMasiva.TipoAlerta">
                        <option value="Todo">Cualquier pendiente</option>
                        <option value="Marcadores">Marcadores</option>
                        <option value="Clasificacion">Clasificacion de grupos</option>
                        <option value="Terceros">Mejores terceros</option>
                        <option value="Podio">Podio</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Fase de marcadores</label>
                    <select class="form-select"
                            disabled="@(alertaMasiva.TipoAlerta != "Marcadores")"
                            @bind="alertaMasiva.FaseMarcadores">
                        <option value="">Todas las fases</option>
                        @foreach (var fase in fasesCalendario)
                        {
                            <option value="@fase">@NombreFase(fase)</option>
                        }
                    </select>
                </div>

                <div class="mass-alert-match">
                    <label class="form-label">Partido especifico</label>
                    <select class="form-select"
                            disabled="@(alertaMasiva.TipoAlerta != "Marcadores")"
                            @bind="alertaMasivaPartidoId">
                        <option value="">No filtrar por partido</option>
                        @foreach (var partido in PartidosAlertaMasiva)
                        {
                            <option value="@partido.Id">
                                @partido.Fecha.ToString("dd/MM HH:mm") - @partido.Local vs @partido.Visitante
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="mass-alert-footer">
                <label class="form-check mass-alert-check">
                    <input class="form-check-input" type="checkbox" @bind="alertaMasiva.EnviarCorreo" />
                    <span class="form-check-label">Enviar tambien correo electronico</span>
                </label>

                <button type="button"
                        class="btn btn-primary"
                        disabled="@enviandoAlertaMasiva"
                        @onclick="EnviarAlertaMasiva">
                    @(enviandoAlertaMasiva ? "Enviando..." : "Enviar alerta masiva")
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-4 admin-anchor" id="admin-cupos">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Solicitudes de ampliación de cupos</span>
            <small class="text-muted">@solicitudesCupos.Count solicitud(es)</small>
        </div>
        <div class="card-body p-0">
            @if (!solicitudesCupos.Any())
            {
                <div class="alert alert-light mb-0">
                    No hay solicitudes de ampliación por ahora.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle admin-mobile-table cupos-table">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Celular</th>
                                <th>Plan</th>
                                <th>Estado</th>
                                <th>Código</th>
                                <th class="text-end">Permitir hasta</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in solicitudesCupos)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@solicitud.UsuarioNombre</div>
                                        <small class="text-muted">@solicitud.UsuarioEmail</small>
                                    </td>
                                    <td>@solicitud.Celular</td>
                                    <td>
                                        <div>@solicitud.CantidadUsuariosSolicitada usuarios</div>
                                        <small class="text-muted">@solicitud.PlanNombre - @FormatoPrecio(solicitud.ValorPlan)</small>
                                    </td>
                                    <td>
                                        <span class="badge @ClaseEstadoSolicitudCupos(solicitud.Estado)">
                                            @solicitud.Estado
                                        </span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(solicitud.CodigoHabilitacion))
                                        {
                                            <span class="text-muted">Sin código</span>
                                        }
                                        else
                                        {
                                            <code>@solicitud.CodigoHabilitacion</code>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <input type="number"
                                               class="form-control form-control-sm text-end"
                                               min="6"
                                               style="width:110px; margin-left:auto"
                                               @bind="solicitud.MaximoMiembrosAutorizado" />
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-success"
                                                disabled="@(procesandoSolicitudCupos == solicitud.Id)"
                                                @onclick="() => GenerarCodigoCupos(solicitud)">
                                            Generar código
                                        </button>
                                         @if (solicitud.Estado != "Rechazada" && solicitud.Estado != "Habilitada")
                                         {
                                             <button class="btn btn-sm btn-outline-danger ms-1"
                                                     disabled="@(procesandoSolicitudCupos == solicitud.Id)"
                                                     @onclick="() => RechazarSolicitudCupos(solicitud)">
                                                 Rechazar
                                             </button>
                                         }
                                         <button class="btn btn-sm btn-outline-primary ms-1"
                                                 disabled="@(procesandoSolicitudCupos == solicitud.Id)"
                                                 @onclick="() => AbrirAlertaContactoCupos(solicitud)">
                                             Pedir info
                                         </button>
                                         <button class="btn btn-sm btn-outline-secondary ms-1"
                                                 disabled="@(procesandoSolicitudCupos == solicitud.Id)"
                                                 @onclick="() => EliminarSolicitudCupos(solicitud)">
                                             Eliminar
                                         </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (solicitudContactoSeleccionada != null)
    {
        <div class="admin-contact-backdrop" role="dialog" aria-modal="true" aria-labelledby="contactAlertTitle">
            <div class="admin-contact-modal">
                <div class="admin-contact-accent"></div>
                <div class="admin-contact-body">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <span class="admin-contact-kicker">Mensaje para el usuario</span>
                            <h5 id="contactAlertTitle" class="mb-1">Solicitar información de contacto</h5>
                            <p class="text-muted mb-0">
                                @solicitudContactoSeleccionada.UsuarioNombre - @solicitudContactoSeleccionada.UsuarioEmail
                            </p>
                        </div>
                        <button type="button"
                                class="btn-close"
                                aria-label="Cerrar"
                                disabled="@enviandoAlertaContacto"
                                @onclick="CerrarAlertaContactoCupos"></button>
                    </div>

                    <div class="admin-contact-summary mt-3">
                        <span>Celular registrado: <strong>@solicitudContactoSeleccionada.Celular</strong></span>
                        <span>Solicitud: <strong>@solicitudContactoSeleccionada.CantidadUsuariosSolicitada usuarios</strong></span>
                        <span>Plan: <strong>@solicitudContactoSeleccionada.PlanNombre</strong></span>
                    </div>

                    <label class="form-label mt-3">Mensaje que verá al iniciar sesión</label>
                    <textarea class="form-control"
                              rows="5"
                              maxlength="1000"
                              @bind="mensajeContactoCupos"></textarea>
                    <small class="text-muted">
                        Se mostrará como ventana emergente y también quedará en notificaciones.
                    </small>

                    <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">
                        <button class="btn btn-outline-secondary"
                                disabled="@enviandoAlertaContacto"
                                @onclick="CerrarAlertaContactoCupos">
                            Cancelar
                        </button>
                        <button class="btn btn-primary"
                                disabled="@enviandoAlertaContacto"
                                @onclick="EnviarAlertaContactoCupos">
                            @(enviandoAlertaContacto ? "Enviando..." : "Enviar alerta")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4 phase-control admin-anchor" id="admin-fases">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Control del torneo por fases</span>
            <small class="text-muted">Finaliza, genera la siguiente fase o reinicia para pruebas</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle admin-mobile-table phase-table">
                    <thead>
                        <tr>
                            <th>Fase</th>
                            <th class="text-center">Partidos</th>
                            <th class="text-center">Finalizados</th>
                            <th class="text-center">Faltan marcador</th>
                            <th class="text-center">Siguiente fase</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fase in fasesAdmin)
                        {
                            <tr>
                                <td class="fw-semibold">@NombreFase(fase.Fase)</td>
                                <td class="text-center">@fase.TotalPartidos</td>
                                <td class="text-center">
                                    <span class="badge @(fase.Pendientes == 0 && fase.TotalPartidos > 0 ? "bg-success" : "bg-secondary")">
                                        @fase.Finalizados / @fase.TotalPartidos
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (fase.PenalesInvalidos > 0)
                                    {
                                        <span class="badge bg-danger">@fase.PenalesInvalidos penales</span>
                                    }
                                    else if (fase.FaltanMarcador > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@fase.FaltanMarcador</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (string.IsNullOrWhiteSpace(fase.SiguienteFase))
                                    {
                                        <span class="text-muted">No aplica</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(fase.SiguienteGenerada ? "bg-success" : "bg-light text-dark")">
                                            @(fase.SiguienteGenerada ? "Generada" : "Pendiente")
                                        </span>
                                        <small class="text-muted ms-1">@fase.SiguienteFase</small>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success me-1"
                                            disabled="@(!fase.PuedeFinalizar || procesandoFase == fase.Fase)"
                                            @onclick="() => FinalizarFase(fase)">
                                        Finalizar fase
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(!fase.PuedeReiniciar || procesandoFase == fase.Fase)"
                                            @onclick="() => ReiniciarFase(fase)">
                                        Reiniciar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-4 calendario-admin admin-anchor" id="admin-calendario">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Calendario de partidos</span>
            <small class="text-muted">Fechas y horas en Colombia</small>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Filtrar fase</label>
                    <select class="form-select"
                            value="@faseCalendario"
                            @onchange="CambiarFaseCalendario">
                        <option value="">Todas</option>
                        @foreach (var fase in fasesCalendario)
                        {
                            <option value="@fase">@NombreFase(fase)</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <small class="text-muted">
                        Usa este control para ajustar horarios oficiales, partidos generados o cambios de sede/fecha.
                    </small>
                </div>
            </div>

            @if (!partidosCalendarioVista.Any())
            {
                <div class="alert alert-light mb-0">
                    No hay partidos para esta fase.
                </div>
            }
            else
            {
                <div class="table-responsive calendario-scroll">
                    <table class="table table-sm align-middle mb-0 admin-mobile-table calendar-table">
                        <thead>
                            <tr>
                                <th>Fase</th>
                                <th>Partido</th>
                                <th>Fecha y hora Colombia</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var partido in partidosCalendarioVista)
                            {
                                <tr>
                                    <td>@NombreFase(partido.Fase)</td>
                                    <td class="fw-semibold">@partido.Local vs @partido.Visitante</td>
                                    <td>
                                        <input type="datetime-local"
                                               class="form-control form-control-sm calendario-fecha"
                                               @bind="partido.Fecha"
                                               @bind:format="yyyy-MM-ddTHH:mm" />
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@partido.Estado</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(procesandoPartidoFecha == partido.Id)"
                                                @onclick="() => GuardarFechaPartido(partido)">
                                            Guardar fecha
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card usuarios-admin admin-anchor" id="admin-usuarios">
                <div class="card-header fw-bold d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span>Usuarios</span>
                    <div class="btn-group btn-group-sm usuarios-filtro" role="group" aria-label="Filtro de usuarios">
                        <button type="button"
                                class="@ClaseFiltroUsuarios("Activos")"
                                @onclick='() => CambiarFiltroUsuarios("Activos")'>
                            Activos (@TotalUsuariosActivos)
                        </button>
                        <button type="button"
                                class="@ClaseFiltroUsuarios("Inactivos")"
                                @onclick='() => CambiarFiltroUsuarios("Inactivos")'>
                            Inactivos (@TotalUsuariosInactivos)
                        </button>
                        <button type="button"
                                class="@ClaseFiltroUsuarios("Todos")"
                                @onclick='() => CambiarFiltroUsuarios("Todos")'>
                            Todos (@usuarios.Count)
                        </button>
                    </div>
                </div>
                <div class="user-progress-toolbar">
                    <span>Avance de juego</span>
                    <div class="btn-group btn-group-sm usuarios-filtro-avance" role="group" aria-label="Filtro de avance de usuarios">
                        <button type="button"
                                class="@ClaseFiltroAvanceUsuarios("Todos")"
                                @onclick='() => CambiarFiltroAvanceUsuarios("Todos")'>
                            Todos (@UsuariosPorEstado.Count())
                        </button>
                        <button type="button"
                                class="@ClaseFiltroAvanceUsuarios("Limpio")"
                                @onclick='() => CambiarFiltroAvanceUsuarios("Limpio")'>
                            Limpios (@TotalUsuariosLimpios)
                        </button>
                        <button type="button"
                                class="@ClaseFiltroAvanceUsuarios("Algunos")"
                                @onclick='() => CambiarFiltroAvanceUsuarios("Algunos")'>
                            En proceso (@TotalUsuariosConAlgunosRegistros)
                        </button>
                        <button type="button"
                                class="@ClaseFiltroAvanceUsuarios("Lleno")"
                                @onclick='() => CambiarFiltroAvanceUsuarios("Lleno")'>
                            Llenos (@TotalUsuariosLlenos)
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle admin-mobile-table users-table">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Email</th>
                                <th>Estado</th>
                                <th class="text-end">Pollas</th>
                                <th>Avance</th>
                                <th class="text-end">Historial</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!UsuariosFiltrados.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        No hay usuarios en este filtro.
                                    </td>
                                </tr>
                            }

                            @foreach (var usuario in UsuariosFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@usuario.Nombre</div>
                                        @if (usuario.PollasCreadas > 0)
                                        {
                                            <small class="text-muted">Creador de @usuario.PollasCreadas polla(s)</small>
                                        }
                                    </td>
                                    <td>@usuario.Email</td>
                                    <td>
                                        <span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">
                                            @(usuario.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">@usuario.Pollas</td>
                                    <td>
                                        <span class="progress-status @ClaseEstadoRegistros(usuario.EstadoRegistros)">
                                            @TextoEstadoRegistros(usuario.EstadoRegistros)
                                        </span>
                                        <small class="progress-detail">
                                            @DetalleEstadoRegistros(usuario)
                                        </small>
                                    </td>
                                    <td class="text-end">
                                        @if (usuario.Historial > 0)
                                        {
                                            <button type="button"
                                                    class="historial-badge"
                                                    title="Ver registros guardados y faltantes"
                                                    @onclick="() => CargarHistorialUsuario(usuario)">
                                                @usuario.Historial registro(s)
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="historial-empty"
                                                    title="Ver registros faltantes"
                                                    @onclick="() => CargarHistorialUsuario(usuario)">
                                                Limpio
                                            </button>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm @(usuario.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                                @onclick="() => CambiarEstadoUsuario(usuario.Id, usuario.Nombre, !usuario.Activo)">
                                            @(usuario.Activo ? "Inactivar" : "Activar")
                                        </button>
                                        @if (!usuario.Activo)
                                        {
                                            @if (usuario.Historial > 0)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary ms-1"
                                                        disabled="@(!PuedeLimpiarHistorialUsuario(usuario))"
                                                        title="@TextoLimpiezaHistorial(usuario)"
                                                        @onclick="() => LimpiarHistorialUsuario(usuario)">
                                                    Limpiar registros
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger ms-1"
                                                    disabled="@(!usuario.PuedeEliminar)"
                                                    title="@TextoUsuarioNoEliminable(usuario)"
                                                    @onclick="() => EliminarUsuario(usuario)">
                                                Eliminar
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card admin-anchor" id="admin-pollas">
            <div class="card-header fw-bold">Pollas y predicciones</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle admin-mobile-table pollas-table">
                        <thead>
                            <tr>
                                <th>Polla</th>
                                <th>Creador</th>
                                <th class="text-end">Miembros</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var polla in pollas)
                            {
                                <tr>
                                    <td>@polla.Nombre</td>
                                    <td>@polla.Creador</td>
                                    <td class="text-end">
                                        @polla.Miembros
                                        @if (polla.MiembrosInactivos > 0)
                                        {
                                            <small class="text-muted">(+@polla.MiembrosInactivos inact.)</small>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => CargarMiembros(polla)">
                                            Ver
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => EliminarPolla(polla)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (pollaSeleccionada != null)
    {
        <div class="card mt-4">
            <div class="card-header fw-bold">
                Miembros de @pollaSeleccionada.Nombre
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle admin-mobile-table members-table">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var miembro in miembros)
                        {
                            <tr>
                                <td>@miembro.Nombre</td>
                                <td>@miembro.Email</td>
                                <td>
                                    <span class="badge @(miembro.Activo ? "bg-success" : "bg-secondary")">
                                        @(miembro.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => CargarPredicciones(miembro)">
                                        Predicciones
                                    </button>
                                    <button class="btn btn-sm @(miembro.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                            @onclick="() => CambiarEstadoUsuario(miembro.UsuarioId, miembro.Nombre, !miembro.Activo)">
                                        @(miembro.Activo ? "Inactivar" : "Activar")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (usuarioPredicciones != null)
    {
        <div class="card mt-4">
            <div class="card-header fw-bold">
                Predicciones de @usuarioPredicciones.Nombre
            </div>
            <div class="card-body p-0">
                <div class="reopen-panel p-3 border-bottom">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Fase para habilitar</label>
                            <select class="form-select form-select-sm" @bind="faseReapertura">
                                @foreach (var fase in fasesCalendario)
                                {
                                    <option value="@fase">@NombreFase(fase)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Reapertura controlada</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        disabled="@(procesandoReapertura != null)"
                                        @onclick="HabilitarMarcadores">
                                    Habilitar marcadores
                                </button>

                                @if (faseReapertura == "Grupos")
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            disabled="@(procesandoReapertura != null)"
                                            @onclick="HabilitarClasificacion">
                                        Habilitar clasificación
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-warning"
                                        disabled="@(procesandoReapertura != null)"
                                        @onclick="HabilitarPodio">
                                    Habilitar podio
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (reaperturasUsuario.Any())
                    {
                        <div class="active-reopens mt-3">
                            <small class="text-muted d-block mb-2">Permisos activos para este usuario</small>
                            @foreach (var reapertura in reaperturasUsuario)
                            {
                                <span class="reopen-chip">
                                    @EtiquetaReapertura(reapertura)
                                    <button type="button"
                                            disabled="@(procesandoReapertura != null)"
                                            @onclick="() => CambiarReapertura(reapertura.Fase, reapertura.Tipo, false)">
                                        cerrar
                                    </button>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <small class="text-muted d-block mt-2">
                            Sin reaperturas activas. El usuario sigue sujeto a los bloqueos normales.
                        </small>
                    }
                </div>

                <div class="admin-prediction-extra p-3 border-bottom">
                    <div class="admin-extra-card">
                        <div class="admin-extra-head">
                            <span>Clasificación de grupos</span>
                            <strong>@clasificacionPrediccionesUsuario.Count / 12</strong>
                        </div>
                        @if (!clasificacionPrediccionesUsuario.Any())
                        {
                            <small class="text-muted">Sin clasificación guardada.</small>
                        }
                        else
                        {
                            <div class="admin-group-picks">
                                @foreach (var grupo in clasificacionPrediccionesUsuario)
                                {
                                    <div>
                                        <strong>Grupo @grupo.Grupo</strong>
                                        <span>1. @grupo.Primero</span>
                                        <span>2. @grupo.Segundo</span>
                                        <span>3. @grupo.Tercero</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="admin-extra-card">
                        <div class="admin-extra-head">
                            <span>Mejores terceros</span>
                            <strong>@tercerosPrediccionesUsuario.Count / 8</strong>
                        </div>
                        <p class="mb-0">
                            @(tercerosPrediccionesUsuario.Any()
                                ? string.Join(", ", tercerosPrediccionesUsuario.Select(g => $"Grupo {g}"))
                                : "Sin mejores terceros seleccionados.")
                        </p>
                    </div>

                    <div class="admin-extra-card">
                        <div class="admin-extra-head">
                            <span>Podio</span>
                            <strong>@(podioPrediccionesUsuario?.Guardado == true ? "Guardado" : "Pendiente")</strong>
                        </div>
                        @if (podioPrediccionesUsuario?.Guardado == true)
                        {
                            <div class="admin-podium-picks">
                                <span>Campeón: <strong>@podioPrediccionesUsuario.Campeon</strong></span>
                                <span>Subcampeón: <strong>@podioPrediccionesUsuario.Subcampeon</strong></span>
                                <span>Tercero: <strong>@podioPrediccionesUsuario.Tercero</strong></span>
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">Sin podio guardado.</small>
                        }
                    </div>
                </div>

                <table class="table table-sm mb-0 align-middle admin-mobile-table predictions-table">
                    <thead>
                        <tr>
                            <th>Partido</th>
                            <th>Pronóstico</th>
                            <th>Resultado real</th>
                            <th>Puntos</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prediccion in prediccionesUsuario)
                        {
                            <tr>
                                <td>@prediccion.Partido</td>
                                <td>
                                    <input class="form-control form-control-sm d-inline-block marcador-admin"
                                           type="number"
                                           min="0"
                                           @bind="prediccion.GolesLocal" />
                                    -
                                    <input class="form-control form-control-sm d-inline-block marcador-admin"
                                           type="number"
                                           min="0"
                                           @bind="prediccion.GolesVisitante" />
                                </td>
                                <td>@prediccion.ResultadoLocal - @prediccion.ResultadoVisitante</td>
                                <td>@prediccion.PuntosTotales</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => GuardarPrediccion(prediccion)">
                                        Guardar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (historialUsuario != null || cargandoHistorial)
    {
        <div class="admin-modal-backdrop">
            <div class="admin-modal historial-modal">
                <div class="admin-modal-header">
                    <div>
                        <span class="modal-kicker">Historial de registros</span>
                        <h4>@(historialUsuario?.Usuario ?? "Cargando...")</h4>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarHistorial"></button>
                </div>

                @if (!string.IsNullOrWhiteSpace(alertaHistorialMensaje))
                {
                    <div class="alert @(alertaHistorialError ? "alert-danger" : "alert-success") m-3 mb-0">
                        @alertaHistorialMensaje
                    </div>
                }

                @if (cargandoHistorial)
                {
                    <div class="p-4 text-muted">
                        Cargando registros del usuario...
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(errorHistorial))
                {
                    <div class="alert alert-danger m-3">@errorHistorial</div>
                }
                else if (historialUsuario == null || (!historialUsuario.Pollas.Any() && !historialUsuario.Alertas.Any()))
                {
                    <div class="empty-history">
                        Este usuario no pertenece a ninguna polla y no tiene registros asociados.
                    </div>
                }
                else
                {
                    <div class="historial-content">
                        <section class="historial-alerts-panel">
                            <div class="historial-alerts-header">
                                <div>
                                    <strong>Alertas enviadas</strong>
                                    <small>
                                        @historialUsuario.Alertas.Count alerta(s) registradas /
                                        @historialUsuario.Alertas.Count(a => a.Estado == "Pendiente") pendiente(s)
                                    </small>
                                </div>
                            </div>

                            @if (historialUsuario.Alertas.Any())
                            {
                                <div class="alert-history-list">
                                    @foreach (var alerta in historialUsuario.Alertas.Take(12))
                                    {
                                        <article class="alert-history-item">
                                            <div class="alert-history-top">
                                                <div>
                                                    <strong>@TipoAlertaHistorial(alerta.TipoDestino)</strong>
                                                    <small>
                                                        @(string.IsNullOrWhiteSpace(alerta.PollaNombre) ? "Sin polla" : alerta.PollaNombre)
                                                        - @alerta.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                                    </small>
                                                </div>
                                                <span class="mini-status @EstadoAlertaClase(alerta.Estado)">
                                                    @alerta.Estado
                                                </span>
                                            </div>
                                            <p>@alerta.Mensaje</p>
                                        </article>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert-history-empty">
                                    Todavia no se han enviado alertas a este usuario.
                                </div>
                            }
                        </section>

                        @foreach (var polla in historialUsuario.Pollas)
                        {
                            <section class="historial-polla">
                                <div class="historial-polla-header">
                                    <div>
                                        <strong>@polla.PollaNombre</strong>
                                        <small>@polla.Resumen.TotalGuardado guardados / @polla.Resumen.TotalFaltante faltantes</small>
                                    </div>
                                    <div class="historial-polla-actions">
                                        <span class="checklist-pill @(polla.Resumen.TotalFaltante == 0 ? "complete" : "pending")">
                                            @(polla.Resumen.TotalFaltante == 0 ? "Completo" : "Pendiente")
                                        </span>
                                        @if (polla.Resumen.TotalFaltante > 0)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary alert-send-btn"
                                                    disabled="@ProcesandoAlerta"
                                                    @onclick='() => EnviarAlertaPendientes(polla, "Todo")'>
                                                @(AlertaEnProceso(polla.PollaId, "Todo") ? "Enviando..." : "Alertar todo")
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="historial-summary-grid">
                                    <div>
                                        <span>Marcadores</span>
                                        <strong>@polla.Resumen.MarcadoresGuardados / @(polla.Resumen.MarcadoresGuardados + polla.Resumen.MarcadoresFaltantes)</strong>
                                    </div>
                                    <div>
                                        <span>Grupos</span>
                                        <strong>@polla.Resumen.GruposGuardados / 12</strong>
                                    </div>
                                    <div>
                                        <span>Mejores terceros</span>
                                        <strong>@polla.Resumen.TercerosSeleccionados / 8</strong>
                                    </div>
                                    <div>
                                        <span>Podio</span>
                                        <strong>@(polla.Resumen.PodioGuardado ? "Guardado" : "Falta")</strong>
                                    </div>
                                </div>

                                @if (polla.Resumen.TotalFaltante > 0)
                                {
                                    <div class="alert-category-actions">
                                        <span>Alerta especifica</span>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                disabled="@(ProcesandoAlerta || polla.Resumen.MarcadoresFaltantes == 0)"
                                                @onclick='() => EnviarAlertaPendientes(polla, "Marcadores")'>
                                            @(AlertaEnProceso(polla.PollaId, "Marcadores") ? "Enviando..." : $"Marcadores ({polla.Resumen.MarcadoresFaltantes})")
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                disabled="@(ProcesandoAlerta || polla.Resumen.GruposFaltantes == 0)"
                                                @onclick='() => EnviarAlertaPendientes(polla, "Clasificacion")'>
                                            @(AlertaEnProceso(polla.PollaId, "Clasificacion") ? "Enviando..." : $"Clasificacion ({polla.Resumen.GruposFaltantes})")
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                disabled="@(ProcesandoAlerta || polla.Resumen.TercerosFaltantes == 0)"
                                                @onclick='() => EnviarAlertaPendientes(polla, "Terceros")'>
                                            @(AlertaEnProceso(polla.PollaId, "Terceros") ? "Enviando..." : $"Terceros ({polla.Resumen.TercerosFaltantes})")
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                disabled="@(ProcesandoAlerta || polla.Resumen.PodioGuardado)"
                                                @onclick='() => EnviarAlertaPendientes(polla, "Podio")'>
                                            @(AlertaEnProceso(polla.PollaId, "Podio") ? "Enviando..." : "Podio")
                                        </button>
                                    </div>
                                }

                                <div class="historial-section">
                                    <h5>Clasificacion de grupos</h5>
                                    <div class="chips">
                                        @if (polla.Clasificacion.Faltantes.Any())
                                        {
                                            @foreach (var grupo in polla.Clasificacion.Faltantes)
                                            {
                                                <span class="chip missing">Falta Grupo @grupo</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="chip saved">12 grupos guardados</span>
                                        }
                                    </div>
                                </div>

                                <div class="historial-section">
                                    <h5>Mejores terceros</h5>
                                    <div class="chips">
                                        @foreach (var grupo in polla.MejoresTerceros.Seleccionados)
                                        {
                                            <span class="chip saved">Grupo @grupo</span>
                                        }
                                        @if (polla.MejoresTerceros.Faltantes > 0)
                                        {
                                            <span class="chip missing">Faltan @polla.MejoresTerceros.Faltantes</span>
                                        }
                                    </div>
                                </div>

                                <div class="historial-section">
                                    <h5>Podio</h5>
                                    @if (polla.Podio.Guardado)
                                    {
                                        <div class="podio-mini">
                                            <span>Campeon: <strong>@polla.Podio.Campeon</strong></span>
                                            <span>Subcampeon: <strong>@polla.Podio.Subcampeon</strong></span>
                                            <span>Tercero: <strong>@polla.Podio.Tercero</strong></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="chip missing">Falta guardar podio</span>
                                    }
                                </div>

                                <div class="historial-section">
                                    <h5>Marcadores por fase</h5>
                                    @foreach (var fase in polla.MarcadoresPorFase)
                                    {
                                        <details class="fase-detail" open="@(fase.Faltantes > 0)">
                                            <summary>
                                                <strong>@NombreFase(fase.Fase)</strong>
                                                <span>@fase.Guardados / @fase.Total guardados</span>
                                                @if (fase.Faltantes > 0)
                                                {
                                                    <em>@fase.Faltantes faltantes</em>
                                                }
                                            </summary>
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-0 historial-table admin-mobile-table history-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Partido</th>
                                                            <th>Estado</th>
                                                            <th>Pronostico</th>
                                                            <th>Extras</th>
                                                            <th>Accion</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var registro in fase.Registros)
                                                        {
                                                            <tr class="@(registro.Estado == "Falta" ? "row-missing" : "")">
                                                                <td>@registro.Partido</td>
                                                                <td>
                                                                    <span class="mini-status @(registro.Estado == "Guardado" ? "saved" : "missing")">
                                                                        @registro.Estado
                                                                    </span>
                                                                </td>
                                                                <td>@(string.IsNullOrWhiteSpace(registro.Pronostico) ? "-" : registro.Pronostico)</td>
                                                                <td>@ExtrasRegistro(registro)</td>
                                                                <td>
                                                                    @if (registro.Estado == "Falta")
                                                                    {
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-outline-primary"
                                                                                disabled="@ProcesandoAlerta"
                                                                                @onclick="() => EnviarAlertaPartidoPendiente(polla, registro)">
                                                                            @(AlertaEnProceso(polla.PollaId, AlertaPartidoTipo(registro.PartidoId)) ? "Enviando..." : "Alertar partido")
                                                                        </button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">-</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </details>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </div>
        </div>
    }
    </section>
}

<style>
    .admin-anchor {
        scroll-margin-top: 1.25rem;
    }

    .admin-quick-nav {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: .55rem;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        background: #f8fbff;
        padding: .75rem;
        margin-bottom: 1rem;
    }

    .admin-quick-link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px solid #bfdbfe;
