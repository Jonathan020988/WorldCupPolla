    private static string AlertaPartidoTipo(int partidoId) => $"MarcadoresPartido:{partidoId}";

    private Task EnviarAlertaPartidoPendiente(
        PollaHistorialAdminDto polla,
        RegistroMarcadorAdminDto registro)
    {
        return EnviarAlertaPendientes(polla, "Marcadores", registro.PartidoId);
    }

    private async Task EnviarAlertaPendientes(
        PollaHistorialAdminDto polla,
        string tipoAlerta,
        int? partidoId = null)
    {
        if (historialUsuario == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        alertaHistorialMensaje = null;
        alertaHistorialError = false;
        var tipoProcesando = partidoId.HasValue
            ? AlertaPartidoTipo(partidoId.Value)
            : tipoAlerta;
        procesandoAlertaKey = AlertaKey(polla.PollaId, tipoProcesando);

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/Admin/usuarios/{historialUsuario.UsuarioId}/alerta-pendientes",
                new AdminEnviarAlertaPendientesRequest
                {
                    AdminUsuarioId = Sesion.UsuarioId.Value,
                    PollaId = polla.PollaId,
                    TipoAlerta = tipoAlerta,
                    PartidoId = partidoId
                });

            alertaHistorialMensaje = await LeerMensajeRespuesta(response);
            alertaHistorialError = !response.IsSuccessStatusCode;

            if (response.IsSuccessStatusCode)
            {
                await RecargarHistorialUsuarioActual();
            }
        }
        catch (Exception ex)
        {
            alertaHistorialMensaje = $"No se pudo enviar la alerta: {ex.Message}";
            alertaHistorialError = true;
        }
        finally
        {
            procesandoAlertaKey = null;
        }
    }

    private async Task RecargarHistorialUsuarioActual()
    {
        if (historialUsuario == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var usuarioId = historialUsuario.UsuarioId;
        var historialActualizado = await Http.GetFromJsonAsync<HistorialUsuarioAdminDto>(
            $"api/Admin/usuarios/{usuarioId}/historial?adminUsuarioId={Sesion.UsuarioId.Value}");

        if (historialActualizado != null)
        {
            historialUsuario = historialActualizado;
        }
    }

    private static string ExtrasRegistro(RegistroMarcadorAdminDto registro)
    {
        var extras = new List<string>();

        if (registro.Clasificado)
            extras.Add("clasificado");
        if (registro.TiempoExtra)
            extras.Add("extra");
        if (registro.Penales)
            extras.Add("penales");

        return extras.Any()
            ? string.Join(", ", extras)
            : "-";
    }

    private async Task EliminarUsuario(UsuarioAdminDto usuario)
    {
        if (!usuario.PuedeEliminar)
        {
            mensaje = TextoUsuarioNoEliminable(usuario);
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            $"Vas a eliminar definitivamente a {usuario.Nombre}. Si luego quiere entrar, debe registrarse otra vez. ¿Continuar?");

        if (!confirmado)
            return;

        var response = await Http.DeleteAsync(
            $"api/Admin/usuarios/{usuario.Id}?adminUsuarioId={Sesion.UsuarioId!.Value}");

        mensaje = response.IsSuccessStatusCode
            ? $"{usuario.Nombre} fue eliminado definitivamente."
            : await response.Content.ReadAsStringAsync();

        if (usuarioPredicciones?.UsuarioId == usuario.Id)
        {
            usuarioPredicciones = null;
        prediccionesUsuario.Clear();
        clasificacionPrediccionesUsuario.Clear();
        tercerosPrediccionesUsuario.Clear();
        podioPrediccionesUsuario = null;
        reaperturasUsuario.Clear();
        }

        await CargarPanel();

        if (pollaSeleccionada != null)
        {
            await CargarMiembros(pollaSeleccionada);
        }
    }

    private async Task LimpiarHistorialUsuario(UsuarioAdminDto usuario)
    {
        if (!PuedeLimpiarHistorialUsuario(usuario))
        {
            mensaje = TextoLimpiezaHistorial(usuario);
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            $"Vas a borrar los registros de prueba asociados a {usuario.Nombre}. Esto no se puede deshacer. ¿Continuar?");

        if (!confirmado)
            return;

        var response = await Http.DeleteAsync(
            $"api/Admin/usuarios/{usuario.Id}/historial?adminUsuarioId={Sesion.UsuarioId!.Value}");

        mensaje = await LeerMensajeRespuesta(response);

        if (usuarioPredicciones?.UsuarioId == usuario.Id)
        {
            usuarioPredicciones = null;
            prediccionesUsuario.Clear();
            reaperturasUsuario.Clear();
        }

        await CargarPanel();

        if (pollaSeleccionada != null)
        {
            await CargarMiembros(pollaSeleccionada);
        }
    }

    private bool PuedeLimpiarHistorialUsuario(UsuarioAdminDto usuario)
    {
        return !usuario.Activo &&
            usuario.Pollas == 0 &&
            usuario.PollasCreadas == 0 &&
            usuario.Historial > 0;
    }

    private string TextoLimpiezaHistorial(UsuarioAdminDto usuario)
    {
        if (PuedeLimpiarHistorialUsuario(usuario))
            return "Borrar registros de prueba para permitir eliminar el usuario.";

        if (usuario.Activo)
            return "Primero debes inactivar el usuario.";

        if (usuario.Pollas > 0 || usuario.PollasCreadas > 0)
            return "Primero retira el usuario de sus pollas y verifica que no sea creador de una polla.";

        return "Este usuario no tiene registros pendientes por limpiar.";
    }

    private string TextoUsuarioNoEliminable(UsuarioAdminDto usuario)
    {
        if (usuario.PuedeEliminar)
            return "Eliminar definitivamente";

        if (usuario.Activo)
            return "Primero debes inactivar el usuario.";

        var motivos = new List<string>();
        if (usuario.PollasCreadas > 0)
            motivos.Add($"{usuario.PollasCreadas} polla(s) creada(s)");
        if (usuario.Historial > 0)
            motivos.Add($"{usuario.Historial} registro(s) de historial");

        return motivos.Any()
            ? "No se puede eliminar porque tiene " + string.Join(", ", motivos) + ". Déjalo inactivo para conservar el historial."
            : "No se puede eliminar este usuario.";
    }

