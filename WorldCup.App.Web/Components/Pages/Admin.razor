        color: #0f5132;
    }

    .chip.missing {
        background: #fff3cd;
        color: #664d03;
    }

    .podio-mini {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 8px;
    }

    .podio-mini span {
        border: 1px solid #e5edf7;
        border-radius: 8px;
        background: #f8fbff;
        padding: 8px 10px;
    }

    .fase-detail {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        margin-bottom: 8px;
        overflow: hidden;
    }

    .fase-detail summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        cursor: pointer;
        background: #f8fafc;
        padding: 10px 12px;
    }

    .fase-detail summary span {
        color: #475569;
        font-weight: 700;
    }

    .fase-detail summary em {
        color: #9a6700;
        font-style: normal;
        font-weight: 800;
    }

    .historial-table th {
        color: #64748b;
        font-size: .75rem;
        text-transform: uppercase;
    }

    .row-missing {
        background: #fffaf0;
    }

    .mini-status {
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 800;
        padding: 3px 8px;
    }

    .mini-status.saved {
        background: #d1e7dd;
        color: #0f5132;
    }

    .mini-status.missing {
        background: #fff3cd;
        color: #664d03;
    }

    .mini-status.replaced {
        background: #e2e8f0;
        color: #475569;
    }

    .trends-admin {
        overflow: hidden;
    }

    .trends-filter-grid {
        display: grid;
        grid-template-columns: .8fr 1fr .8fr 1.5fr;
        gap: .8rem;
        align-items: end;
    }

    .trends-filter-grid .form-label {
        color: #52606d;
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .trends-generate {
        grid-column: 1 / -1;
        justify-self: end;
        min-height: 38px;
        min-width: 190px;
        padding-inline: 1.1rem;
        white-space: nowrap;
    }

    .trends-result {
        margin-top: 1rem;
        border: 1px solid #d8e5de;
        border-radius: 8px;
        background: #fbfdfc;
        overflow: hidden;
    }

    .trends-match-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.1rem;
        background: #0b4937;
        color: #fff;
        border-bottom: 4px solid #d7a21a;
    }

    .trends-match-head span,
    .trend-section-title span {
        display: block;
        color: #f6c944;
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .trends-match-head h4 {
        margin: .1rem 0;
        font-size: 1.2rem;
        font-weight: 900;
    }

    .trends-match-head small {
        color: #d5e6df;
        font-weight: 700;
    }

    .trends-match-head > strong {
        border: 1px solid rgba(255,255,255,.35);
        border-radius: 6px;
        padding: .45rem .7rem;
        text-align: center;
    }

    .trends-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        padding: 1rem;
    }

    .trends-metrics article {
        min-width: 0;
        border: 1px solid #dce8e2;
        border-top: 3px solid #14805e;
        border-radius: 7px;
        background: #fff;
        padding: .8rem;
    }

    .trends-metrics span,
    .trends-metrics small {
        display: block;
        color: #667085;
        font-size: .74rem;
        font-weight: 800;
    }

    .trends-metrics span {
        text-transform: uppercase;
    }

    .trends-metrics strong {
        display: block;
        margin: .15rem 0;
        color: #102a23;
        font-size: 1.35rem;
        font-weight: 950;
        overflow-wrap: anywhere;
    }

    .trends-visual-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
        gap: 1rem;
        padding: 0 1rem 1rem;
    }

    .trend-chart-card,
    .trend-detail-card {
        min-width: 0;
        border: 1px solid #dce8e2;
        border-radius: 8px;
        background: #fff;
        padding: 1rem;
    }

    .trend-section-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .trend-section-title h5 {
        margin: .1rem 0 0;
        color: #102a23;
        font-size: 1rem;
        font-weight: 900;
    }

    .trend-section-title small {
        color: #667085;
        font-weight: 800;
    }

    .trend-chart-layout {
        display: grid;
        grid-template-columns: minmax(220px, .8fr) minmax(240px, 1.2fr);
        align-items: center;
        gap: 1rem;
    }

    .trend-donut {
        position: relative;
        width: min(100%, 280px);
        aspect-ratio: 1;
        margin: auto;
        border-radius: 50%;
        box-shadow: inset 0 0 0 1px rgba(15, 81, 50, .08);
    }

    .trend-donut::after {
        position: absolute;
        inset: 24%;
        content: "";
        border: 1px solid #dce8e2;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 8px 20px rgba(16, 42, 35, .1);
    }

    .trend-donut > div {
        position: absolute;
        inset: 31%;
        z-index: 1;
        display: grid;
        place-content: center;
        text-align: center;
    }

    .trend-donut strong,
    .trend-donut span {
        display: block;
    }

    .trend-donut strong {
        color: #0b4937;
        font-size: 1.8rem;
        font-weight: 950;
        line-height: 1;
    }

    .trend-donut span {
        color: #667085;
        font-size: .72rem;
        font-weight: 800;
    }

    .trend-legend {
        display: grid;
        gap: .4rem;
        max-height: 300px;
        overflow-y: auto;
        padding-right: .25rem;
    }

    .trend-legend-item {
        display: grid;
        grid-template-columns: 12px minmax(42px, auto) 1fr auto;
        align-items: center;
        gap: .55rem;
        width: 100%;
        border: 1px solid #e4ebe7;
        border-radius: 6px;
        background: #fbfdfc;
        color: #24352e;
        padding: .48rem .55rem;
        text-align: left;
    }

    .trend-legend-item:hover {
        border-color: #9bc7b6;
        background: #f0f8f4;
    }

    .trend-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

    .trend-legend-item span:not(.trend-color),
    .trend-legend-item small {
        color: #667085;
        font-size: .78rem;
        font-weight: 800;
    }

    .trend-legend-item small {
        text-align: right;
    }

    .trend-selected-score {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: .65rem;
        margin-top: .85rem;
        border: 1px solid #cfe3da;
        border-radius: 8px;
        background: #eef8f3;
        padding: .85rem;
        text-align: center;
    }

    .trend-selected-score span {
        color: #344b41;
        font-size: .82rem;
        font-weight: 800;
    }

    .trend-selected-score strong {
        color: #0b4937;
        font-size: 1.45rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .trend-selected-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .65rem;
        margin-top: .65rem;
    }

    .trend-selected-stats div {
        border: 1px solid #e4ebe7;
        border-radius: 7px;
        padding: .65rem;
        text-align: center;
    }

    .trend-selected-stats strong,
    .trend-selected-stats span {
        display: block;
    }

    .trend-selected-stats strong {
        color: #102a23;
        font-size: 1.15rem;
        font-weight: 950;
    }

    .trend-selected-stats span {
        color: #667085;
        font-size: .74rem;
        font-weight: 800;
    }

    .trend-score-list {
        display: grid;
        gap: .4rem;
        max-height: 230px;
        margin-top: .8rem;
        overflow-y: auto;
    }

    .trend-score-list button {
        display: grid;
        grid-template-columns: 55px 1fr auto;
        gap: .55rem;
        width: 100%;
        border: 1px solid #e4ebe7;
        border-radius: 6px;
        background: #fff;
        color: #344b41;
        padding: .45rem .55rem;
        text-align: left;
    }

    .trend-score-list button.selected {
        border-color: #14805e;
        background: #eef8f3;
    }

    .trend-score-list span,
    .trend-score-list small {
        color: #667085;
        font-size: .78rem;
        font-weight: 800;
    }

    .trend-score-list small {
        text-align: right;
    }

    .trends-empty {
        margin: 0 1rem 1rem;
        border: 1px dashed #a9cdbf;
        border-radius: 7px;
        background: #f3faf7;
        color: #456257;
        padding: 1rem;
        text-align: center;
        font-weight: 800;
    }

