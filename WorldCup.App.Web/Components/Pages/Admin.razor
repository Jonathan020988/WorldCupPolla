        font-size: .78rem;
        text-transform: uppercase;
    }

    .phase-control td {
        vertical-align: middle;
    }

    .calendario-admin th {
        color: #5f6b7a;
        font-size: .78rem;
        text-transform: uppercase;
    }

    .calendario-scroll {
        max-height: 420px;
        overflow: auto;
    }

    .calendario-fecha {
        min-width: 190px;
    }

    .reopen-panel {
        background: #f8fbff;
    }

    .admin-prediction-extra {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr) minmax(0, .9fr);
        gap: .8rem;
        background: #fbfcfd;
    }

    .admin-extra-card {
        border: 1px solid #d8e2ef;
        border-radius: 8px;
        background: #fff;
        padding: .85rem;
    }

    .admin-extra-head {
        display: flex;
        justify-content: space-between;
        gap: .65rem;
        align-items: center;
        margin-bottom: .55rem;
    }

    .admin-extra-head span {
        color: #5f6b7a;
