@page "/admin"
@rendermode InteractiveServer
@inject HttpClient Http
@inject WorldCup.App.Shared.Services.SesionService Sesion
@inject NavigationManager Navigation

<h2 class="mb-4">Panel administrador</h2>

@if (cargando)
{
    <p>Cargando panel...</p>
}
else if (!Sesion.EsAdmin)
{
    <div class="alert alert-danger">
        No tienes permisos para entrar al panel administrador.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <small class="text-muted">Usuarios</small>
                    <h3>@resumen?.Usuarios</h3>
                    <small class="text-muted">@resumen?.UsuariosActivos activos / @resumen?.UsuariosInactivos inactivos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <small class="text-muted">Pollas</small>
                    <h3>@resumen?.Pollas</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <small class="text-muted">Finalizados</small>
                    <h3>@resumen?.PartidosFinalizados</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <small class="text-muted">Pendientes</small>
                    <h3>@resumen?.PartidosPendientes</h3>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info">@mensaje</div>
    }

    <div class="card mb-4">
        <div class="card-header fw-bold">Prueba de correo SMTP</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Correo destino</label>
                    <input class="form-control"
                           placeholder="correo@ejemplo.com"
                           @bind="correoPrueba" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary w-100"
                            @onclick="EnviarCorreoPrueba">
                        Enviar prueba
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 phase-control">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Control del torneo por fases</span>
            <small class="text-muted">Finaliza, genera la siguiente fase o reinicia para pruebas</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Fase</th>
                            <th class="text-center">Partidos</th>
                            <th class="text-center">Finalizados</th>
                            <th class="text-center">Faltan marcador</th>
                            <th class="text-center">Siguiente fase</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fase in fasesAdmin)
                        {
                            <tr>
                                <td class="fw-semibold">@NombreFase(fase.Fase)</td>
                                <td class="text-center">@fase.TotalPartidos</td>
                                <td class="text-center">
                                    <span class="badge @(fase.Pendientes == 0 && fase.TotalPartidos > 0 ? "bg-success" : "bg-secondary")">
                                        @fase.Finalizados / @fase.TotalPartidos
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (fase.PenalesInvalidos > 0)
                                    {
                                        <span class="badge bg-danger">@fase.PenalesInvalidos penales</span>
                                    }
                                    else if (fase.FaltanMarcador > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@fase.FaltanMarcador</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (string.IsNullOrWhiteSpace(fase.SiguienteFase))
                                    {
                                        <span class="text-muted">No aplica</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(fase.SiguienteGenerada ? "bg-success" : "bg-light text-dark")">
                                            @(fase.SiguienteGenerada ? "Generada" : "Pendiente")
                                        </span>
                                        <small class="text-muted ms-1">@fase.SiguienteFase</small>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success me-1"
                                            disabled="@(!fase.PuedeFinalizar || procesandoFase == fase.Fase)"
                                            @onclick="() => FinalizarFase(fase)">
                                        Finalizar fase
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(!fase.PuedeReiniciar || procesandoFase == fase.Fase)"
                                            @onclick="() => ReiniciarFase(fase)">
                                        Reiniciar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-4 calendario-admin">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>Calendario de partidos</span>
            <small class="text-muted">Fechas y horas en Colombia</small>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Filtrar fase</label>
                    <select class="form-select"
                            value="@faseCalendario"
                            @onchange="CambiarFaseCalendario">
                        <option value="">Todas</option>
                        @foreach (var fase in fasesCalendario)
                        {
                            <option value="@fase">@NombreFase(fase)</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <small class="text-muted">
                        Usa este control para ajustar horarios oficiales, partidos generados o cambios de sede/fecha.
                    </small>
                </div>
            </div>

            @if (!partidosCalendarioVista.Any())
            {
                <div class="alert alert-light mb-0">
                    No hay partidos para esta fase.
                </div>
            }
            else
            {
                <div class="table-responsive calendario-scroll">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fase</th>
                                <th>Partido</th>
                                <th>Fecha y hora Colombia</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var partido in partidosCalendarioVista)
                            {
                                <tr>
                                    <td>@NombreFase(partido.Fase)</td>
                                    <td class="fw-semibold">@partido.Local vs @partido.Visitante</td>
                                    <td>
                                        <input type="datetime-local"
                                               class="form-control form-control-sm calendario-fecha"
                                               @bind="partido.Fecha"
                                               @bind:format="yyyy-MM-ddTHH:mm" />
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@partido.Estado</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(procesandoPartidoFecha == partido.Id)"
                                                @onclick="() => GuardarFechaPartido(partido)">
                                            Guardar fecha
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header fw-bold">Usuarios</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Email</th>
                                <th>Estado</th>
                                <th class="text-end">Pollas</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usuario in usuarios)
                            {
                                <tr>
                                    <td>@usuario.Nombre</td>
                                    <td>@usuario.Email</td>
                                    <td>
                                        <span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">
                                            @(usuario.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">@usuario.Pollas</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm @(usuario.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                                @onclick="() => CambiarEstadoUsuario(usuario.Id, usuario.Nombre, !usuario.Activo)">
                                            @(usuario.Activo ? "Inactivar" : "Activar")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header fw-bold">Pollas</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Polla</th>
                                <th>Creador</th>
                                <th class="text-end">Miembros</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var polla in pollas)
                            {
                                <tr>
                                    <td>@polla.Nombre</td>
                                    <td>@polla.Creador</td>
                                    <td class="text-end">
                                        @polla.Miembros
                                        @if (polla.MiembrosInactivos > 0)
                                        {
                                            <small class="text-muted">(+@polla.MiembrosInactivos inact.)</small>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => CargarMiembros(polla)">
                                            Ver
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => EliminarPolla(polla)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (pollaSeleccionada != null)
    {
        <div class="card mt-4">
            <div class="card-header fw-bold">
                Miembros de @pollaSeleccionada.Nombre
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var miembro in miembros)
                        {
                            <tr>
                                <td>@miembro.Nombre</td>
                                <td>@miembro.Email</td>
                                <td>
                                    <span class="badge @(miembro.Activo ? "bg-success" : "bg-secondary")">
                                        @(miembro.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => CargarPredicciones(miembro)">
                                        Predicciones
                                    </button>
                                    <button class="btn btn-sm @(miembro.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                            @onclick="() => CambiarEstadoUsuario(miembro.UsuarioId, miembro.Nombre, !miembro.Activo)">
                                        @(miembro.Activo ? "Inactivar" : "Activar")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (usuarioPredicciones != null)
    {
        <div class="card mt-4">
            <div class="card-header fw-bold">
                Predicciones de @usuarioPredicciones.Nombre
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Partido</th>
                            <th>Pronóstico</th>
                            <th>Resultado real</th>
                            <th>Puntos</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prediccion in prediccionesUsuario)
                        {
                            <tr>
                                <td>@prediccion.Partido</td>
                                <td>
                                    <input class="form-control form-control-sm d-inline-block marcador-admin"
                                           type="number"
                                           min="0"
                                           @bind="prediccion.GolesLocal" />
                                    -
                                    <input class="form-control form-control-sm d-inline-block marcador-admin"
                                           type="number"
                                           min="0"
                                           @bind="prediccion.GolesVisitante" />
                                </td>
                                <td>@prediccion.ResultadoLocal - @prediccion.ResultadoVisitante</td>
                                <td>@prediccion.PuntosTotales</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => GuardarPrediccion(prediccion)">
                                        Guardar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    .marcador-admin {
        width: 70px;
    }

    .phase-control th {
        color: #5f6b7a;
        font-size: .78rem;
        text-transform: uppercase;
    }

    .phase-control td {
        vertical-align: middle;
    }

    .calendario-admin th {
        color: #5f6b7a;
        font-size: .78rem;
        text-transform: uppercase;
    }

    .calendario-scroll {
        max-height: 420px;
        overflow: auto;
    }

    .calendario-fecha {
        min-width: 190px;
    }
</style>

@code {
    private bool cargando = true;
    private string? mensaje;
    private ResumenAdminDto? resumen;
    private List<UsuarioAdminDto> usuarios = new();
    private List<PollaAdminDto> pollas = new();
    private List<MiembroAdminDto> miembros = new();
    private List<PrediccionAdminDto> prediccionesUsuario = new();
    private List<FaseAdminDto> fasesAdmin = new();
    private List<PartidoCalendarioAdminDto> partidosCalendario = new();
    private List<PartidoCalendarioAdminDto> partidosCalendarioVista = new();
    private PollaAdminDto? pollaSeleccionada;
    private MiembroAdminDto? usuarioPredicciones;
    private string? procesandoFase;
    private int? procesandoPartidoFecha;
    private string faseCalendario = "";
    private string correoPrueba = "";

    private readonly List<string> fasesCalendario = new()
    {
        "Grupos",
        "Dieciseisavos",
        "Octavos",
        "Cuartos",
        "Semifinales",
        "TercerPuesto",
        "Final"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login?returnUrl=/admin", true);
            return;
        }

        if (Sesion.EsAdmin)
        {
            await CargarPanel();
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task CargarPanel()
    {
        var adminId = Sesion.UsuarioId!.Value;

        resumen = await Http.GetFromJsonAsync<ResumenAdminDto>(
            $"api/Admin/resumen?adminUsuarioId={adminId}");
        fasesAdmin = await Http.GetFromJsonAsync<List<FaseAdminDto>>(
            $"api/Partidos/admin-fases?adminUsuarioId={adminId}") ?? new();
        await CargarCalendario();
        usuarios = await Http.GetFromJsonAsync<List<UsuarioAdminDto>>(
            $"api/Admin/usuarios?adminUsuarioId={adminId}") ?? new();
        pollas = await Http.GetFromJsonAsync<List<PollaAdminDto>>(
            $"api/Admin/pollas?adminUsuarioId={adminId}") ?? new();
    }

    private async Task CargarCalendario()
    {
        partidosCalendario = await Http.GetFromJsonAsync<List<PartidoCalendarioAdminDto>>(
            "api/Partidos") ?? new();

        AplicarFiltroCalendario();
    }

    private void CambiarFaseCalendario(ChangeEventArgs e)
    {
        faseCalendario = e.Value?.ToString() ?? "";
        AplicarFiltroCalendario();
    }

    private void AplicarFiltroCalendario()
    {
        partidosCalendarioVista = partidosCalendario
            .Where(p => string.IsNullOrWhiteSpace(faseCalendario) || p.Fase == faseCalendario)
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id)
            .ToList();
    }

    private async Task GuardarFechaPartido(PartidoCalendarioAdminDto partido)
    {
        if (!Sesion.UsuarioId.HasValue)
            return;

        procesandoPartidoFecha = partido.Id;

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-fecha",
            new AdminFechaPartidoRequestDto
            {
                AdminUsuarioId = Sesion.UsuarioId.Value,
                Fecha = partido.Fecha
            });

        mensaje = response.IsSuccessStatusCode
            ? $"Fecha actualizada: {partido.Local} vs {partido.Visitante}."
            : await response.Content.ReadAsStringAsync();

        await CargarCalendario();
        procesandoPartidoFecha = null;
    }

    private async Task EnviarCorreoPrueba()
    {
        if (string.IsNullOrWhiteSpace(correoPrueba))
        {
            mensaje = "Debes indicar un correo destino.";
            return;
        }

        var response = await Http.PostAsync(
            $"api/Admin/probar-correo?adminUsuarioId={Sesion.UsuarioId!.Value}&destino={Uri.EscapeDataString(correoPrueba)}",
            null);

        mensaje = response.IsSuccessStatusCode
            ? "Correo de prueba solicitado. Revisa la bandeja de entrada y spam."
            : await response.Content.ReadAsStringAsync();
    }

    private async Task FinalizarFase(FaseAdminDto fase)
    {
        await EjecutarAccionFase(fase, "finalizar");
    }

    private async Task ReiniciarFase(FaseAdminDto fase)
    {
        await EjecutarAccionFase(fase, "reiniciar");
    }

    private async Task EjecutarAccionFase(FaseAdminDto fase, string accion)
    {
        if (!Sesion.UsuarioId.HasValue)
            return;

        procesandoFase = fase.Fase;

        var response = await Http.PostAsJsonAsync(
            $"api/Partidos/admin-fases/{fase.Fase}/{accion}",
            new AdminFaseRequestDto
            {
                AdminUsuarioId = Sesion.UsuarioId.Value
            });

        mensaje = await LeerMensajeRespuesta(response);
        await CargarPanel();

        if (usuarioPredicciones != null)
        {
            await CargarPredicciones(usuarioPredicciones);
        }

        procesandoFase = null;
    }

    private async Task<string> LeerMensajeRespuesta(HttpResponseMessage response)
    {
        var contenido = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(contenido))
        {
            return response.IsSuccessStatusCode
                ? "Operación realizada correctamente."
                : "No se pudo completar la operación.";
        }

        if (!response.IsSuccessStatusCode)
        {
            return contenido;
        }

        try
        {
            using var json = System.Text.Json.JsonDocument.Parse(contenido);
            if (json.RootElement.TryGetProperty("mensaje", out var mensajeApi))
            {
                return mensajeApi.GetString() ?? contenido;
            }
        }
        catch
        {
            return contenido;
        }

        return contenido;
    }

    private string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

    private async Task CargarMiembros(PollaAdminDto polla)
    {
        pollaSeleccionada = polla;
        usuarioPredicciones = null;
        prediccionesUsuario.Clear();

        miembros = await Http.GetFromJsonAsync<List<MiembroAdminDto>>(
            $"api/Admin/pollas/{polla.Id}/miembros?adminUsuarioId={Sesion.UsuarioId!.Value}") ?? new();
    }

    private async Task EliminarMiembro(MiembroAdminDto miembro)
    {
        if (pollaSeleccionada == null)
            return;

        var response = await Http.DeleteAsync(
            $"api/Admin/pollas/{pollaSeleccionada.Id}/miembros/{miembro.UsuarioId}?adminUsuarioId={Sesion.UsuarioId!.Value}");

        mensaje = response.IsSuccessStatusCode
            ? $"{miembro.Nombre} fue retirado de la polla."
            : await response.Content.ReadAsStringAsync();

        await CargarMiembros(pollaSeleccionada);
        await CargarPanel();
    }

    private async Task CambiarEstadoUsuario(int usuarioId, string nombre, bool activo)
    {
        var response = await Http.PutAsJsonAsync(
            $"api/Admin/usuarios/{usuarioId}/estado",
            new
            {
                AdminUsuarioId = Sesion.UsuarioId!.Value,
                Activo = activo
            });

        mensaje = response.IsSuccessStatusCode
            ? $"{nombre} quedó {(activo ? "activo" : "inactivo")}."
            : await response.Content.ReadAsStringAsync();

        await CargarPanel();

        if (pollaSeleccionada != null)
        {
            await CargarMiembros(pollaSeleccionada);
        }
    }

    private async Task EliminarPolla(PollaAdminDto polla)
    {
        var response = await Http.DeleteAsync(
            $"api/Admin/pollas/{polla.Id}?adminUsuarioId={Sesion.UsuarioId!.Value}");

        mensaje = response.IsSuccessStatusCode
            ? $"La polla {polla.Nombre} fue eliminada."
            : await response.Content.ReadAsStringAsync();

        pollaSeleccionada = null;
        miembros.Clear();
        await CargarPanel();
    }

    private async Task CargarPredicciones(MiembroAdminDto miembro)
    {
        if (pollaSeleccionada == null)
            return;

        usuarioPredicciones = miembro;
        prediccionesUsuario = await Http.GetFromJsonAsync<List<PrediccionAdminDto>>(
            $"api/Admin/predicciones?adminUsuarioId={Sesion.UsuarioId!.Value}&pollaId={pollaSeleccionada.Id}&usuarioId={miembro.UsuarioId}") ?? new();
    }

    private async Task GuardarPrediccion(PrediccionAdminDto prediccion)
    {
        var response = await Http.PutAsJsonAsync(
            $"api/Admin/predicciones/{prediccion.Id}",
            new
            {
                AdminUsuarioId = Sesion.UsuarioId!.Value,
                prediccion.GolesLocal,
                prediccion.GolesVisitante
            });

        mensaje = response.IsSuccessStatusCode
            ? "Predicción actualizada."
            : await response.Content.ReadAsStringAsync();

        if (usuarioPredicciones != null)
        {
            await CargarPredicciones(usuarioPredicciones);
        }
    }

    private class AdminFaseRequestDto
    {
        public int AdminUsuarioId { get; set; }
    }

    private class AdminFechaPartidoRequestDto
    {
