    private Task EnviarAlertaPartidoPendiente(
        PollaHistorialAdminDto polla,
        RegistroMarcadorAdminDto registro)
    {
        return EnviarAlertaPendientes(polla, "Marcadores", registro.PartidoId);
    }

    private async Task EnviarAlertaPendientes(
        PollaHistorialAdminDto polla,
        string tipoAlerta,
        int? partidoId = null)
    {
        if (historialUsuario == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        alertaHistorialMensaje = null;
        alertaHistorialError = false;
        var tipoProcesando = partidoId.HasValue
            ? AlertaPartidoTipo(partidoId.Value)
            : tipoAlerta;
        procesandoAlertaKey = AlertaKey(polla.PollaId, tipoProcesando);

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/Admin/usuarios/{historialUsuario.UsuarioId}/alerta-pendientes",
                new AdminEnviarAlertaPendientesRequest
                {
                    AdminUsuarioId = Sesion.UsuarioId.Value,
                    PollaId = polla.PollaId,
                    TipoAlerta = tipoAlerta,
                    PartidoId = partidoId
                });

            alertaHistorialMensaje = await LeerMensajeRespuesta(response);
            alertaHistorialError = !response.IsSuccessStatusCode;

            if (response.IsSuccessStatusCode)
            {
                await RecargarHistorialUsuarioActual();
            }
        }
        catch (Exception ex)
        {
            alertaHistorialMensaje = $"No se pudo enviar la alerta: {ex.Message}";
            alertaHistorialError = true;
        }
        finally
        {
            procesandoAlertaKey = null;
        }
    }

    private async Task RecargarHistorialUsuarioActual()
    {
        if (historialUsuario == null || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var usuarioId = historialUsuario.UsuarioId;
        var historialActualizado = await Http.GetFromJsonAsync<HistorialUsuarioAdminDto>(
            $"api/Admin/usuarios/{usuarioId}/historial?adminUsuarioId={Sesion.UsuarioId.Value}");

        if (historialActualizado != null)
        {
            historialUsuario = historialActualizado;
        }
    }

    private static string ExtrasRegistro(RegistroMarcadorAdminDto registro)
    {
        var extras = new List<string>();

        if (registro.Clasificado)
            extras.Add("clasificado");
        if (registro.TiempoExtra)
            extras.Add("extra");
        if (registro.Penales)
            extras.Add("penales");

        return extras.Any()
            ? string.Join(", ", extras)
            : "-";
    }

