    private List<TendenciaSegmentoVisualDto> SegmentosGraficaPastel()
    {
        if (tendencias == null || !tendencias.Distribucion.Any())
        {
            return new();
        }

        const int maximoVisibles = 7;
        var segmentos = tendencias.Distribucion
            .Take(maximoVisibles)
            .Select((d, indice) => new TendenciaSegmentoVisualDto
            {
                Marcador = d.Marcador,
                Cantidad = d.Cantidad,
                Porcentaje = d.Porcentaje,
                Color = coloresTendencias[indice % coloresTendencias.Length]
            })
            .ToList();

        var restantes = tendencias.Distribucion.Skip(maximoVisibles).ToList();
        if (restantes.Any())
        {
            segmentos.Add(new TendenciaSegmentoVisualDto
            {
                Marcador = "Otros",
                Cantidad = restantes.Sum(d => d.Cantidad),
                Porcentaje = Math.Round(restantes.Sum(d => d.Porcentaje), 1),
                Color = coloresTendencias[^1]
            });
        }

        return segmentos;
    }

    private string EstiloGraficaPastel()
    {
        var segmentos = SegmentosGraficaPastel();
        if (!segmentos.Any())
        {
            return "background:#e7efeb";
        }

        var total = segmentos.Sum(s => s.Cantidad);
        var inicio = 0d;
        var partes = new List<string>();

        foreach (var segmento in segmentos)
        {
            var fin = inicio + segmento.Cantidad * 100d / Math.Max(1, total);
            partes.Add(
                $"{segmento.Color} {FormatoCss(inicio)}% {FormatoCss(fin)}%");
            inicio = fin;
        }

        return $"background:conic-gradient({string.Join(", ", partes)})";
    }

