    private static string DetalleEstadoRegistros(UsuarioAdminDto usuario)
    {
        if (usuario.RegistrosGuardados == 0)
        {
            return usuario.Pollas > 0
                ? "Sin registros guardados"
                : "Sin pollas ni registros";
        }

        if (usuario.RegistrosEsperados <= 0)
        {
            return $"{usuario.RegistrosGuardados} guardado(s)";
        }

        return usuario.RegistrosFaltantes == 0
            ? $"{usuario.RegistrosGuardados}/{usuario.RegistrosEsperados} guardados"
            : $"{usuario.RegistrosGuardados}/{usuario.RegistrosEsperados} guardados, faltan {usuario.RegistrosFaltantes}";
