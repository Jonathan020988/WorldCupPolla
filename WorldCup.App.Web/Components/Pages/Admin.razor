    private async Task EnviarAlertaMasiva()
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            return;
        }

        var confirmado = await JS.InvokeAsync<bool>(
            "confirm",
            "Vas a enviar una alerta masiva solo a los usuarios que tengan pendiente el filtro seleccionado. Continuar?");
        if (!confirmado)
        {
            return;
        }

        alertaMasivaMensaje = null;
        alertaMasivaError = false;
        enviandoAlertaMasiva = true;

        try
        {
            var request = new AdminEnviarAlertaMasivaPendientesRequest
            {
                AdminUsuarioId = Sesion.UsuarioId.Value,
                PollaId = int.TryParse(alertaMasiva.PollaId, out var pollaId) ? pollaId : null,
                TipoAlerta = alertaMasiva.TipoAlerta,
                FaseMarcadores = alertaMasiva.TipoAlerta == "Marcadores"
                    ? alertaMasiva.FaseMarcadores
                    : "",
                PartidoId = alertaMasiva.TipoAlerta == "Marcadores" &&
                    int.TryParse(alertaMasivaPartidoId, out var partidoId)
                        ? partidoId
                        : null,
                EnviarCorreo = alertaMasiva.EnviarCorreo
            };

            var response = await Http.PostAsJsonAsync(
                "api/Admin/alertas-masivas/pendientes",
                request);

            alertaMasivaMensaje = await LeerMensajeRespuesta(response);
            alertaMasivaError = !response.IsSuccessStatusCode;
        }
        catch (Exception ex)
        {
            alertaMasivaMensaje = $"No se pudo enviar la alerta masiva: {ex.Message}";
            alertaMasivaError = true;
        }
        finally
        {
            enviandoAlertaMasiva = false;
        }
    }

    private async Task GenerarCodigoCupos(SolicitudCuposAdminDto solicitud)
    {
        if (!Sesion.UsuarioId.HasValue)
            return;

        var maximo = solicitud.MaximoMiembrosAutorizado ?? solicitud.CantidadUsuariosSolicitada;
        if (maximo < 6)
        {
            mensaje = "La cantidad autorizada debe ser mayor a 5 usuarios.";
            return;
        }

        procesandoSolicitudCupos = solicitud.Id;

        var response = await Http.PostAsJsonAsync(
            $"api/Admin/cupos/solicitudes/{solicitud.Id}/codigo",
            new AdminGenerarCodigoCuposRequestDto
            {
                AdminUsuarioId = Sesion.UsuarioId.Value,
                MaximoMiembrosAutorizado = maximo
            });

        mensaje = await LeerMensajeRespuesta(response);
        await CargarPanel();
        procesandoSolicitudCupos = null;
    }

