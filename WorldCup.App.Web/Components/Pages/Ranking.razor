@page "/ranking"
@rendermode InteractiveServer

@using Microsoft.JSInterop
@using System.Net.Http.Json
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services
@using WorldCup.App.Web.Components.Shared
@implements IAsyncDisposable
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<section class="ranking-page">
    <div class="ranking-hero">
        <div>
            <div class="eyebrow">&#x1F3C5; Ranking</div>
            <h1>Tabla de posiciones</h1>
            <p>
                @if (Sesion.PollaActivaId.HasValue)
                {
                    <span>@Sesion.PollaActivaNombre</span>
                }
                else
                {
                    <span>Selecciona una polla para ver la competencia.</span>
                }
            </p>
        </div>

        @if (Sesion.PollaActivaId.HasValue)
        {
            <button class="switch-btn" @onclick="CambiarPolla">
                Cambiar polla
            </button>
        }
    </div>

    @if (cargando)
    {
        <div class="ranking-panel loading-panel">
            Cargando ranking...
        </div>
    }
    else if (!Sesion.PollaActivaId.HasValue)
    {
        <div class="ranking-panel selector-panel">
            <h2>Selecciona la polla</h2>

            @if (!pollas.Any())
            {
                <div class="empty-state">
                    No tienes pollas disponibles todavia.
                </div>
            }
            else
            {
                <div class="polla-grid">
                    @foreach (var polla in pollas)
                    {
                        <button class="polla-option"
                                @onclick="() => SeleccionarPolla(polla)">
                            <span class="polla-icon">&#x1F3C6;</span>
                            <span>
                                <strong>@polla.Nombre</strong>
                                <small>Ver ranking y detalle</small>
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else if (!ranking.Any())
    {
        <div class="ranking-panel empty-state">
            Aun no hay participantes activos en esta polla.
        </div>
    }
    else
    {
        @if (MundialFinalizado())
        {
            <div class="winners-banner">
                <span class="winners-kicker">Polla finalizada</span>
                <h2>Felicitaciones a los ganadores</h2>
                <div class="winners-grid">
                    @foreach (var ganador in ranking.Take(3))
                    {
                        var posicionGanador = ranking.IndexOf(ganador) + 1;
                        <div class="winner-card winner-@posicionGanador">
                            <span class="winner-place">@posicionGanador</span>
                            <strong>@ganador.Usuario</strong>
                            <small>@ganador.Puntos puntos</small>
                            @if (ganador.Premio.HasValue && ganador.Premio.Value > 0)
                            {
                                <span class="winner-prize">Premio @FormatoPremio(ganador.Premio)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        var miRendimiento = ObtenerMiRendimiento();

        @if (miRendimiento != null)
        {
            <section class="my-performance" aria-label="Mi rendimiento">
                <div class="my-performance-intro">
                    <span>Mi rendimiento</span>
                    <strong>@miRendimiento.Usuario</strong>
                    <small>
                        Vas de <b>#@miRendimiento.Posicion</b> entre @ranking.Count participantes
                    </small>
                </div>

                <div class="my-performance-stats">
                    <div>
                        <span>Posición</span>
                        <strong>#@miRendimiento.Posicion</strong>
                    </div>
                    <div>
                        <span>Puntos</span>
                        <strong>@miRendimiento.Puntos</strong>
                    </div>
                    <div>
                        <span>Promedio</span>
                        <strong>@miRendimiento.PromedioPorPartido</strong>
                        <small>por partido</small>
                    </div>
                    <div>
                        <span>Exactos</span>
                        <strong>@miRendimiento.Exactos</strong>
                    </div>
                    <div>
                        <span>Con puntos</span>
                        <strong>@miRendimiento.ConPuntos</strong>
                    </div>
                    <div>
                        <span>Efectividad</span>
                        <strong>@miRendimiento.Efectividad%</strong>
                    </div>
                </div>
            </section>
        }

        <div class="summary-grid">
            <div class="summary-item leader">
                <span class="summary-label">Lider</span>
                <strong>@ranking.First().Usuario</strong>
                <small>@ranking.First().Puntos puntos</small>
            </div>

            <div class="summary-item">
                <span class="summary-label">Participantes</span>
                <strong>@ranking.Count</strong>
                <small>usuarios activos</small>
            </div>

            <div class="summary-item">
                <span class="summary-label">Puntaje promedio</span>
                <strong>@PromedioPuntos()</strong>
                <small>puntos</small>
            </div>
        </div>

        <div class="podium-strip">
            @foreach (var r in ranking.Take(3))
            {
                var posicion = ranking.IndexOf(r) + 1;
                <button class="podium-item podium-@posicion"
                        @onclick="() => ToggleDetalleUsuario(r.Usuario)">
                    <span class="position-medal">@posicion</span>
                    <span class="podium-name">@r.Usuario</span>
                    <strong>@r.Puntos</strong>
                    @if (r.Premio.HasValue && r.Premio.Value > 0)
                    {
                        <small class="podium-prize">Premio @FormatoPremio(r.Premio)</small>
                    }
                </button>
            }
        </div>

        <div class="ranking-panel table-panel">
            <div class="panel-title">
                <h2>Ranking general</h2>
                <span>@ranking.Count participantes</span>
            </div>

            <div class="table-responsive">
                <table class="ranking-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Usuario</th>
                            <th class="text-end">Puntos</th>
                            <th class="text-end">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ranking)
                        {
                            var posicion = ranking.IndexOf(r) + 1;
                            <tr class="ranking-row @(usuarioDetalleAbierto == r.Usuario ? "open" : "")">
                                <td data-label="#">
                                    <span class="rank-number">@posicion</span>
                                </td>
                                <td data-label="Usuario">
                                    <div class="user-cell">
                                        <span class="avatar">@Iniciales(r.Usuario)</span>
                                        <span>
                                            <strong>@r.Usuario</strong>
                                            <small>@ResumenUsuario(r.Usuario)</small>
                                            @if (r.Premio.HasValue && r.Premio.Value > 0)
                                            {
                                                <small class="table-prize">Premio @FormatoPremio(r.Premio)</small>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td class="text-end" data-label="Puntos">
                                    <span class="score-pill">@r.Puntos</span>
                                </td>
                                <td class="text-end" data-label="Detalle">
                                    <button class="detail-btn"
                                            @onclick="() => ToggleDetalleUsuario(r.Usuario)">
                                        @(usuarioDetalleAbierto == r.Usuario ? "Ocultar" : "Ver")
                                    </button>
                                </td>
                            </tr>

                            @if (usuarioDetalleAbierto == r.Usuario)
                            {
                                <tr>
                                    <td colspan="4" class="detail-cell">
                                        <div class="detail-wrapper">
                                            <div class="detail-title">
                                                <strong>Detalle de puntos</strong>
                                                <span>@r.Usuario</span>
                                            </div>

                                            <div class="detail-filters">
                                                <div>
                                                    <label>Equipo</label>
                                                    <select @bind="detalleEquipoFiltro">
                                                        <option value="">Todos</option>
                                                        @foreach (var equipo in EquiposDetalleDisponibles(r.Usuario))
                                                        {
                                                            <option value="@equipo">@equipo</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div>
                                                    <label>Grupo</label>
                                                    <select @bind="detalleGrupoFiltro">
                                                        <option value="">Todos</option>
                                                        @foreach (var grupoFiltro in GruposDetalleDisponibles(r.Usuario))
                                                        {
                                                            <option value="@grupoFiltro">Grupo @grupoFiltro</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div>
                                                    <label>Fecha</label>
                                                    <input type="date" @bind="detalleFechaFiltro" />
                                                </div>
                                                <div>
                                                    <label>Resumen por fase</label>
                                                    <select @bind="detalleFaseResumenFiltro">
                                                        <option value="">Ver partidos</option>
                                                        @foreach (var faseFiltro in FasesDetalleDisponibles(r.Usuario))
                                                        {
                                                            <option value="@faseFiltro">@NombreFase(faseFiltro)</option>
                                                        }
                                                    </select>
                                                </div>

                                                @if (HayFiltrosDetalle())
                                                {
                                                    <button type="button"
                                                            class="clear-detail-filters"
                                                            @onclick="LimpiarFiltrosDetalle">
                                                        Limpiar
                                                    </button>
                                                }
                                            </div>

                                            <div class="table-responsive detail-scroll">
                                                <table class="detail-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Partido</th>
                                                            <th>Fase</th>
                                                            <th>Pronostico</th>
                                                            <th>Resultado</th>
                                                            <th>Exacto</th>
                                                            <th>Ganador</th>
                                                            <th>Dif.</th>
                                                            <th>Goles</th>
                                                            <th>Clas.</th>
                                                            <th>Extras</th>
                                                            <th>Podio</th>
                                                            <th>Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @{
                                                            var detallesFiltrados = DetallesUsuarioFiltrados(r.Usuario).ToList();
                                                            var resumenFaseActivo = !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
                                                        }

                                                        @if (!detallesFiltrados.Any())
                                                        {
                                                            <tr>
                                                                <td colspan="12" class="detail-empty">
                                                                    No hay registros con esos filtros.
                                                                </td>
                                                            </tr>
                                                        }
                                                        else if (resumenFaseActivo)
                                                        {
                                                            <tr class="detail-summary-total-row">
                                                                <td data-label="Partido">
                                                                    <strong>Resumen</strong>
                                                                    <small>@detallesFiltrados.Count partido(s)</small>
                                                                </td>
                                                                <td data-label="Fase"><span class="phase-pill">@NombreFase(detalleFaseResumenFiltro!)</span></td>
                                                                <td data-label="Pronostico">-</td>
                                                                <td data-label="Resultado">-</td>
                                                                <td data-label="Exacto">@Puntos(detallesFiltrados.Sum(x => x.PuntosExacto), "points-green")</td>
                                                                <td data-label="Ganador">@Puntos(detallesFiltrados.Sum(x => x.PuntosGanador), "points-blue")</td>
                                                                <td data-label="Dif.">@Puntos(detallesFiltrados.Sum(x => x.PuntosDiferencia), "points-slate")</td>
                                                                <td data-label="Goles">@Puntos(detallesFiltrados.Sum(x => x.PuntosGoles), "points-indigo")</td>
                                                                <td data-label="Clas.">@Puntos(detallesFiltrados.Sum(x => x.PuntosClasificacion), "points-gold")</td>
                                                                <td data-label="Extras">@Puntos(detallesFiltrados.Sum(x => x.PuntosExtras), "points-dark")</td>
                                                                <td data-label="Podio">@Puntos(detallesFiltrados.Sum(x => x.PuntosPodio), "points-red")</td>
                                                                <td data-label="Total"><strong>@detallesFiltrados.Sum(x => x.Total)</strong></td>
                                                            </tr>
                                                        }
                                                        else
                                                        {
                                                            @foreach (var faseDetalle in detallesFiltrados
                                                                .GroupBy(x => x.Fase)
                                                                .OrderBy(g => OrdenFase(g.Key)))
                                                            {
                                                                var faseNombre = faseDetalle.Key;
                                                                var faseMinimizada = FaseDetalleMinimizada(r.Usuario, faseNombre);

                                                                <tr class="detail-phase-row">
                                                                    <td colspan="12">
                                                                        <div class="detail-phase-header">
                                                                            <div>
                                                                                <strong>@faseNombre</strong>
                                                                                <span>@faseDetalle.Count() partidos | @faseDetalle.Sum(x => x.Total) puntos</span>
                                                                            </div>
                                                                            <button type="button"
                                                                                    class="detail-phase-btn"
                                                                                    @onclick="() => ToggleFaseDetalle(r.Usuario, faseNombre)">
                                                                                @(faseMinimizada ? "Mostrar" : "Minimizar")
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>

                                                                @if (!faseMinimizada)
                                                                {
                                                                    @foreach (var d in faseDetalle.OrderBy(x => x.Fecha).ThenBy(x => x.Local))
                                                                    {
                                                                        <tr data-track-prediction-view="@(DebeRegistrarVista(d) ? "true" : "false")"
                                                                            data-polla-id="@Sesion.PollaActivaId"
                                                                            data-owner-id="@d.UsuarioId"
                                                                            data-match-id="@d.PartidoId">
                                                                            <td data-label="Partido"><strong>@d.Local</strong> vs <strong>@d.Visitante</strong></td>
                                                                            <td data-label="Fase"><span class="phase-pill">@d.Fase</span></td>
                                                                            <td data-label="Pronostico">@MarcadorPronostico(d)</td>
                                                                            <td data-label="Resultado">@Marcador(d.ResultadoLocal, d.ResultadoVisitante, "result-pill")</td>
                                                                            <td data-label="Exacto">@Puntos(d.PuntosExacto, "points-green")</td>
                                                                            <td data-label="Ganador">@Puntos(d.PuntosGanador, "points-blue")</td>
                                                                            <td data-label="Dif.">@Puntos(d.PuntosDiferencia, "points-slate")</td>
                                                                            <td data-label="Goles">@Puntos(d.PuntosGoles, "points-indigo")</td>
                                                                            <td data-label="Clas.">
                                                                                @if (d.PuntosClasificacion > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="points-pill points-button points-gold"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Clasificacion", d.PuntosClasificacion, "points-gold", d.DetalleClasificacion, d)'>
                                                                                        +@d.PuntosClasificacion
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }
                                                                            </td>
                                                                            <td data-label="Extras">
                                                                                @if (d.PuntosExtras > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="points-pill points-button points-dark"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Extras", d.PuntosExtras, "points-dark", d.DetalleExtras, d)'>
                                                                                        +@d.PuntosExtras
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }
                                                                            </td>
                                                                            <td data-label="Podio">
                                                                                @if (d.PuntosPodio > 0)
                                                                                {
                                                                                    <button type="button"
                                                                                            class="points-pill points-button points-red"
                                                                                            title="Ver detalle"
                                                                                            @onclick='() => AbrirDetallePuntos("Podio", d.PuntosPodio, "points-red", d.DetallePodio, d)'>
                                                                                        +@d.PuntosPodio
                                                                                    </button>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">0</span>
                                                                                }
                                                                            </td>
                                                                            <td data-label="Total"><strong>@d.Total</strong></td>
                                                                        </tr>
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <RankingEvolutionChart Ranking="ranking"
                               Detalles="rankingDetalle" />
    }
</section>

@if (detallePuntosVisible)
{
    <div class="points-modal-backdrop" @onclick="CerrarDetallePuntos">
        <div class="points-modal" @onclick:stopPropagation="true">
            <button type="button"
                    class="points-modal-close"
                    aria-label="Cerrar"
                    @onclick="CerrarDetallePuntos">
                x
            </button>

            <div class="points-modal-head">
                <span class="points-pill @detallePuntosClase">+@detallePuntosValor</span>
                <div>
                    <h3>@detallePuntosTitulo</h3>
                    <small>@detallePuntosContexto</small>
                </div>
            </div>

            <p class="points-modal-text">@detallePuntosTexto</p>
        </div>
    </div>
}

<style>
    .ranking-page {
        --ink: #13201c;
        --muted: #617067;
        --line: #d9e5df;
        --panel: #ffffff;
        --soft: #f4f8f6;
        --green: #116b4f;
        --gold: #d7a21a;
        color: var(--ink);
    }

    .ranking-hero {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        background: linear-gradient(135deg, #0c513b, #137457 58%, #c79b20);
        color: white;
        padding: 1.35rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        box-shadow: 0 14px 32px rgba(15, 64, 48, .18);
    }

    .ranking-hero h1 {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .ranking-hero p {
        margin: .25rem 0 0;
        opacity: .92;
    }

    .eyebrow {
        font-size: .8rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0;
        opacity: .9;
    }

    .switch-btn,
    .detail-btn {
        border: 1px solid rgba(255, 255, 255, .65);
        background: rgba(255, 255, 255, .14);
        color: white;
        border-radius: 6px;
        padding: .45rem .75rem;
        font-weight: 700;
    }

    .detail-btn {
        border-color: #b8d2c7;
        background: white;
        color: var(--green);
    }

    .ranking-panel,
    .summary-item,
    .podium-item {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(27, 58, 45, .08);
    }

    .selector-panel,
    .loading-panel,
    .empty-state {
        padding: 1.25rem;
    }

    .selector-panel h2,
    .panel-title h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .polla-grid {
        display: grid;
        gap: .7rem;
        margin-top: 1rem;
    }

    .polla-option {
        display: flex;
        align-items: center;
        gap: .75rem;
        width: 100%;
        text-align: left;
        border: 1px solid var(--line);
        background: var(--soft);
        border-radius: 8px;
        padding: .8rem;
    }

    .polla-icon {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #e7f4ef;
    }

    .polla-option small,
    .summary-item small,
    .user-cell small {
        display: block;
        color: var(--muted);
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
        margin-bottom: .9rem;
    }

    .my-performance {
        display: grid;
        grid-template-columns: minmax(230px, .8fr) 2.2fr;
        gap: 1rem;
        margin-bottom: .9rem;
        border: 1px solid #cfe3d9;
        border-left: 5px solid var(--green);
        border-radius: 8px;
        background: linear-gradient(105deg, #eff9f4 0%, #ffffff 58%);
        box-shadow: 0 10px 24px rgba(27, 58, 45, .08);
        padding: 1rem;
    }

    .my-performance-intro {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

    .my-performance-intro > span {
        color: var(--green);
        font-size: .74rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .my-performance-intro > strong {
        overflow: hidden;
        margin: .15rem 0;
        color: var(--ink);
        font-size: 1.25rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .my-performance-intro small {
        color: var(--muted);
    }

    .my-performance-stats {
        display: grid;
        grid-template-columns: repeat(6, minmax(80px, 1fr));
        gap: .55rem;
    }

    .my-performance-stats > div {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 76px;
        border: 1px solid #dce9e3;
        border-radius: 7px;
        background: rgba(255, 255, 255, .88);
        padding: .65rem;
    }

    .my-performance-stats span,
    .my-performance-stats small {
        color: var(--muted);
        font-size: .69rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .my-performance-stats strong {
        color: #0d523d;
        font-size: 1.2rem;
        line-height: 1.15;
    }

    .winners-banner {
        margin-bottom: 1rem;
        padding: 1.3rem;
        border: 1px solid #d6eadf;
        border-radius: 8px;
        background: linear-gradient(135deg, #f3fbf6 0%, #ffffff 58%, #fff8df 100%);
        box-shadow: 0 14px 34px rgba(22, 61, 42, .08);
    }

    .winners-kicker {
        color: var(--green);
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .winners-banner h2 {
        margin: .15rem 0 1rem;
        font-size: clamp(1.45rem, 3vw, 2.2rem);
        font-weight: 900;
        color: var(--ink);
    }

    .winners-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: .8rem;
    }

    .winner-card {
        display: grid;
        gap: .2rem;
        padding: 1rem;
        border: 1px solid #dfe7ef;
        border-radius: 8px;
        background: #fff;
    }

    .winner-card strong {
        color: var(--ink);
        font-size: 1.1rem;
        font-weight: 900;
    }

    .winner-card small {
        color: var(--muted);
        font-weight: 800;
    }

    .winner-prize,
    .podium-prize,
    .table-prize {
        color: #0f7a4f !important;
        font-size: .8rem;
        font-weight: 900;
    }

    .winner-prize {
        margin-top: .25rem;
    }

    .winner-place {
        display: grid;
