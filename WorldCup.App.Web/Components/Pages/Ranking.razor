@code {
    private List<PollaDto> pollas = new();
    private List<RankingPollaDto> ranking = new();
    private List<DetalleRankingDto> rankingDetalle = new();
    private string? usuarioDetalleAbierto;
    private bool cargando = true;
    private bool detallePuntosVisible;
    private string detallePuntosTitulo = "";
    private string detallePuntosTexto = "";
    private string detallePuntosContexto = "";
    private string detallePuntosClase = "";
    private int detallePuntosValor;
    private HashSet<string> fasesDetalleMinimizadas = new(StringComparer.OrdinalIgnoreCase);
    private string? detalleEquipoFiltro;
    private string? detalleGrupoFiltro;
    private DateTime? detalleFechaFiltro;
    private string? detalleFaseResumenFiltro;
    private IJSObjectReference? predictionTrackerModule;
    private DotNetObjectReference<Ranking>? predictionTrackerReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sesion.RestaurarSesionAsync();

            if (!Sesion.EstaLogueado)
            {
                Navigation.NavigateTo("/login?returnUrl=/ranking", true);
                return;
            }

            predictionTrackerModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/prediction-view-tracker.js");
            predictionTrackerReference = DotNetObjectReference.Create(this);

            pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);

            if (Sesion.PollaActivaId.HasValue &&
                !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
            {
                await Sesion.LimpiarPollaActivaAsync();
            }

            if (Sesion.PollaActivaId.HasValue)
            {
                await CargarRankingAsync();
            }

            cargando = false;
            StateHasChanged();
            return;
        }

        if (usuarioDetalleAbierto != null &&
            predictionTrackerModule != null &&
            predictionTrackerReference != null)
        {
            await predictionTrackerModule.InvokeVoidAsync(
                "observePredictionViews",
                predictionTrackerReference);
        }
    }

    private bool DebeRegistrarVista(DetalleRankingDto detalle)
    {
        return Sesion.UsuarioId.HasValue &&
               Sesion.PollaActivaId.HasValue &&
               !Sesion.EsAdmin &&
               detalle.UsuarioId != Sesion.UsuarioId.Value &&
               detalle.PartidoId > 0 &&
               PuedeMostrarPronostico(detalle) &&
               detalle.PronosticoLocal.HasValue &&
               detalle.PronosticoVisitante.HasValue;
    }

    [JSInvokable]
    public async Task RegistrarVistaPrediccion(
        int pollaId,
        int usuarioObjetivoId,
        int partidoId)
    {
        if (!Sesion.UsuarioId.HasValue ||
            Sesion.EsAdmin ||
            Sesion.UsuarioId.Value == usuarioObjetivoId)
        {
            return;
        }

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "api/Predicciones/registrar-visualizacion",
                new
                {
                    PollaId = pollaId,
                    UsuarioObjetivoId = usuarioObjetivoId,
                    PartidoId = partidoId,
                    UsuarioVisualizadorId = Sesion.UsuarioId.Value
                });
        }
        catch
        {
            // El seguimiento no debe interrumpir la experiencia del ranking.
        }
    }

    private async Task SeleccionarPolla(PollaDto polla)
    {
        cargando = true;
        StateHasChanged();

        await Sesion.SeleccionarPollaAsync(polla.Id, polla.Nombre);
        await CargarRankingAsync();

        cargando = false;
        StateHasChanged();
    }

    private async Task CambiarPolla()
    {
        if (predictionTrackerModule != null)
        {
            await predictionTrackerModule.InvokeVoidAsync(
                "disconnectPredictionViews");
        }

        await Sesion.LimpiarPollaActivaAsync();
        ranking.Clear();
        rankingDetalle.Clear();
        usuarioDetalleAbierto = null;
        fasesDetalleMinimizadas.Clear();
        LimpiarFiltrosDetalle();
    }

    public async ValueTask DisposeAsync()
    {
        if (predictionTrackerModule != null)
        {
            try
            {
                await predictionTrackerModule.InvokeVoidAsync(
                    "disconnectPredictionViews");
                await predictionTrackerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        predictionTrackerReference?.Dispose();
    }

    private async Task CargarRankingAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        ranking = await PollasService.GetRankingAsync(
            Sesion.PollaActivaId.Value,
            Sesion.UsuarioId.Value);
        rankingDetalle = await PollasService.GetRankingDetalleAsync(
            Sesion.PollaActivaId.Value,
            Sesion.UsuarioId.Value);
    }

    private void ToggleDetalleUsuario(string usuario)
    {
        if (usuarioDetalleAbierto != usuario)
        {
            LimpiarFiltrosDetalle();
        }

        usuarioDetalleAbierto = usuarioDetalleAbierto == usuario
            ? null
            : usuario;
    }

    private IEnumerable<DetalleRankingDto> DetallesUsuarioFiltrados(string usuario)
    {
        var query = rankingDetalle
            .Where(x => x.Usuario == usuario)
            .AsEnumerable();

        if (!string.IsNullOrWhiteSpace(detalleEquipoFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Local, detalleEquipoFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.Visitante, detalleEquipoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(detalleGrupoFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Grupo, detalleGrupoFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (detalleFechaFiltro.HasValue)
        {
            query = query.Where(x => x.Fecha.Date == detalleFechaFiltro.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(detalleFaseResumenFiltro))
        {
            query = query.Where(x =>
                string.Equals(x.Fase, detalleFaseResumenFiltro, StringComparison.OrdinalIgnoreCase));
        }

        return query
            .OrderBy(x => OrdenFase(x.Fase))
            .ThenBy(x => x.Fecha)
            .ThenBy(x => x.Local);
    }

    private List<string> EquiposDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .SelectMany(x => new[] { x.Local, x.Visitante })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private List<string> GruposDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .Select(x => x.Grupo)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private List<string> FasesDetalleDisponibles(string usuario)
    {
        return rankingDetalle
            .Where(x => x.Usuario == usuario)
            .Select(x => x.Fase)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(OrdenFase)
            .ToList();
    }

    private bool HayFiltrosDetalle()
    {
        return !string.IsNullOrWhiteSpace(detalleEquipoFiltro) ||
               !string.IsNullOrWhiteSpace(detalleGrupoFiltro) ||
               detalleFechaFiltro.HasValue ||
               !string.IsNullOrWhiteSpace(detalleFaseResumenFiltro);
    }

    private void LimpiarFiltrosDetalle()
    {
        detalleEquipoFiltro = null;
        detalleGrupoFiltro = null;
        detalleFechaFiltro = null;
        detalleFaseResumenFiltro = null;
    }

    private static int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private static string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

    private bool FaseDetalleMinimizada(string usuario, string fase)
    {
        return fasesDetalleMinimizadas.Contains(ClaveFaseDetalle(usuario, fase));
    }

    private void ToggleFaseDetalle(string usuario, string fase)
    {
        var clave = ClaveFaseDetalle(usuario, fase);
        if (!fasesDetalleMinimizadas.Add(clave))
        {
            fasesDetalleMinimizadas.Remove(clave);
        }
    }

    private static string ClaveFaseDetalle(string usuario, string fase)
    {
        return $"{usuario}|{fase}";
    }

    private int PromedioPuntos()
    {
        return ranking.Any()
            ? (int)Math.Round(ranking.Average(r => r.Puntos))
            : 0;
    }

    private RendimientoPersonal? ObtenerMiRendimiento()
    {
        if (!Sesion.UsuarioId.HasValue)
        {
            return null;
        }

        var posicion = ranking.FindIndex(r =>
            r.UsuarioId == Sesion.UsuarioId.Value);
        if (posicion < 0)
        {
            return null;
        }

        var usuario = ranking[posicion];
        var partidosFinalizados = rankingDetalle
            .Where(d =>
                d.UsuarioId == usuario.UsuarioId &&
                d.ResultadoLocal.HasValue &&
                d.ResultadoVisitante.HasValue)
            .ToList();
        var exactos = partidosFinalizados.Count(d => d.PuntosExacto > 0);
        var conPuntos = partidosFinalizados.Count(d => d.PuntosMarcador > 0);

        return new RendimientoPersonal
        {
            Usuario = usuario.Usuario,
            Posicion = posicion + 1,
            Puntos = usuario.Puntos,
            PromedioPorPartido = partidosFinalizados.Any()
                ? Math.Round(usuario.Puntos / (double)partidosFinalizados.Count, 1)
                : 0,
            Exactos = exactos,
            ConPuntos = conPuntos,
            Efectividad = partidosFinalizados.Any()
                ? (int)Math.Round(
                    conPuntos * 100d / partidosFinalizados.Count)
                : 0
        };
    }

    private static string FormatoPremio(decimal? premio)
    {
        return premio.HasValue && premio.Value > 0
            ? $"${premio.Value:N0}"
            : "";
    }

    private bool MundialFinalizado()
    {
        return ranking.Any() &&
               rankingDetalle.Any(d =>
                   d.Fase == "Final" &&
                   d.ResultadoLocal.HasValue &&
                   d.ResultadoVisitante.HasValue);
    }

    private string Iniciales(string nombre)
    {
        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => p[0].ToString().ToUpperInvariant());

        var iniciales = string.Concat(partes);
        return string.IsNullOrWhiteSpace(iniciales) ? "?" : iniciales;
    }

    private string ResumenUsuario(string usuario)
    {
        var detalles = rankingDetalle.Where(x => x.Usuario == usuario).ToList();
        var conPuntos = detalles.Count(x => x.Total > 0);
        return $"{conPuntos} jugadas con puntos";
    }

    private MarkupString Marcador(int? local, int? visitante, string clase)
    {
        var texto = local.HasValue && visitante.HasValue
            ? $"{local} - {visitante}"
            : "--";

        return new MarkupString($"<span class=\"{clase}\">{texto}</span>");
    }

    private MarkupString MarcadorPronostico(DetalleRankingDto detalle)
    {
        if (!PuedeMostrarPronostico(detalle))
        {
            return new MarkupString("<span class=\"prediction-pill locked-prediction\">Oculto</span>");
        }

        if (!detalle.PronosticoLocal.HasValue ||
            !detalle.PronosticoVisitante.HasValue)
        {
            return new MarkupString("<span class=\"missing-prediction\">No pronosticó</span>");
        }

        return Marcador(detalle.PronosticoLocal, detalle.PronosticoVisitante, "prediction-pill");
    }

    private bool PuedeMostrarPronostico(DetalleRankingDto detalle)
    {
        return detalle.PronosticoVisible &&
               (
                   Sesion.EsAdmin ||
                   Sesion.UsuarioId.HasValue &&
                   detalle.UsuarioId == Sesion.UsuarioId.Value ||
                   PartidoCerradoParaVisibilidad(detalle)
               );
    }

    private static bool PartidoCerradoParaVisibilidad(DetalleRankingDto detalle)
    {
        return detalle.ResultadoLocal.HasValue &&
               detalle.ResultadoVisitante.HasValue ||
               AhoraColombia() >= FechaColombia(detalle.Fecha).AddHours(-1);
    }

    private static DateTime AhoraColombia()
    {
        var zona = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows()
                ? "SA Pacific Standard Time"
                : "America/Bogota");
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zona);
    }

    private static DateTime FechaColombia(DateTime fecha)
    {
        if (fecha.Kind != DateTimeKind.Utc)
        {
            return fecha;
        }

        var zona = TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows()
                ? "SA Pacific Standard Time"
                : "America/Bogota");
        return TimeZoneInfo.ConvertTimeFromUtc(fecha, zona);
    }

    private MarkupString Puntos(int puntos, string clase)
    {
        return puntos > 0
            ? new MarkupString($"<span class=\"points-pill {clase}\">+{puntos}</span>")
            : new MarkupString("<span class=\"text-muted\">0</span>");
    }

    private void AbrirDetallePuntos(
        string titulo,
        int puntos,
        string clase,
        string? detalle,
        DetalleRankingDto detalleRanking)
    {
        detallePuntosTitulo = titulo;
        detallePuntosValor = puntos;
        detallePuntosClase = clase;
        detallePuntosTexto = string.IsNullOrWhiteSpace(detalle)
            ? $"Estos puntos corresponden a {titulo.ToLowerInvariant()}."
            : detalle;
        detallePuntosContexto = $"{detalleRanking.Local} vs {detalleRanking.Visitante} | {detalleRanking.Fase}";
        detallePuntosVisible = true;
    }

    private void CerrarDetallePuntos()
    {
        detallePuntosVisible = false;
    }

    private sealed class RendimientoPersonal
    {
        public string Usuario { get; set; } = "";
        public int Posicion { get; set; }
        public int Puntos { get; set; }
        public double PromedioPorPartido { get; set; }
        public int Exactos { get; set; }
        public int ConPuntos { get; set; }
        public int Efectividad { get; set; }
    }
}
