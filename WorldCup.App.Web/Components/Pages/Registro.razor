@using WorldCup.App.Shared.DTOs
@inject WorldCup.App.Shared.Services.UsuariosService UsuariosService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@page "/registro"

<div class="registro-page">
    <div class="registro-card">
        <div class="registro-header">
            <span class="registro-icon">WC</span>
            <div>
                <h3>Crear cuenta</h3>
                <p>Regístrate y valida tu correo con un código seguro.</p>
            </div>
        </div>

        @if (error != null)
        {
            <div class="alert alert-danger mt-3">
                @error
            </div>
        }

        @if (mensaje != null)
        {
            <div class="alert alert-success mt-3">
                @mensaje
            </div>
        }

        @if (!codigoEnviado)
        {
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input class="form-control" placeholder="Tu nombre" @bind="model.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email" class="form-control" placeholder="correo@ejemplo.com" @bind="model.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="@TipoPassword" class="form-control" @bind="model.Password" />
            </div>

            <div class="mb-2">
                <label class="form-label">Confirmar contraseña</label>
                <input type="@TipoPassword" class="form-control" @bind="model.ConfirmPassword" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mostrarPassword" @bind="mostrarPassword" />
                <label class="form-check-label" for="mostrarPassword">
                    Mostrar contraseñas
                </label>
            </div>

            <button class="btn btn-success w-100 mt-2"
                    disabled="@cargando"
                    @onclick="Registrar">
                @(cargando ? "Enviando código..." : "Crear cuenta")
            </button>
        }
        else
        {
            <div class="codigo-panel">
                <span class="codigo-badge">Código enviado</span>
                <h4>Revisa tu correo</h4>
                <p>
                    Enviamos un código de 6 dígitos a <strong>@emailPendiente</strong>.
                    Escríbelo aquí para activar tu cuenta.
                </p>

                <label class="form-label">Código de confirmación</label>
                <input class="form-control codigo-input"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="000000"
                       @bind="codigoConfirmacion"
                       @bind:event="oninput" />

                <button class="btn btn-primary w-100 mt-3"
                        disabled="@cargando"
                        @onclick="ConfirmarCodigo">
                    @(cargando ? "Validando..." : "Validar código")
                </button>

                <button class="btn btn-link w-100 mt-2"
                        disabled="@cargando"
                        @onclick="CambiarDatos">
                    Cambiar datos o reenviar código
                </button>
            </div>
        }

        <div class="text-center mt-3">
            <small class="text-muted">
                ¿Ya tienes cuenta?
                <a href="/login">Iniciar sesión</a>
            </small>
        </div>
    </div>
</div>

@if (registroConfirmado)
{
    <div class="registro-modal-backdrop">
        <div class="registro-modal">
            <span class="modal-icon">OK</span>
            <h3>Cuenta confirmada</h3>
            <p>
                Felicitaciones, tu cuenta ha sido registrada correctamente.
                Bienvenido a la Polla Mundial.
            </p>
            <button class="btn btn-primary w-100" @onclick="IrLogin">
                Iniciar sesión
            </button>
        </div>
    </div>
}

@code {
    private RegistroUsuarioDTO model = new();
    private string? error;
    private string? mensaje;
    private bool cargando;
    private bool codigoEnviado;
    private bool registroConfirmado;
    private bool mostrarPassword;
    private string codigoConfirmacion = "";
    private string emailPendiente = "";

    private string TipoPassword => mostrarPassword ? "text" : "password";

    private async Task Registrar()
    {
        error = null;
        mensaje = null;

        if (string.IsNullOrWhiteSpace(model.Nombre) ||
            string.IsNullOrWhiteSpace(model.Email) ||
            string.IsNullOrWhiteSpace(model.Password))
        {
            error = "Nombre, correo y contraseña son obligatorios.";
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            error = "Las contraseñas no coinciden.";
            return;
        }

        try
        {
            cargando = true;

            await UsuariosService.RegistrarUsuarioAsync(new RegistroUsuarioDTO
            {
                Nombre = model.Nombre,
                Email = model.Email,
                Password = model.Password
            });

            emailPendiente = model.Email.Trim();
            codigoConfirmacion = "";
            codigoEnviado = true;
            mensaje = "Te enviamos un código de 6 dígitos al correo registrado.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConfirmarCodigo()
    {
        error = null;
        mensaje = null;

        var codigo = (codigoConfirmacion ?? "").Trim();
        if (codigo.Length != 6 || !codigo.All(char.IsDigit))
        {
            error = "Escribe el código de 6 dígitos que llegó a tu correo.";
            return;
        }

        try
        {
            cargando = true;
            var apiError = await UsuariosService.ConfirmarCodigoCorreoAsync(new ConfirmarCodigoCorreoDTO
            {
                Email = emailPendiente,
                Codigo = codigo
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            registroConfirmado = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarDatos()
    {
        codigoEnviado = false;
        codigoConfirmacion = "";
        mensaje = null;
        error = null;
    }

    private void IrLogin()
    {
        Navigation.NavigateTo("/login", true);
    }
}
