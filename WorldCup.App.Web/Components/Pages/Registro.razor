@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services
@inject WorldCup.App.Shared.Services.UsuariosService UsuariosService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@page "/registro"

<div class="registro-page">
    <div class="registro-card">
        <div class="registro-header">
            <div>
                <h3>Crear cuenta</h3>
                <p>Registrate y valida tu correo con un codigo seguro.</p>
            </div>
        </div>

        @if (error != null)
        {
            <div class="alert alert-danger mt-3">
                @error
            </div>
        }

        @if (mensaje != null)
        {
            <div class="alert alert-success mt-3">
                @mensaje
            </div>
        }

        @if (!codigoEnviado)
        {
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input class="form-control" placeholder="Tu nombre" @bind="model.Nombre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email" class="form-control" placeholder="correo@ejemplo.com" @bind="model.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contrasena</label>
                <input type="@TipoPassword" class="form-control" @bind="model.Password" />
            </div>

            <div class="mb-2">
                <label class="form-label">Confirmar contrasena</label>
                <input type="@TipoPassword" class="form-control" @bind="model.ConfirmPassword" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mostrarPassword" @bind="mostrarPassword" />
                <label class="form-check-label" for="mostrarPassword">
                    Mostrar contrasenas
                </label>
            </div>

            <div class="legal-register-box">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" @bind="aceptaLegal" />
                    <span class="form-check-label">
                        Acepto los
                        <a href="/terminos-condiciones" target="_blank">Terminos y Condiciones</a>,
                        la <a href="/politica-privacidad" target="_blank">Politica de Privacidad</a>
                        y autorizo el
                        <a href="/tratamiento-datos" target="_blank">Tratamiento de Datos Personales</a>.
                    </span>
                </label>
                <small>
                    La plataforma no recauda, administra ni distribuye premios. Las reglas, cobros y pagos de cada polla son responsabilidad de su organizador.
                </small>
            </div>

            <button class="btn btn-success w-100 mt-2"
                    disabled="@cargando"
                    @onclick="Registrar">
                @(cargando ? "Enviando codigo..." : "Crear cuenta")
            </button>
        }
        else
        {
            <div class="codigo-panel">
                <span class="codigo-badge">Codigo enviado</span>
                <h4>Revisa tu correo</h4>
                <p>
                    Enviamos un codigo de 6 digitos a <strong>@emailPendiente</strong>.
                    Escribelo aqui para activar tu cuenta. Revisa tambien la carpeta de spam o correo no deseado.
                </p>

                <label class="form-label">Codigo de confirmacion</label>
                <input class="form-control codigo-input"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="000000"
                       @bind="codigoConfirmacion"
                       @bind:event="oninput" />

                <button class="btn btn-primary w-100 mt-3"
                        disabled="@cargando"
                        @onclick="ConfirmarCodigo">
                    @(cargando ? "Validando..." : "Validar codigo")
                </button>

                <button class="btn btn-link w-100 mt-2"
                        disabled="@cargando"
                        @onclick="ReenviarCodigo">
                    Reenviar codigo
                </button>

                <button class="btn btn-link w-100"
                        disabled="@cargando"
                        @onclick="CambiarDatos">
                    Cambiar datos
                </button>
            </div>
        }

        <div class="text-center mt-3">
            <small class="text-muted">
                Ya tienes cuenta?
                <a href="@LoginUrl">Iniciar sesion</a>
            </small>
        </div>
    </div>
</div>

@if (registroConfirmado)
{
    <div class="registro-modal-backdrop">
        <div class="registro-modal">
            <span class="modal-icon">OK</span>
            <h3>Cuenta confirmada</h3>
            <p>
                Felicitaciones, tu cuenta ha sido registrada correctamente.
                Bienvenido a la Polla Mundial.
            </p>
            <button class="btn btn-primary w-100" @onclick="IrLogin">
                Iniciar sesion
            </button>
        </div>
    </div>
}

@code {
    private RegistroUsuarioDTO model = new();
    private string? error;
    private string? mensaje;
    private bool cargando;
    private bool codigoEnviado;
    private bool registroConfirmado;
    private bool mostrarPassword;
    private bool aceptaLegal;
    private string codigoConfirmacion = "";
    private string emailPendiente = "";

    [Parameter, SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    private string TipoPassword => mostrarPassword ? "text" : "password";
    private string LoginUrl => string.IsNullOrWhiteSpace(returnUrl)
        ? "/login"
        : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

    private async Task Registrar()
    {
        error = null;
        mensaje = null;

        if (string.IsNullOrWhiteSpace(model.Nombre) ||
            string.IsNullOrWhiteSpace(model.Email) ||
            string.IsNullOrWhiteSpace(model.Password))
        {
            error = "Nombre, correo y contrasena son obligatorios.";
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            error = "Las contrasenas no coinciden.";
            return;
        }

        if (!aceptaLegal)
        {
            error = "Debes aceptar los terminos, la politica de privacidad y el tratamiento de datos para crear la cuenta.";
            return;
        }

        try
        {
            cargando = true;

            await UsuariosService.RegistrarUsuarioAsync(new RegistroUsuarioDTO
            {
                Nombre = model.Nombre,
                Email = model.Email,
                Password = model.Password,
                VersionLegal = LegalService.VersionActual,
                AceptaTerminos = true,
                AceptaPoliticaPrivacidad = true,
                AceptaTratamientoDatos = true
            });

            emailPendiente = model.Email.Trim();
            codigoConfirmacion = "";
            codigoEnviado = true;
            mensaje = "Te enviamos un codigo de 6 digitos al correo registrado. Puede tardar unos minutos.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
            if (error.Contains("no has confirmado", StringComparison.OrdinalIgnoreCase) ||
                error.Contains("reenviar codigo", StringComparison.OrdinalIgnoreCase))
            {
                emailPendiente = model.Email.Trim();
                codigoEnviado = true;
                mensaje = "Esta cuenta quedó pendiente de confirmación. Puedes reenviar el código y revisar bandeja de entrada, promociones y spam.";
                error = null;
            }
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ConfirmarCodigo()
    {
        error = null;
        mensaje = null;

        var codigo = (codigoConfirmacion ?? "").Trim();
        if (codigo.Length != 6 || !codigo.All(char.IsDigit))
        {
            error = "Escribe el codigo de 6 digitos que llego a tu correo.";
            return;
        }

        try
        {
            cargando = true;
            var apiError = await UsuariosService.ConfirmarCodigoCorreoAsync(new ConfirmarCodigoCorreoDTO
            {
                Email = emailPendiente,
                Codigo = codigo
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            registroConfirmado = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ReenviarCodigo()
    {
        error = null;
        mensaje = null;

        if (string.IsNullOrWhiteSpace(emailPendiente))
        {
            error = "No hay un correo pendiente para reenviar.";
            return;
        }

        try
        {
            cargando = true;
            var apiError = await UsuariosService.ReenviarCodigoCorreoAsync(new ReenviarCodigoCorreoDTO
            {
                Email = emailPendiente
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            codigoConfirmacion = "";
            mensaje = "Te reenviamos un codigo nuevo. Revisa tu bandeja, promociones y spam.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void CambiarDatos()
    {
        codigoEnviado = false;
        codigoConfirmacion = "";
        mensaje = null;
        error = null;
    }

    private void IrLogin()
    {
        Navigation.NavigateTo(LoginUrl, true);
    }
}
