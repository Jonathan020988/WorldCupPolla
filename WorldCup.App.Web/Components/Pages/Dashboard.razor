@page "/dashboard"
@rendermode InteractiveServer

@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SesionService Sesion


<h3 class="mb-4">🏆 Mis Pollas</h3>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(mensajeError ? "alert-danger" : "alert-success")">
        @mensaje
    </div>
}

@if (pollas == null || !pollas.Any())
{
    <div class="alert alert-info">
        No tienes pollas aún.
        <br />
        <a class="btn btn-success btn-sm mt-2" href="/crear-polla">
            + Crear nueva polla
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in pollas)
        {
            <div class="col-md-4" @key="p.Id">
                <div class="card shadow-sm polla-card">
                    <div class="card-body">
                        <h5 class="card-title mb-1">⚽ @p.Nombre</h5>

                        <small class="text-muted">
                            📅 @p.FechaCreacion.ToString("dd/MM/yyyy")
                        </small>
                        <div class="d-flex align-items-center mt-3">
                            <!-- Estado -->
                            <span class="badge bg-success">Activa</span>

                            <!-- Entrar centrado -->
                            <div class="flex-grow-1 text-center">
                                <NavLink class="btn btn-sm btn-outline-primary"
                                         href="@($"/polla/{p.Id}")">
                                    Entrar ▶
                                </NavLink>
                            </div>

                            @if (p.CreadorId == Sesion.UsuarioId)
                            {
                                <!-- Eliminar a la derecha -->
                                <button class="btn btn-sm btn-danger d-flex align-items-center gap-1"
                                        title="Eliminar polla"
                                        @onclick="() => ConfirmarEliminar(p)">
                                    🗑 <span>Eliminar</span>
                                </button>
                            }

                        </div>

                        
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {

    private List<PollaDto> pollas = new();
    private string? mensaje;
    private bool mensajeError;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sesion.RestaurarSesionAsync();

            if (!Sesion.EstaLogueado)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);
            StateHasChanged();
        }
    }
   

    private async Task ConfirmarEliminar(PollaDto pollaEliminar)
    {
        var pollaId = pollaEliminar.Id;

        if (pollaEliminar.CantidadParticipantes > 1)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Primero debes eliminar los usuarios de la polla antes de eliminarla.");
            return;
        }

        var confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "⚠️ ¿Seguro que deseas eliminar esta polla?\n\nEsta acción NO se puede deshacer."
        );

        if (!confirmar)
            return;

        try
        {
            if (!Sesion.UsuarioId.HasValue)
            {
                mensaje = "Debes iniciar sesión para eliminar una polla.";
                mensajeError = true;
                return;
            }

            // 1️⃣ Eliminar en backend
            await PollasService.EliminarPollaAsync(pollaId, Sesion.UsuarioId.Value);

            // 2️⃣ Eliminar del listado LOCAL (CLAVE 🔑)
            var polla = pollas.FirstOrDefault(p => p.Id == pollaId);
            if (polla != null)
                pollas.Remove(polla);

            if (Sesion.PollaActivaId == pollaId)
            {
                await Sesion.LimpiarPollaActivaAsync();
            }

            mensaje = "Polla eliminada correctamente.";
            mensajeError = false;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            mensajeError = true;
        }
    }
}

<style>
    .polla-card {
        border-left: 4px solid #198754;
        border-radius: 10px;
    }
</style>

