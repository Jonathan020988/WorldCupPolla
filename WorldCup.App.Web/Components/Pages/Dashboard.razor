@page "/dashboard"

@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@inject PollasService PollasService
@inject NavigationManager Navigation

<h3 class="mb-4">🏆 Mis Pollas</h3>

@if (!pollas.Any())
{
    <div class="alert alert-info">
        No tienes pollas aún.
        <br />
        <a class="btn btn-success btn-sm mt-2" href="/crear-polla">
            + Crear nueva polla
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in pollas)
        {
            <div class="col-md-4">
                <div class="card shadow-sm polla-card">
                    <div class="card-body">
                        <h5 class="card-title mb-1">⚽ @p.Nombre</h5>

                        <small class="text-muted">
                            📅 @p.FechaCreacion.ToString("dd/MM/yyyy")
                        </small>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge bg-success">Activa</span>

                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => EntrarPolla(p.Id)">
                                Entrar ▶
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PollaDto> pollas = new();

    protected override async Task OnInitializedAsync()
    {
        int usuarioId = 1; // luego saldrá del login
        pollas = await PollasService.GetPollasPorUsuarioAsync(usuarioId);
    }

    private void EntrarPolla(int pollaId)
    {
        Navigation.NavigateTo($"/polla/{pollaId}");
    }
}

<style>
    .polla-card {
        border-left: 4px solid #198754;
        border-radius: 10px;
    }
</style>
