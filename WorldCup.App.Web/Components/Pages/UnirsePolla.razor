@page "/unirse-polla/{PollaId:int}"
@rendermode InteractiveServer

@using System.Globalization
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http
@inject PollasService PollasService

<div class="join-page">
    @if (cargandoPolla)
    {
        <div class="join-card text-center">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-3 mb-0">Cargando informacion de la polla...</p>
        </div>
    }
    else if (polla == null)
    {
        <div class="join-card">
            <div class="alert alert-danger mb-0">
                No pudimos encontrar esta polla. Revisa que el enlace este completo.
            </div>
        </div>
    }
    else
    {
        <section class="join-hero">
            <div class="join-hero-content">
                <span class="join-kicker">Invitacion a la polla</span>
                <h2>@polla.Nombre</h2>
                <p>
                    Antes de ingresar puedes revisar las condiciones de la polla. Cuando tengas tu cuenta activa,
                    escribes el PIN y quedas participando.
                </p>
            </div>

            <div class="join-status-pill">
                @polla.CantidadParticipantes participante@(polla.CantidadParticipantes == 1 ? "" : "s")
            </div>
        </section>

        @if (mensaje != null)
        {
            <div class="alert @(esError ? "alert-danger" : "alert-success")">
                @mensaje
            </div>
        }

        <div class="join-grid">
            <section class="join-card join-description-card">
                <div class="join-section-title">
                    <span>Descripcion</span>
                </div>

                @if (string.IsNullOrWhiteSpace(polla.Descripcion))
                {
                    <p class="text-muted mb-0">
                        El creador todavia no agrego una descripcion para esta polla.
                    </p>
                }
                else
                {
                    <div class="join-description">@polla.Descripcion</div>
                }
            </section>

            <aside class="join-card join-side-card">
                <div class="join-info-row">
                    <span>Valor</span>
                    <strong>@ValorInscripcionTexto</strong>
                </div>

                <div class="join-info-row">
                    <span>Cupo</span>
                    <strong>@CupoTexto</strong>
                </div>

                @if (PollaSinCupos)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        Esta polla ya llegó al límite de usuarios. El creador debe solicitar una ampliación para permitir más ingresos.
                    </div>
                }

                @if (!polla.InscripcionesAbiertas)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        Las inscripciones de esta polla estan cerradas. Contacta al administrador de la polla si necesitas ingresar.
                    </div>
                }

                <div class="join-payment">
                    <span>Metodo de pago</span>
                    <p>@MetodoPagoTexto</p>
                </div>

                @if (!Sesion.EstaLogueado)
                {
                    <div class="join-action-box">
                        <h5>Primero crea tu cuenta</h5>
                        <p>
                            Para proteger la polla, primero debes registrarte o iniciar sesion.
                            Despues volveras a esta pantalla para ingresar el PIN.
                        </p>

                        <a class="btn btn-success w-100" href="@RegistroUrl">
                            Crear cuenta
                        </a>

                        <a class="btn btn-outline-primary w-100 mt-2" href="@LoginUrl">
                            Ya tengo cuenta
                        </a>
                    </div>
                }
                else
                {
                    <div class="join-pin-box">
                        <h5>Ingresar con PIN</h5>
                        <p>
                            Estas como <strong>@Sesion.Nombre</strong>. Escribe el PIN de 4 digitos para unirte.
                        </p>

                        <input class="form-control join-pin-input"
                               placeholder="0000"
                               inputmode="numeric"
                               maxlength="4"
                               @bind="pinIngreso"
                               @bind:event="oninput" />

                        <button class="btn btn-primary w-100 mt-3"
                                disabled="@(procesando || !polla.InscripcionesAbiertas)"
                                @onclick="Unirse">
                            @(procesando ? "Validando..." : "Unirme a esta polla")
                        </button>

                        @if (yaEsMiembro)
                        {
                            <button class="btn btn-outline-success w-100 mt-2"
                                    @onclick="IrAPolla">
                                Ir al detalle de la polla
                            </button>
                        }
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo CulturaColombia = CultureInfo.GetCultureInfo("es-CO");

    private string? mensaje;
    private bool esError;
    private bool cargandoPolla = true;
    private bool procesando;
    private bool yaEsMiembro;
    private PollaDto? polla;
    private string pinIngreso = "";

    [Parameter]
    public int PollaId { get; set; }

    private string ReturnUrl => $"/unirse-polla/{PollaId}";
    private string RegistroUrl => $"/registro?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
    private string LoginUrl => $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string ValorInscripcionTexto =>
        polla?.ValorInscripcion.HasValue == true && polla.ValorInscripcion.Value > 0
            ? polla.ValorInscripcion.Value.ToString("C0", CulturaColombia)
            : "Por definir";

    private string MetodoPagoTexto =>
        string.IsNullOrWhiteSpace(polla?.MetodoPago)
            ? "El creador aun no ha definido el metodo de pago."
            : polla!.MetodoPago!;

    private string CupoTexto =>
        polla?.CuposIlimitados == true
            ? $"{polla.CantidadParticipantes} / ilimitado"
            :
        polla?.MaximoMiembros.HasValue == true && polla.MaximoMiembros.Value > 0
            ? $"{polla.CantidadParticipantes}/{polla.MaximoMiembros.Value}"
            : $"{polla?.CantidadParticipantes ?? 0}";

    private bool PollaSinCupos =>
        polla?.CuposIlimitados != true &&
        polla?.MaximoMiembros.HasValue == true &&
        polla.CantidadParticipantes >= polla.MaximoMiembros.Value;

    protected override async Task OnInitializedAsync()
    {
        await CargarPolla();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sesion.RestaurarSesionAsync();
            StateHasChanged();
        }
    }

    private async Task CargarPolla()
    {
        cargandoPolla = true;
        try
        {
            polla = await PollasService.GetPollaPublicaAsync(PollaId);
        }
        catch
        {
            polla = null;
        }
        finally
        {
            cargandoPolla = false;
        }
    }

    private async Task Unirse()
    {
        mensaje = null;
        esError = false;
        yaEsMiembro = false;

        if (!Sesion.EstaLogueado || Sesion.UsuarioId == null)
        {
            mensaje = "Debes crear una cuenta o iniciar sesion antes de ingresar el PIN.";
            esError = true;
            return;
        }

        if (polla?.InscripcionesAbiertas != true)
        {
            mensaje = "Las inscripciones de esta polla están cerradas. Contacta al administrador de la polla si necesitas ingresar.";
            esError = true;
            return;
        }

        var pin = (pinIngreso ?? "").Trim();
        if (pin.Length != 4 || !pin.All(char.IsDigit))
        {
            mensaje = "Escribe el PIN de 4 digitos que te compartio el creador.";
            esError = true;
            return;
        }

        var dto = new UnirsePollaDTO
        {
            PollaId = PollaId,
            UsuarioId = Sesion.UsuarioId!.Value,
            PinIngreso = pin
        };

        procesando = true;
        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/Polla/{PollaId}/unirse",
                dto);

            if (!response.IsSuccessStatusCode)
            {
                mensaje = await response.Content.ReadAsStringAsync();
                esError = true;
                yaEsMiembro = mensaje.Contains("Ya perteneces", StringComparison.OrdinalIgnoreCase);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ResultadoIngresoDTO>();

            if (result?.Ingreso == "directo")
            {
                mensaje = "Te uniste correctamente a la polla. Bienvenido.";
                esError = false;

                await InvokeAsync(StateHasChanged);
                await Task.Delay(2500);

                Navigation.NavigateTo($"/polla/{PollaId}");
            }
            else if (result?.Ingreso == "solicitud")
            {
                mensaje = "El PIN no coincide. Enviamos una solicitud al creador de la polla para que revise tu ingreso.";
                esError = false;
            }
        }
        finally
        {
            procesando = false;
        }
    }

    private void IrAPolla()
    {
        Navigation.NavigateTo($"/polla/{PollaId}");
    }
}

<style>
    .join-page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1rem;
    }

    .join-hero {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        padding: 1.25rem;
        border: 1px solid #d9eadf;
        border-radius: 8px;
        background: linear-gradient(135deg, #f7fff9 0%, #eef7ff 100%);
        margin-bottom: 1rem;
    }

    .join-hero-content h2 {
        margin: .25rem 0 .45rem;
        font-weight: 800;
        color: #102a1f;
    }

    .join-hero-content p {
        margin: 0;
        color: #4e6258;
        max-width: 720px;
    }

    .join-kicker {
        display: inline-flex;
        color: #087f5b;
        font-size: .8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .join-status-pill {
        flex: 0 0 auto;
        border-radius: 999px;
        background: #0f5132;
        color: #fff;
        padding: .45rem .8rem;
        font-size: .85rem;
        font-weight: 700;
    }

    .join-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 1rem;
    }

    .join-card {
        border: 1px solid #dbe3df;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 22px rgba(16, 42, 31, .06);
        padding: 1rem;
    }

    .join-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #41534a;
        font-size: .8rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .75rem;
    }

    .join-description {
        white-space: pre-line;
        line-height: 1.55;
        color: #16261f;
    }

    .join-side-card {
        align-self: start;
    }

    .join-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .75rem 0;
        border-bottom: 1px solid #eef2f0;
    }

    .join-info-row span,
    .join-payment span {
        color: #66766f;
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .join-info-row strong {
        color: #0f5132;
        font-size: 1.05rem;
    }

    .join-payment {
        padding: .85rem 0;
        border-bottom: 1px solid #eef2f0;
    }

    .join-payment p {
        margin: .35rem 0 0;
        color: #26352f;
        line-height: 1.4;
        white-space: pre-line;
    }

    .join-action-box,
    .join-pin-box {
        margin-top: 1rem;
        padding: .9rem;
        border-radius: 8px;
        background: #f7faf8;
        border: 1px solid #e4ece7;
    }

    .join-action-box h5,
    .join-pin-box h5 {
        margin: 0 0 .35rem;
        font-weight: 800;
        color: #102a1f;
    }

    .join-action-box p,
    .join-pin-box p {
        color: #5c6d65;
        font-size: .92rem;
        margin-bottom: .85rem;
    }

    .join-pin-input {
        text-align: center;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: .25rem;
    }

    @@media (max-width: 760px) {
        .join-page {
            padding: .75rem;
        }

        .join-hero {
            flex-direction: column;
            padding: 1rem;
        }

        .join-status-pill {
            width: 100%;
            text-align: center;
        }

        .join-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
