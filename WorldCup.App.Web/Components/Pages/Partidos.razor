    public async ValueTask DisposeAsync()
    {
        actualizacionEnVivoCts?.Cancel();

        if (actualizacionEnVivoTask != null)
        {
            try
            {
                await actualizacionEnVivoTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        actualizacionEnVivoCts?.Dispose();
    }

