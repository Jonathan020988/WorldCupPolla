    private static string EtiquetaMarcadorEnVivo(PartidoDto partido)
    {
        return partido.EstadoMarcadorEnVivo == "Finalizado"
            ? "FIFA FINAL"
            : "FIFA PROV.";
    }

    private void EditarResultadoAdmin(PartidoDto partido)
    {
        resultadosEnEdicion.Add(partido.Id);
    }

    private async Task GuardarResultadoAdmin(PartidoDto partido)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        erroresPartido.Remove(partido.Id);
        var estado = EstadoParaGuardar(partido);
        var clasificadoId = ClasificadoParaGuardar(partido);

        if (estado == "Finalizado" &&
            EsEliminatoria(partido) &&
            !clasificadoId.HasValue)
        {
            erroresPartido[partido.Id] =
                "Selecciona el equipo que clasificó. Si el marcador quedó empatado y fue por penales, ingresa ambos penales.";
            return;
        }

        var dto = new AdminResultadoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            Estado = estado,
            GolesLocal = partido.GolesLocal,
            GolesVisitante = partido.GolesVisitante,
            TiempoExtra = partido.TiempoExtra,
            ClasificadoId = clasificadoId,
            PenalesLocal = !PenalesDeshabilitados(partido) ? partido.PenalesLocal : null,
            PenalesVisitante = !PenalesDeshabilitados(partido) ? partido.PenalesVisitante : null
        };

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-resultado",
            dto);

        if (!response.IsSuccessStatusCode)
        {
            erroresPartido[partido.Id] =
                await response.Content.ReadAsStringAsync();
            return;
        }

        resultadosEnEdicion.Remove(partido.Id);
        await CargarPartidosAsync(detectarGoles: true);

        if (estado == "Finalizado")
        {
            await CargarAuditoriaRankingPartidoAsync(partido.Id);
        }
        else if (auditoriaRankingPartido?.PartidoId == partido.Id)
        {
            CerrarAuditoriaRanking();
        }
    }

    private async Task EliminarMarcadorAdmin(PartidoDto partido)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        erroresPartido.Remove(partido.Id);

        var dto = new AdminResultadoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            Estado = "Pendiente",
            GolesLocal = null,
            GolesVisitante = null,
            TiempoExtra = false,
            ClasificadoId = null,
            PenalesLocal = null,
            PenalesVisitante = null
        };

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-resultado",
            dto);

        if (!response.IsSuccessStatusCode)
        {
            erroresPartido[partido.Id] =
                await response.Content.ReadAsStringAsync();
            return;
        }

        resultadosEnEdicion.Remove(partido.Id);
        await CargarPartidosAsync();

        if (auditoriaRankingPartido?.PartidoId == partido.Id)
        {
            CerrarAuditoriaRanking();
        }
    }

    private async Task CargarAuditoriaRankingPartidoAsync(int partidoId)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            return;
        }

        cargandoAuditoriaRanking = true;
        mensajeAuditoriaRanking = null;
        errorAuditoriaRanking = false;

        try
        {
            var response = await Http.GetAsync(
                $"api/Partidos/{partidoId}/ranking-auditoria?adminUsuarioId={Sesion.UsuarioId.Value}");

            if (!response.IsSuccessStatusCode)
            {
                mensajeAuditoriaRanking = await response.Content.ReadAsStringAsync();
                errorAuditoriaRanking = true;
                return;
            }

            auditoriaRankingPartido =
                await response.Content.ReadFromJsonAsync<AuditoriaRankingPartidoDto>();
            pollaAuditoriaSeleccionadaId = auditoriaRankingPartido?.Pollas.FirstOrDefault()?.PollaId;
        }
        catch (Exception ex)
        {
            mensajeAuditoriaRanking = $"No se pudo cargar la revision de ranking: {ex.Message}";
            errorAuditoriaRanking = true;
        }
        finally
        {
            cargandoAuditoriaRanking = false;
        }
    }

    private async Task PublicarAuditoriaRanking()
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin || auditoriaRankingPartido == null)
        {
            return;
        }

        publicandoAuditoriaRanking = true;
        mensajeAuditoriaRanking = null;
        errorAuditoriaRanking = false;

        var dto = new AdminPublicarRankingPartidoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            PollaId = pollaAuditoriaSeleccionadaId
        };

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/Partidos/{auditoriaRankingPartido.PartidoId}/ranking-publicacion",
                dto);

            if (!response.IsSuccessStatusCode)
            {
                mensajeAuditoriaRanking = await response.Content.ReadAsStringAsync();
                errorAuditoriaRanking = true;
                return;
            }

            auditoriaRankingPartido =
                await response.Content.ReadFromJsonAsync<AuditoriaRankingPartidoDto>();

            if (pollaAuditoriaSeleccionadaId.HasValue &&
                auditoriaRankingPartido?.Pollas.Any(p => p.PollaId == pollaAuditoriaSeleccionadaId.Value) != true)
            {
                pollaAuditoriaSeleccionadaId = auditoriaRankingPartido?.Pollas.FirstOrDefault()?.PollaId;
            }

            mensajeAuditoriaRanking = "Revision publicada para este partido.";
            errorAuditoriaRanking = false;
        }
        catch (Exception ex)
        {
            mensajeAuditoriaRanking = $"No se pudo publicar la revision: {ex.Message}";
            errorAuditoriaRanking = true;
        }
        finally
        {
            publicandoAuditoriaRanking = false;
        }
    }

    private void SeleccionarPollaAuditoria(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pollaId))
        {
            pollaAuditoriaSeleccionadaId = pollaId;
        }
    }

    private AuditoriaRankingPollaDto? PollaAuditoriaSeleccionada()
    {
        return auditoriaRankingPartido?.Pollas
            .FirstOrDefault(p => p.PollaId == pollaAuditoriaSeleccionadaId) ??
            auditoriaRankingPartido?.Pollas.FirstOrDefault();
    }

    private void CerrarAuditoriaRanking()
    {
        var faseCrucesPendientes = FaseConCrucesPendientesDespuesAuditoria();

        auditoriaRankingPartido = null;
        pollaAuditoriaSeleccionadaId = null;
        mensajeAuditoriaRanking = null;
        errorAuditoriaRanking = false;
        cargandoAuditoriaRanking = false;
        publicandoAuditoriaRanking = false;

        if (!string.IsNullOrWhiteSpace(faseCrucesPendientes))
        {
            Navigation.NavigateTo(
                $"/admin?revisarCruces={Uri.EscapeDataString(faseCrucesPendientes)}");
        }
    }

    private string? FaseConCrucesPendientesDespuesAuditoria()
    {
        if (!Sesion.EsAdmin ||
            auditoriaRankingPartido?.Publicado != true)
        {
            return null;
        }

        var fase = auditoriaRankingPartido.Fase;
        var siguiente = FaseSiguienteParaCruces(fase);
        if (string.IsNullOrWhiteSpace(siguiente))
        {
            return null;
        }

        var partidosFase = partidos
            .Where(p => string.Equals(p.Fase, fase, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!partidosFase.Any() || partidosFase.Any(p => !p.Finalizado))
        {
            return null;
        }

        var siguienteGenerada = fase == "Semifinales"
            ? partidos.Any(p => p.Fase == "Final") &&
              partidos.Any(p => p.Fase == "TercerPuesto")
            : partidos.Any(p => p.Fase == siguiente);

        return siguienteGenerada ? null : fase;
    }

    private static string? FaseSiguienteParaCruces(string fase)
    {
        return fase switch
        {
            "Grupos" => "Dieciseisavos",
            "Dieciseisavos" => "Octavos",
            "Octavos" => "Cuartos",
            "Cuartos" => "Semifinales",
            "Semifinales" => "Final",
            _ => null
        };
    }

    private static string PuntosConSigno(int puntos)
    {
        return puntos > 0
            ? $"+{puntos}"
            : puntos.ToString(CultureInfo.InvariantCulture);
    }

    private static string ClaseCambioPuntos(int puntos)
    {
        return puntos switch
        {
            > 0 => "ranking-audit-points",
            < 0 => "ranking-audit-points negative",
            _ => "ranking-audit-points zero"
        };
    }

    private async Task LlenarAleatorioVisible()
    {
        if (!PuedeUsarHerramientasMasivas())
        {
            return;
        }

        procesandoMasivo = true;
        mensajeAdminMasivo = null;
        errorAdminMasivo = false;

        var objetivo = PartidosObjetivoAdmin().ToList();

        foreach (var partido in objetivo)
        {
            AplicarMarcadorAleatorio(partido);
            resultadosEnEdicion.Add(partido.Id);
            await GuardarResultadoAdmin(partido);
        }

        mensajeAdminMasivo = $"Se llenaron aleatoriamente {objetivo.Count} partidos visibles.";
        procesandoMasivo = false;
    }

    private async Task FinalizarVisibles()
    {
        if (!PuedeUsarHerramientasMasivas())
        {
            return;
        }

        procesandoMasivo = true;
        mensajeAdminMasivo = null;
        errorAdminMasivo = false;

        var objetivo = PartidosObjetivoAdmin().ToList();

        foreach (var partido in objetivo)
        {
            if (!partido.GolesLocal.HasValue || !partido.GolesVisitante.HasValue)
            {
                AplicarMarcadorAleatorio(partido);
            }

            if (partido.Fase != "Grupos" &&
                partido.GolesLocal == partido.GolesVisitante &&
                (!partido.PenalesLocal.HasValue ||
                 !partido.PenalesVisitante.HasValue ||
                 partido.PenalesLocal == partido.PenalesVisitante))
            {
                partido.TiempoExtra = true;
                AplicarPenalesAleatorios(partido);
            }

            partido.Estado = "Finalizado";
            partido.ClasificadoId = ClasificadoParaGuardar(partido);
            resultadosEnEdicion.Add(partido.Id);
            await GuardarResultadoAdmin(partido);
        }

        mensajeAdminMasivo = $"Se finalizaron {objetivo.Count} partidos visibles.";
        procesandoMasivo = false;
    }

    private bool PuedeUsarHerramientasMasivas()
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin || !herramientasPruebaHabilitadas)
        {
            return false;
        }

        if (!partidosFiltrados.Any())
        {
            mensajeAdminMasivo = "No hay partidos visibles para procesar.";
            errorAdminMasivo = true;
            return false;
        }

        return true;
    }

    private IEnumerable<PartidoDto> PartidosObjetivoAdmin()
    {
        return partidosFiltrados
            .Where(p => p.Estado != "Postergado")
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id);
    }

    private static void AplicarMarcadorAleatorio(PartidoDto partido)
    {
        partido.GolesLocal = Random.Shared.Next(0, 5);
        partido.GolesVisitante = Random.Shared.Next(0, 5);

        if (partido.Fase == "Grupos" || partido.GolesLocal != partido.GolesVisitante)
        {
            partido.TiempoExtra = false;
            partido.ClasificadoId = partido.Fase == "Grupos"
                ? null
                : partido.GolesLocal > partido.GolesVisitante
                    ? partido.LocalId
                    : partido.VisitanteId;
            partido.PenalesLocal = null;
            partido.PenalesVisitante = null;
            return;
        }

        partido.TiempoExtra = true;
        AplicarPenalesAleatorios(partido);
        partido.ClasificadoId = partido.PenalesLocal > partido.PenalesVisitante
            ? partido.LocalId
            : partido.VisitanteId;
    }

    private static void AplicarPenalesAleatorios(PartidoDto partido)
    {
        partido.PenalesLocal = Random.Shared.Next(3, 7);
        partido.PenalesVisitante = Random.Shared.Next(3, 7);

        if (partido.PenalesLocal == partido.PenalesVisitante)
        {
            partido.PenalesVisitante++;
        }
    }

