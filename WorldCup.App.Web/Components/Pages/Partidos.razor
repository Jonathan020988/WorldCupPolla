@page "/partidos"
@rendermode InteractiveServer
@using WorldCup.App.Shared.Models
@using System.Globalization
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.SesionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    body {
        background-color: #0b3d2e;
    }

    .page-bg {
        background: linear-gradient(180deg, #0b3d2e 0%, #145a32 100%);
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .page-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
        margin-bottom: 1.5rem;
    }

    .fase-tabs {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
        margin-bottom: 2rem;
    }

    .team-filter {
        background: white;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: end;
        gap: .75rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .team-filter > div {
        min-width: min(100%, 320px);
    }

    .fase-btn {
        border-radius: 20px;
        padding: .45rem 1rem;
        font-weight: 500;
    }

    .match-card {
        background: white;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.12);
        border-left: 6px solid #198754;
    }

    .score {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .admin-result {
        display: grid;
        grid-template-columns: minmax(130px, 1fr) 90px 90px minmax(120px, auto) 90px 90px minmax(220px, auto);
        gap: .5rem;
        align-items: center;
    }

    .extra-time-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        min-height: 31px;
        margin: 0;
        padding: .25rem .45rem;
        border: 1px solid #d7dee8;
        border-radius: 6px;
        background: #f8fafc;
        color: #344054;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .resultado-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .35rem;
    }

    .admin-test-tools {
        background: #fff;
        border: 1px solid #d9e5df;
        border-left: 5px solid #ffc107;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .admin-test-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .5rem;
    }

    .partidos-phase-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin: 1.3rem 0 .75rem;
        padding: .8rem 1rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .partidos-phase-title strong {
        display: block;
        color: #173b2f;
        font-size: 1.05rem;
    }

    .partidos-phase-title small {
        color: #667085;
        font-weight: 700;
    }

    .phase-collapse-btn {
        border: 1px solid #cfd8e3;
        border-radius: 999px;
        background: #ffffff;
        color: #344054;
        padding: .28rem .7rem;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .phase-collapse-btn:hover,
    .phase-collapse-btn:focus-visible {
        background: #f2f4f7;
    }

    .phase-collapsed-summary {
        margin-bottom: .9rem;
        padding: .75rem .9rem;
        border: 1px dashed #cfd8e3;
        border-radius: 12px;
        background: rgba(255, 255, 255, .92);
        color: #667085;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
    }

    @@media (max-width: 576px) {
        .admin-result {
            grid-template-columns: 1fr 1fr;
        }

        .team-filter {
            align-items: stretch;
            flex-direction: column;
        }

        .admin-test-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .partidos-phase-title {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="page-bg">
    <div class="container">

        <!-- HEADER -->
        <div class="page-header">
            <h1 class="fw-bold mb-1">⚽ Partidos del Mundial</h1>
            <p class="text-muted mb-0">
                Resultados y estado de todos los partidos
            </p>
        </div>

        <!-- FILTRO DE FASES -->
        <div class="fase-tabs">
            @foreach (var fase in fasesOrdenadas)
            {
                <button class="@GetFaseButtonClass(fase)"
                        @onclick="() => FiltrarPorFase(GetFaseValue(fase))">
                    @fase
                </button>



            }
        </div>

        <div class="team-filter">
            <div>
                <label class="form-label fw-bold mb-1">Filtrar por país</label>
                <select class="form-select"
                        value="@paisFiltro"
                        @onchange="CambiarPais">
                    <option value="">Todos los países</option>
                    @foreach (var pais in PaisesDisponibles())
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fecha</label>
                <input class="form-control"
                       type="date"
                       @bind="fechaFiltro"
                       @bind:after="AplicarFiltros" />
            </div>

            @if (FiltrosActivos())
            {
                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Ver todos
                </button>
            }
        </div>

        @if (Sesion.EsAdmin)
        {
            <div class="admin-test-tools">
                <label class="form-check mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="herramientasPruebaHabilitadas" />
                    <span class="form-check-label fw-bold">
                        Habilitar herramientas de prueba para partidos visibles
                    </span>
                </label>

                <div class="admin-test-actions">
                    <button class="btn btn-sm btn-outline-warning"
                            disabled="@(!herramientasPruebaHabilitadas || procesandoMasivo)"
                            @onclick="LlenarAleatorioVisible">
                        Llenado aleatorio
                    </button>
                    <button class="btn btn-sm btn-outline-success"
                            disabled="@(!herramientasPruebaHabilitadas || procesandoMasivo)"
                            @onclick="FinalizarVisibles">
                        Finalizar visibles
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(mensajeAdminMasivo))
        {
            <div class="alert @(errorAdminMasivo ? "alert-danger" : "alert-success")">
                @mensajeAdminMasivo
            </div>
        }

        <!-- PARTIDOS -->
        @if (!partidosFiltrados.Any())
        {
            <div class="page-header">
                <p class="text-muted mb-0">No hay partidos para esta fase.</p>
            </div>
        }
        else
        {
            @foreach (var fase in partidosFiltrados
                    .GroupBy(p => p.Fase)
                    .OrderBy(g => OrdenFase(g.Key)))
            {
                var faseNombre = fase.Key;
                var faseFinalizada = FaseFinalizada(faseNombre);
                var faseMinimizada = FaseMinimizada(faseNombre);

                <div class="partidos-phase-title">
                    <div>
                        <strong>@NombreFase(faseNombre)</strong>
                        <small>@fase.Count() partidos visibles</small>
                    </div>

                    @if (faseFinalizada)
                    {
                        <button type="button"
                                class="phase-collapse-btn"
                                @onclick="() => ToggleFaseMinimizada(faseNombre)">
                            @(faseMinimizada ? "Mostrar fase" : "Minimizar fase")
                        </button>
                    }
                </div>

                @if (faseMinimizada)
                {
                    <div class="phase-collapsed-summary">
                        @NombreFase(faseNombre) finalizada. @fase.Count() partidos ocultos para navegar más rápido.
                    </div>
                }
                else
                {
                    @foreach (var p in fase.OrderBy(p => p.Fecha).ThenBy(p => p.Id))
                    {
                        <div class="match-card">
                            <span class="badge bg-success mb-2">@p.Fase</span>

                            <div class="row align-items-center text-center">
                                <div class="col-5 fw-bold text-end">@p.Local</div>

                                <div class="col-2 score">
                                    @if (p.Finalizado)
                                    {
                                        @($"{p.GolesLocal} - {p.GolesVisitante}")
                                        @if (p.Fase != "Grupos" && p.TiempoExtra)
                                        {
                                            <div class="small text-muted">
                                                T. extra
                                            </div>
                                        }
                                        @if (p.Fase != "Grupos" &&
                                       p.GolesLocal == p.GolesVisitante &&
                                       p.PenalesLocal.HasValue &&
                                       p.PenalesVisitante.HasValue)
                                        {
                                            <div class="small text-muted">
                                                Pen. @p.PenalesLocal - @p.PenalesVisitante
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }

                                </div>


                                <div class="col-5 fw-bold text-start">@p.Visitante</div>
                            </div>

                            <div class="text-center text-muted mt-1" style="font-size: 0.9rem;">
                                @p.Fecha.ToString(
                                         "dddd dd 'de' MMMM 'de' yyyy · HH:mm",
                                         new CultureInfo("es-CO")
                                         )
                            </div>

                            <div class="text-center mt-2">
                                <span class="@GetEstadoBadgeClass(p.Estado)">
                                    @p.Estado
                                </span>
                            </div>

                            @if (Sesion.EsAdmin)
                            {
                                var resultadoEditable = ResultadoEditable(p);
                                var tieneResultado = TieneResultadoReal(p);

                                <div class="admin-result mt-3">
                                    <select class="form-select form-select-sm"
                                            disabled="@(!resultadoEditable)"
                                            @bind="p.Estado">
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="EnJuego">En juego</option>
                                        <option value="Postergado">Postergado</option>
                                        <option value="Finalizado">Finalizado</option>
                                    </select>

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Local"
                                           disabled="@(!resultadoEditable)"
                                           @bind="p.GolesLocal" />

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Visitante"
                                           disabled="@(!resultadoEditable)"
                                           @bind="p.GolesVisitante" />

                                    <label class="extra-time-check">
                                        <input class="form-check-input mt-0"
                                               type="checkbox"
                                               disabled="@(!resultadoEditable || !EsEliminatoria(p))"
                                               @bind="p.TiempoExtra" />
                                        <span>T. extra</span>
                                    </label>

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Pen. local"
                                           disabled="@(!resultadoEditable || PenalesDeshabilitados(p))"
                                           @bind="p.PenalesLocal" />

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Pen. visit."
                                           disabled="@(!resultadoEditable || PenalesDeshabilitados(p))"
                                           @bind="p.PenalesVisitante" />

                                    <div class="resultado-actions">
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(!resultadoEditable)"
                                                @onclick="() => GuardarResultadoAdmin(p)">
                                            Guardar
                                        </button>

                                        <button class="btn btn-sm btn-outline-secondary"
                                                disabled="@(resultadoEditable || !tieneResultado)"
                                                @onclick="() => EditarResultadoAdmin(p)">
                                            Editar
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                disabled="@(!tieneResultado)"
                                                @onclick="() => EliminarMarcadorAdmin(p)">
                                            Eliminar marcador
                                        </button>
                                    </div>
                                </div>

                                @if (erroresPartido.ContainsKey(p.Id))
                                {
                                    <div class="alert alert-danger mt-2 mb-0 py-2">
                                        @erroresPartido[p.Id]
                                    </div>
                                }
                            }

                        </div>
                    }
                }
            }
        }
    </div>
</div>

@code {

    private List<PartidoDto> partidos = new();
    private List<PartidoDto> partidosFiltrados = new();
    private Dictionary<int, string> erroresPartido = new();
    private HashSet<int> resultadosEnEdicion = new();
    private HashSet<int> resultadosPersistidos = new();
    private HashSet<string> fasesMinimizadas = new(StringComparer.OrdinalIgnoreCase);

    private string? faseSeleccionada;
    private string? paisFiltro;
    private DateTime? fechaFiltro;
    private bool herramientasPruebaHabilitadas;
    private bool procesandoMasivo;
    private string? mensajeAdminMasivo;
    private bool errorAdminMasivo;

    private readonly List<string> fasesOrdenadas = new()
    {
        "Todas",
        "Grupos",
        "Dieciseisavos",
        "Octavos",
        "Cuartos",
        "Semifinales",
        "TercerPuesto",
        "Final"
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarPartidosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();
        StateHasChanged();
    }

    private void FiltrarPorFase(string? fase)
    {
        faseSeleccionada = fase;
        AplicarFiltros();
    }

    private void CambiarPais(ChangeEventArgs e)
    {
        paisFiltro = e.Value?.ToString();
        AplicarFiltros();
    }

    private void LimpiarFiltros()
    {
        paisFiltro = null;
        fechaFiltro = null;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var query = string.IsNullOrEmpty(faseSeleccionada)
            ? partidos
            : partidos.Where(p => p.Fase == faseSeleccionada).ToList();

        if (!string.IsNullOrWhiteSpace(paisFiltro))
        {
            query = query
                .Where(p =>
                    string.Equals(p.Local, paisFiltro, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(p.Visitante, paisFiltro, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (fechaFiltro.HasValue)
        {
            query = query
                .Where(p => p.Fecha.Date == fechaFiltro.Value.Date)
                .ToList();
        }

        partidosFiltrados = query;
    }

    private bool FiltrosActivos()
    {
        return !string.IsNullOrWhiteSpace(paisFiltro) || fechaFiltro.HasValue;
    }

    private List<string> PaisesDisponibles()
    {
        return partidos
            .SelectMany(p => new[] { p.Local, p.Visitante })
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(p => p)
            .ToList();
    }

    private string GetFaseButtonClass(string fase)
    {
        var isActive =
            (fase == "Todas" && faseSeleccionada == null) ||
            (faseSeleccionada == fase);

        return isActive
            ? "btn btn-success fase-btn"
            : "btn btn-outline-success fase-btn";
    }

    private string? GetFaseValue(string fase)
    {
        return fase == "Todas" ? null : fase;
    }

    private int OrdenFase(string fase)
    {
        var index = fasesOrdenadas.IndexOf(fase);
        return index < 0 ? 99 : index;
    }

    private string NombreFase(string fase)
    {
        return fase switch
        {
            "TercerPuesto" => "Tercer puesto",
            _ => fase
        };
    }

    private bool FaseFinalizada(string fase)
    {
        return partidos.Any(p => p.Fase == fase) &&
               partidos.Where(p => p.Fase == fase).All(p => p.Finalizado);
    }

    private bool FaseMinimizada(string fase)
    {
        return FaseFinalizada(fase) && fasesMinimizadas.Contains(fase);
    }

    private void ToggleFaseMinimizada(string fase)
    {
        if (!FaseFinalizada(fase))
        {
            fasesMinimizadas.Remove(fase);
            return;
        }

        if (!fasesMinimizadas.Add(fase))
        {
            fasesMinimizadas.Remove(fase);
        }
    }

    private string GetEstadoBadgeClass(string? estado)
    {
        return estado switch
        {
            "Finalizado" => "badge bg-success",
            "EnJuego" => "badge bg-warning text-dark",
            "Postergado" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }

    private bool PenalesDeshabilitados(PartidoDto partido)
    {
        return !EsEliminatoria(partido) ||
               !partido.TiempoExtra ||
               !partido.GolesLocal.HasValue ||
               !partido.GolesVisitante.HasValue ||
               partido.GolesLocal != partido.GolesVisitante;
    }

    private static bool EsEliminatoria(PartidoDto partido)
    {
        return partido.Fase != "Grupos";
    }

    private bool TieneResultadoReal(PartidoDto partido)
    {
        return resultadosPersistidos.Contains(partido.Id);
    }

    private bool ResultadoEditable(PartidoDto partido)
    {
        return !TieneResultadoReal(partido) ||
               resultadosEnEdicion.Contains(partido.Id);
    }

    private async Task CargarPartidosAsync()
    {
        partidos = await PartidosService.GetPartidosAsync();
        resultadosPersistidos = partidos
            .Where(TieneResultadoRealPersistido)
            .Select(p => p.Id)
            .ToHashSet();
        AplicarFiltros();
    }

    private static bool TieneResultadoRealPersistido(PartidoDto partido)
    {
        return partido.GolesLocal.HasValue ||
               partido.GolesVisitante.HasValue ||
               partido.PenalesLocal.HasValue ||
               partido.PenalesVisitante.HasValue ||
               partido.Finalizado ||
               partido.Estado != "Pendiente";
    }

    private void EditarResultadoAdmin(PartidoDto partido)
    {
        resultadosEnEdicion.Add(partido.Id);
    }

    private async Task GuardarResultadoAdmin(PartidoDto partido)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        erroresPartido.Remove(partido.Id);

        var dto = new AdminResultadoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            Estado = partido.Estado,
            GolesLocal = partido.GolesLocal,
            GolesVisitante = partido.GolesVisitante,
            TiempoExtra = partido.TiempoExtra,
            PenalesLocal = !PenalesDeshabilitados(partido) ? partido.PenalesLocal : null,
            PenalesVisitante = !PenalesDeshabilitados(partido) ? partido.PenalesVisitante : null
        };

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-resultado",
            dto);

        if (!response.IsSuccessStatusCode)
        {
            erroresPartido[partido.Id] =
                await response.Content.ReadAsStringAsync();
            return;
        }

        await CargarPartidosAsync();
        resultadosEnEdicion.Remove(partido.Id);
    }

    private async Task EliminarMarcadorAdmin(PartidoDto partido)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        erroresPartido.Remove(partido.Id);

        var dto = new AdminResultadoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            Estado = "Pendiente",
            GolesLocal = null,
            GolesVisitante = null,
            TiempoExtra = false,
            PenalesLocal = null,
            PenalesVisitante = null
        };

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-resultado",
            dto);

        if (!response.IsSuccessStatusCode)
        {
            erroresPartido[partido.Id] =
                await response.Content.ReadAsStringAsync();
            return;
        }

        resultadosEnEdicion.Remove(partido.Id);
        await CargarPartidosAsync();
    }

    private async Task LlenarAleatorioVisible()
    {
        if (!PuedeUsarHerramientasMasivas())
        {
            return;
        }

        procesandoMasivo = true;
        mensajeAdminMasivo = null;
        errorAdminMasivo = false;

        var objetivo = PartidosObjetivoAdmin().ToList();

        foreach (var partido in objetivo)
        {
            AplicarMarcadorAleatorio(partido);
            resultadosEnEdicion.Add(partido.Id);
            await GuardarResultadoAdmin(partido);
        }

        mensajeAdminMasivo = $"Se llenaron aleatoriamente {objetivo.Count} partidos visibles.";
        procesandoMasivo = false;
    }

    private async Task FinalizarVisibles()
    {
        if (!PuedeUsarHerramientasMasivas())
        {
            return;
        }

        procesandoMasivo = true;
        mensajeAdminMasivo = null;
        errorAdminMasivo = false;

        var objetivo = PartidosObjetivoAdmin().ToList();

        foreach (var partido in objetivo)
        {
            if (!partido.GolesLocal.HasValue || !partido.GolesVisitante.HasValue)
            {
                AplicarMarcadorAleatorio(partido);
            }

            if (partido.Fase != "Grupos" &&
                partido.GolesLocal == partido.GolesVisitante &&
                (!partido.PenalesLocal.HasValue ||
                 !partido.PenalesVisitante.HasValue ||
                 partido.PenalesLocal == partido.PenalesVisitante))
            {
                partido.TiempoExtra = true;
                AplicarPenalesAleatorios(partido);
            }

            partido.Estado = "Finalizado";
            resultadosEnEdicion.Add(partido.Id);
            await GuardarResultadoAdmin(partido);
        }

        mensajeAdminMasivo = $"Se finalizaron {objetivo.Count} partidos visibles.";
        procesandoMasivo = false;
    }

    private bool PuedeUsarHerramientasMasivas()
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin || !herramientasPruebaHabilitadas)
        {
            return false;
        }

        if (!partidosFiltrados.Any())
        {
            mensajeAdminMasivo = "No hay partidos visibles para procesar.";
            errorAdminMasivo = true;
            return false;
        }

        return true;
    }

    private IEnumerable<PartidoDto> PartidosObjetivoAdmin()
    {
        return partidosFiltrados
            .Where(p => p.Estado != "Postergado")
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id);
    }

    private static void AplicarMarcadorAleatorio(PartidoDto partido)
    {
        partido.GolesLocal = Random.Shared.Next(0, 5);
        partido.GolesVisitante = Random.Shared.Next(0, 5);

        if (partido.Fase == "Grupos" || partido.GolesLocal != partido.GolesVisitante)
        {
            partido.TiempoExtra = false;
            partido.PenalesLocal = null;
            partido.PenalesVisitante = null;
            return;
        }

        partido.TiempoExtra = true;
        AplicarPenalesAleatorios(partido);
    }

    private static void AplicarPenalesAleatorios(PartidoDto partido)
    {
        partido.PenalesLocal = Random.Shared.Next(3, 7);
        partido.PenalesVisitante = Random.Shared.Next(3, 7);

        if (partido.PenalesLocal == partido.PenalesVisitante)
        {
            partido.PenalesVisitante++;
        }
    }

    private class AdminResultadoDto
    {
        public int AdminUsuarioId { get; set; }
        public string Estado { get; set; } = "Pendiente";
        public int? GolesLocal { get; set; }
        public int? GolesVisitante { get; set; }
        public bool TiempoExtra { get; set; }
        public int? PenalesLocal { get; set; }
        public int? PenalesVisitante { get; set; }
    }

}

