@page "/partidos"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using WorldCup.App.Shared.Models
@using System.Globalization
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.SesionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    body {
        background-color: #0b3d2e;
    }

    .page-bg {
        background: linear-gradient(180deg, #0b3d2e 0%, #145a32 100%);
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .page-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
        margin-bottom: 1.5rem;
    }

    .fase-tabs {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
        margin-bottom: 2rem;
    }

    .team-filter {
        background: white;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: end;
        gap: .75rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .team-filter > div {
        min-width: min(100%, 320px);
    }

    .fase-btn {
        border-radius: 20px;
        padding: .45rem 1rem;
        font-weight: 500;
    }

    .match-card {
        background: white;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.12);
        border-left: 6px solid #198754;
    }

    .match-card.admin-priority-match {
        border-left-color: #ffc107;
        box-shadow: 0 0 0 3px rgba(255,193,7,.22), 0 10px 24px rgba(0,0,0,.16);
    }

    .score {
        font-size: 1.25rem;
        font-weight: bold;
        white-space: nowrap;
    }

    .live-arena {
        margin-bottom: 1.25rem;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.32);
        border-radius: 14px;
        background: #082f23;
        color: #fff;
        box-shadow: 0 14px 30px rgba(0,0,0,.2);
    }

    .live-arena-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .75rem 1rem;
        background: #071f19;
        border-bottom: 1px solid rgba(255,255,255,.14);
    }

    .live-kicker {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: #ffda6a;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .live-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ff3b4f;
        box-shadow: 0 0 0 5px rgba(255,59,79,.16);
        animation: livePulse 1.35s ease-in-out infinite;
    }

    .live-arena-list {
        display: grid;
        gap: 1px;
        background: rgba(255,255,255,.12);
    }

    .live-scoreboard {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
        align-items: center;
        gap: 1rem;
        min-height: 92px;
        padding: 1rem 1.2rem;
        background: #0b4937;
    }

    .live-team {
        min-width: 0;
        font-size: 1.05rem;
        font-weight: 850;
    }

    .live-team.local {
        text-align: right;
    }

    .live-team.visitante {
        text-align: left;
    }

    .live-score {
        display: inline-flex;
        align-items: center;
        gap: .65rem;
        padding: .45rem .85rem;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 8px;
        background: #fff;
        color: #10241d;
        font-size: 1.65rem;
        font-weight: 950;
        font-variant-numeric: tabular-nums;
        box-shadow: 0 7px 18px rgba(0,0,0,.2);
    }

    .live-meta {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin-top: .35rem;
        color: #d7fff0;
        font-size: .78rem;
        font-weight: 800;
    }

    .goal-callout {
        position: absolute;
        inset: auto 50% 5px auto;
        z-index: 2;
        transform: translateX(50%);
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .75rem;
        border-radius: 999px;
        background: #ffcc28;
        color: #1d241f;
        font-size: .82rem;
        font-weight: 950;
        box-shadow: 0 6px 18px rgba(0,0,0,.24);
        animation: goalEntrance .55s cubic-bezier(.22,.85,.33,1.35);
    }

    .match-card.goal-highlight {
        border-left-color: #ffcc28;
        animation: goalCard 1.1s ease-out;
    }

    .live-card-label {
        display: block;
        margin-top: .2rem;
        color: #b42318;
        font-size: .68rem;
        font-weight: 950;
        letter-spacing: .05em;
    }

    .live-reference {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: .35rem;
        padding: .35rem .65rem;
        border-radius: 999px;
        background: #fff8e6;
        color: #8a5f00;
        font-size: .78rem;
        font-weight: 850;
    }

    @@keyframes livePulse {
        0%, 100% { transform: scale(.85); opacity: .65; }
        50% { transform: scale(1.08); opacity: 1; }
    }

    @@keyframes goalEntrance {
        0% { opacity: 0; transform: translateX(50%) scale(.55) translateY(14px); }
        100% { opacity: 1; transform: translateX(50%) scale(1) translateY(0); }
    }

    @@keyframes goalCard {
        0%, 100% { box-shadow: 0 6px 18px rgba(0,0,0,.12); }
        35% { box-shadow: 0 0 0 5px rgba(255,204,40,.3), 0 12px 25px rgba(0,0,0,.2); }
    }

    .admin-result {
        display: grid;
        grid-template-columns: minmax(120px, 1.2fr) 80px 80px minmax(112px, auto) minmax(145px, 1fr) 86px 86px minmax(220px, auto);
        gap: .5rem;
        align-items: center;
    }

    .extra-time-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        min-height: 31px;
        margin: 0;
        padding: .25rem .45rem;
        border: 1px solid #d7dee8;
        border-radius: 6px;
        background: #f8fafc;
        color: #344054;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .resultado-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .35rem;
    }

    .admin-result-hint {
        grid-column: 1 / -1;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .45rem .65rem;
        border-radius: 8px;
        background: #ecfdf3;
        color: #146c43;
        font-size: .84rem;
        font-weight: 800;
    }

    .admin-result-hint.warning {
        background: #fff8e6;
        color: #8a5f00;
    }

    .admin-priority-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: .35rem;
        margin: .45rem 0 .75rem;
        padding: .45rem .7rem;
        border-radius: 8px;
        background: #fff8e6;
        color: #8a5f00;
        font-size: .84rem;
        font-weight: 900;
    }

    .admin-test-tools {
        background: #fff;
        border: 1px solid #d9e5df;
        border-left: 5px solid #ffc107;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .admin-test-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: .5rem;
    }

    .ranking-audit-panel {
        background: #fff;
        border: 1px solid #d9e5df;
        border-left: 5px solid #0f5132;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1.2rem;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .ranking-audit-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .9rem;
    }

    .ranking-audit-head h2 {
        margin: 0;
        color: #082f23;
        font-size: 1.05rem;
        font-weight: 900;
    }

    .ranking-audit-meta {
        color: #667085;
        font-size: .86rem;
        font-weight: 700;
    }

    .ranking-audit-controls {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) auto auto;
        gap: .65rem;
        align-items: end;
        margin-bottom: .85rem;
    }

    .ranking-audit-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .6rem;
        margin-bottom: .85rem;
    }

    .ranking-audit-stat {
        border: 1px solid #d9e5df;
        border-radius: 8px;
        padding: .65rem .75rem;
        background: #f8fbfa;
    }

    .ranking-audit-stat small {
        display: block;
        color: #667085;
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .ranking-audit-stat strong {
        display: block;
        color: #082f23;
        font-size: 1.05rem;
        line-height: 1.2;
    }

    .ranking-audit-table-wrap {
        max-height: 420px;
        overflow: auto;
        border: 1px solid #d9e5df;
        border-radius: 8px;
    }

    .ranking-audit-table {
        min-width: 940px;
    }

    .ranking-audit-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #101820;
        color: #fff;
        border-color: #2d3748;
        font-size: .78rem;
        white-space: nowrap;
    }

    .ranking-audit-table tbody td {
        font-weight: 700;
        vertical-align: middle;
    }

    .ranking-audit-change {
        background: #f0fdf4;
    }

    .ranking-audit-points {
        display: inline-flex;
        min-width: 44px;
        justify-content: center;
        border-radius: 7px;
        padding: .18rem .4rem;
        background: #e6f4ef;
        color: #0f5132;
        font-weight: 900;
    }

    .ranking-audit-points.zero {
        background: #eef2f6;
        color: #475467;
    }

    .ranking-audit-points.negative {
        background: #fff1f3;
        color: #b42318;
    }

    .partidos-phase-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin: 1.3rem 0 .75rem;
        padding: .8rem 1rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
    }

    .partidos-phase-title strong {
        display: block;
        color: #173b2f;
        font-size: 1.05rem;
    }

    .partidos-phase-title small {
        color: #667085;
        font-weight: 700;
    }

    .phase-collapse-btn {
        border: 1px solid #cfd8e3;
        border-radius: 999px;
        background: #ffffff;
        color: #344054;
        padding: .28rem .7rem;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .phase-collapse-btn:hover,
    .phase-collapse-btn:focus-visible {
        background: #f2f4f7;
    }

    .phase-collapsed-summary {
        margin-bottom: .9rem;
        padding: .75rem .9rem;
        border: 1px dashed #cfd8e3;
        border-radius: 12px;
        background: rgba(255, 255, 255, .92);
        color: #667085;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
    }

    @@media (max-width: 576px) {
        .page-bg {
            padding: 1rem .55rem;
        }

        .live-arena-head {
            align-items: flex-start;
            flex-direction: column;
            gap: .25rem;
        }

        .live-scoreboard {
            gap: .5rem;
            min-height: 104px;
            padding: .85rem .65rem 1.5rem;
        }

        .live-team {
            overflow-wrap: anywhere;
            font-size: .88rem;
        }

        .live-score {
            gap: .4rem;
            padding: .38rem .58rem;
            font-size: 1.35rem;
        }

        .score {
            font-size: 1rem;
        }

        .admin-result {
            grid-template-columns: 1fr 1fr;
        }

        .admin-qualifier-select,
        .resultado-actions,
        .admin-result-hint {
            grid-column: 1 / -1;
        }

        .team-filter {
            align-items: stretch;
            flex-direction: column;
        }

        .admin-test-tools {
            align-items: stretch;
            flex-direction: column;
        }

        .ranking-audit-head,
        .ranking-audit-controls {
            align-items: stretch;
            grid-template-columns: 1fr;
            flex-direction: column;
        }

        .ranking-audit-summary {
            grid-template-columns: 1fr 1fr;
        }

        .partidos-phase-title {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="page-bg">
    <div class="container">

        <!-- HEADER -->
        <div class="page-header">
            <h1 class="fw-bold mb-1">⚽ Partidos del Mundial</h1>
            <p class="text-muted mb-0">
                Resultados y estado de todos los partidos
            </p>
        </div>

        <!-- FILTRO DE FASES -->
        <div class="fase-tabs">
            @foreach (var fase in fasesOrdenadas)
            {
                <button class="@GetFaseButtonClass(fase)"
                        @onclick="() => FiltrarPorFase(GetFaseValue(fase))">
                    @fase
                </button>



            }
        </div>

        <div class="team-filter">
            <div>
                <label class="form-label fw-bold mb-1">Filtrar por país</label>
                <select class="form-select"
                        value="@paisFiltro"
                        @onchange="CambiarPais">
                    <option value="">Todos los países</option>
                    @foreach (var pais in PaisesDisponibles())
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fecha</label>
                <input class="form-control"
                       type="date"
                       @bind="fechaFiltro"
                       @bind:after="AplicarFiltros" />
            </div>

            @if (FiltrosActivos())
            {
                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Ver todos
                </button>
            }
        </div>

        @if (Sesion.EsAdmin)
        {
            <div class="admin-test-tools">
                <label class="form-check mb-0">
                    <input class="form-check-input"
                           type="checkbox"
                           @bind="herramientasPruebaHabilitadas" />
                    <span class="form-check-label fw-bold">
                        Habilitar herramientas de prueba para partidos visibles
                    </span>
                </label>

                <div class="admin-test-actions">
                    <button class="btn btn-sm btn-outline-warning"
                            disabled="@(!herramientasPruebaHabilitadas || procesandoMasivo)"
                            @onclick="LlenarAleatorioVisible">
                        Llenado aleatorio
                    </button>
                    <button class="btn btn-sm btn-outline-success"
                            disabled="@(!herramientasPruebaHabilitadas || procesandoMasivo)"
                            @onclick="FinalizarVisibles">
                        Finalizar visibles
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(mensajeAdminMasivo))
        {
            <div class="alert @(errorAdminMasivo ? "alert-danger" : "alert-success")">
                @mensajeAdminMasivo
            </div>
        }

        @if (Sesion.EsAdmin &&
                (cargandoAuditoriaRanking ||
                 auditoriaRankingPartido != null ||
                 !string.IsNullOrWhiteSpace(mensajeAuditoriaRanking)))
        {
            var pollaAuditoria = PollaAuditoriaSeleccionada();

            <section class="ranking-audit-panel">
                <div class="ranking-audit-head">
                    <div>
                        <h2>Revision de ranking por partido</h2>
                        @if (auditoriaRankingPartido != null)
                        {
                            <div class="ranking-audit-meta">
                                @auditoriaRankingPartido.Partido · @auditoriaRankingPartido.Fase · Resultado @auditoriaRankingPartido.Resultado
                            </div>
                        }
                        else
                        {
                            <div class="ranking-audit-meta">
                                Preparando el resumen del partido cerrado.
                            </div>
                        }
                    </div>

                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            @onclick="CerrarAuditoriaRanking">
                        Cerrar
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(mensajeAuditoriaRanking))
                {
                    <div class="alert @(errorAuditoriaRanking ? "alert-danger" : "alert-success") py-2">
                        @mensajeAuditoriaRanking
                    </div>
                }

                @if (cargandoAuditoriaRanking)
                {
                    <div class="text-muted fw-bold">
                        Cargando auditoria de rankings...
                    </div>
                }
                else if (auditoriaRankingPartido != null)
                {
                    <div class="ranking-audit-controls">
                        <div>
                            <label class="form-label fw-bold mb-1">Polla para revisar</label>
                            <select class="form-select"
                                    value="@pollaAuditoriaSeleccionadaId"
                                    @onchange="SeleccionarPollaAuditoria">
                                @foreach (var polla in auditoriaRankingPartido.Pollas)
                                {
                                    <option value="@polla.PollaId">
                                        @polla.Nombre (@polla.Participantes participantes)
                                    </option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label fw-bold mb-1">Estado</label>
                            <div>
                                <span class="badge @(auditoriaRankingPartido.Publicado ? "bg-success" : "bg-warning text-dark")">
                                    @(auditoriaRankingPartido.Publicado ? "Publicado" : "Pendiente")
                                </span>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-success"
                                disabled="@(auditoriaRankingPartido.Publicado || publicandoAuditoriaRanking)"
                                @onclick="PublicarAuditoriaRanking">
                            @(publicandoAuditoriaRanking ? "Publicando..." : "Publicar revision")
                        </button>
                    </div>

                    @if (pollaAuditoria != null)
                    {
                        <div class="ranking-audit-summary">
                            <div class="ranking-audit-stat">
                                <small>Polla</small>
                                <strong>@pollaAuditoria.Nombre</strong>
                            </div>
                            <div class="ranking-audit-stat">
                                <small>Participantes</small>
                                <strong>@pollaAuditoria.Participantes</strong>
                            </div>
                            <div class="ranking-audit-stat">
                                <small>Cambio neto</small>
                                <strong>@PuntosConSigno(pollaAuditoria.PuntosOtorgados)</strong>
                            </div>
                            <div class="ranking-audit-stat">
                                <small>Con cambio</small>
                                <strong>@pollaAuditoria.ParticipantesConCambio</strong>
                            </div>
                        </div>

                        @if (!pollaAuditoria.Filas.Any())
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                Esta polla no tiene participantes activos en la auditoria.
                            </div>
                        }
                        else
                        {
                            <div class="ranking-audit-table-wrap">
                                <table class="table table-sm ranking-audit-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Usuario</th>
                                            <th>Pronostico</th>
                                            <th>Antes</th>
                                            <th>Cambio</th>
                                            <th>Marcador</th>
                                            <th>Clas.</th>
                                            <th>Podio</th>
                                            <th>Total ranking</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fila in pollaAuditoria.Filas)
                                        {
                                            <tr class="@(fila.PuntosCambio != 0 ? "ranking-audit-change" : "")">
                                                <td>@fila.Posicion</td>
                                                <td>@fila.Usuario</td>
                                                <td>
                                                    <span class="badge @(fila.TienePrediccion ? "bg-primary" : "bg-secondary")">
                                                        @fila.Pronostico
                                                    </span>
                                                </td>
                                                <td>@fila.PuntosPrevios</td>
                                                <td>
                                                    <span class="@ClaseCambioPuntos(fila.PuntosCambio)">
                                                        @PuntosConSigno(fila.PuntosCambio)
                                                    </span>
                                                </td>
                                                <td>@PuntosConSigno(fila.PuntosMarcadorCierre)</td>
                                                <td>@PuntosConSigno(fila.PuntosClasificacionCierre)</td>
                                                <td>@PuntosConSigno(fila.PuntosPodioCierre)</td>
                                                <td class="fw-bold">@fila.PuntosRanking</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </section>
        }

        @if (PartidosEnJuego().Any())
        {
            <section class="live-arena" aria-live="polite">
                <div class="live-arena-head">
                    <span class="live-kicker">
                        <span class="live-dot"></span>
                        Partidos en vivo
                    </span>
                    <small>Marcador provisional FIFA. El puntaje se calcula únicamente cuando el admin confirma.</small>
                </div>

                <div class="live-arena-list">
                    @foreach (var partidoEnJuego in PartidosEnJuego())
                    {
                        <div class="live-scoreboard">
                            <span class="live-team local">@partidoEnJuego.Local</span>
                            <span class="live-score">
                                <span>@(MarcadorEnVivoLocal(partidoEnJuego) ?? 0)</span>
                                <span>-</span>
                                <span>@(MarcadorEnVivoVisitante(partidoEnJuego) ?? 0)</span>
                            </span>
                            <span class="live-team visitante">@partidoEnJuego.Visitante</span>

                            <span class="live-meta">
                                <span>@EstadoEnVivoTexto(partidoEnJuego)</span>
                                @if (!string.IsNullOrWhiteSpace(partidoEnJuego.MinutoMarcadorEnVivo))
                                {
                                    <span>· @partidoEnJuego.MinutoMarcadorEnVivo</span>
                                }
                            </span>

                            @if (golEnVivo?.PartidoId == partidoEnJuego.Id)
                            {
                                <span class="goal-callout">
                                    ⚽ ¡GOL! @golEnVivo.Equipo
                                </span>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <!-- PARTIDOS -->
        @if (!partidosFiltrados.Any())
        {
            <div class="page-header">
                <p class="text-muted mb-0">No hay partidos para esta fase.</p>
            </div>
        }
        else
        {
            @foreach (var fase in partidosFiltrados
                    .GroupBy(p => p.Fase)
                    .OrderBy(g => GrupoTienePartidosParaConsolidar(g) ? 0 : 1)
                    .ThenBy(g => PrimeraFechaParaConsolidar(g))
                    .ThenBy(g => OrdenFase(g.Key)))
            {
                var faseNombre = fase.Key;
                var faseFinalizada = FaseFinalizada(faseNombre);
                var faseMinimizada = FaseMinimizada(faseNombre);

                <div class="partidos-phase-title">
                    <div>
                        <strong>@NombreFase(faseNombre)</strong>
                        <small>@fase.Count() partidos visibles</small>
                    </div>

                    @if (faseFinalizada)
                    {
                        <button type="button"
                                class="phase-collapse-btn"
                                @onclick="() => ToggleFaseMinimizada(faseNombre)">
                            @(faseMinimizada ? "Mostrar fase" : "Minimizar fase")
                        </button>
                    }
                </div>

                @if (faseMinimizada)
                {
                    <div class="phase-collapsed-summary">
                        @NombreFase(faseNombre) finalizada. @fase.Count() partidos ocultos para navegar más rápido.
                    </div>
                }
                else
                {
                    @foreach (var p in fase
                        .OrderBy(OrdenListadoPartido)
                        .ThenBy(p => p.Fecha)
                        .ThenBy(p => p.Id))
                    {
                        var listoParaConsolidar = PartidoListoParaConsolidar(p);

                        <div class="match-card @(golEnVivo?.PartidoId == p.Id ? "goal-highlight" : "") @(listoParaConsolidar ? "admin-priority-match" : "")">
                            <span class="badge bg-success mb-2">@p.Fase</span>

                            @if (listoParaConsolidar)
                            {
                                <div class="admin-priority-banner">
                                    Listo para consolidar · cerrado desde
                                    @p.Fecha.AddHours(-1).ToString("dd/MM/yyyy HH:mm", new CultureInfo("es-CO"))
                                </div>
                            }

                            <div class="row align-items-center text-center">
                                <div class="col-5 fw-bold text-end">@p.Local</div>

                                <div class="col-2 score">
                                    @if (p.Finalizado || TieneMarcadorCompleto(p))
                                    {
                                        @($"{p.GolesLocal} - {p.GolesVisitante}")
                                        @if (!p.Finalizado && p.Estado == "EnJuego")
                                        {
                                            <span class="live-card-label">EN VIVO</span>
                                        }
                                        @if (p.Fase != "Grupos" && p.TiempoExtra)
                                        {
                                            <div class="small text-muted">
                                                T. extra
                                            </div>
                                        }
                                        @if (p.Fase != "Grupos" &&
                                       p.GolesLocal == p.GolesVisitante &&
                                       p.PenalesLocal.HasValue &&
                                       p.PenalesVisitante.HasValue)
                                        {
                                            <div class="small text-muted">
                                                Pen. @p.PenalesLocal - @p.PenalesVisitante
                                            </div>
                                        }
                                        @if (p.Fase != "Grupos" && p.ClasificadoId.HasValue)
                                        {
                                            <div class="small text-success">
                                                Clasifica @NombreEquipoPorId(p, p.ClasificadoId.Value)
                                            </div>
                                        }
                                    }
                                    else if (TieneMarcadorEnVivo(p))
                                    {
                                        @($"{p.MarcadorEnVivoLocal} - {p.MarcadorEnVivoVisitante}")
                                        <span class="live-card-label">@EtiquetaMarcadorEnVivo(p)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }

                                </div>


                                <div class="col-5 fw-bold text-start">@p.Visitante</div>
                            </div>

                            <div class="text-center text-muted mt-1" style="font-size: 0.9rem;">
                                @p.Fecha.ToString(
                                         "dddd dd 'de' MMMM 'de' yyyy · HH:mm",
                                         new CultureInfo("es-CO")
                                         )
                            </div>

                            <div class="text-center mt-2">
                                <span class="@GetEstadoBadgeClass(p.Estado)">
                                    @p.Estado
                                </span>
                            </div>

                            @if (!p.Finalizado && TieneMarcadorEnVivo(p))
                            {
                                <div class="text-center mt-2">
                                    <span class="live-reference">
                                        FIFA provisional:
                                        @($"{p.MarcadorEnVivoLocal} - {p.MarcadorEnVivoVisitante}")
                                        @EstadoEnVivoTexto(p)
                                    </span>
                                </div>
                            }

                            @if (Sesion.EsAdmin)
                            {
                                var resultadoEditable = ResultadoEditable(p);
                                var tieneResultado = TieneResultadoReal(p);

                                <div class="admin-result mt-3">
                                    <select class="form-select form-select-sm"
                                            disabled="@(!resultadoEditable)"
                                            @onfocus="() => EditarResultadoAdmin(p)"
                                            @bind="p.Estado">
                                        <option value="Pendiente">Pendiente</option>
                                        <option value="EnJuego">En juego</option>
                                        <option value="Postergado">Postergado</option>
                                        <option value="Finalizado">Finalizado</option>
                                    </select>

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Local"
                                           disabled="@(!resultadoEditable)"
                                           @onfocus="() => EditarResultadoAdmin(p)"
                                           @bind="p.GolesLocal" />

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Visitante"
                                           disabled="@(!resultadoEditable)"
                                           @onfocus="() => EditarResultadoAdmin(p)"
                                           @bind="p.GolesVisitante" />

                                    <label class="extra-time-check">
                                        <input class="form-check-input mt-0"
                                               type="checkbox"
                                               disabled="@(!resultadoEditable || !EsEliminatoria(p))"
                                               @bind="p.TiempoExtra" />
                                        <span>T. extra</span>
                                    </label>

                                    <select class="form-select form-select-sm admin-qualifier-select"
                                            disabled="@(!resultadoEditable || !EsEliminatoria(p))"
                                            @bind="p.ClasificadoId">
                                        <option value="">Clasifica</option>
                                        <option value="@p.LocalId">@p.Local</option>
                                        <option value="@p.VisitanteId">@p.Visitante</option>
                                    </select>

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Pen. local"
                                           disabled="@(!resultadoEditable || PenalesDeshabilitados(p))"
                                           @bind="p.PenalesLocal" />

                                    <input type="number"
                                           class="form-control form-control-sm"
                                           min="0"
                                           placeholder="Pen. visit."
                                           disabled="@(!resultadoEditable || PenalesDeshabilitados(p))"
                                           @bind="p.PenalesVisitante" />

                                    <div class="resultado-actions">
                                        <button class="btn btn-sm btn-primary"
                                                disabled="@(!resultadoEditable)"
                                                @onclick="() => GuardarResultadoAdmin(p)">
                                            Guardar
                                        </button>

                                        <button class="btn btn-sm btn-outline-secondary"
                                                disabled="@(resultadoEditable || !tieneResultado)"
                                                @onclick="() => EditarResultadoAdmin(p)">
                                            Editar
                                        </button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                disabled="@(!tieneResultado)"
                                                @onclick="() => EliminarMarcadorAdmin(p)">
                                            Eliminar marcador
                                        </button>
                                    </div>

                                    @if (EsEliminatoria(p))
                                    {
                                        var pistaClasificado = MensajeClasificadoAdmin(p);
                                        if (!string.IsNullOrWhiteSpace(pistaClasificado))
                                        {
                                            <div class="@ClaseMensajeClasificadoAdmin(p)">
                                                @pistaClasificado
                                            </div>
                                        }
                                    }
                                </div>

                                @if (erroresPartido.ContainsKey(p.Id))
                                {
                                    <div class="alert alert-danger mt-2 mb-0 py-2">
                                        @erroresPartido[p.Id]
                                    </div>
                                }
                            }

                        </div>
                    }
                }
            }
        }
    </div>
</div>

@code {

    private List<PartidoDto> partidos = new();
    private List<PartidoDto> partidosFiltrados = new();
    private Dictionary<int, string> erroresPartido = new();
    private HashSet<int> resultadosEnEdicion = new();
    private HashSet<int> resultadosPersistidos = new();
    private HashSet<string> fasesMinimizadas = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<int, (int? Local, int? Visitante)> marcadoresServidor = new();
    private CancellationTokenSource? actualizacionEnVivoCts;
    private Task? actualizacionEnVivoTask;
    private GolEnVivo? golEnVivo;
    private long secuenciaGol;

    private string? faseSeleccionada;
    private string? paisFiltro;
    private DateTime? fechaFiltro;
    private bool herramientasPruebaHabilitadas;
    private bool procesandoMasivo;
    private string? mensajeAdminMasivo;
    private bool errorAdminMasivo;
    private AuditoriaRankingPartidoDto? auditoriaRankingPartido;
    private int? pollaAuditoriaSeleccionadaId;
    private bool cargandoAuditoriaRanking;
    private bool publicandoAuditoriaRanking;
    private string? mensajeAuditoriaRanking;
    private bool errorAuditoriaRanking;

    private readonly List<string> fasesOrdenadas = new()
    {
        "Todas",
        "Grupos",
        "Dieciseisavos",
        "Octavos",
        "Cuartos",
        "Semifinales",
        "TercerPuesto",
        "Final"
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarPartidosAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (actualizacionEnVivoTask == null)
        {
            actualizacionEnVivoCts = new CancellationTokenSource();
            actualizacionEnVivoTask = ActualizarPartidosEnVivoAsync(
                actualizacionEnVivoCts.Token);
        }

        StateHasChanged();
    }

    private void FiltrarPorFase(string? fase)
    {
        faseSeleccionada = fase;
        AplicarFiltros();
    }

    private void CambiarPais(ChangeEventArgs e)
    {
        paisFiltro = e.Value?.ToString();
        AplicarFiltros();
    }

    private void LimpiarFiltros()
    {
        paisFiltro = null;
        fechaFiltro = null;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var query = string.IsNullOrEmpty(faseSeleccionada)
            ? partidos
            : partidos.Where(p => p.Fase == faseSeleccionada).ToList();

        if (!string.IsNullOrWhiteSpace(paisFiltro))
        {
            query = query
                .Where(p =>
                    string.Equals(p.Local, paisFiltro, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(p.Visitante, paisFiltro, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        if (fechaFiltro.HasValue)
        {
            query = query
                .Where(p => p.Fecha.Date == fechaFiltro.Value.Date)
                .ToList();
        }

        partidosFiltrados = query;
    }

    private bool FiltrosActivos()
    {
        return !string.IsNullOrWhiteSpace(paisFiltro) || fechaFiltro.HasValue;
    }

    private List<string> PaisesDisponibles()
    {
        return partidos
            .SelectMany(p => new[] { p.Local, p.Visitante })
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(p => p)
            .ToList();
    }

    private string GetFaseButtonClass(string fase)
    {
        var isActive =
            (fase == "Todas" && faseSeleccionada == null) ||
            (faseSeleccionada == fase);

        return isActive
            ? "btn btn-success fase-btn"
            : "btn btn-outline-success fase-btn";
    }

    private string? GetFaseValue(string fase)
    {
        return fase == "Todas" ? null : fase;
    }

    private int OrdenFase(string fase)
    {
        var index = fasesOrdenadas.IndexOf(fase);
        return index < 0 ? 99 : index;
    }

    private string NombreFase(string fase)
    {
        return fase switch
        {
            "TercerPuesto" => "Tercer puesto",
            _ => fase
        };
    }

    private bool FaseFinalizada(string fase)
    {
        return partidos.Any(p => p.Fase == fase) &&
               partidos.Where(p => p.Fase == fase).All(p => p.Finalizado);
    }

    private bool FaseMinimizada(string fase)
    {
        return FaseFinalizada(fase) && fasesMinimizadas.Contains(fase);
    }

    private bool GrupoTienePartidosParaConsolidar(IEnumerable<PartidoDto> fase)
    {
        return fase.Any(PartidoListoParaConsolidar);
    }

    private DateTime PrimeraFechaParaConsolidar(IEnumerable<PartidoDto> fase)
    {
        var fechas = fase
            .Where(PartidoListoParaConsolidar)
            .Select(p => p.Fecha)
            .ToList();

        return fechas.Any()
            ? fechas.Min()
            : DateTime.MaxValue;
    }

    private bool PartidoListoParaConsolidar(PartidoDto partido)
    {
        if (!Sesion.EsAdmin ||
            partido.Finalizado ||
            string.Equals(partido.Estado, "Finalizado", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(partido.Estado, "Postergado", StringComparison.OrdinalIgnoreCase) ||
            partido.Fecha <= DateTime.MinValue.AddDays(1))
        {
            return false;
        }

        return HoraColombiaActual() >= partido.Fecha.AddHours(-1);
    }

    private int OrdenListadoPartido(PartidoDto partido)
    {
        if (PartidoListoParaConsolidar(partido))
        {
            return 0;
        }

        if (!partido.Finalizado &&
            string.Equals(partido.Estado, "EnJuego", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        if (!partido.Finalizado &&
            !string.Equals(partido.Estado, "Postergado", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        if (partido.Finalizado ||
            string.Equals(partido.Estado, "Finalizado", StringComparison.OrdinalIgnoreCase))
        {
            return 3;
        }

        return 4;
    }

    private static DateTime HoraColombiaActual()
    {
        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time"));
        }
        catch
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"));
        }
    }

    private void ToggleFaseMinimizada(string fase)
    {
        if (!FaseFinalizada(fase))
        {
            fasesMinimizadas.Remove(fase);
            return;
        }

        if (!fasesMinimizadas.Add(fase))
        {
            fasesMinimizadas.Remove(fase);
        }
    }

    private string GetEstadoBadgeClass(string? estado)
    {
        return estado switch
        {
            "Finalizado" => "badge bg-success",
            "EnJuego" => "badge bg-warning text-dark",
            "Postergado" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }

    private bool PenalesDeshabilitados(PartidoDto partido)
    {
        return !EsEliminatoria(partido) ||
               !partido.TiempoExtra ||
               !partido.GolesLocal.HasValue ||
               !partido.GolesVisitante.HasValue ||
               partido.GolesLocal != partido.GolesVisitante;
    }

    private static bool EsEliminatoria(PartidoDto partido)
    {
        return partido.Fase != "Grupos";
    }

    private static bool TieneMarcadorCompleto(PartidoDto partido)
    {
        return partido.GolesLocal.HasValue &&
               partido.GolesVisitante.HasValue;
    }

    private string EstadoParaGuardar(PartidoDto partido)
    {
        if (partido.Estado == "Pendiente" && TieneMarcadorCompleto(partido))
        {
            return "Finalizado";
        }

        return partido.Estado;
    }

    private int? ClasificadoParaGuardar(PartidoDto partido)
    {
        if (!EsEliminatoria(partido) || !TieneMarcadorCompleto(partido))
        {
            return null;
        }

        if (partido.ClasificadoId.HasValue)
        {
            return partido.ClasificadoId;
        }

        if (partido.GolesLocal > partido.GolesVisitante)
        {
            return partido.LocalId;
        }

        if (partido.GolesVisitante > partido.GolesLocal)
        {
            return partido.VisitanteId;
        }

        if (!PenalesDeshabilitados(partido) &&
            partido.PenalesLocal.HasValue &&
            partido.PenalesVisitante.HasValue &&
            partido.PenalesLocal != partido.PenalesVisitante)
        {
            return partido.PenalesLocal > partido.PenalesVisitante
                ? partido.LocalId
                : partido.VisitanteId;
        }

        return null;
    }

    private string MensajeClasificadoAdmin(PartidoDto partido)
    {
        if (!TieneMarcadorCompleto(partido))
        {
            return "";
        }

        var clasificadoId = ClasificadoParaGuardar(partido);

        if (clasificadoId.HasValue)
        {
            return $"Clasifica: {NombreEquipoPorId(partido, clasificadoId.Value)}";
        }

        if (partido.GolesLocal == partido.GolesVisitante)
        {
            return partido.TiempoExtra
                ? "Empate con tiempo extra: selecciona quién clasificó o ingresa penales."
                : "Empate en eliminatoria: marca tiempo extra o ingresa penales para definir quién clasifica.";
        }

        return "";
    }

    private string ClaseMensajeClasificadoAdmin(PartidoDto partido)
    {
        return ClasificadoParaGuardar(partido).HasValue
            ? "admin-result-hint"
            : "admin-result-hint warning";
    }

    private static string NombreEquipoPorId(PartidoDto partido, int equipoId)
    {
        if (equipoId == partido.LocalId)
        {
            return partido.Local;
        }

        if (equipoId == partido.VisitanteId)
        {
            return partido.Visitante;
        }

        return "equipo seleccionado";
    }

    private bool TieneResultadoReal(PartidoDto partido)
    {
        return resultadosPersistidos.Contains(partido.Id);
    }

    private bool ResultadoEditable(PartidoDto partido)
    {
        return partido.Estado == "EnJuego" ||
               !TieneResultadoReal(partido) ||
               resultadosEnEdicion.Contains(partido.Id);
    }

    private async Task CargarPartidosAsync(bool detectarGoles = false)
    {
        var nuevosPartidos = await PartidosService.GetPartidosAsync();

        if (detectarGoles)
        {
            DetectarGol(nuevosPartidos);
        }

        foreach (var partidoNuevo in nuevosPartidos)
        {
            if (!resultadosEnEdicion.Contains(partidoNuevo.Id))
            {
                continue;
            }

            var partidoLocal = partidos.FirstOrDefault(p => p.Id == partidoNuevo.Id);
            if (partidoLocal == null)
            {
                continue;
            }

            partidoNuevo.Estado = partidoLocal.Estado;
            partidoNuevo.GolesLocal = partidoLocal.GolesLocal;
            partidoNuevo.GolesVisitante = partidoLocal.GolesVisitante;
            partidoNuevo.TiempoExtra = partidoLocal.TiempoExtra;
            partidoNuevo.ClasificadoId = partidoLocal.ClasificadoId;
            partidoNuevo.PenalesLocal = partidoLocal.PenalesLocal;
            partidoNuevo.PenalesVisitante = partidoLocal.PenalesVisitante;
        }

        marcadoresServidor = nuevosPartidos.ToDictionary(
            p => p.Id,
            MarcadorParaDetectar);
        partidos = nuevosPartidos;
        resultadosPersistidos = partidos
            .Where(TieneResultadoRealPersistido)
            .Select(p => p.Id)
            .ToHashSet();
        AplicarFiltros();
    }

    private IEnumerable<PartidoDto> PartidosEnJuego()
    {
        return partidos
            .Where(p =>
                MarcadorEnVivoActivo(p) ||
                (p.Estado == "EnJuego" && TieneMarcadorCompleto(p)))
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id);
    }

    private void DetectarGol(IEnumerable<PartidoDto> nuevosPartidos)
    {
        foreach (var partido in nuevosPartidos.Where(p =>
            MarcadorEnVivoActivo(p) ||
            (p.Estado == "EnJuego" && TieneMarcadorCompleto(p))))
        {
            if (!marcadoresServidor.TryGetValue(
                    partido.Id,
                    out var marcadorAnterior))
            {
                continue;
            }

            var marcadorNuevo = MarcadorParaDetectar(partido);
            var aumentoLocal =
                marcadorNuevo.Local.HasValue &&
                marcadorNuevo.Local.Value > (marcadorAnterior.Local ?? 0);
            var aumentoVisitante =
                marcadorNuevo.Visitante.HasValue &&
                marcadorNuevo.Visitante.Value > (marcadorAnterior.Visitante ?? 0);

            if (!aumentoLocal && !aumentoVisitante)
            {
                continue;
            }

            var equipo = aumentoLocal && aumentoVisitante
                ? $"{partido.Local} / {partido.Visitante}"
                : aumentoLocal
                    ? partido.Local
                    : partido.Visitante;

            MostrarGol(partido.Id, equipo);
        }
    }

    private void MostrarGol(int partidoId, string equipo)
    {
        var secuencia = Interlocked.Increment(ref secuenciaGol);
        golEnVivo = new GolEnVivo
        {
            PartidoId = partidoId,
            Equipo = equipo,
            Secuencia = secuencia
        };

        _ = OcultarGolAsync(secuencia);
    }

    private async Task OcultarGolAsync(long secuencia)
    {
        await Task.Delay(TimeSpan.FromSeconds(6));

        await InvokeAsync(() =>
        {
            if (golEnVivo?.Secuencia != secuencia)
            {
                return;
            }

            golEnVivo = null;
            StateHasChanged();
        });
    }

    private async Task ActualizarPartidosEnVivoAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(7));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await CargarPartidosAsync(detectarGoles: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            // La siguiente navegación o recarga normal recupera el sondeo.
        }
    }

    private static bool TieneResultadoRealPersistido(PartidoDto partido)
    {
        return partido.GolesLocal.HasValue ||
               partido.GolesVisitante.HasValue ||
               partido.PenalesLocal.HasValue ||
               partido.PenalesVisitante.HasValue ||
               partido.ClasificadoId.HasValue ||
               partido.Finalizado ||
               partido.Estado != "Pendiente";
    }

    private static bool TieneMarcadorEnVivo(PartidoDto partido)
    {
        return partido.MarcadorEnVivoLocal.HasValue &&
               partido.MarcadorEnVivoVisitante.HasValue;
    }

    private static bool MarcadorEnVivoActivo(PartidoDto partido)
    {
        if (!TieneMarcadorEnVivo(partido) || partido.Finalizado)
        {
            return false;
        }

        return partido.EstadoMarcadorEnVivo switch
        {
            "EnJuego" or "Descanso" or "TiempoExtra" or "Penales" => true,
            _ => false
        };
    }

    private static (int? Local, int? Visitante) MarcadorParaDetectar(PartidoDto partido)
    {
        if (TieneMarcadorEnVivo(partido))
        {
            return (partido.MarcadorEnVivoLocal, partido.MarcadorEnVivoVisitante);
        }

        if (partido.Estado == "EnJuego" && TieneMarcadorCompleto(partido))
        {
            return (partido.GolesLocal, partido.GolesVisitante);
        }

        return (null, null);
    }

    private static int? MarcadorEnVivoLocal(PartidoDto partido)
    {
        return TieneMarcadorEnVivo(partido)
            ? partido.MarcadorEnVivoLocal
            : partido.GolesLocal;
    }

    private static int? MarcadorEnVivoVisitante(PartidoDto partido)
    {
        return TieneMarcadorEnVivo(partido)
            ? partido.MarcadorEnVivoVisitante
            : partido.GolesVisitante;
    }

    private static string EstadoEnVivoTexto(PartidoDto partido)
    {
        return partido.EstadoMarcadorEnVivo switch
        {
            "Finalizado" => "FIFA final",
            "Programado" => "FIFA programado",
            "EnJuego" => "FIFA en vivo",
            "Descanso" => "Descanso",
            "TiempoExtra" => "Tiempo extra",
            "Penales" => "Penales",
            _ when partido.Estado == "EnJuego" => "En vivo",
            _ => "FIFA provisional"
        };
