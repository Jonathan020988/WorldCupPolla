@page "/partidos"
@rendermode InteractiveServer
@using WorldCup.App.Shared.Models
@using System.Globalization
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.SesionService Sesion
@inject HttpClient Http
@inject NavigationManager Navigation

<style>
    body {
        background-color: #0b3d2e;
    }

    .page-bg {
        background: linear-gradient(180deg, #0b3d2e 0%, #145a32 100%);
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .page-header {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
        margin-bottom: 1.5rem;
    }

    .fase-tabs {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(0,0,0,.12);
        margin-bottom: 2rem;
    }

    .fase-btn {
        border-radius: 20px;
        padding: .45rem 1rem;
        font-weight: 500;
    }

    .match-card {
        background: white;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 6px 18px rgba(0,0,0,.12);
        border-left: 6px solid #198754;
    }

    .score {
        font-size: 1.25rem;
        font-weight: bold;
    }

    .admin-result {
        display: grid;
        grid-template-columns: minmax(130px, 1fr) 90px 90px auto;
        gap: .5rem;
        align-items: center;
    }

    @@media (max-width: 576px) {
        .admin-result {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="page-bg">
    <div class="container">

        <!-- HEADER -->
        <div class="page-header">
            <h1 class="fw-bold mb-1">⚽ Partidos del Mundial</h1>
            <p class="text-muted mb-0">
                Resultados y estado de todos los partidos
            </p>
        </div>

        <!-- FILTRO DE FASES -->
        <div class="fase-tabs">
            @foreach (var fase in fasesOrdenadas)
            {
                <button class="@GetFaseButtonClass(fase)"
                        @onclick="() => FiltrarPorFase(GetFaseValue(fase))">
                    @fase
                </button>



            }
        </div>

        <!-- PARTIDOS -->
        @if (!partidosFiltrados.Any())
        {
            <div class="page-header">
                <p class="text-muted mb-0">No hay partidos para esta fase.</p>
            </div>
        }
        else
        {
            @foreach (var p in partidosFiltrados)
            {
                <div class="match-card">
                    <span class="badge bg-success mb-2">@p.Fase</span>

                    <div class="row align-items-center text-center">
                        <div class="col-5 fw-bold text-end">@p.Local</div>

                        <div class="col-2 score">
                            @if (p.Finalizado)
                            {
                                @($"{p.GolesLocal} - {p.GolesVisitante}")
                            }
                            else
                            {
                                <span class="text-muted">–</span>
                            }

                        </div>


                        <div class="col-5 fw-bold text-start">@p.Visitante</div>
                    </div>

                    <div class="text-center text-muted mt-1" style="font-size: 0.9rem;">
                        @p.Fecha.ToString(
                                 "dddd dd 'de' MMMM 'de' yyyy · HH:mm",
                                 new CultureInfo("es-CO")
                                 )
                    </div>

                    <div class="text-center mt-2">
                        <span class="@GetEstadoBadgeClass(p.Estado)">
                            @p.Estado
                        </span>
                    </div>

                    @if (Sesion.EsAdmin)
                    {
                        <div class="admin-result mt-3">
                            <select class="form-select form-select-sm"
                                    @bind="p.Estado">
                                <option value="Pendiente">Pendiente</option>
                                <option value="EnJuego">En juego</option>
                                <option value="Postergado">Postergado</option>
                                <option value="Finalizado">Finalizado</option>
                            </select>

                            <input type="number"
                                   class="form-control form-control-sm"
                                   min="0"
                                   placeholder="Local"
                                   @bind="p.GolesLocal" />

                            <input type="number"
                                   class="form-control form-control-sm"
                                   min="0"
                                   placeholder="Visitante"
                                   @bind="p.GolesVisitante" />

                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => GuardarResultadoAdmin(p)">
                                Guardar
                            </button>
                        </div>

                        @if (erroresPartido.ContainsKey(p.Id))
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-2">
                                @erroresPartido[p.Id]
                            </div>
                        }
                    }
                                       
                </div>
            }
        }
    </div>
</div>

@code {

    private List<PartidoDto> partidos = new();
    private List<PartidoDto> partidosFiltrados = new();
    private Dictionary<int, string> erroresPartido = new();

    private string? faseSeleccionada;

    private readonly List<string> fasesOrdenadas = new()
    {
        "Todas",
        "Grupos",
        "Dieciseisavos",
        "Octavos",
        "Cuartos",
        "Semifinales",
        "TercerPuesto",
        "Final"
    };

    protected override async Task OnInitializedAsync()
    {
        partidos = await PartidosService.GetPartidosAsync();
        partidosFiltrados = partidos;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();
        StateHasChanged();
    }

    private void FiltrarPorFase(string? fase)
    {
        faseSeleccionada = fase;

        partidosFiltrados = string.IsNullOrEmpty(fase)
            ? partidos
            : partidos.Where(p => p.Fase == fase).ToList();
    }

    private string GetFaseButtonClass(string fase)
    {
        var isActive =
            (fase == "Todas" && faseSeleccionada == null) ||
            (faseSeleccionada == fase);

        return isActive
            ? "btn btn-success fase-btn"
            : "btn btn-outline-success fase-btn";
    }

    private string? GetFaseValue(string fase)
    {
        return fase == "Todas" ? null : fase;
    }

    private string GetEstadoBadgeClass(string? estado)
    {
        return estado switch
        {
            "Finalizado" => "badge bg-success",
            "EnJuego" => "badge bg-warning text-dark",
            "Postergado" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }

    private async Task GuardarResultadoAdmin(PartidoDto partido)
    {
        if (!Sesion.UsuarioId.HasValue || !Sesion.EsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        erroresPartido.Remove(partido.Id);

        var dto = new AdminResultadoDto
        {
            AdminUsuarioId = Sesion.UsuarioId.Value,
            Estado = partido.Estado,
            GolesLocal = partido.GolesLocal,
            GolesVisitante = partido.GolesVisitante
        };

        var response = await Http.PutAsJsonAsync(
            $"api/Partidos/{partido.Id}/admin-resultado",
            dto);

        if (!response.IsSuccessStatusCode)
        {
            erroresPartido[partido.Id] =
                await response.Content.ReadAsStringAsync();
            return;
        }

        partidos = await PartidosService.GetPartidosAsync();
        FiltrarPorFase(faseSeleccionada);
    }

    private class AdminResultadoDto
    {
        public int AdminUsuarioId { get; set; }
        public string Estado { get; set; } = "Pendiente";
        public int? GolesLocal { get; set; }
        public int? GolesVisitante { get; set; }
    }

}

