@page "/predicciones"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Models
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.PrediccionesService PrediccionesService
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http

<section class="predictions-header">
    <div>
        <span class="predictions-kicker">Mundial 2026</span>
        <h1>Mis Predicciones</h1>
        <p>
            Puedes modificar tus marcadores hasta <b>1 hora</b> antes de cada partido.
        </p>
    </div>
</section>

@if (cargando)
{
    <p>Cargando predicciones...</p>
}
else if (!Sesion.PollaActivaId.HasValue)
{
    <div class="card shadow-sm mb-4" style="max-width:520px">
        <div class="card-body">
            <h5 class="mb-3">Selecciona la polla</h5>
            <p class="text-muted">
                Tus predicciones se guardarán en la polla que elijas.
            </p>

            @if (!pollas.Any())
            {
                <div class="alert alert-info">
                    No tienes pollas disponibles todavía.
                </div>

                <a class="btn btn-success" href="/dashboard">
                    Ir a mis pollas
                </a>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var polla in pollas)
                    {
                        <button class="btn btn-outline-primary text-start"
                                @onclick="() => SeleccionarPolla(polla)">
                            🏆 @polla.Nombre
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="polla-banner">
        <span>
            Trabajando en la polla:
            <strong>@Sesion.PollaActivaNombre</strong>
        </span>

        <button class="btn btn-sm btn-outline-success"
                @onclick="CambiarPolla">
            Cambiar polla
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeGuardado))
    {
        <div class="alert @(guardadoConError ? "alert-danger" : "alert-success")">
            @mensajeGuardado
        </div>
    }

    @if (reaperturasActivas.Any())
    {
        <div class="alert alert-warning reopen-user-alert">
            El administrador habilitó edición temporal para:
            <strong>@string.Join(", ", reaperturasActivas.Select(EtiquetaReapertura))</strong>.
        </div>
    }

    @if (partidos?.Any() == true)
    {
        <div class="prediction-filter">
            <div>
                <label class="form-label fw-bold mb-1">Filtrar por país</label>
                <select class="form-select"
                        @bind="paisFiltro">
                    <option value="">Todos los países</option>
                    @foreach (var pais in PaisesDisponibles())
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fecha</label>
                <input class="form-control"
                       type="date"
                       @bind="fechaFiltro" />
            </div>

            @if (FiltrosActivos())
            {
                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Ver todos
                </button>
            }
        </div>

        var pendientesMarcador = PartidosPendientesMarcador().ToList();

        <div class="pending-predictions-panel @(pendientesMarcador.Any() ? "" : "is-complete")">
            <div class="pending-summary">
                <strong>Marcadores pendientes</strong>
                <span>
                    @(pendientesMarcador.Any()
                        ? $"{pendientesMarcador.Count} por completar"
                        : "Todos completos")
                </span>
            </div>

            @if (pendientesMarcador.Any())
            {
                <div class="pending-list">
                    @foreach (var partido in pendientesMarcador.Take(10))
                    {
                        <span class="pending-chip">
                            @partido.Local vs @partido.Visitante
                            <small>@partido.Fecha.ToString("dd/MM HH:mm")</small>
                        </span>
                    }

                    @if (pendientesMarcador.Count > 10)
                    {
                        <span class="pending-chip more">
                            +@(pendientesMarcador.Count - 10) más
                        </span>
                    }
                </div>
            }
        </div>
    }

    @if (podioEstado?.disponible == true)
    {
        <div class="card shadow-sm mb-3 border-warning">
            <div class="card-header bg-warning fw-bold">
                Podio del Mundial
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Campeón</label>
                        <select class="form-select" @bind="podio.CampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 1)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Subcampeón</label>
                        <select class="form-select" @bind="podio.SubcampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 2)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tercer puesto</label>
                        <select class="form-select" @bind="podio.TerceroId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 3)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <button class="btn btn-warning mt-3"
                        @onclick="GuardarPodio">
                    Guardar podio
                </button>
            </div>
        </div>
    }
    else if (podioEstado?.gruposTerminados == true && podioEstado.cerrado)
    {
        <div class="alert alert-secondary">
            El podio ya se cerró porque empezó la fase de dieciseisavos.
        </div>
    }

    @if (partidos == null)
    {
        <p>Cargando partidos...</p>
    }
    else
    {
        var partidosVista = PartidosFiltrados().ToList();

        @if (!partidosVista.Any())
        {
            <div class="alert alert-info">
                No hay partidos para el país seleccionado.
            </div>
        }
        else
        {
            @foreach (var fase in partidosVista.GroupBy(p => p.Fase).OrderBy(g => OrdenFase(g.Key)))
            {
                var faseNombre = fase.Key;
                var faseFinalizada = FaseFinalizada(faseNombre);
                var faseMinimizada = FaseMinimizada(faseNombre);

                <div class="phase-title">
                    <div class="phase-title-main">
                        <span>@faseNombre</span>
                        <small>@fase.Count() partidos</small>
                    </div>

                    @if (faseFinalizada)
                    {
                        <button type="button"
                                class="phase-collapse-btn"
                                @onclick="() => ToggleFaseMinimizada(faseNombre)">
                            @(faseMinimizada ? "Mostrar fase" : "Minimizar fase")
                        </button>
                    }
                </div>

                @if (faseMinimizada)
                {
                    <div class="phase-collapsed-summary">
                        @faseNombre finalizada. @fase.Count() partidos ocultos para navegar más rápido.
                    </div>
                }
                else
                {
                    @foreach (var p in fase.OrderBy(p => p.Fecha).ThenBy(p => p.Id))
                    {
                        var bloqueado = EstaBloqueado(p);
                        var guardada = EstaGuardada(p);
                        var editable = EstaEditable(p);

                        <div class="prediction-card @(guardada ? "is-saved" : "") @(editable ? "is-editing" : "")">
                            <div class="prediction-card-main">
                                <div class="prediction-team prediction-team-local">
                                    <span>@p.Local</span>
                                    <img class="team-flag"
                                         src="@GetBandera(p.Local)"
                                         alt="@p.Local" />
                                </div>

                                <div class="score-panel">
                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesLocal"
                                           @bind:event="oninput" />

                                    <span class="score-separator">-</span>

                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesVisitante"
                                           @bind:event="oninput" />
                                </div>

                                <div class="prediction-team prediction-team-visitor">
                                    <img class="team-flag"
                                         src="@GetBandera(p.Visitante)"
                                         alt="@p.Visitante" />
                                    <span>@p.Visitante</span>
                                </div>

                                <div class="prediction-actions">
                                    <button class="btn btn-sm btn-success"
                                            disabled="@(!editable)"
                                            title="Guardar predicción"
                                            @onclick="() => GuardarPartido(p)">
                                        Guardar
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary"
                                            disabled="@(bloqueado || !guardada || editable)"
                                            title="Editar predicción"
                                            @onclick="() => EditarPartido(p)">
                                        Editar
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(bloqueado || !guardada)"
                                            title="Eliminar predicción"
                                            @onclick="() => EliminarPartido(p)">
                                        Eliminar
                                    </button>
                                </div>
                            </div>

                            @if (p.Fase != "Grupos")
                            {
                                var alertaEmpate = AlertaEmpateEliminatoria(p);

                                <div class="prediction-extra">
                                    <select class="form-select form-select-sm"
                                            disabled="@(!editable)"
                                            @bind="predicciones[p.Id].PrediceClasificadoId">
                                        <option value="">Equipo que clasifica</option>
                                        <option value="@p.LocalId">@p.Local</option>
                                        <option value="@p.VisitanteId">@p.Visitante</option>
                                    </select>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               disabled="@(!editable)"
                                               @bind="predicciones[p.Id].PrediceTiempoExtra" />
                                        <span class="form-check-label">Tiempo extra</span>
                                    </label>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               disabled="@(!editable)"
                                               @bind="predicciones[p.Id].PredicePenales" />
                                        <span class="form-check-label">Extra + penales</span>
                                    </label>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(alertaEmpate))
                                {
                                    <div class="knockout-alert">
                                        @alertaEmpate
                                    </div>
                                }
                            }

                            <div class="prediction-footer">
                                <span>
                                    @(DateTime.SpecifyKind(p.Fecha, DateTimeKind.Unspecified)
                                        .ToString("dddd dd 'de' MMMM yyyy HH:mm"))
                                </span>

                                @if (bloqueado)
                                {
                                    <span class="status-pill locked">Bloqueado</span>
                                }
                                else if (editable && guardada)
                                {
                                    <span class="status-pill editing">Editando</span>
                                }
                                else if (guardada)
                                {
                                    <span class="status-pill saved">Guardada</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">Pendiente</span>
                                }
                            </div>
                        </div>
                    }
                }
            }
        }
    }
}

<style>
