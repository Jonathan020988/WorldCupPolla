    private bool HayNumeracionOficialEnFase(string fase)
    {
        return PartidosMapaPorFase(fase).Any(p => p.NumeroPartidoFifa.HasValue);
    }

    private PartidoDto? PartidoPorNumeroMapa(int numeroPartido)
    {
        var partidoPorNumero = partidos?
            .FirstOrDefault(p => p.NumeroPartidoFifa == numeroPartido);

        if (partidoPorNumero != null)
        {
            return partidoPorNumero;
        }

        var fase = FasePorNumeroMapa(numeroPartido);
        var index = IndexFallbackPorNumeroMapa(numeroPartido);

        if (HayNumeracionOficialEnFase(fase))
        {
            return null;
        }

        return index >= 0
            ? PartidosMapaPorFase(fase).ElementAtOrDefault(index)
            : null;
    }

    private static string FasePorNumeroMapa(int numeroPartido)
    {
        return numeroPartido switch
        {
            >= 73 and <= 88 => "Dieciseisavos",
            >= 89 and <= 96 => "Octavos",
            >= 97 and <= 100 => "Cuartos",
            101 or 102 => "Semifinales",
            103 => "TercerPuesto",
            104 => "Final",
            _ => ""
        };
    }

    private static int IndexFallbackPorNumeroMapa(int numeroPartido)
    {
        return numeroPartido switch
        {
            >= 73 and <= 88 => numeroPartido - 73,
            >= 89 and <= 96 => numeroPartido - 89,
            >= 97 and <= 100 => numeroPartido - 97,
            101 or 102 => numeroPartido - 101,
            103 or 104 => 0,
            _ => -1
        };
    }

    private PartidoDto? PartidoFinalMapa()
    {
        return PartidoPorNumeroMapa(104) ??
            PartidosMapaPorFase("Final").FirstOrDefault();
    }

    private PartidoDto? PartidoTercerPuestoMapa()
    {
        return PartidoPorNumeroMapa(103) ??
            PartidosMapaPorFase("TercerPuesto").FirstOrDefault();
    }

    private string ClaseTarjetaMapa(PartidoDto? partido)
    {
        if (partido == null)
        {
            return "duel-bracket-card is-placeholder";
        }

        return partido.Finalizado
            ? "duel-bracket-card is-final"
            : "duel-bracket-card";
    }

    private static string ClaseSlotMapa(string columnaCss, int index)
    {
        if (columnaCss.Contains("is-r32", StringComparison.OrdinalIgnoreCase))
        {
            return $"slot-r32-{index}";
        }

        if (columnaCss.Contains("is-r16", StringComparison.OrdinalIgnoreCase))
        {
            return $"slot-r16-{index}";
        }

        if (columnaCss.Contains("is-r8", StringComparison.OrdinalIgnoreCase))
        {
            return $"slot-r8-{index}";
        }

        return "slot-r4-1";
    }

