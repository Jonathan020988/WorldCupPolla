@page "/predicciones"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Models
@using WorldCup.App.Web.Services
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.PrediccionesService PrediccionesService
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ClasificacionDraftService ClasificacionDraft

<section class="predictions-header">
    <div>
        <span class="predictions-kicker">Mundial 2026</span>
        <h1>Mis Predicciones</h1>
        <p>
            Puedes modificar tus marcadores hasta <b>1 hora</b> antes de cada partido.
        </p>
    </div>
</section>

@if (cargando)
{
    <p>Cargando predicciones...</p>
}
else if (!Sesion.PollaActivaId.HasValue)
{
    <div class="card shadow-sm mb-4" style="max-width:520px">
        <div class="card-body">
            <h5 class="mb-3">Selecciona la polla</h5>
            <p class="text-muted">
                Tus predicciones se guardarán en la polla que elijas.
            </p>

            @if (!pollas.Any())
            {
                <div class="alert alert-info">
                    No tienes pollas disponibles todavía.
                </div>

                <a class="btn btn-success" href="/dashboard">
                    Ir a mis pollas
                </a>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var polla in pollas)
                    {
                        <button class="btn btn-outline-primary text-start"
                                @onclick="() => SeleccionarPolla(polla)">
                            🏆 @polla.Nombre
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="polla-banner">
        <span>
            Trabajando en la polla:
            <strong>@Sesion.PollaActivaNombre</strong>
        </span>

        <button class="btn btn-sm btn-outline-success"
                @onclick="CambiarPolla">
            Cambiar polla
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeGuardado))
    {
        <div class="alert @(guardadoConError ? "alert-danger" : "alert-success")">
            @mensajeGuardado
        </div>
    }

    @if (reaperturasActivas.Any())
    {
        <div class="alert alert-warning reopen-user-alert">
            El administrador habilitó edición temporal para:
            <strong>@string.Join(", ", reaperturasActivas.Select(EtiquetaReapertura))</strong>.
        </div>
    }

    @if (partidos?.Any() == true)
    {
        <div class="prediction-filter">
            <div>
                <label class="form-label fw-bold mb-1">Filtrar por país</label>
                <select class="form-select"
                        @bind="paisFiltro">
                    <option value="">Todos los países</option>
                    @foreach (var pais in PaisesDisponibles())
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fecha</label>
                <input class="form-control"
                       type="date"
                       @bind="fechaFiltro" />
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fase</label>
                <select class="form-select"
                        @bind="faseFiltro">
                    <option value="">Todas las fases</option>
                    @foreach (var fase in FasesDisponibles())
                    {
                        <option value="@fase">@NombreFase(fase)</option>
                    }
                </select>
            </div>

            @if (FiltrosActivos())
            {
                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Ver todos
                </button>
            }
        </div>

        var pendientesMarcador = PartidosPendientesMarcador().ToList();

        <div class="pending-predictions-panel @(pendientesMarcador.Any() ? "" : "is-complete")">
            <div class="pending-summary">
                <strong>Marcadores pendientes</strong>
                <span>
                    @(pendientesMarcador.Any()
                        ? $"{pendientesMarcador.Count} por completar"
                        : "Todos completos")
                </span>
            </div>

            @if (pendientesMarcador.Any())
            {
                <div class="pending-list">
                    @foreach (var partido in pendientesMarcador.Take(10))
                    {
                        <span class="pending-chip">
                            @partido.Local vs @partido.Visitante
                            <small>@partido.Fecha.ToString("dd/MM HH:mm")</small>
                        </span>
                    }

                    @if (pendientesMarcador.Count > 10)
                    {
                        <span class="pending-chip more">
                            +@(pendientesMarcador.Count - 10) más
                        </span>
                    }
                </div>
            }
        </div>

        var resumenClasificacion = ResumenClasificacionPredicciones();

        <div class="classification-projection-panel @(resumenClasificacion.EstaCompleto ? "ready" : "waiting")">
            <div class="projection-copy">
                <span class="projection-kicker">Clasificacion calculada</span>
                <strong>Tabla de grupos segun tus marcadores</strong>
                <p>
                    @(resumenClasificacion.EstaCompleto
                        ? "Ya puedes revisar primeros, segundos y mejores terceros antes de llevarlos como borrador."
                        : $"Completa {resumenClasificacion.Faltantes} marcador(es) de fase de grupos para calcular la tabla.")
                </p>
            </div>

            <div class="projection-actions">
                <span class="projection-count">
                    @resumenClasificacion.Completos / @resumenClasificacion.Total marcadores
                </span>
                <button class="btn btn-sm btn-primary"
                        disabled="@(!resumenClasificacion.EstaCompleto)"
                        @onclick="AbrirVistaClasificacion">
                    Ver tabla calculada
                </button>
            </div>
        </div>
    }

    @if (mostrarVistaClasificacion && vistaClasificacion != null)
    {
        <div class="projection-backdrop">
            <div class="projection-modal">
                <div class="projection-modal-header">
                    <div>
                        <span class="projection-kicker">Borrador opcional</span>
                        <h2>Clasificacion sugerida por tus marcadores</h2>
                        <p>
                            Esto no guarda nada todavia. Puedes llevarlo a Clasificacion Grupos,
                            ajustar posiciones y guardar alla grupo por grupo.
                        </p>
                    </div>
                    <button type="button"
                            class="projection-close"
                            title="Cerrar"
                            @onclick="CerrarVistaClasificacion">
                        x
                    </button>
                </div>

                <div class="projection-modal-body">
                    <div class="projection-groups">
                        @foreach (var grupo in vistaClasificacion.Grupos)
                        {
                            <div class="projection-group-card">
                                <div class="projection-group-title">
                                    <strong>Grupo @grupo.Grupo</strong>
                                    <span>@grupo.Equipos.Count equipos</span>
                                </div>

                                <table class="projection-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Equipo</th>
                                            <th>Pts</th>
                                            <th>DG</th>
                                            <th>GF</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var equipo in grupo.Equipos)
                                        {
                                            <tr class="@(equipo.EsMejorTercero ? "best-third" : "")">
                                                <td>
                                                    <span class="position-badge @PosicionCss(equipo.Posicion)">
                                                        @equipo.Posicion
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="team-inline">
                                                        <img class="team-flag small"
                                                             src="@GetBandera(equipo.Equipo)"
                                                             alt="@equipo.Equipo" />
                                                        @equipo.Equipo
                                                    </span>
                                                </td>
                                                <td>@equipo.Puntos</td>
                                                <td>@equipo.Diferencia</td>
                                                <td>@equipo.GolesFavor</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="best-thirds-panel">
                        <div class="projection-group-title">
                            <strong>8 mejores terceros</strong>
                            <span>Segun puntos, diferencia y goles a favor</span>
                        </div>

                        <div class="best-thirds-list">
                            @foreach (var tercero in vistaClasificacion.MejoresTerceros)
                            {
                                <div class="best-third-chip">
                                    <span>@tercero.OrdenMejorTercero</span>
                                    <img class="team-flag small"
                                         src="@GetBandera(tercero.Equipo)"
                                         alt="@tercero.Equipo" />
                                    <strong>@tercero.Equipo</strong>
                                    <small>Grupo @tercero.Grupo · @tercero.Puntos pts</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="projection-modal-footer">
                    <button class="btn btn-outline-secondary"
                            @onclick="CerrarVistaClasificacion">
                        Seguir manual
                    </button>
                    <button class="btn btn-success"
                            @onclick="LlevarClasificacionComoBorrador">
                        Llevar a Clasificacion Grupos
                    </button>
                </div>
            </div>
        </div>
    }

    @if (podioEstado?.disponible == true)
    {
        <div class="card shadow-sm mb-3 border-warning">
            <div class="card-header bg-warning fw-bold">
                Podio del Mundial
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Campeón</label>
                        <select class="form-select" @bind="podio.CampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 1)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Subcampeón</label>
                        <select class="form-select" @bind="podio.SubcampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 2)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tercer puesto</label>
                        <select class="form-select" @bind="podio.TerceroId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 3)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <button class="btn btn-warning mt-3"
                        @onclick="GuardarPodio">
                    Guardar podio
                </button>
            </div>
        </div>
    }
    else if (podioEstado?.gruposTerminados == true && podioEstado.cerrado)
    {
        <div class="alert alert-secondary">
            El podio ya se cerró porque empezó la fase de dieciseisavos.
        </div>
    }

    @if (partidos == null)
    {
        <p>Cargando partidos...</p>
    }
    else
    {
        var partidosVista = PartidosFiltrados().ToList();

        @if (!partidosVista.Any())
        {
            <div class="alert alert-info">
                No hay partidos para el país seleccionado.
            </div>
        }
        else
        {
            @foreach (var fase in partidosVista.GroupBy(p => p.Fase).OrderBy(g => OrdenFase(g.Key)))
            {
                var faseNombre = fase.Key;
                var faseFinalizada = FaseFinalizada(faseNombre);
                var faseMinimizada = FaseMinimizada(faseNombre);

                <div class="phase-title">
                    <div class="phase-title-main">
                        <span>@faseNombre</span>
                        <small>@fase.Count() partidos</small>
                    </div>

                    @if (faseFinalizada)
                    {
                        <button type="button"
                                class="phase-collapse-btn"
                                @onclick="() => ToggleFaseMinimizada(faseNombre)">
                            @(faseMinimizada ? "Mostrar fase" : "Minimizar fase")
                        </button>
                    }
                </div>

                @if (faseMinimizada)
                {
                    <div class="phase-collapsed-summary">
                        @faseNombre finalizada. @fase.Count() partidos ocultos para navegar más rápido.
                    </div>
                }
                else
                {
                    @foreach (var p in fase.OrderBy(p => p.Fecha).ThenBy(p => p.Id))
                    {
                        var bloqueado = EstaBloqueado(p);
                        var guardada = EstaGuardada(p);
                        var editable = EstaEditable(p);

                        <div class="prediction-card @(guardada ? "is-saved" : "") @(editable ? "is-editing" : "")">
                            <div class="prediction-card-main">
                                <div class="prediction-team prediction-team-local">
                                    <span>@p.Local</span>
                                    <img class="team-flag"
                                         src="@GetBandera(p.Local)"
                                         alt="@p.Local" />
                                </div>

                                <div class="score-panel">
                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesLocal"
                                           @bind:event="oninput" />

                                    <span class="score-separator">-</span>

                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesVisitante"
                                           @bind:event="oninput" />
                                </div>

                                <div class="prediction-team prediction-team-visitor">
                                    <img class="team-flag"
                                         src="@GetBandera(p.Visitante)"
                                         alt="@p.Visitante" />
                                    <span>@p.Visitante</span>
                                </div>

                                <div class="prediction-actions">
                                    <button class="btn btn-sm btn-success"
                                            disabled="@(!editable)"
                                            title="Guardar predicción"
                                            @onclick="() => GuardarPartido(p)">
                                        Guardar
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary"
                                            disabled="@(bloqueado || !guardada || editable)"
                                            title="Editar predicción"
                                            @onclick="() => EditarPartido(p)">
                                        Editar
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(bloqueado || !guardada)"
                                            title="Eliminar predicción"
                                            @onclick="() => EliminarPartido(p)">
                                        Eliminar
                                    </button>
                                </div>
                            </div>

                            @if (p.Fase != "Grupos")
                            {
                                var alertaEmpate = AlertaEmpateEliminatoria(p);

                                <div class="prediction-extra">
                                    <select class="form-select form-select-sm"
                                            disabled="@(!editable)"
                                            @bind="predicciones[p.Id].PrediceClasificadoId">
                                        <option value="">Equipo que clasifica</option>
                                        <option value="@p.LocalId">@p.Local</option>
                                        <option value="@p.VisitanteId">@p.Visitante</option>
                                    </select>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               disabled="@(!editable)"
                                               @bind="predicciones[p.Id].PrediceTiempoExtra" />
                                        <span class="form-check-label">Tiempo extra</span>
                                    </label>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               disabled="@(!editable)"
                                               @bind="predicciones[p.Id].PredicePenales" />
                                        <span class="form-check-label">Extra + penales</span>
                                    </label>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(alertaEmpate))
                                {
                                    <div class="knockout-alert">
                                        @alertaEmpate
                                    </div>
                                }
                            }

                            <div class="prediction-footer">
                                <span>
                                    @(DateTime.SpecifyKind(p.Fecha, DateTimeKind.Unspecified)
                                        .ToString("dddd dd 'de' MMMM yyyy HH:mm"))
                                </span>

                                @if (bloqueado)
                                {
                                    <span class="status-pill locked">Bloqueado</span>
                                }
                                else if (editable && guardada)
                                {
                                    <span class="status-pill editing">Editando</span>
                                }
                                else if (guardada)
                                {
                                    <span class="status-pill saved">Guardada</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">Pendiente</span>
                                }
                            </div>
                        </div>
                    }
                }
            }
        }
    }
}

<style>
    .predictions-header {
        margin-bottom: 1rem;
        padding: 1rem 1.2rem;
        border: 1px solid #d8e8df;
        border-left: 5px solid #198754;
        border-radius: 8px;
        background: linear-gradient(135deg, #ffffff 0%, #f5fbf7 100%);
    }

    .predictions-header h1 {
        margin: 0;
        font-size: clamp(1.6rem, 2vw, 2.1rem);
        font-weight: 800;
        color: #17221c;
    }

    .predictions-header p {
        margin: .25rem 0 0;
        color: #5f6f66;
    }

    .predictions-kicker {
        display: block;
        margin-bottom: .15rem;
        color: #198754;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .polla-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: .75rem 1rem;
        border: 1px solid #cfe8d8;
        border-radius: 8px;
        background: #f3fbf6;
        color: #163c27;
    }

    .reopen-user-alert {
        border-radius: 8px;
        font-weight: 700;
    }

    .phase-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        margin: 1.35rem 0 .6rem;
        padding-bottom: .35rem;
        border-bottom: 1px solid #e1e6eb;
    }

    .phase-title-main {
        display: grid;
        gap: .1rem;
    }

    .phase-title span {
        font-size: 1.05rem;
        font-weight: 800;
        color: #1d2733;
    }

    .phase-title small {
        color: #6b7785;
        font-weight: 600;
    }

    .phase-collapse-btn {
        border: 1px solid #ccd5df;
        border-radius: 999px;
        background: #ffffff;
        color: #344054;
        padding: .28rem .7rem;
        font-size: .82rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .phase-collapse-btn:hover,
    .phase-collapse-btn:focus-visible {
        background: #f2f4f7;
    }

    .phase-collapsed-summary {
        margin-bottom: .75rem;
        padding: .65rem .8rem;
        border: 1px dashed #cfd8e3;
        border-radius: 8px;
        background: #f8fafc;
        color: #667085;
        font-size: .9rem;
        font-weight: 700;
    }

    .prediction-filter {
        display: flex;
        align-items: flex-end;
        gap: .75rem;
        margin-bottom: 1rem;
        padding: .85rem 1rem;
        border: 1px solid #dfe5eb;
        border-radius: 8px;
        background: #ffffff;
    }

    .prediction-filter > div {
        min-width: min(100%, 320px);
    }

    .pending-predictions-panel {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        padding: .85rem 1rem;
        border: 1px solid #f2d49b;
        border-left: 4px solid #f0ad4e;
        border-radius: 8px;
        background: #fff8ed;
    }

    .pending-predictions-panel.is-complete {
        border-color: #b7dfc1;
        border-left-color: #198754;
        background: #f0fbf4;
    }

    .pending-summary {
        min-width: 190px;
    }

    .pending-summary strong {
        display: block;
        color: #2f3a45;
    }

    .pending-summary span {
        color: #6b7280;
        font-size: .9rem;
    }

    .pending-list {
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
    }

    .pending-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .28rem .55rem;
        border: 1px solid #ead6b4;
        border-radius: 999px;
        background: #fff;
        color: #344054;
        font-size: .84rem;
        font-weight: 600;
    }

    .pending-chip small {
        color: #8a5f1b;
        font-weight: 700;
    }

    .pending-chip.more {
        background: #2f3a45;
        border-color: #2f3a45;
        color: white;
    }

    .classification-projection-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        padding: 1rem;
        border: 1px solid #d6dde7;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(16, 24, 40, .06);
    }

    .classification-projection-panel.ready {
        border-color: #b9e2c6;
        background: linear-gradient(135deg, #ffffff 0%, #f2fbf5 100%);
    }

    .classification-projection-panel.waiting {
        border-color: #f1d6a4;
        background: #fffaf1;
    }

    .projection-copy strong {
        display: block;
        color: #17221c;
        font-size: 1rem;
        font-weight: 850;
    }

    .projection-copy p {
        margin: .2rem 0 0;
        color: #667085;
        font-size: .9rem;
    }

    .projection-kicker {
        display: block;
        color: #198754;
        font-size: .75rem;
        font-weight: 850;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .projection-actions {
        display: flex;
        align-items: center;
        gap: .65rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .projection-count {
        min-height: 28px;
        padding: .25rem .6rem;
        border-radius: 999px;
        background: #f2f4f7;
        color: #344054;
        font-size: .82rem;
        font-weight: 850;
    }

    .projection-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(15, 23, 42, .58);
    }

    .projection-modal {
        width: min(1180px, 100%);
        max-height: min(92vh, 980px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 24px 70px rgba(0, 0, 0, .28);
    }

    .projection-modal-header,
    .projection-modal-footer {
        display: flex;
        justify-content: space-between;
