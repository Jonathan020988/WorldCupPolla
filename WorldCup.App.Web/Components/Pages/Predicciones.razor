    private MapaEquipoSlotDto EquipoSlotEsperadoMapa(int numeroPartido, bool esLocal)
    {
        var fuente = FuenteSlotMapa(numeroPartido, esLocal);
        if (!fuente.NumeroPartido.HasValue)
        {
            return new MapaEquipoSlotDto("Equipo por definir", "", "-", false);
        }

        var partidoFuente = PartidoPorNumeroMapa(fuente.NumeroPartido.Value);
        var origen = fuente.EsPerdedor
            ? $"Perdedor P{fuente.NumeroPartido.Value}"
            : $"Ganador P{fuente.NumeroPartido.Value}";

        if (partidoFuente == null || !partidoFuente.Finalizado)
        {
            return new MapaEquipoSlotDto(origen, "Pendiente", "-", false);
        }

        var equipo = fuente.EsPerdedor
            ? EquipoPerdedorMapa(partidoFuente)
            : EquipoGanadorMapa(partidoFuente);

        return string.IsNullOrWhiteSpace(equipo)
            ? new MapaEquipoSlotDto(origen, "Pendiente", "-", false)
            : new MapaEquipoSlotDto(equipo, origen, "-", true);
    }

    private static FuenteMapaSlotDto FuenteSlotMapa(int numeroPartido, bool esLocal)
    {
        return numeroPartido switch
        {
            89 => new FuenteMapaSlotDto(esLocal ? 74 : 77),
            90 => new FuenteMapaSlotDto(esLocal ? 73 : 75),
            91 => new FuenteMapaSlotDto(esLocal ? 76 : 78),
            92 => new FuenteMapaSlotDto(esLocal ? 79 : 80),
            93 => new FuenteMapaSlotDto(esLocal ? 83 : 84),
            94 => new FuenteMapaSlotDto(esLocal ? 81 : 82),
            95 => new FuenteMapaSlotDto(esLocal ? 86 : 88),
            96 => new FuenteMapaSlotDto(esLocal ? 85 : 87),
            97 => new FuenteMapaSlotDto(esLocal ? 89 : 90),
            98 => new FuenteMapaSlotDto(esLocal ? 93 : 94),
            99 => new FuenteMapaSlotDto(esLocal ? 91 : 92),
            100 => new FuenteMapaSlotDto(esLocal ? 95 : 96),
            101 => new FuenteMapaSlotDto(esLocal ? 97 : 98),
            102 => new FuenteMapaSlotDto(esLocal ? 99 : 100),
            103 => new FuenteMapaSlotDto(esLocal ? 101 : 102, true),
            104 => new FuenteMapaSlotDto(esLocal ? 101 : 102),
            _ => new FuenteMapaSlotDto(null)
        };
    }

    private string EquipoGanadorMapa(PartidoDto partido)
    {
        if (partido.ClasificadoId.HasValue)
        {
            if (partido.ClasificadoId.Value == partido.LocalId)
            {
                return NombreEquipoMapa(partido.Local);
            }

            if (partido.ClasificadoId.Value == partido.VisitanteId)
            {
                return NombreEquipoMapa(partido.Visitante);
            }
        }

        if (!partido.GolesLocal.HasValue ||
            !partido.GolesVisitante.HasValue ||
            partido.GolesLocal.Value == partido.GolesVisitante.Value)
        {
            return "";
        }

        return partido.GolesLocal.Value > partido.GolesVisitante.Value
            ? NombreEquipoMapa(partido.Local)
            : NombreEquipoMapa(partido.Visitante);
    }

    private string EquipoPerdedorMapa(PartidoDto partido)
    {
        if (partido.ClasificadoId.HasValue)
        {
            if (partido.ClasificadoId.Value == partido.LocalId)
            {
                return NombreEquipoMapa(partido.Visitante);
            }

            if (partido.ClasificadoId.Value == partido.VisitanteId)
            {
                return NombreEquipoMapa(partido.Local);
            }
        }

        if (!partido.GolesLocal.HasValue ||
            !partido.GolesVisitante.HasValue ||
            partido.GolesLocal.Value == partido.GolesVisitante.Value)
        {
            return "";
        }

        return partido.GolesLocal.Value > partido.GolesVisitante.Value
            ? NombreEquipoMapa(partido.Visitante)
            : NombreEquipoMapa(partido.Local);
    }

    private string EtiquetaPartidoMapa(PartidoDto partido)
    {
        return partido.NumeroPartidoFifa.HasValue
            ? $"Partido {partido.NumeroPartidoFifa.Value}"
            : $"Partido {partido.Id}";
    }

    private string EstadoPartidoMapa(PartidoDto partido)
    {
        if (partido.Finalizado)
        {
            return "Finalizado";
        }

        return partido.Fecha <= DateTime.MinValue
            ? "Pendiente"
            : partido.Fecha.ToString("dd/MM HH:mm");
    }

    private string NombreEquipoMapa(string equipo)
    {
        if (string.IsNullOrWhiteSpace(equipo) ||
            equipo.Contains("Selecciona", StringComparison.OrdinalIgnoreCase))
        {
            return "Por definir";
        }

        return equipo;
    }

    private string MarcadorEquipoMapa(int? goles)
    {
        return goles.HasValue
            ? goles.Value.ToString()
            : "-";
    }

    private bool EquipoClasificadoMapa(PartidoDto partido, int equipoId)
    {
        if (equipoId <= 0)
        {
            return false;
        }

        if (partido.ClasificadoId.HasValue)
        {
            return partido.ClasificadoId.Value == equipoId;
        }

        if (!partido.Finalizado ||
            !partido.GolesLocal.HasValue ||
            !partido.GolesVisitante.HasValue ||
            partido.GolesLocal.Value == partido.GolesVisitante.Value)
        {
            return false;
        }

        return partido.GolesLocal.Value > partido.GolesVisitante.Value
            ? partido.LocalId == equipoId
            : partido.VisitanteId == equipoId;
    }

    private string DetalleClasificacionMapa(PartidoDto partido)
    {
        if (!partido.ClasificadoId.HasValue)
        {
            return "";
        }

        var clasificado = partido.ClasificadoId.Value == partido.LocalId
            ? NombreEquipoMapa(partido.Local)
            : partido.ClasificadoId.Value == partido.VisitanteId
                ? NombreEquipoMapa(partido.Visitante)
                : "";

        if (string.IsNullOrWhiteSpace(clasificado) ||
            string.Equals(clasificado, "Por definir", StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }

        if (partido.PenalesLocal.HasValue || partido.PenalesVisitante.HasValue)
        {
            return $"Clasifica {clasificado} por penales";
        }

        if (partido.TiempoExtra)
        {
            return TieneMarcadorExtraCompleto(partido)
                ? $"Clasifica {clasificado} en tiempo extra ({partido.GolesExtraLocal}-{partido.GolesExtraVisitante})"
                : $"Clasifica {clasificado} en tiempo extra";
        }

        return $"Clasifica {clasificado}";
    }

    private static bool TieneMarcadorExtraCompleto(PartidoDto partido)
    {
        return partido.GolesExtraLocal.HasValue &&
               partido.GolesExtraVisitante.HasValue;
    }

    private bool EquipoPodioOcupado(int equipoId, int campo)
    {
        return campo switch
        {
            1 => equipoId == podio.SubcampeonId || equipoId == podio.TerceroId,
            2 => equipoId == podio.CampeonId || equipoId == podio.TerceroId,
            3 => equipoId == podio.CampeonId || equipoId == podio.SubcampeonId,
            _ => false
        };
    }

    private string CierrePodioTexto()
    {
        var cierre = podioEstado?.cierreColombia ??
            new DateTime(2026, 6, 29, 11, 0, 0);

        return cierre.ToString("dd/MM/yyyy h:mm tt")
            .Replace("AM", "a. m.")
            .Replace("PM", "p. m.");
    }

    private string AlertaEmpateEliminatoria(PartidoDto partido)
    {
        if (partido.Fase == "Grupos" ||
            !predicciones.TryGetValue(partido.Id, out var item) ||
            !item.GolesLocal.HasValue ||
            !item.GolesVisitante.HasValue ||
            item.GolesLocal != item.GolesVisitante)
        {
            return "";
        }

        var faltaClasificado = !item.PrediceClasificadoId.HasValue;
        var faltaDefinicion = !item.PrediceTiempoExtra && !item.PredicePenales;

        if (!faltaClasificado && !faltaDefinicion)
        {
            return "";
        }

        return "Empate en eliminatoria: debes definir qué equipo pasa y si pasa por tiempo extra o por penales.";
    }

    private void SeleccionarDefinicionEliminatoria(int partidoId, bool penales)
    {
        if (!predicciones.TryGetValue(partidoId, out var item))
        {
            return;
        }

        item.PrediceTiempoExtra = true;
        item.PredicePenales = penales;
    }

    private void EditarPartido(PartidoDto partido)
    {
        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        if (!EstaGuardada(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} todavía no está guardada.";
            guardadoConError = true;
            return;
        }

        prediccionesEnEdicion.Add(partido.Id);
        mensajeGuardado = $"Puedes editar la predicción {NombrePartido(partido)}.";
        guardadoConError = false;
    }

    private void EditarPartidoMovil(PartidoDto partido)
    {
        EditarPartido(partido);
        if (!guardadoConError)
        {
            partidoMovilAbiertoId = partido.Id;
        }
    }

    private async Task GuardarPartido(PartidoDto partido)
    {
        if (!predicciones.ContainsKey(partido.Id) ||
            !Sesion.PollaActivaId.HasValue ||
            !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        var item = predicciones[partido.Id];

        if (partido.Fase != "Grupos")
        {
            if (item.PredicePenales)
            {
                item.PrediceTiempoExtra = true;
            }

            var esEmpate = item.GolesLocal.HasValue &&
                item.GolesVisitante.HasValue &&
                item.GolesLocal == item.GolesVisitante;

            if (esEmpate)
            {
                if (!item.PrediceClasificadoId.HasValue ||
                    (!item.PrediceTiempoExtra && !item.PredicePenales))
                {
                    mensajeGuardado = $"La predicción {NombrePartido(partido)} está empatada: debes indicar qué equipo clasifica y si pasa por tiempo extra o por penales.";
                    guardadoConError = true;
                    return;
                }
            }
            else if (item.GolesLocal.HasValue &&
                item.GolesVisitante.HasValue)
            {
                item.PrediceClasificadoId = item.GolesLocal > item.GolesVisitante
                    ? partido.LocalId
                    : partido.VisitanteId;
                item.PrediceTiempoExtra = false;
                item.PredicePenales = false;
            }

            if (!item.PrediceClasificadoId.HasValue)
            {
                mensajeGuardado = "En eliminatorias debes indicar qué equipo clasifica.";
                guardadoConError = true;
                return;
            }
        }

        var dto = new GuardarPrediccionGrupoDto
            {
                PollaId = Sesion.PollaActivaId.Value,
                UsuarioId = Sesion.UsuarioId.Value,

                // Backend exige Grupo siempre
                Grupo = partido.Fase == "Grupos"
                    ? partido.Grupo ?? "A"
                    : "ELIMINATORIA",

                Predicciones = new List<GuardarPrediccionItemDto>
            {
                item
            }
            };

        try
        {
            await PrediccionesService.GuardarMultiplesAsync(dto);
            prediccionesGuardadas.Add(partido.Id);
            prediccionesEnEdicion.Remove(partido.Id);
            mensajeGuardado = $"Predicción {NombrePartido(partido)} guardada correctamente.";
            guardadoConError = false;
        }
        catch (Exception ex)
        {
            mensajeGuardado = $"No se pudo guardar la predicción: {ex.Message}";
            guardadoConError = true;
        }
    }

    private async Task GuardarPartidoMovil(PartidoDto partido)
    {
        await GuardarPartido(partido);
        if (!guardadoConError)
        {
            partidoMovilAbiertoId = null;
        }
    }

    private async Task EliminarPartido(PartidoDto partido)
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        try
        {
            await PrediccionesService.EliminarPrediccionAsync(
                Sesion.PollaActivaId.Value,
                Sesion.UsuarioId.Value,
                partido.Id);

            predicciones[partido.Id] = new GuardarPrediccionItemDto
                {
                    PartidoId = partido.Id
                };
            prediccionesGuardadas.Remove(partido.Id);
            prediccionesEnEdicion.Remove(partido.Id);
            mensajeGuardado = $"Predicción {NombrePartido(partido)} eliminada correctamente.";
            guardadoConError = false;
        }
        catch (Exception ex)
        {
            mensajeGuardado = $"No se pudo eliminar la predicción {NombrePartido(partido)}: {ex.Message}";
            guardadoConError = true;
        }
    }

    private async Task EliminarPartidoMovil(PartidoDto partido)
    {
        await EliminarPartido(partido);
        if (!guardadoConError)
        {
            partidoMovilAbiertoId = null;
        }
    }

    private async Task CargarPodioAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            podioEstado = await Http.GetFromJsonAsync<PodioEstadoDto>(
                $"api/Podio/estado?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}");

            if (podioEstado?.prediccion != null)
            {
                podio = new GuardarPodioDto
                {
                    CampeonId = podioEstado.prediccion.campeonId,
                    SubcampeonId = podioEstado.prediccion.subcampeonId,
                    TerceroId = podioEstado.prediccion.terceroId
                };
            }
        }
        catch
        {
            podioEstado = null;
        }
    }

    private async Task GuardarPodio()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (podio.CampeonId == 0 ||
            podio.SubcampeonId == 0 ||
            podio.TerceroId == 0 ||
            podio.CampeonId == podio.SubcampeonId ||
            podio.CampeonId == podio.TerceroId ||
            podio.SubcampeonId == podio.TerceroId)
        {
            mensajeGuardado = "Debes elegir tres equipos distintos para el podio.";
            guardadoConError = true;
            mensajePodioGuardado = "Debes elegir tres equipos distintos para confirmar tu podio.";
            podioGuardadoConError = true;
            return;
        }

        podio.PollaId = Sesion.PollaActivaId.Value;
        podio.UsuarioId = Sesion.UsuarioId.Value;

        try
        {
            guardandoPodio = true;
            mensajePodioGuardado = null;

            var campeon = NombreEquipoPodio(podio.CampeonId);
            var subcampeon = NombreEquipoPodio(podio.SubcampeonId);
            var tercero = NombreEquipoPodio(podio.TerceroId);

            var response = await Http.PostAsJsonAsync("api/Podio/guardar", podio);
            if (!response.IsSuccessStatusCode)
            {
                mensajeGuardado = await response.Content.ReadAsStringAsync();
                guardadoConError = true;
                mensajePodioGuardado = mensajeGuardado;
                podioGuardadoConError = true;
                return;
            }

            mensajeGuardado = "Podio guardado correctamente.";
            guardadoConError = false;
            mensajePodioGuardado =
                $"Confirmado: Campeón {campeon}, Subcampeón {subcampeon}, Tercer puesto {tercero}.";
            podioGuardadoConError = false;
            await CargarPodioAsync();
        }
        catch (Exception ex)
        {
            mensajeGuardado = $"No se pudo guardar el podio: {ex.Message}";
            guardadoConError = true;
            mensajePodioGuardado = mensajeGuardado;
            podioGuardadoConError = true;
        }
        finally
        {
            guardandoPodio = false;
        }
    }

    private string NombreEquipoPodio(int equipoId)
    {
        return podioEstado?.equipos.FirstOrDefault(e => e.id == equipoId)?.nombre
            ?? $"equipo {equipoId}";
    }

    private int OrdenFase(string fase) => fase switch
    {
        "Grupos" => 1,
        "Dieciseisavos" => 2,
        "Octavos" => 3,
        "Cuartos" => 4,
        "Semifinales" => 5,
        "TercerPuesto" => 6,
        "Final" => 7,
        _ => 99
    };

    private string NombreFase(string fase)
    {
        return fase == "TercerPuesto"
            ? "Tercer puesto"
            : fase;
    }

