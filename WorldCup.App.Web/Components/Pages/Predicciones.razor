    private void TogglePartidoMovil(PartidoDto partido)
    {
        if (partidoMovilAbiertoId == partido.Id)
        {
            partidoMovilAbiertoId = null;
            return;
        }

        partidoMovilAbiertoId = partido.Id;

        if (!EstaBloqueado(partido) &&
            EstaGuardada(partido) &&
            !prediccionesEnEdicion.Contains(partido.Id))
        {
            EditarPartido(partido);
        }
    }

    private string MarcadorMovilTexto(PartidoDto partido)
    {
        if (predicciones.TryGetValue(partido.Id, out var item) &&
            item.GolesLocal.HasValue &&
            item.GolesVisitante.HasValue)
        {
            return $"{item.GolesLocal.Value}-{item.GolesVisitante.Value}";
        }

        return EstaGuardada(partido)
            ? "Guardada"
            : "Abrir";
    }

    private (string Clase, string Texto) EstadoPrediccion(PartidoDto partido)
    {
        var bloqueado = EstaBloqueado(partido);
        var guardada = EstaGuardada(partido);
        var editable = EstaEditable(partido);

        if (bloqueado)
        {
            return ("locked", "Bloqueado");
        }

        if (editable && guardada)
        {
            return ("editing", "Editando");
        }

        if (guardada)
        {
            return ("saved", "Guardada");
        }

        return ("pending", "Pendiente");
    }

    private RenderFragment EstadoPrediccionPill(PartidoDto partido) => builder =>
    {
        var estado = EstadoPrediccion(partido);
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"status-pill {estado.Clase}");
        builder.AddContent(2, estado.Texto);
        builder.CloseElement();
    };

    private bool EstaGuardada(PartidoDto partido)
    {
        return prediccionesGuardadas.Contains(partido.Id);
    }

    private bool EstaEditable(PartidoDto partido)
    {
        return !EstaBloqueado(partido) &&
               (!EstaGuardada(partido) || prediccionesEnEdicion.Contains(partido.Id));
    }

    private string NombrePartido(PartidoDto partido)
    {
        return $"{partido.Local} vs {partido.Visitante}";
    }

    private bool FaseFinalizada(string fase)
    {
        return partidos?.Any(p => p.Fase == fase) == true &&
               partidos.Where(p => p.Fase == fase).All(p => p.Finalizado);
    }

    private bool MostrarClasificacionCalculada()
    {
        return string.IsNullOrWhiteSpace(faseFiltro) ||
               string.Equals(faseFiltro, "Grupos", StringComparison.OrdinalIgnoreCase);
    }

    private bool FaseMinimizada(string fase)
    {
        return FaseFinalizada(fase) && fasesMinimizadas.Contains(fase);
    }

    private void ToggleFaseMinimizada(string fase)
    {
        if (!FaseFinalizada(fase))
        {
            fasesMinimizadas.Remove(fase);
            return;
        }

        if (!fasesMinimizadas.Add(fase))
        {
            fasesMinimizadas.Remove(fase);
        }
    }

    private bool EsFaseEliminatoria(string fase)
    {
        return OrdenFase(fase) >= OrdenFase("Dieciseisavos") &&
               OrdenFase(fase) <= OrdenFase("Final");
    }

    private void AbrirMapaDuelos(string fase)
    {
        faseMapaDuelos = EsFaseEliminatoria(fase)
            ? fase
            : "Dieciseisavos";
        mostrarMapaDuelos = true;
    }

    private void CerrarMapaDuelos()
    {
        mostrarMapaDuelos = false;
    }

    private IEnumerable<string> FasesMapaDuelos()
    {
        return FasesEliminatoriasMapa;
    }

    private IEnumerable<PartidoDto> PartidosMapaPorFase(string fase)
    {
        return partidos?
            .Where(p => string.Equals(p.Fase, fase, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.NumeroPartidoFifa ?? p.Id)
            .ThenBy(p => p.Id) ?? Enumerable.Empty<PartidoDto>();
    }

    private bool FaseMapaActiva(string fase)
    {
        return string.Equals(faseMapaDuelos, fase, StringComparison.OrdinalIgnoreCase);
    }

    private string ConteoMapaFase(int publicados)
    {
        return publicados > 0
            ? $"{publicados} publicado(s)"
            : "Por definir";
    }

    private string ResumenMapaDuelos()
    {
        var publicados = partidos?
            .Count(p => EsFaseEliminatoria(p.Fase)) ?? 0;

        return publicados > 0
            ? $"{publicados} partido(s) eliminatorio(s) publicados. Los siguientes cruces se llenan a medida que el administrador los monte."
            : "Todavia no hay cruces eliminatorios publicados.";
    }

