@page "/predicciones"
@rendermode InteractiveServer

@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Models
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.PrediccionesService PrediccionesService
@inject SesionService Sesion
@inject NavigationManager Navigation


<h1 class="mb-1">🎯 Mis Predicciones</h1>
<p class="text-muted mb-3">
    ⏱️ Puedes modificar tus predicciones hasta <b>20 minutos</b> antes del partido
</p>

@if (partidos == null)
{
    <p>Cargando partidos...</p>
}
else
{
    @foreach (var p in partidos)
    {
        var bloqueado = EstaBloqueado(p);

        <div class="card mb-2 partido-card">

            <div class="card-body py-2 px-3">

                <!-- FILA PARTIDO -->
                <div class="row align-items-center text-center">

                    <!-- LOCAL -->
                    <div class="col-4 text-end fw-semibold text-truncate">
                        ⚽ @p.Local
                    </div>

                    <!-- MARCADOR -->
                    <div class="col-3 d-flex justify-content-center align-items-center gap-1">

                        <input type="number"
                               class="form-control form-control-sm marcador-input"
                               min="0"
                               disabled="@bloqueado"
                               @bind="predicciones[p.Id].GolesLocal"
                               @bind:event="oninput" />

                        <span class="fw-bold text-muted">:</span>

                        <input type="number"
                               class="form-control form-control-sm marcador-input"
                               min="0"
                               disabled="@bloqueado"
                               @bind="predicciones[p.Id].GolesVisitante"
                               @bind:event="oninput" />
                    </div>

                    <!-- VISITANTE -->
                    <div class="col-4 text-start fw-semibold text-truncate">
                        @p.Visitante ⚽
                    </div>

                    <!-- GUARDAR -->
                    <div class="col-1 text-end">
                        <button class="btn btn-sm btn-outline-primary"
                                disabled="@bloqueado"
                                title="Guardar predicción"
                                @onclick="() => GuardarPartido(p)">
                            💾
                        </button>
                    </div>
                </div>

                <!-- INFO -->
                <div class="mt-1 text-center small text-muted">
                    🗓️ @(DateTime.SpecifyKind(p.Fecha, DateTimeKind.Unspecified)
                    .ToString("dddd dd 'de' MMMM yyyy HH:mm"))

                    · 🏆 @p.Fase

                    @if (bloqueado)
                    {
                        <span class="badge bg-danger ms-2">🔒 Bloqueado</span>
                    }
                </div>

            </div>
        </div>
    }
}

<style>
    .partido-card {
        border-left: 4px solid #0d6efd;
        border-radius: 8px;
    }

    .marcador-input {
        width: 42px;
        text-align: center;
        padding: 2px 4px;
        font-weight: 600;
    }
</style>

@code {

    private List<PartidoDto>? partidos;
    private Dictionary<int, GuardarPrediccionItemDto> predicciones = new();

    private const int PollaId = 2;

    protected override async Task OnInitializedAsync()
    {
        partidos = await PartidosService.GetPartidosAsync();

        var existentes = await PrediccionesService.GetPrediccionesAsync();

        var existentesDict = existentes
            .GroupBy(x => x.PartidoId)
            .ToDictionary(x => x.Key, x => x.First());

        foreach (var p in partidos)
        {
            if (existentesDict.TryGetValue(p.Id, out var e))
            {
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id,
                        GolesLocal = e.GolesLocal,
                        GolesVisitante = e.GolesVisitante
                    };
            }
            else
            {
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id
                    };
            }
        }
    }

    private bool EstaBloqueado(PartidoDto partido)
    {
        if (partido.Fecha <= DateTime.MinValue)
            return false;

        return DateTime.UtcNow >= partido.Fecha.AddMinutes(-20)
               || partido.Finalizado;
    }

    private async Task GuardarPartido(PartidoDto partido)
    {
        if (!predicciones.ContainsKey(partido.Id))
            return;

        var dto = new GuardarPrediccionGrupoDto
            {
                PollaId = PollaId,

                // Backend exige Grupo siempre
                Grupo = partido.Fase == "Grupos"
                    ? partido.Grupo ?? "A"
                    : "ELIMINATORIA",

                Predicciones = new List<GuardarPrediccionItemDto>
            {
                predicciones[partido.Id]
            }
            };

        try
        {
            await PrediccionesService.GuardarMultiplesAsync(dto);
            Console.WriteLine($"✅ Predicción guardada partido {partido.Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al guardar: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sesion.RestaurarSesionAsync();

            if (!Sesion.EstaLogueado)
            {
                Navigation.NavigateTo("/login", true);
            }
        }
    }

   

}





