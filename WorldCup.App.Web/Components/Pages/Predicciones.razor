@code {

    private List<PartidoDto>? partidos;
    private Dictionary<int, GuardarPrediccionItemDto> predicciones = new();
    private HashSet<int> prediccionesGuardadas = new();
    private HashSet<int> prediccionesEnEdicion = new();
    private List<PollaDto> pollas = new();
    private PodioEstadoDto? podioEstado;
    private GuardarPodioDto podio = new();
    private List<ReaperturaUsuarioDto> reaperturasActivas = new();
    private bool cargando = true;
    private string? mensajeGuardado;
    private bool guardadoConError;
    private string? paisFiltro;
    private DateTime? fechaFiltro;
    private string? faseFiltro;
    private HashSet<string> fasesMinimizadas = new(StringComparer.OrdinalIgnoreCase);
    private bool mostrarVistaClasificacion;
    private ClasificacionCalculadaDto? vistaClasificacion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login?returnUrl=/predicciones", true);
            return;
        }

        pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);

        if (Sesion.PollaActivaId.HasValue &&
            !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
        {
            await Sesion.LimpiarPollaActivaAsync();
        }

        if (Sesion.PollaActivaId.HasValue)
        {
            await CargarPrediccionesAsync();
            await CargarPodioAsync();
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task SeleccionarPolla(PollaDto polla)
    {
        cargando = true;
        StateHasChanged();

        await Sesion.SeleccionarPollaAsync(polla.Id, polla.Nombre);
        await CargarPrediccionesAsync();
        await CargarPodioAsync();

        cargando = false;
        StateHasChanged();
    }

    private async Task CambiarPolla()
    {
        await Sesion.LimpiarPollaActivaAsync();
        partidos = null;
        predicciones.Clear();
        prediccionesGuardadas.Clear();
        prediccionesEnEdicion.Clear();
        reaperturasActivas.Clear();
        fasesMinimizadas.Clear();
        paisFiltro = null;
        fechaFiltro = null;
        faseFiltro = null;
        podioEstado = null;
        podio = new();
        vistaClasificacion = null;
        mostrarVistaClasificacion = false;
    }

    private async Task CargarPrediccionesAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        partidos = (await PartidosService.GetPartidosAsync())
            .OrderBy(p => OrdenFase(p.Fase))
            .ThenBy(p => p.Fecha)
            .ThenBy(p => p.Id)
            .ToList();

        var existentes = await PrediccionesService.GetPrediccionesAsync(
            Sesion.PollaActivaId.Value,
            Sesion.UsuarioId.Value);

        await CargarReaperturasAsync();

        var existentesDict = existentes
            .GroupBy(x => x.PartidoId)
            .ToDictionary(x => x.Key, x => x.First());

        predicciones.Clear();
        prediccionesGuardadas.Clear();
        prediccionesEnEdicion.Clear();

        foreach (var p in partidos)
        {
            if (existentesDict.TryGetValue(p.Id, out var e))
            {
                prediccionesGuardadas.Add(p.Id);
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id,
                        GolesLocal = e.GolesLocal,
                        GolesVisitante = e.GolesVisitante,
                        PrediceTiempoExtra = e.PrediceTiempoExtra,
                        PredicePenales = e.PredicePenales,
                        PrediceClasificadoId = e.PrediceClasificadoId
                    };
            }
            else
            {
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id
                };
            }
        }

        MinimizarFasesFinalizadasAlCargar();
    }

    private void MinimizarFasesFinalizadasAlCargar()
    {
        fasesMinimizadas = partidos?
            .GroupBy(p => p.Fase)
            .Where(g => g.Any() && g.All(p => p.Finalizado))
            .Select(g => g.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase)
            ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private bool EstaBloqueado(PartidoDto partido)
    {
        if (ReaperturaActiva(partido.Fase, "Marcadores"))
        {
            return false;
        }

        if (partido.Fecha <= DateTime.MinValue)
            return false;

        return HoraColombiaActual() >= partido.Fecha.AddHours(-1)
               || partido.Finalizado;
    }

    private async Task CargarReaperturasAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            reaperturasActivas.Clear();
            return;
        }

        reaperturasActivas = await Http.GetFromJsonAsync<List<ReaperturaUsuarioDto>>(
            $"api/Predicciones/reaperturas?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}") ?? new();
    }

    private bool ReaperturaActiva(string fase, string tipo)
    {
        return reaperturasActivas.Any(r =>
            r.Activa &&
            string.Equals(r.Fase, fase, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(r.Tipo, tipo, StringComparison.OrdinalIgnoreCase));
    }

    private string EtiquetaReapertura(ReaperturaUsuarioDto reapertura)
    {
        return reapertura.Tipo == "Podio"
            ? "podio final"
            : $"{reapertura.Fase} ({reapertura.Tipo.ToLowerInvariant()})";
    }

    private static DateTime HoraColombiaActual()
    {
        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time"));
        }
        catch
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"));
        }
    }

    private IEnumerable<PartidoDto> PartidosFiltrados()
    {
        if (partidos == null)
        {
            return Enumerable.Empty<PartidoDto>();
        }

        var query = partidos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(paisFiltro))
        {
            query = query.Where(p =>
                string.Equals(p.Local, paisFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Visitante, paisFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (fechaFiltro.HasValue)
        {
            query = query.Where(p => p.Fecha.Date == fechaFiltro.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(faseFiltro))
        {
            query = query.Where(p =>
                string.Equals(p.Fase, faseFiltro, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private List<string> PaisesDisponibles()
    {
        return partidos?
            .SelectMany(p => new[] { p.Local, p.Visitante })
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(p => p)
            .ToList() ?? new List<string>();
    }

    private List<string> FasesDisponibles()
    {
        return partidos?
            .Select(p => p.Fase)
            .Where(f => !string.IsNullOrWhiteSpace(f))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(OrdenFase)
            .ToList() ?? new List<string>();
    }

    private bool FiltrosActivos()
    {
        return !string.IsNullOrWhiteSpace(paisFiltro) ||
               fechaFiltro.HasValue ||
               !string.IsNullOrWhiteSpace(faseFiltro);
    }

    private void LimpiarFiltros()
    {
        paisFiltro = null;
        fechaFiltro = null;
        faseFiltro = null;
    }

    private IEnumerable<PartidoDto> PartidosPendientesMarcador()
    {
        if (partidos == null)
        {
            return Enumerable.Empty<PartidoDto>();
        }

        return partidos
            .Where(p =>
                !prediccionesGuardadas.Contains(p.Id) ||
                !predicciones.TryGetValue(p.Id, out var prediccion) ||
                !prediccion.GolesLocal.HasValue ||
                !prediccion.GolesVisitante.HasValue)
            .OrderBy(p => OrdenFase(p.Fase))
            .ThenBy(p => p.Fecha)
            .ThenBy(p => p.Id);
    }

    private ClasificacionResumenDto ResumenClasificacionPredicciones()
    {
        var partidosGrupo = PartidosDeGrupos().ToList();
        var faltantes = partidosGrupo.Count(p => !MarcadorCompleto(p));

        return new ClasificacionResumenDto
        {
            Total = partidosGrupo.Count,
            Faltantes = faltantes,
            Completos = partidosGrupo.Count - faltantes
        };
    }

    private void AbrirVistaClasificacion()
    {
        var calculo = CalcularClasificacionDesdePredicciones();

        if (!calculo.EstaCompleta)
        {
            mensajeGuardado = $"Faltan {calculo.Faltantes.Count} marcador(es) de fase de grupos para calcular la clasificacion.";
            guardadoConError = true;
            return;
        }

        vistaClasificacion = calculo;
        mostrarVistaClasificacion = true;
        mensajeGuardado = null;
        guardadoConError = false;
    }

    private void CerrarVistaClasificacion()
    {
        mostrarVistaClasificacion = false;
    }

    private void LlevarClasificacionComoBorrador()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        vistaClasificacion ??= CalcularClasificacionDesdePredicciones();

        if (!vistaClasificacion.EstaCompleta)
        {
            mensajeGuardado = "Todavia faltan marcadores de fase de grupos para llevar la clasificacion.";
            guardadoConError = true;
            mostrarVistaClasificacion = false;
            return;
        }

        ClasificacionDraft.Set(new ClasificacionDraftDto
        {
            PollaId = Sesion.PollaActivaId.Value,
            UsuarioId = Sesion.UsuarioId.Value,
            Grupos = vistaClasificacion.Grupos
                .Select(g => new GrupoClasificacionDraftDto
                {
                    Grupo = g.Grupo,
                    Equipos = g.Equipos
                        .Select(e => new EquipoClasificacionDraftDto
                        {
                            EquipoId = e.EquipoId,
                            Equipo = e.Equipo,
                            Posicion = e.Posicion
                        })
                        .ToList()
                })
                .ToList(),
            MejoresTerceros = vistaClasificacion.MejoresTerceros
                .Select(t => t.Grupo)
                .ToList()
        });

        Navigation.NavigateTo("/clasificacion-grupos");
    }

    private ClasificacionCalculadaDto CalcularClasificacionDesdePredicciones()
    {
        var partidosGrupo = PartidosDeGrupos().ToList();
        var faltantes = partidosGrupo
            .Where(p => !MarcadorCompleto(p))
            .OrderBy(p => p.Fecha)
            .ThenBy(p => p.Id)
            .ToList();

        var resultado = new ClasificacionCalculadaDto
        {
            Faltantes = faltantes
        };

        if (faltantes.Any() || !partidosGrupo.Any())
        {
            return resultado;
        }

        foreach (var grupo in partidosGrupo.GroupBy(p => NormalizarGrupo(p.Grupo ?? "")))
        {
            var equipos = new Dictionary<int, EquipoTablaCalculadaDto>();

            foreach (var partido in grupo)
            {
                AgregarEquipoTabla(equipos, partido.LocalId, partido.Local, grupo.Key);
                AgregarEquipoTabla(equipos, partido.VisitanteId, partido.Visitante, grupo.Key);

                var item = predicciones[partido.Id];
                var golesLocal = item.GolesLocal!.Value;
                var golesVisitante = item.GolesVisitante!.Value;
                var local = equipos[partido.LocalId];
                var visitante = equipos[partido.VisitanteId];

                local.GolesFavor += golesLocal;
                local.GolesContra += golesVisitante;
                visitante.GolesFavor += golesVisitante;
                visitante.GolesContra += golesLocal;

                if (golesLocal > golesVisitante)
                {
                    local.Puntos += 3;
                }
                else if (golesVisitante > golesLocal)
                {
                    visitante.Puntos += 3;
                }
                else
                {
                    local.Puntos += 1;
                    visitante.Puntos += 1;
                }
            }

            var ordenados = equipos.Values
                .OrderByDescending(e => e.Puntos)
                .ThenByDescending(e => e.Diferencia)
                .ThenByDescending(e => e.GolesFavor)
                .ThenBy(e => e.Equipo)
                .ToList();

            for (var i = 0; i < ordenados.Count; i++)
            {
                ordenados[i].Posicion = i + 1;
            }

            resultado.Grupos.Add(new GrupoTablaCalculadaDto
            {
                Grupo = grupo.Key,
                Equipos = ordenados
            });
        }

        resultado.Grupos = resultado.Grupos
            .OrderBy(g => g.Grupo)
            .ToList();

        resultado.MejoresTerceros = resultado.Grupos
            .SelectMany(g => g.Equipos.Where(e => e.Posicion == 3))
            .OrderByDescending(e => e.Puntos)
            .ThenByDescending(e => e.Diferencia)
            .ThenByDescending(e => e.GolesFavor)
            .ThenBy(e => e.Equipo)
            .Take(8)
            .Select((e, index) =>
            {
                e.EsMejorTercero = true;
                e.OrdenMejorTercero = index + 1;
                return e;
            })
            .ToList();

        return resultado;
    }

    private IEnumerable<PartidoDto> PartidosDeGrupos()
    {
        return partidos?
            .Where(p => string.Equals(p.Fase, "Grupos", StringComparison.OrdinalIgnoreCase))
            .Where(p => !string.IsNullOrWhiteSpace(p.Grupo))
            .OrderBy(p => NormalizarGrupo(p.Grupo ?? ""))
            .ThenBy(p => p.Fecha)
            .ThenBy(p => p.Id) ?? Enumerable.Empty<PartidoDto>();
    }

    private bool MarcadorCompleto(PartidoDto partido)
    {
        return predicciones.TryGetValue(partido.Id, out var item) &&
            item.GolesLocal.HasValue &&
            item.GolesVisitante.HasValue;
    }

    private static void AgregarEquipoTabla(
        Dictionary<int, EquipoTablaCalculadaDto> equipos,
        int equipoId,
        string equipo,
        string grupo)
    {
        if (equipos.ContainsKey(equipoId))
        {
            return;
        }

        equipos[equipoId] = new EquipoTablaCalculadaDto
        {
            EquipoId = equipoId,
            Equipo = equipo,
            Grupo = grupo
        };
    }

    private static string NormalizarGrupo(string grupo)
    {
        return grupo.Replace("Grupo", "", StringComparison.OrdinalIgnoreCase)
            .Trim()
            .ToUpperInvariant();
    }

    private static string PosicionCss(int posicion)
    {
        return posicion switch
        {
            1 => "pos-1",
            2 => "pos-2",
            3 => "pos-3",
            _ => ""
        };
    }

    private bool EstaGuardada(PartidoDto partido)
    {
        return prediccionesGuardadas.Contains(partido.Id);
    }

    private bool EstaEditable(PartidoDto partido)
    {
        return !EstaBloqueado(partido) &&
               (!EstaGuardada(partido) || prediccionesEnEdicion.Contains(partido.Id));
    }

    private string NombrePartido(PartidoDto partido)
    {
        return $"{partido.Local} vs {partido.Visitante}";
    }

    private bool FaseFinalizada(string fase)
    {
        return partidos?.Any(p => p.Fase == fase) == true &&
               partidos.Where(p => p.Fase == fase).All(p => p.Finalizado);
    }

    private bool FaseMinimizada(string fase)
    {
        return FaseFinalizada(fase) && fasesMinimizadas.Contains(fase);
    }

    private void ToggleFaseMinimizada(string fase)
    {
        if (!FaseFinalizada(fase))
        {
            fasesMinimizadas.Remove(fase);
            return;
        }

        if (!fasesMinimizadas.Add(fase))
        {
            fasesMinimizadas.Remove(fase);
        }
    }

    private bool EquipoPodioOcupado(int equipoId, int campo)
    {
        return campo switch
        {
            1 => equipoId == podio.SubcampeonId || equipoId == podio.TerceroId,
            2 => equipoId == podio.CampeonId || equipoId == podio.TerceroId,
            3 => equipoId == podio.CampeonId || equipoId == podio.SubcampeonId,
            _ => false
        };
    }

    private string AlertaEmpateEliminatoria(PartidoDto partido)
    {
        if (partido.Fase == "Grupos" ||
            !predicciones.TryGetValue(partido.Id, out var item) ||
            !item.GolesLocal.HasValue ||
            !item.GolesVisitante.HasValue ||
            item.GolesLocal != item.GolesVisitante)
        {
            return "";
        }

        var faltaClasificado = !item.PrediceClasificadoId.HasValue;
        var faltaDefinicion = !item.PrediceTiempoExtra && !item.PredicePenales;

        if (!faltaClasificado && !faltaDefinicion)
        {
            return "";
        }

        return "Empate en eliminatoria: debes definir qué equipo pasa y si pasa por tiempo extra o por tiempo extra y penales.";
    }

    private void EditarPartido(PartidoDto partido)
    {
        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        if (!EstaGuardada(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} todavía no está guardada.";
            guardadoConError = true;
            return;
        }

        prediccionesEnEdicion.Add(partido.Id);
        mensajeGuardado = $"Puedes editar la predicción {NombrePartido(partido)}.";
        guardadoConError = false;
    }

    private async Task GuardarPartido(PartidoDto partido)
    {
        if (!predicciones.ContainsKey(partido.Id) ||
            !Sesion.PollaActivaId.HasValue ||
            !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        var item = predicciones[partido.Id];

        if (partido.Fase != "Grupos")
        {
            if (item.PredicePenales)
            {
                item.PrediceTiempoExtra = true;
            }

            var esEmpate = item.GolesLocal.HasValue &&
                item.GolesVisitante.HasValue &&
                item.GolesLocal == item.GolesVisitante;

            if (esEmpate)
            {
                if (!item.PrediceClasificadoId.HasValue ||
                    (!item.PrediceTiempoExtra && !item.PredicePenales))
                {
                    mensajeGuardado = $"La predicción {NombrePartido(partido)} está empatada: debes indicar qué equipo clasifica y si pasa por tiempo extra o por penales.";
                    guardadoConError = true;
                    return;
                }
            }
            else if (!item.PrediceClasificadoId.HasValue &&
                item.GolesLocal.HasValue &&
                item.GolesVisitante.HasValue)
            {
                item.PrediceClasificadoId = item.GolesLocal > item.GolesVisitante
                    ? partido.LocalId
                    : partido.VisitanteId;
            }

            if (!item.PrediceClasificadoId.HasValue)
            {
                mensajeGuardado = "En eliminatorias debes indicar qué equipo clasifica.";
                guardadoConError = true;
                return;
            }
        }

        var dto = new GuardarPrediccionGrupoDto
            {
                PollaId = Sesion.PollaActivaId.Value,
                UsuarioId = Sesion.UsuarioId.Value,

                // Backend exige Grupo siempre
                Grupo = partido.Fase == "Grupos"
                    ? partido.Grupo ?? "A"
                    : "ELIMINATORIA",

                Predicciones = new List<GuardarPrediccionItemDto>
            {
                item
            }
            };

        try
        {
            await PrediccionesService.GuardarMultiplesAsync(dto);
            prediccionesGuardadas.Add(partido.Id);
            prediccionesEnEdicion.Remove(partido.Id);
            mensajeGuardado = $"Predicción {NombrePartido(partido)} guardada correctamente.";
            guardadoConError = false;
        }
        catch (Exception ex)
        {
            mensajeGuardado = $"No se pudo guardar la predicción: {ex.Message}";
            guardadoConError = true;
        }
    }

    private async Task EliminarPartido(PartidoDto partido)
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (EstaBloqueado(partido))
        {
            mensajeGuardado = $"La predicción {NombrePartido(partido)} ya está bloqueada.";
            guardadoConError = true;
            return;
        }

        try
        {
            await PrediccionesService.EliminarPrediccionAsync(
                Sesion.PollaActivaId.Value,
                Sesion.UsuarioId.Value,
                partido.Id);

            predicciones[partido.Id] = new GuardarPrediccionItemDto
                {
                    PartidoId = partido.Id
                };
            prediccionesGuardadas.Remove(partido.Id);
            prediccionesEnEdicion.Remove(partido.Id);
            mensajeGuardado = $"Predicción {NombrePartido(partido)} eliminada correctamente.";
            guardadoConError = false;
        }
        catch (Exception ex)
        {
            mensajeGuardado = $"No se pudo eliminar la predicción {NombrePartido(partido)}: {ex.Message}";
            guardadoConError = true;
        }
    }

    private async Task CargarPodioAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        try
        {
            podioEstado = await Http.GetFromJsonAsync<PodioEstadoDto>(
                $"api/Podio/estado?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}");

            if (podioEstado?.prediccion != null)
            {
                podio = new GuardarPodioDto
                {
                    CampeonId = podioEstado.prediccion.campeonId,
                    SubcampeonId = podioEstado.prediccion.subcampeonId,
                    TerceroId = podioEstado.prediccion.terceroId
                };
            }
        }
        catch
        {
            podioEstado = null;
        }
    }

    private async Task GuardarPodio()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        if (podio.CampeonId == 0 ||
            podio.SubcampeonId == 0 ||
            podio.TerceroId == 0 ||
            podio.CampeonId == podio.SubcampeonId ||
            podio.CampeonId == podio.TerceroId ||
            podio.SubcampeonId == podio.TerceroId)
        {
            mensajeGuardado = "Debes elegir tres equipos distintos para el podio.";
            guardadoConError = true;
            return;
        }

        podio.PollaId = Sesion.PollaActivaId.Value;
        podio.UsuarioId = Sesion.UsuarioId.Value;

        var response = await Http.PostAsJsonAsync("api/Podio/guardar", podio);
        if (!response.IsSuccessStatusCode)
        {
            mensajeGuardado = await response.Content.ReadAsStringAsync();
            guardadoConError = true;
            return;
        }

        mensajeGuardado = "Podio guardado correctamente.";
        guardadoConError = false;
        await CargarPodioAsync();
    }

