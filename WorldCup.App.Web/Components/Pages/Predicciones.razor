    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Sesion.RestaurarSesionAsync();

        if (!Sesion.EstaLogueado)
        {
            Navigation.NavigateTo("/login?returnUrl=/predicciones", true);
            return;
        }

        pollas = await PollasService.GetPollasPorUsuarioAsync(Sesion.UsuarioId!.Value);

        if (Sesion.PollaActivaId.HasValue &&
            !pollas.Any(p => p.Id == Sesion.PollaActivaId.Value))
        {
            await Sesion.LimpiarPollaActivaAsync();
        }

        if (Sesion.PollaActivaId.HasValue)
        {
            await CargarPrediccionesAsync();
            await CargarPodioAsync();
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task SeleccionarPolla(PollaDto polla)
    {
        cargando = true;
        StateHasChanged();

        await Sesion.SeleccionarPollaAsync(polla.Id, polla.Nombre);
        await CargarPrediccionesAsync();
        await CargarPodioAsync();

        cargando = false;
        StateHasChanged();
    }

    private async Task CambiarPolla()
    {
        await Sesion.LimpiarPollaActivaAsync();
        partidos = null;
        predicciones.Clear();
        prediccionesGuardadas.Clear();
        prediccionesEnEdicion.Clear();
        partidoMovilAbiertoId = null;
        reaperturasActivas.Clear();
        fasesMinimizadas.Clear();
        paisFiltro = null;
        fechaFiltro = null;
        faseFiltro = null;
        faseInicialAplicada = false;
        podioEstado = null;
        podio = new();
        vistaClasificacion = null;
        mostrarVistaClasificacion = false;
    }

    private async Task CargarPrediccionesAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            return;
        }

        partidos = (await PartidosService.GetPartidosAsync())
            .OrderBy(p => OrdenFase(p.Fase))
            .ThenBy(p => p.Fecha)
            .ThenBy(p => p.Id)
            .ToList();

        var existentes = await PrediccionesService.GetPrediccionesAsync(
            Sesion.PollaActivaId.Value,
            Sesion.UsuarioId.Value);

        await CargarReaperturasAsync();

        var existentesDict = existentes
            .GroupBy(x => x.PartidoId)
            .ToDictionary(x => x.Key, x => x.First());

        predicciones.Clear();
        prediccionesGuardadas.Clear();
        prediccionesEnEdicion.Clear();

        foreach (var p in partidos)
        {
            if (existentesDict.TryGetValue(p.Id, out var e))
            {
                prediccionesGuardadas.Add(p.Id);
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id,
                        GolesLocal = e.GolesLocal,
                        GolesVisitante = e.GolesVisitante,
                        PrediceTiempoExtra = e.PrediceTiempoExtra,
                        PredicePenales = e.PredicePenales,
                        PrediceClasificadoId = e.PrediceClasificadoId
                    };
            }
            else
            {
                predicciones[p.Id] = new GuardarPrediccionItemDto
                    {
                        PartidoId = p.Id
                };
            }
        }

        MinimizarFasesFinalizadasAlCargar();
        AplicarFaseInicialPredicciones();
        partidoMovilAbiertoId = null;
    }

    private void AplicarFaseInicialPredicciones()
    {
        if (faseInicialAplicada ||
            partidos == null ||
            !partidos.Any() ||
            !string.IsNullOrWhiteSpace(faseFiltro))
        {
            faseInicialAplicada = true;
            return;
        }

        faseFiltro = partidos
            .GroupBy(p => p.Fase)
            .OrderBy(g => OrdenFase(g.Key))
            .FirstOrDefault(g => g.Any(p => !p.Finalizado))
            ?.Key;

        if (string.IsNullOrWhiteSpace(faseFiltro))
        {
            faseFiltro = partidos
                .GroupBy(p => p.Fase)
                .OrderByDescending(g => OrdenFase(g.Key))
                .FirstOrDefault()
                ?.Key;
        }

        faseInicialAplicada = true;
    }

    private void MinimizarFasesFinalizadasAlCargar()
    {
        fasesMinimizadas = partidos?
            .GroupBy(p => p.Fase)
            .Where(g => g.Any() && g.All(p => p.Finalizado))
            .Select(g => g.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase)
            ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private bool EstaBloqueado(PartidoDto partido)
    {
        if (ReaperturaActiva(partido.Fase, "Marcadores", partido.Id))
        {
            return false;
        }

        if (partido.Fecha <= DateTime.MinValue)
            return false;

        return HoraColombiaActual() >= partido.Fecha.AddHours(-1)
               || partido.Finalizado;
    }

    private async Task CargarReaperturasAsync()
    {
        if (!Sesion.PollaActivaId.HasValue || !Sesion.UsuarioId.HasValue)
        {
            reaperturasActivas.Clear();
            return;
        }

        reaperturasActivas = await Http.GetFromJsonAsync<List<ReaperturaUsuarioDto>>(
            $"api/Predicciones/reaperturas?pollaId={Sesion.PollaActivaId.Value}&usuarioId={Sesion.UsuarioId.Value}") ?? new();
    }

    private bool ReaperturaActiva(string fase, string tipo, int? partidoId = null)
    {
        return reaperturasActivas.Any(r =>
            r.Activa &&
            string.Equals(r.Tipo, tipo, StringComparison.OrdinalIgnoreCase) &&
            (
                (!r.PartidoId.HasValue && string.Equals(r.Fase, fase, StringComparison.OrdinalIgnoreCase)) ||
                (partidoId.HasValue && r.PartidoId == partidoId.Value)
            ));
    }

    private string EtiquetaReapertura(ReaperturaUsuarioDto reapertura)
    {
        if (reapertura.Tipo == "Marcadores" && reapertura.PartidoId.HasValue)
        {
            return string.IsNullOrWhiteSpace(reapertura.Partido)
                ? $"partido {reapertura.PartidoId.Value}"
                : reapertura.Partido;
        }

        return reapertura.Tipo == "Podio"
            ? "podio final"
            : $"{reapertura.Fase} ({reapertura.Tipo.ToLowerInvariant()})";
    }

    private static DateTime HoraColombiaActual()
    {
        try
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time"));
        }
        catch
        {
            return TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("America/Bogota"));
        }
    }

    private IEnumerable<PartidoDto> PartidosFiltrados()
    {
        if (partidos == null)
        {
            return Enumerable.Empty<PartidoDto>();
        }

        var query = partidos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(paisFiltro))
        {
            query = query.Where(p =>
                string.Equals(p.Local, paisFiltro, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(p.Visitante, paisFiltro, StringComparison.OrdinalIgnoreCase));
        }

        if (fechaFiltro.HasValue)
        {
            query = query.Where(p => p.Fecha.Date == fechaFiltro.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(faseFiltro))
        {
            query = query.Where(p =>
                string.Equals(p.Fase, faseFiltro, StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }

    private List<string> PaisesDisponibles()
    {
        return partidos?
            .SelectMany(p => new[] { p.Local, p.Visitante })
