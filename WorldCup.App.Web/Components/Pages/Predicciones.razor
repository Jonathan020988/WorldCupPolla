@page "/predicciones"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Models
@using WorldCup.App.Web.Services
@inject WorldCup.App.Shared.Services.PartidosService PartidosService
@inject WorldCup.App.Shared.Services.PrediccionesService PrediccionesService
@inject PollasService PollasService
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject HttpClient Http
@inject ClasificacionDraftService ClasificacionDraft

<section class="predictions-header">
    <div>
        <span class="predictions-kicker">Mundial 2026</span>
        <h1>Mis Predicciones</h1>
        <p>
            Puedes modificar tus marcadores hasta <b>1 hora</b> antes de cada partido.
        </p>
    </div>
</section>

@if (cargando)
{
    <p>Cargando predicciones...</p>
}
else if (!Sesion.PollaActivaId.HasValue)
{
    <div class="card shadow-sm mb-4" style="max-width:520px">
        <div class="card-body">
            <h5 class="mb-3">Selecciona la polla</h5>
            <p class="text-muted">
                Tus predicciones se guardarán en la polla que elijas.
            </p>

            @if (!pollas.Any())
            {
                <div class="alert alert-info">
                    No tienes pollas disponibles todavía.
                </div>

                <a class="btn btn-success" href="/dashboard">
                    Ir a mis pollas
                </a>
            }
            else
            {
                <div class="d-grid gap-2">
                    @foreach (var polla in pollas)
                    {
                        <button class="btn btn-outline-primary text-start"
                                @onclick="() => SeleccionarPolla(polla)">
                            🏆 @polla.Nombre
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="polla-banner">
        <span>
            Trabajando en la polla:
            <strong>@Sesion.PollaActivaNombre</strong>
        </span>

        <button class="btn btn-sm btn-outline-success"
                @onclick="CambiarPolla">
            Cambiar polla
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeGuardado))
    {
        <div class="alert @(guardadoConError ? "alert-danger" : "alert-success")">
            @mensajeGuardado
        </div>
    }

    @if (reaperturasActivas.Any())
    {
        <div class="alert alert-warning reopen-user-alert">
            El administrador habilitó edición temporal para:
            <strong>@string.Join(", ", reaperturasActivas.Select(EtiquetaReapertura))</strong>.
        </div>
    }

    @if (partidos?.Any() == true)
    {
        <div class="prediction-filter">
            <div>
                <label class="form-label fw-bold mb-1">Filtrar por país</label>
                <select class="form-select"
                        @bind="paisFiltro">
                    <option value="">Todos los países</option>
                    @foreach (var pais in PaisesDisponibles())
                    {
                        <option value="@pais">@pais</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fecha</label>
                <input class="form-control"
                       type="date"
                       @bind="fechaFiltro" />
            </div>

            <div>
                <label class="form-label fw-bold mb-1">Filtrar por fase</label>
                <select class="form-select"
                        @bind="faseFiltro">
                    <option value="">Todas las fases</option>
                    @foreach (var fase in FasesDisponibles())
                    {
                        <option value="@fase">@NombreFase(fase)</option>
                    }
                </select>
            </div>

            @if (FiltrosActivos())
            {
                <button class="btn btn-outline-secondary"
                        @onclick="LimpiarFiltros">
                    Ver todos
                </button>
            }
        </div>

        var pendientesMarcador = PartidosPendientesMarcador().ToList();

        <div class="pending-predictions-panel @(pendientesMarcador.Any() ? "" : "is-complete")">
            <div class="pending-summary">
                <strong>Marcadores pendientes</strong>
                <span>
                    @(pendientesMarcador.Any()
                        ? $"{pendientesMarcador.Count} por completar"
                        : "Todos completos")
                </span>
            </div>

            @if (pendientesMarcador.Any())
            {
                <div class="pending-list">
                    @foreach (var partido in pendientesMarcador.Take(10))
                    {
                        <span class="pending-chip">
                            @partido.Local vs @partido.Visitante
                            <small>@partido.Fecha.ToString("dd/MM HH:mm")</small>
                        </span>
                    }

                    @if (pendientesMarcador.Count > 10)
                    {
                        <span class="pending-chip more">
                            +@(pendientesMarcador.Count - 10) más
                        </span>
                    }
                </div>
            }
        </div>

        @if (MostrarClasificacionCalculada())
        {
            var resumenClasificacion = ResumenClasificacionPredicciones();

            <div class="classification-projection-panel @(resumenClasificacion.EstaCompleto ? "ready" : "waiting")">
                <div class="projection-copy">
                    <span class="projection-kicker">Clasificacion calculada</span>
                    <strong>Tabla de grupos segun tus marcadores</strong>
                    <p>
                        @(resumenClasificacion.EstaCompleto
                            ? "Ya puedes revisar primeros, segundos y mejores terceros antes de llevarlos como borrador."
                            : $"Completa {resumenClasificacion.Faltantes} marcador(es) de fase de grupos para calcular la tabla.")
                    </p>
                </div>

                <div class="projection-actions">
                    <span class="projection-count">
                        @resumenClasificacion.Completos / @resumenClasificacion.Total marcadores
                    </span>
                    <button class="btn btn-sm btn-primary"
                            disabled="@(!resumenClasificacion.EstaCompleto)"
                            @onclick="AbrirVistaClasificacion">
                        Ver tabla calculada
                    </button>
                </div>
            </div>
        }
    }

    @if (mostrarVistaClasificacion && vistaClasificacion != null)
    {
        <div class="projection-backdrop">
            <div class="projection-modal">
                <div class="projection-modal-header">
                    <div>
                        <span class="projection-kicker">Borrador opcional</span>
                        <h2>Clasificacion sugerida por tus marcadores</h2>
                        <p>
                            Esto no guarda nada todavia. Puedes llevarlo a Clasificacion Grupos,
                            ajustar posiciones y guardar alla grupo por grupo.
                        </p>
                    </div>
                    <button type="button"
                            class="projection-close"
                            title="Cerrar"
                            @onclick="CerrarVistaClasificacion">
                        x
                    </button>
                </div>

                <div class="projection-modal-body">
                    <div class="projection-groups">
                        @foreach (var grupo in vistaClasificacion.Grupos)
                        {
                            <div class="projection-group-card">
                                <div class="projection-group-title">
                                    <strong>Grupo @grupo.Grupo</strong>
                                    <span>@grupo.Equipos.Count equipos</span>
                                </div>

                                <table class="projection-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Equipo</th>
                                            <th>Pts</th>
                                            <th>DG</th>
                                            <th>GF</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var equipo in grupo.Equipos)
                                        {
                                            <tr class="@(equipo.EsMejorTercero ? "best-third" : "")">
                                                <td>
                                                    <span class="position-badge @PosicionCss(equipo.Posicion)">
                                                        @equipo.Posicion
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="team-inline">
                                                        <img class="team-flag small"
                                                             src="@GetBandera(equipo.Equipo)"
                                                             alt="@equipo.Equipo" />
                                                        @equipo.Equipo
                                                    </span>
                                                </td>
                                                <td>@equipo.Puntos</td>
                                                <td>@equipo.Diferencia</td>
                                                <td>@equipo.GolesFavor</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="best-thirds-panel">
                        <div class="projection-group-title">
                            <strong>8 mejores terceros</strong>
                            <span>Segun puntos, diferencia y goles a favor</span>
                        </div>

                        <div class="best-thirds-list">
                            @foreach (var tercero in vistaClasificacion.MejoresTerceros)
                            {
                                <div class="best-third-chip">
                                    <span>@tercero.OrdenMejorTercero</span>
                                    <img class="team-flag small"
                                         src="@GetBandera(tercero.Equipo)"
                                         alt="@tercero.Equipo" />
                                    <strong>@tercero.Equipo</strong>
                                    <small>Grupo @tercero.Grupo · @tercero.Puntos pts</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="projection-modal-footer">
                    <button class="btn btn-outline-secondary"
                            @onclick="CerrarVistaClasificacion">
                        Seguir manual
                    </button>
                    <button class="btn btn-success"
                            @onclick="LlevarClasificacionComoBorrador">
                        Llevar a Clasificacion Grupos
                    </button>
                </div>
            </div>
        </div>
    }

    @if (mostrarMapaDuelos)
    {
        <div class="duel-map-backdrop" @onclick="CerrarMapaDuelos">
            <div class="duel-map-modal" @onclick:stopPropagation="true">
                <div class="duel-map-head">
                    <div>
                        <span>Mapa de duelos</span>
                        <h2>Camino hacia la final</h2>
                        <p>@ResumenMapaDuelos()</p>
                    </div>

                    <button type="button"
                            class="duel-map-close"
                            aria-label="Cerrar mapa de duelos"
                            @onclick="CerrarMapaDuelos">
                        x
                    </button>
                </div>

                <div class="duel-map-scroll">
                    <div class="duel-bracket-board">
                        <div class="duel-bracket-title">
                            <strong>@NombreFase(faseMapaDuelos).ToUpperInvariant()</strong>
                            <span>AL MOMENTO</span>
                        </div>

                        @foreach (var columna in ColumnasMapaDuelos(true))
                        {
                            <section class="duel-bracket-column @columna.CssClass">
                                <h3>@columna.Titulo</h3>
                                @{
                                    var slotMapa = 0;
                                }
                                @foreach (var slotDuelosMapa in columna.Slots)
                                {
                                    slotMapa++;
                                    var partidoMapa = slotDuelosMapa.Partido;
                                    <article class="@($"{ClaseTarjetaMapa(partidoMapa)} {ClaseSlotMapa(columna.CssClass, slotMapa)}")">
                                        @if (partidoMapa == null)
                                        {
                                            <div class="duel-bracket-card-top">
                                                <span>P@slotDuelosMapa.NumeroPartido</span>
                                                <small>Por definir</small>
                                            </div>
                                            @EquipoSlotMapa(slotDuelosMapa.NumeroPartido, true)
                                            @EquipoSlotMapa(slotDuelosMapa.NumeroPartido, false)
                                        }
                                        else
                                        {
                                            <div class="duel-bracket-card-top">
                                                <span>@EtiquetaPartidoMapa(partidoMapa)</span>
                                                <small>@EstadoPartidoMapa(partidoMapa)</small>
                                            </div>
                                            @EquipoMapa(partidoMapa, true)
                                            @EquipoMapa(partidoMapa, false)
                                            @if (!string.IsNullOrWhiteSpace(DetalleClasificacionMapa(partidoMapa)))
                                            {
                                                <div class="duel-map-advance">@DetalleClasificacionMapa(partidoMapa)</div>
                                            }
                                        }
                                    </article>
                                }
                            </section>
                        }

                        <section class="duel-bracket-final">
                            <span>FINAL</span>
                            @{
                                var partidoFinalMapa = PartidoFinalMapa();
                                var partidoTercerPuestoMapa = PartidoTercerPuestoMapa();
                            }
                            <article class="@ClaseTarjetaMapa(partidoFinalMapa)">
                                @if (partidoFinalMapa == null)
                                {
                                    <div class="duel-bracket-card-top">
                                        <span>P104</span>
                                        <small>Por definir</small>
                                    </div>
                                    @EquipoSlotMapa(104, true)
                                    @EquipoSlotMapa(104, false)
                                }
                                else
                                {
                                    <div class="duel-bracket-card-top">
                                        <span>@EtiquetaPartidoMapa(partidoFinalMapa)</span>
                                        <small>@EstadoPartidoMapa(partidoFinalMapa)</small>
                                    </div>
                                    @EquipoMapa(partidoFinalMapa, true)
                                    @EquipoMapa(partidoFinalMapa, false)
                                    @if (!string.IsNullOrWhiteSpace(DetalleClasificacionMapa(partidoFinalMapa)))
                                    {
                                        <div class="duel-map-advance">@DetalleClasificacionMapa(partidoFinalMapa)</div>
                                    }
                                }
                            </article>

                            <span class="duel-bracket-third-title">TERCER PUESTO</span>
                            <article class="@ClaseTarjetaMapa(partidoTercerPuestoMapa)">
                                @if (partidoTercerPuestoMapa == null)
                                {
                                    <div class="duel-bracket-card-top">
                                        <span>P103</span>
                                        <small>Por definir</small>
                                    </div>
                                    @EquipoSlotMapa(103, true)
                                    @EquipoSlotMapa(103, false)
                                }
                                else
                                {
                                    <div class="duel-bracket-card-top">
                                        <span>@EtiquetaPartidoMapa(partidoTercerPuestoMapa)</span>
                                        <small>@EstadoPartidoMapa(partidoTercerPuestoMapa)</small>
                                    </div>
                                    @EquipoMapa(partidoTercerPuestoMapa, true)
                                    @EquipoMapa(partidoTercerPuestoMapa, false)
                                    @if (!string.IsNullOrWhiteSpace(DetalleClasificacionMapa(partidoTercerPuestoMapa)))
                                    {
                                        <div class="duel-map-advance">@DetalleClasificacionMapa(partidoTercerPuestoMapa)</div>
                                    }
                                }
                            </article>
                        </section>

                        @foreach (var columna in ColumnasMapaDuelos(false))
                        {
                            <section class="duel-bracket-column @columna.CssClass">
                                <h3>@columna.Titulo</h3>
                                @{
                                    var slotMapa = 0;
                                }
                                @foreach (var slotDuelosMapa in columna.Slots)
                                {
                                    slotMapa++;
                                    var partidoMapa = slotDuelosMapa.Partido;
                                    <article class="@($"{ClaseTarjetaMapa(partidoMapa)} {ClaseSlotMapa(columna.CssClass, slotMapa)}")">
                                        @if (partidoMapa == null)
                                        {
                                            <div class="duel-bracket-card-top">
                                                <span>P@slotDuelosMapa.NumeroPartido</span>
                                                <small>Por definir</small>
                                            </div>
                                            @EquipoSlotMapa(slotDuelosMapa.NumeroPartido, true)
                                            @EquipoSlotMapa(slotDuelosMapa.NumeroPartido, false)
                                        }
                                        else
                                        {
                                            <div class="duel-bracket-card-top">
                                                <span>@EtiquetaPartidoMapa(partidoMapa)</span>
                                                <small>@EstadoPartidoMapa(partidoMapa)</small>
                                            </div>
                                            @EquipoMapa(partidoMapa, true)
                                            @EquipoMapa(partidoMapa, false)
                                            @if (!string.IsNullOrWhiteSpace(DetalleClasificacionMapa(partidoMapa)))
                                            {
                                                <div class="duel-map-advance">@DetalleClasificacionMapa(partidoMapa)</div>
                                            }
                                        }
                                    </article>
                                }
                            </section>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (podioEstado?.disponible == true)
    {
        <div class="card shadow-sm mb-3 border-warning">
            <div class="card-header bg-warning fw-bold">
                Podio del Mundial
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    El podio se habilita al terminar la fase de grupos y se cierra
                    @CierrePodioTexto().
                </p>

                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Campeón</label>
                        <select class="form-select" @bind="podio.CampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 1)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Subcampeón</label>
                        <select class="form-select" @bind="podio.SubcampeonId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 2)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tercer puesto</label>
                        <select class="form-select" @bind="podio.TerceroId">
                            <option value="0">Selecciona equipo</option>
                            @foreach (var equipo in podioEstado.equipos)
                            {
                                <option value="@equipo.id"
                                        disabled="@EquipoPodioOcupado(equipo.id, 3)">
                                    @equipo.nombre
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <button class="btn btn-warning mt-3"
                        disabled="@guardandoPodio"
                        @onclick="GuardarPodio">
                    @(guardandoPodio ? "Guardando podio..." : "Guardar podio")
                </button>

                @if (!string.IsNullOrWhiteSpace(mensajePodioGuardado))
                {
                    <div class="alert @(podioGuardadoConError ? "alert-danger" : "alert-success") podio-save-message mt-3 mb-0">
                        <strong>
                            @(podioGuardadoConError
                                ? "No se pudo guardar el podio"
                                : "Podio guardado con éxito")
                        </strong>
                        <span>@mensajePodioGuardado</span>
                    </div>
                }
            </div>
        </div>
    }
    @if (partidos == null)
    {
        <p>Cargando partidos...</p>
    }
    else
    {
        var partidosVista = PartidosFiltrados().ToList();

        @if (!partidosVista.Any())
        {
            <div class="alert alert-info">
                No hay partidos para el país seleccionado.
            </div>
        }
        else
        {
            @foreach (var fase in partidosVista.GroupBy(p => p.Fase).OrderBy(g => OrdenFase(g.Key)))
            {
                var faseNombre = fase.Key;
                var faseFinalizada = FaseFinalizada(faseNombre);
                var faseMinimizada = FaseMinimizada(faseNombre);

                <div class="phase-title">
                    <div class="phase-title-main">
                        <span>@faseNombre</span>
                        <small>@fase.Count() partidos</small>
                    </div>

                    @if (faseFinalizada)
                    {
                        <button type="button"
                                class="phase-collapse-btn"
                                @onclick="() => ToggleFaseMinimizada(faseNombre)">
                            @(faseMinimizada ? "Mostrar fase" : "Minimizar fase")
                        </button>
                    }
                </div>

                @if (EsFaseEliminatoria(faseNombre))
                {
                    <button type="button"
                            class="duel-map-launch"
                            @onclick="() => AbrirMapaDuelos(faseNombre)">
                        <span class="duel-map-launch-kicker">Camino a la final</span>
                        <strong>Mapa de duelos</strong>
                        <small>Ver cruces publicados y equipos que van avanzando</small>
                    </button>
                }

                @if (faseMinimizada)
                {
                    <div class="phase-collapsed-summary">
                        @faseNombre finalizada. @fase.Count() partidos ocultos para navegar más rápido.
                    </div>
                }
                else
                {
                    <div class="mobile-prediction-list">
                        @foreach (var p in fase.OrderBy(p => p.Fecha).ThenBy(p => p.Id))
                        {
                            var bloqueado = EstaBloqueado(p);
                            var guardada = EstaGuardada(p);
                            var editable = EstaEditable(p);
                            var abiertoMovil = PartidoMovilAbierto(p.Id);

                            <article class="mobile-prediction-item @(guardada ? "is-saved" : "") @(editable ? "is-editing" : "")">
                                <button type="button"
                                        class="mobile-prediction-row"
                                        @onclick="() => TogglePartidoMovil(p)">
                                    <span class="mobile-prediction-time">@p.Fecha.ToString("dd/MM HH:mm")</span>
                                    <span class="mobile-prediction-match">
                                        <img class="team-flag"
                                             src="@GetBandera(p.Local)"
                                             alt="@p.Local" />
                                        <strong>@p.Local</strong>
                                        <small>vs</small>
                                        <strong>@p.Visitante</strong>
                                        <img class="team-flag"
                                             src="@GetBandera(p.Visitante)"
                                             alt="@p.Visitante" />
                                    </span>
                                    <span class="mobile-prediction-summary">
                                        <span class="mobile-prediction-score">@MarcadorMovilTexto(p)</span>
                                        @if (bloqueado)
                                        {
                                            <span class="mobile-prediction-state locked">Bloqueado</span>
                                        }
                                        else
                                        {
                                            <span class="mobile-prediction-state editable">Editar</span>
                                        }
                                    </span>
                                </button>

                                @if (abiertoMovil)
                                {
                                    <div class="mobile-prediction-editor">
                                        <div class="mobile-score-editor">
                                            <label>
                                                <span>@p.Local</span>
                                                <input type="number"
                                                       class="form-control form-control-sm score-input"
                                                       min="0"
                                                       disabled="@(!editable)"
                                                       @bind="predicciones[p.Id].GolesLocal"
                                                       @bind:event="oninput" />
                                            </label>

                                            <span class="score-separator">-</span>

                                            <label>
                                                <span>@p.Visitante</span>
                                                <input type="number"
                                                       class="form-control form-control-sm score-input"
                                                       min="0"
                                                       disabled="@(!editable)"
                                                       @bind="predicciones[p.Id].GolesVisitante"
                                                       @bind:event="oninput" />
                                            </label>
                                        </div>

                                        @if (p.Fase != "Grupos")
                                        {
                                            var alertaEmpateMovil = AlertaEmpateEliminatoria(p);

                                            <div class="prediction-extra mobile-prediction-extra">
                                                <select class="form-select form-select-sm"
                                                        disabled="@(!editable)"
                                                        @bind="predicciones[p.Id].PrediceClasificadoId">
                                                    <option value="">Equipo que clasifica</option>
                                                    <option value="@p.LocalId">@p.Local</option>
                                                    <option value="@p.VisitanteId">@p.Visitante</option>
                                                </select>

                                                <label class="form-check compact-check">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="@($"definicion-mobile-{p.Id}")"
                                                           checked="@(predicciones[p.Id].PrediceTiempoExtra && !predicciones[p.Id].PredicePenales)"
                                                           disabled="@(!editable)"
                                                           @onchange="() => SeleccionarDefinicionEliminatoria(p.Id, false)" />
                                                    <span class="form-check-label">T. extra</span>
                                                </label>

                                                <label class="form-check compact-check">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="@($"definicion-mobile-{p.Id}")"
                                                           checked="@predicciones[p.Id].PredicePenales"
                                                           disabled="@(!editable)"
                                                           @onchange="() => SeleccionarDefinicionEliminatoria(p.Id, true)" />
                                                    <span class="form-check-label">Penales</span>
                                                </label>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(alertaEmpateMovil))
                                            {
                                                <div class="knockout-alert">
                                                    @alertaEmpateMovil
                                                </div>
                                            }
                                        }

                                        <div class="mobile-prediction-actions">
                                            <button class="btn btn-sm btn-success"
                                                    disabled="@(!editable)"
                                                    title="Guardar predicción"
                                                    @onclick="() => GuardarPartidoMovil(p)">
                                                Guardar
                                            </button>

                                            <button class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(bloqueado || !guardada || editable)"
                                                    title="Editar predicción"
                                                    @onclick="() => EditarPartidoMovil(p)">
                                                Editar
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(bloqueado || !guardada)"
                                                    title="Eliminar predicción"
                                                    @onclick="() => EliminarPartidoMovil(p)">
                                                Eliminar
                                            </button>
                                        </div>

                                        <div class="mobile-prediction-meta">
                                            <span>
                                                @(DateTime.SpecifyKind(p.Fecha, DateTimeKind.Unspecified)
                                                    .ToString("dddd dd 'de' MMMM yyyy HH:mm"))
                                            </span>
                                            @EstadoPrediccionPill(p)
                                        </div>
                                    </div>
                                }
                            </article>
                        }
                    </div>

                    <div class="desktop-prediction-cards">
                    @foreach (var p in fase.OrderBy(p => p.Fecha).ThenBy(p => p.Id))
                    {
                        var bloqueado = EstaBloqueado(p);
                        var guardada = EstaGuardada(p);
                        var editable = EstaEditable(p);

                        <div class="prediction-card @(guardada ? "is-saved" : "") @(editable ? "is-editing" : "")">
                            <div class="prediction-card-main">
                                <div class="prediction-team prediction-team-local">
                                    <span>@p.Local</span>
                                    <img class="team-flag"
                                         src="@GetBandera(p.Local)"
                                         alt="@p.Local" />
                                </div>

                                <div class="score-panel">
                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesLocal"
                                           @bind:event="oninput" />

                                    <span class="score-separator">-</span>

                                    <input type="number"
                                           class="form-control form-control-sm score-input"
                                           min="0"
                                           disabled="@(!editable)"
                                           @bind="predicciones[p.Id].GolesVisitante"
                                           @bind:event="oninput" />
                                </div>

                                <div class="prediction-team prediction-team-visitor">
                                    <img class="team-flag"
                                         src="@GetBandera(p.Visitante)"
                                         alt="@p.Visitante" />
                                    <span>@p.Visitante</span>
                                </div>

                                <div class="prediction-actions">
                                    <button class="btn btn-sm btn-success"
                                            disabled="@(!editable)"
                                            title="Guardar predicción"
                                            @onclick="() => GuardarPartido(p)">
                                        Guardar
                                    </button>

                                    <button class="btn btn-sm btn-outline-secondary"
                                            disabled="@(bloqueado || !guardada || editable)"
                                            title="Editar predicción"
                                            @onclick="() => EditarPartido(p)">
                                        Editar
                                    </button>

                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(bloqueado || !guardada)"
                                            title="Eliminar predicción"
                                            @onclick="() => EliminarPartido(p)">
                                        Eliminar
                                    </button>
                                </div>
                            </div>

                            @if (p.Fase != "Grupos")
                            {
                                var alertaEmpate = AlertaEmpateEliminatoria(p);

                                <div class="prediction-extra">
                                    <select class="form-select form-select-sm"
                                            disabled="@(!editable)"
                                            @bind="predicciones[p.Id].PrediceClasificadoId">
                                        <option value="">Equipo que clasifica</option>
                                        <option value="@p.LocalId">@p.Local</option>
                                        <option value="@p.VisitanteId">@p.Visitante</option>
                                    </select>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="@($"definicion-{p.Id}")"
                                               checked="@(predicciones[p.Id].PrediceTiempoExtra && !predicciones[p.Id].PredicePenales)"
                                               disabled="@(!editable)"
                                               @onchange="() => SeleccionarDefinicionEliminatoria(p.Id, false)" />
                                        <span class="form-check-label">T. extra</span>
                                    </label>

                                    <label class="form-check compact-check">
                                        <input class="form-check-input"
                                               type="radio"
                                               name="@($"definicion-{p.Id}")"
                                               checked="@predicciones[p.Id].PredicePenales"
                                               disabled="@(!editable)"
                                               @onchange="() => SeleccionarDefinicionEliminatoria(p.Id, true)" />
                                        <span class="form-check-label">Penales</span>
                                    </label>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(alertaEmpate))
                                {
                                    <div class="knockout-alert">
                                        @alertaEmpate
                                    </div>
                                }
                            }

                            <div class="prediction-footer">
                                <span>
                                    @(DateTime.SpecifyKind(p.Fecha, DateTimeKind.Unspecified)
                                        .ToString("dddd dd 'de' MMMM yyyy HH:mm"))
                                </span>

                                @if (bloqueado)
                                {
                                    <span class="status-pill locked">Bloqueado</span>
                                }
                                else if (editable && guardada)
                                {
                                    <span class="status-pill editing">Editando</span>
                                }
                                else if (guardada)
                                {
                                    <span class="status-pill saved">Guardada</span>
                                }
                                else
                                {
                                    <span class="status-pill pending">Pendiente</span>
                                }
                            </div>
                        </div>
                    }
                    </div>
                }
            }
        }
    }
}

