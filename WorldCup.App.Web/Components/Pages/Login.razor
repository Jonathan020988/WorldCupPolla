@page "/login"

@rendermode InteractiveServer
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs

@inject AuthService AuthService
@inject SesionService Sesion
@inject NavigationManager Navigation

<div class="container py-5" style="max-width:420px">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3 class="text-center mb-3">🔐 Iniciar sesión</h3>

            @if (error != null)
            {
                <div class="alert alert-danger text-center">
                    @error
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email"
                       class="form-control"
                       @bind="email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password"
                       class="form-control"
                       @bind="password" />
            </div>

            <button class="btn btn-primary w-100 mt-2"
                    @onclick="LoginAsync">
                Entrar
            </button>

        </div>
    </div>

</div>

@code {

    private string email = "";
    private string password = "";
    private string? error;

    private async Task LoginAsync()
    {
        
        error = null;

        var result = await AuthService.LoginAsync(new LoginDto
            {
                Email = email,
                Password = password
            });

        if (result == null)
        {
            error = "Credenciales inválidas";
            return;
        }
        await Sesion.LoginAsync(result.Id, result.Nombre);
        Console.WriteLine($"SESION OK -> {Sesion.UsuarioId}");
        
        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            Navigation.NavigateTo(returnUrl);
        }
        else
        {
            Navigation.NavigateTo("/dashboard");
        }


    }

    [Parameter, SupplyParameterFromQuery]
    public string? returnUrl { get; set; }



}
