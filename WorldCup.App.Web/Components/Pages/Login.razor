@page "/login"

@rendermode InteractiveServer
@using WorldCup.App.Shared.Services
@using WorldCup.App.Shared.DTOs

@inject AuthService AuthService
@inject UsuariosService UsuariosService
@inject SesionService Sesion
@inject NavigationManager Navigation

<div class="container py-5" style="max-width:420px">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3 class="text-center mb-3">🔐 Iniciar sesión</h3>

            @if (error != null)
            {
                <div class="alert alert-danger text-center">
                    @error
                </div>
            }

            @if (mensaje != null)
            {
                <div class="alert alert-success text-center">
                    @mensaje
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email"
                       class="form-control"
                       @bind="email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="@TipoPassword"
                       class="form-control"
                       @bind="password" />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input"
                       type="checkbox"
                       id="mostrarPasswordLogin"
                       @bind="mostrarPassword" />
                <label class="form-check-label" for="mostrarPasswordLogin">
                    Mostrar contraseña
                </label>
            </div>

            <button class="btn btn-primary w-100 mt-2"
                    @onclick="LoginAsync">
                Entrar
            </button>

            @if (requiereConfirmacion)
            {
                <div class="border rounded p-3 mt-3">
                    <h6 class="fw-bold">Completar registro</h6>
                    <p class="text-muted mb-2">
                        Revisa tu correo y también la carpeta de spam. Puedes reenviar el código si no lo encuentras.
                    </p>

                    <input class="form-control text-center"
                           inputmode="numeric"
                           maxlength="6"
                           placeholder="000000"
                           @bind="codigoConfirmacion"
                           @bind:event="oninput" />

                    <button class="btn btn-success w-100 mt-2"
                            disabled="@cargandoConfirmacion"
                            @onclick="ConfirmarCodigo">
                        Validar código
                    </button>

                    <button class="btn btn-link w-100 mt-1"
                            disabled="@cargandoConfirmacion"
                            @onclick="ReenviarCodigo">
                        Reenviar código
                    </button>
                </div>
            }

            <div class="text-center mt-3">
                <small>
                    <a href="/olvide-password">¿Olvidaste tu contraseña?</a>
                </small>
            </div>

        </div>
    </div>

</div>

@code {

    private string email = "";
    private string password = "";
    private string? error;
    private string? mensaje;
    private bool mostrarPassword;
    private bool requiereConfirmacion;
    private bool cargandoConfirmacion;
    private string codigoConfirmacion = "";

    private string TipoPassword => mostrarPassword ? "text" : "password";

    private async Task LoginAsync()
    {
        
        error = null;
        mensaje = null;
        requiereConfirmacion = false;

        try
        {
            var result = await AuthService.LoginAsync(new LoginDto
                {
                    Email = email,
                    Password = password
                });

            if (result == null)
            {
                error = "Credenciales inválidas";
                return;
            }

            await Sesion.LoginAsync(result.Id, result.Nombre, result.EsAdmin);
        
            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                Navigation.NavigateTo(returnUrl, true);
            }
            else
            {
                Navigation.NavigateTo("/dashboard", true);
            }
        }
        catch (Exception ex)
        {
            error = string.IsNullOrWhiteSpace(ex.Message)
                ? "Credenciales inválidas"
                : ex.Message;
            requiereConfirmacion = error.Contains("confirmar tu correo", StringComparison.OrdinalIgnoreCase);
        }
    }

    private async Task ReenviarCodigo()
    {
        error = null;
        mensaje = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Escribe el correo para reenviar el código.";
            return;
        }

        try
        {
            cargandoConfirmacion = true;
            var apiError = await UsuariosService.ReenviarCodigoCorreoAsync(new ReenviarCodigoCorreoDTO
            {
                Email = email
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            mensaje = "Te reenviamos un código nuevo. Revisa tu correo, promociones y spam.";
            requiereConfirmacion = true;
        }
        finally
        {
            cargandoConfirmacion = false;
        }
    }

    private async Task ConfirmarCodigo()
    {
        error = null;
        mensaje = null;

        var codigo = (codigoConfirmacion ?? "").Trim();
        if (codigo.Length != 6 || !codigo.All(char.IsDigit))
        {
            error = "Escribe el código de 6 dígitos que llegó a tu correo.";
            requiereConfirmacion = true;
            return;
        }

        try
        {
            cargandoConfirmacion = true;
            var apiError = await UsuariosService.ConfirmarCodigoCorreoAsync(new ConfirmarCodigoCorreoDTO
            {
                Email = email,
                Codigo = codigo
            });

            if (apiError != null)
            {
                error = apiError;
                requiereConfirmacion = true;
                return;
            }

            mensaje = "Correo confirmado correctamente. Ya puedes iniciar sesión.";
            requiereConfirmacion = false;
            codigoConfirmacion = "";
        }
        finally
        {
            cargandoConfirmacion = false;
        }
    }

    [Parameter, SupplyParameterFromQuery]
    public string? returnUrl { get; set; }



}
