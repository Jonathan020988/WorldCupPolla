@page "/crear-polla"

<div class="container py-4" style="max-width:600px">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3 class="mb-1">🏆 Crear nueva polla</h3>
            <p class="text-muted small">
                Configura tu polla y empieza a invitar jugadores
            </p>

            <div class="mb-3">
                <label class="form-label fw-bold">Nombre de la polla</label>
                <input class="form-control"
                       placeholder="Ej: Polla Mundial Amigos" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tipo de polla</label>

                <select class="form-select">
                    <option value="Privada">🔒 Privada (solo invitados)</option>
                    <option value="Publica">🌍 Pública</option>
                </select>
            </div>

            <div class="alert alert-info small">
                ℹ️ Las pollas privadas generan un código de invitación
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="/dashboard" class="btn btn-outline-secondary">
                    ⬅ Volver
                </a>

                <button class="btn btn-success">
                    ✅ Crear polla
                </button>
            </div>

        </div>
    </div>

</div>
