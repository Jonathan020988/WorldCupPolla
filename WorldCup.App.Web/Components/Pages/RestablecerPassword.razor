@page "/restablecer-password"

@rendermode InteractiveServer
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

@inject AuthService AuthService

<div class="container py-5" style="max-width:460px">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3 class="text-center mb-3">Nueva contraseña</h3>

            @if (mensaje != null)
            {
                <div class="alert alert-success">
                    @mensaje
                </div>
            }

            @if (error != null)
            {
                <div class="alert alert-danger">
                    @error
                </div>
            }

            @if (mensaje == null)
            {
                <div class="mb-3">
                    <label class="form-label">Contraseña nueva</label>
                    <input type="password"
                           class="form-control"
                           @bind="password" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar contraseña</label>
                    <input type="password"
                           class="form-control"
                           @bind="confirmPassword" />
                </div>

                <button class="btn btn-success w-100 mt-2"
                        disabled="@cargando"
                        @onclick="Guardar">
                    @(cargando ? "Guardando..." : "Guardar contraseña")
                </button>
            }

            <div class="text-center mt-3">
                <small>
                    <a href="/login">Ir al inicio de sesión</a>
                </small>
            </div>

        </div>
    </div>

</div>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? token { get; set; }

    private string password = "";
    private string confirmPassword = "";
    private string? mensaje;
    private string? error;
    private bool cargando;

    private async Task Guardar()
    {
        mensaje = null;
        error = null;

        if (string.IsNullOrWhiteSpace(token))
        {
            error = "El enlace de recuperación no es válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password) || password.Length < 6)
        {
            error = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        if (password != confirmPassword)
        {
            error = "Las contraseñas no coinciden.";
            return;
        }

        cargando = true;

        try
        {
            var apiError = await AuthService.RestablecerPasswordAsync(new RestablecerPasswordDto
            {
                Token = token,
                Password = password
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            mensaje = "Tu contraseña fue actualizada correctamente.";
            password = "";
            confirmPassword = "";
        }
        finally
        {
            cargando = false;
        }
    }
}
