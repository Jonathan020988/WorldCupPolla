@page "/olvide-password"

@rendermode InteractiveServer
@using WorldCup.App.Shared.DTOs
@using WorldCup.App.Shared.Services

@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="container py-5" style="max-width:460px">

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h3 class="text-center mb-3">Restablecer contraseña</h3>

            @if (mensaje != null)
            {
                <div class="alert alert-success">
                    @mensaje
                </div>
            }

            @if (error != null)
            {
                <div class="alert alert-danger">
                    @error
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Correo</label>
                <input type="email"
                       class="form-control"
                       placeholder="correo@ejemplo.com"
                       @bind="email" />
            </div>

            <button class="btn btn-primary w-100 mt-2"
                    disabled="@cargando"
                    @onclick="Enviar">
                @(cargando ? "Enviando..." : "Enviar enlace")
            </button>

            <div class="text-center mt-3">
                <small>
                    <a href="/login">Volver al inicio de sesión</a>
                </small>
            </div>

        </div>
    </div>

</div>

@code {
    private string email = "";
    private string? mensaje;
    private string? error;
    private bool cargando;

    private async Task Enviar()
    {
        mensaje = null;
        error = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Escribe el correo de tu cuenta.";
            return;
        }

        cargando = true;

        try
        {
            var resetUrlBase = $"{Navigation.BaseUri.TrimEnd('/')}/restablecer-password";
            var apiError = await AuthService.SolicitarResetPasswordAsync(new SolicitarResetPasswordDto
            {
                Email = email,
                ResetUrlBase = resetUrlBase
            });

            if (apiError != null)
            {
                error = apiError;
                return;
            }

            mensaje = "Si el correo está registrado, recibirás un enlace para restablecer tu contraseña.";
        }
        finally
        {
            cargando = false;
        }
    }
}
