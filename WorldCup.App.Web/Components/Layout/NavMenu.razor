@using WorldCup.App.Shared.Services
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject PollasService PollasService
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WorldCup.App</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @if (Sesion.EstaLogueado)
        {
            <div class="px-3 py-2 text-white">
                👤 <strong>@Sesion.Nombre</strong>
            </div>

        }
      
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                🏠 Home
            </NavLink>
        </div>

       
        @if (!Sesion.EstaLogueado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">🔐 Login</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/registro">📝 Registro</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Unirse">🔗 Unirse a una polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/partidos">⚽ Partidos</NavLink>
            </div>

            
           
        }

        @if (Sesion.EstaLogueado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/dashboard">🏆 Mis Pollas</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/notificaciones">
                    🔔 Notificaciones @if (solicitudesPendientes > 0)
                    {
                        <span class="badge bg-danger ms-2">
                            @solicitudesPendientes
                        </span>
                    }
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/crear-polla">➕ Crear Polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Unirse">🔗 Unirse a una polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/predicciones">🎯 Predicciones</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/clasificacion-grupos">
                    📊 Clasificación Grupos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/partidos">⚽ Partidos</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/simulador">📊 Simulador</NavLink>
            </div>


            <div class="nav-item px-3">
                <a class="nav-link" style="cursor:pointer" @onclick="CerrarSesion">
                    🚪 Cerrar sesión
                </a>
            </div>
        }

        

       
    </nav>
</div>

@code {

    private async Task CargarSolicitudesPendientes()
    {
        if (Sesion.EstaLogueado && Sesion.UsuarioId != null)
        {
            var solicitudes = await PollasService
                .GetNotificacionesAsync(Sesion.UsuarioId.Value);

            solicitudesPendientes = solicitudes
                .Count(s => s.Estado == "Pendiente");

            StateHasChanged();
        }
    }
    protected override void OnInitialized()
    {
        Sesion.OnChange += async () =>
        {
            await CargarSolicitudesPendientes();
        };

        PollasService.OnNotificacionesChanged += async () =>
        {
            await CargarSolicitudesPendientes();
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await CargarSolicitudesPendientes();
    }
}
        
    // // // protected override void OnInitialized()
    // // {
    // //     Sesion.OnChange += StateHasChanged;
    // // }

    private async Task CerrarSesion()
    {
         await Sesion.LogoutAsync();
         Navigation.NavigateTo("/login", true);
    }
    

    public void Dispose()
    {
        Sesion.OnChange -= StateHasChanged;
    }

    private int solicitudesPendientes = 0;
}

