@using WorldCup.App.Shared.Services
@implements IDisposable
@inject SesionService Sesion
@inject NavigationManager Navigation
@inject PollasService PollasService
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand app-brand"
           href=""
           style="display:flex!important;flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;white-space:normal!important;line-height:1.05!important;max-width:190px!important;overflow:hidden!important;">
            <span class="brand-title"
                  style="display:block!important;font-size:1rem!important;font-weight:700!important;line-height:1.05!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;">
                WorldCup.App
            </span>
            <span class="brand-version"
                  style="display:block!important;font-size:0.72rem!important;font-weight:500!important;line-height:1.1!important;color:rgba(255,255,255,.72)!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;">
                @AppVersion - @AppVersionDate
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @if (Sesion.EstaLogueado)
        {
            <div class="px-3 py-2 text-white">
                👤 <strong>@Sesion.Nombre</strong>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                🏠 Home
            </NavLink>
        </div>

        @if (!Sesion.EstaLogueado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/login">🔐 Login</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/registro">📝 Registro</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Unirse">🔗 Unirse a una polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/partidos">⚽ Partidos</NavLink>
            </div>
        }

        @if (Sesion.EstaLogueado)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/dashboard">🏆 Mis Pollas</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/ranking">&#x1F3C5; Ranking</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/comparar">&#x1F50D; Comparar</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/notificaciones">
                    🔔 Notificaciones
                    @if (solicitudesPendientes > 0)
                    {
                        <span class="badge bg-danger ms-2">
                            @solicitudesPendientes
                        </span>
                    }
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/crear-polla">➕ Crear Polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Unirse">🔗 Unirse a una polla</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/predicciones">🎯 Predicciones</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/clasificacion-grupos">
                    📊 Clasificación Grupos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/partidos">⚽ Partidos</NavLink>
            </div>

            @if (Sesion.EsAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/admin">🛠 Admin</NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/simulador">📊 Simulador</NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/reglas">📘 Reglas</NavLink>
            </div>

            <div class="nav-item px-3">
                <a class="nav-link" style="cursor:pointer" @onclick="CerrarSesion">
                    🚪 Cerrar sesión
                </a>
            </div>
        }
    </nav>
</div>

@code {
    private const string AppVersion = "Version 5";
    private const string AppVersionDate = "17/05/2026";
    private int solicitudesPendientes;

    protected override void OnInitialized()
    {
        Sesion.OnChange += OnSesionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Sesion.RestaurarSesionAsync();
            await CargarSolicitudesPendientes();
            StateHasChanged();
        }
    }

    private void OnSesionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarSolicitudesPendientes();
            StateHasChanged();
        });
    }

    private async Task CargarSolicitudesPendientes()
    {
        if (!Sesion.EstaLogueado || Sesion.UsuarioId == null)
        {
            solicitudesPendientes = 0;
            return;
        }

        try
        {
            var solicitudes = await PollasService.GetNotificacionesAsync(Sesion.UsuarioId.Value);
            solicitudesPendientes = solicitudes.Count(s => s.Estado == "Pendiente");
        }
        catch
        {
            solicitudesPendientes = 0;
        }
    }

    private async Task CerrarSesion()
    {
        await Sesion.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Sesion.OnChange -= OnSesionChanged;
    }
}
