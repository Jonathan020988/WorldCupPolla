@using System.Globalization
@using WorldCup.App.Shared.DTOs

<section class="evolution-panel" id="evolucion-ranking">
    <div class="evolution-head">
        <div>
            <span class="evolution-kicker">Centro de rendimiento</span>
            <h2>Evolución de la polla</h2>
            <p>Elige participantes y un rango de partidos para comparar su avance.</p>
        </div>
    </div>

    @if (!eventos.Any())
    {
        <div class="evolution-empty">
            La gráfica aparecerá cuando finalice el primer partido.
        </div>
    }
    else
    {
        <div class="evolution-config">
            <label class="config-field">
                <span>Tipo de gráfica</span>
                <select @bind="modoBorrador">
                    <option value="Rendimiento">Evolución de puntos</option>
                    <option value="Partido">Puntos por partido</option>
                    <option value="Posicion">Posición histórica</option>
                </select>
            </label>

            <div class="config-field participant-field">
                <span>Participantes</span>
                <button type="button"
                        class="participant-trigger"
                        aria-expanded="@selectorParticipantesAbierto"
                        @onclick="ToggleSelectorParticipantes">
                    <span>@ResumenSeleccionBorrador()</span>
                    <b aria-hidden="true">⌄</b>
                </button>

                @if (selectorParticipantesAbierto)
                {
                    <div class="participant-menu">
                        <input type="search"
                               placeholder="Buscar por nombre..."
                               aria-label="Buscar participante"
                               @bind="filtroUsuario"
                               @bind:event="oninput" />

                        <div class="participant-actions">
                            <button type="button" @onclick="SeleccionarLideresBorrador">Top 5</button>
                            <button type="button" @onclick="SeleccionarTodosBorrador">Todos</button>
                            <button type="button" @onclick="LimpiarSeleccionBorrador">Limpiar</button>
                            <button type="button"
                                    class="participant-done"
                                    @onclick="ToggleSelectorParticipantes">
                                Listo
                            </button>
                        </div>

                        <div class="participant-options">
                            @foreach (var serie in SeriesFiltradas())
                            {
                                var seleccionada = usuariosBorrador.Contains(serie.UsuarioId);
                                <div class="participant-option @(seleccionada ? "selected" : "")">
                                    <label class="participant-select">
                                        <input type="checkbox"
                                               checked="@seleccionada"
                                               @onchange="e => CambiarSeleccionBorrador(serie.UsuarioId, e)" />
                                        <span class="user-color" style="background:@serie.Color"></span>
                                        <span>
                                            <strong>@serie.Usuario</strong>
                                            <small>@serie.PuntosActuales pts · #@serie.PosicionActual</small>
                                        </span>
                                    </label>
                                    <input type="color"
                                           class="participant-color-picker"
                                           value="@serie.Color"
                                           title="Cambiar color de @serie.Usuario"
                                           aria-label="Color de @serie.Usuario"
                                           @oninput="e => CambiarColorUsuario(serie, e)" />
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <label class="config-field">
                <span>Desde</span>
                <select value="@rangoDesdeBorrador"
                        @onchange="CambiarRangoDesde">
                    @foreach (var evento in eventos)
                    {
                        <option value="@evento.Indice">@NombreEvento(evento)</option>
                    }
                </select>
            </label>

            <label class="config-field">
                <span>Hasta</span>
                <select value="@rangoHastaBorrador"
                        @onchange="CambiarRangoHasta">
                    @foreach (var evento in eventos)
                    {
                        <option value="@evento.Indice">@NombreEvento(evento)</option>
                    }
                </select>
            </label>

            <button type="button"
                    class="generate-chart"
                    @onclick="GenerarGrafica">
                Generar gráfica
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeValidacion))
        {
            <div class="evolution-warning">@mensajeValidacion</div>
        }

        @if (!graficaGenerada)
        {
            <div class="evolution-empty compact">
                Configura los participantes y el rango; después pulsa “Generar gráfica”.
            </div>
        }
        else if (!SeriesAplicadas().Any())
        {
            <div class="evolution-empty compact">
                Selecciona al menos un participante para generar la gráfica.
            </div>
        }
        else
        {
            <div class="chart-context">
                <div>
                    <strong>@TituloGrafica()</strong>
                    <span>@DescripcionRango()</span>
                </div>
                <p>
                    Si varias líneas se superponen, esos participantes llevan el mismo resultado en ese tramo.
                </p>
            </div>

            <div class="football-chart">
                <div class="chart-scoreboard">
                    <span>@TituloGrafica()</span>
                    <strong>@CantidadEventosAplicados() partido@(CantidadEventosAplicados() == 1 ? "" : "s")</strong>
                </div>

                <svg viewBox="0 0 1000 410"
                     role="img"
                     aria-label="Gráfica de evolución del ranking">
                    <rect x="64" y="30" width="910" height="294" rx="6" class="chart-field"></rect>

                    @foreach (var tick in TicksVerticales())
                    {
                        <line x1="64"
                              y1="@F(tick.Y)"
                              x2="974"
                              y2="@F(tick.Y)"
                              class="chart-grid-line"></line>
                        <foreignObject x="0"
                                       y="@F(tick.Y - 11)"
                                       width="55"
                                       height="24">
                            <div class="chart-axis-label">@tick.Texto</div>
                        </foreignObject>
                    }

                    @foreach (var tick in TicksHorizontales())
                    {
                        <line x1="@F(tick.X)"
                              y1="30"
                              x2="@F(tick.X)"
                              y2="324"
                              class="chart-grid-line vertical"></line>
                        <foreignObject x="@F(tick.X - 58)"
                                       y="337"
                                       width="116"
                                       height="22">
                            <div class="chart-event-label">@tick.Linea1</div>
                        </foreignObject>
                        <foreignObject x="@F(tick.X - 58)"
                                       y="356"
                                       width="116"
                                       height="34">
                            <div class="chart-event-label muted">@tick.Linea2</div>
                        </foreignObject>
                    }

                    @foreach (var serie in SeriesAplicadas())
                    {
                        var puntosGrafica = PuntosGrafica(serie);
                        <polyline points="@PuntosSvg(serie)"
                                  style="stroke:@serie.Color"
                                  class="chart-line"></polyline>

                        @foreach (var punto in puntosGrafica.Select((valor, indice) => new { valor, indice }))
                        {
                            <circle cx="@F(X(punto.indice, puntosGrafica.Count))"
                                    cy="@F(Y(punto.valor))"
                                    r="5"
                                    style="fill:@serie.Color"
                                    class="chart-point">
                                <title>@TextoPunto(serie, punto.valor)</title>
                            </circle>
                        }
                    }
                </svg>
            </div>

            <div class="evolution-legend">
                @foreach (var serie in SeriesAplicadas())
                {
                    <div>
                        <input type="color"
                               class="legend-color-picker"
                               value="@serie.Color"
                               title="Cambiar color de @serie.Usuario"
                               aria-label="Color de @serie.Usuario"
                               @oninput="e => CambiarColorUsuario(serie, e)" />
                        <strong>@serie.Usuario</strong>
                        <small>@ValorFinalTexto(serie)</small>
                    </div>
                }
            </div>

            <div class="performance-grid">
                @foreach (var serie in SeriesAplicadas())
                {
                    var resumen = ResumenRango(serie);
                    <article class="performance-card" style="border-top-color:@serie.Color">
                        <div class="performance-name">
                            <strong>@serie.Usuario</strong>
                            <span>#@serie.PosicionActual</span>
                        </div>
                        <dl>
                            <div><dt>Puntos en rango</dt><dd>@resumen.PuntosGanados</dd></div>
                            <div><dt>Exactos</dt><dd>@resumen.Exactos</dd></div>
                            <div><dt>Con puntos</dt><dd>@resumen.ConPuntos</dd></div>
                            <div><dt>Movimiento</dt><dd>@resumen.Movimiento</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
    }
</section>

