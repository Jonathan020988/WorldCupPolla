</style>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RankingPollaDto> Ranking { get; set; } =
        Array.Empty<RankingPollaDto>();

    [Parameter, EditorRequired]
    public IReadOnlyList<DetalleRankingDto> Detalles { get; set; } =
        Array.Empty<DetalleRankingDto>();

    private readonly string[] colores =
    {
        "#0b7a53", "#d59a00", "#2563eb", "#d92d20", "#7a5af8",
        "#0086c9", "#b54708", "#c11574", "#475467", "#039855",
        "#7f56d9", "#dc6803"
    };

    private List<EventoGrafica> eventos = new();
    private List<SerieUsuario> series = new();
    private readonly Dictionary<int, string> coloresPersonalizados = new();
    private HashSet<int> usuariosBorrador = new();
    private HashSet<int> usuariosAplicados = new();
    private string modoBorrador = "Rendimiento";
    private string modoAplicado = "Rendimiento";
    private string filtroUsuario = "";
    private string firmaDatos = "";
    private string mensajeValidacion = "";
    private bool selectorParticipantesAbierto;
    private bool graficaGenerada;
    private int rangoDesdeBorrador;
    private int rangoHastaBorrador;
    private int rangoDesdeAplicado;
    private int rangoHastaAplicado;
    private int maxPuntosGrafica = 1;

    protected override void OnParametersSet()
    {
        var nuevaFirma =
            $"{Ranking.Count}:{Detalles.Count}:{Detalles.Count(d => d.ResultadoLocal.HasValue && d.ResultadoVisitante.HasValue)}";

        if (nuevaFirma == firmaDatos)
        {
            return;
        }

        firmaDatos = nuevaFirma;
        ConstruirSeries();
    }

    private void ConstruirSeries()
    {
        eventos = Detalles
            .Where(d => d.ResultadoLocal.HasValue && d.ResultadoVisitante.HasValue)
            .GroupBy(d => new
            {
                d.Fecha,
                d.Fase,
                d.Local,
                d.Visitante
            })
            .Select(g => new EventoGrafica
            {
                Fecha = g.Key.Fecha,
                Fase = g.Key.Fase,
                Local = g.Key.Local,
                Visitante = g.Key.Visitante
            })
            .OrderBy(e => e.Fecha)
            .ThenBy(e => e.Local)
            .ThenBy(e => e.Visitante)
            .ToList();

        for (var i = 0; i < eventos.Count; i++)
        {
            eventos[i].Indice = i;
        }

        series = Ranking
            .Select((r, index) => new SerieUsuario
            {
                UsuarioId = r.UsuarioId,
                Usuario = r.Usuario,
                Color = coloresPersonalizados.TryGetValue(r.UsuarioId, out var colorPersonalizado)
                    ? colorPersonalizado
                    : colores[index % colores.Length],
                PosicionActual = index + 1,
                PuntosActuales = r.Puntos
            })
            .ToList();

        foreach (var serie in series)
        {
            var acumulado = 0;
            var exactos = 0;
            var ganadores = 0;
            var goles = 0;
            var diferencias = 0;
            var clasificacion = 0;
            var podio = 0;
            var conPuntos = 0;

            foreach (var evento in eventos)
            {
                var detalle = Detalles.FirstOrDefault(d =>
                    d.UsuarioId == serie.UsuarioId &&
                    d.Fecha == evento.Fecha &&
                    d.Fase == evento.Fase &&
                    d.Local == evento.Local &&
                    d.Visitante == evento.Visitante);

                var puntosEvento = detalle?.Total ?? 0;
                acumulado += puntosEvento;

                if (detalle != null)
                {
                    exactos += detalle.PuntosExacto > 0 ? 1 : 0;
                    ganadores += detalle.PuntosGanador > 0 ? 1 : 0;
                    goles += detalle.PuntosGoles > 0 ? 1 : 0;
                    diferencias += detalle.PuntosDiferencia > 0 ? 1 : 0;
                    clasificacion += detalle.PuntosClasificacion;
                    podio += detalle.PuntosPodio;
                    conPuntos += detalle.PuntosMarcador > 0 ? 1 : 0;
                }

                serie.Puntos.Add(new PuntoSerie
                {
                    PuntosEvento = puntosEvento,
                    PuntosAcumulados = acumulado,
                    ExactosAcumulados = exactos,
                    GanadoresAcumulados = ganadores,
                    GolesAcumulados = goles,
                    DiferenciasAcumuladas = diferencias,
                    ClasificacionAcumulada = clasificacion,
                    PodioAcumulado = podio,
                    ConPuntosAcumulados = conPuntos
                });
            }
        }

        for (var eventoIndex = 0; eventoIndex < eventos.Count; eventoIndex++)
        {
            var orden = series
                .OrderByDescending(s => s.Puntos[eventoIndex].PuntosAcumulados)
                .ThenByDescending(s => s.Puntos[eventoIndex].ExactosAcumulados)
                .ThenByDescending(s => s.Puntos[eventoIndex].GanadoresAcumulados)
                .ThenByDescending(s => s.Puntos[eventoIndex].GolesAcumulados)
                .ThenByDescending(s => s.Puntos[eventoIndex].DiferenciasAcumuladas)
                .ThenByDescending(s => s.Puntos[eventoIndex].ClasificacionAcumulada)
                .ThenByDescending(s => s.Puntos[eventoIndex].PodioAcumulado)
                .ThenBy(s => s.Usuario)
                .ToList();

            for (var posicion = 0; posicion < orden.Count; posicion++)
            {
                orden[posicion].Puntos[eventoIndex].Posicion = posicion + 1;
            }
        }

        usuariosBorrador = series
            .OrderBy(s => s.PosicionActual)
            .Take(5)
            .Select(s => s.UsuarioId)
            .ToHashSet();
        usuariosAplicados.Clear();
        rangoDesdeBorrador = 0;
        rangoHastaBorrador = Math.Max(0, eventos.Count - 1);
        rangoDesdeAplicado = rangoDesdeBorrador;
        rangoHastaAplicado = rangoHastaBorrador;
        graficaGenerada = false;
        mensajeValidacion = "";
    }

    private IEnumerable<SerieUsuario> SeriesFiltradas()
    {
        var texto = (filtroUsuario ?? "").Trim();
        return series
            .Where(s =>
                string.IsNullOrWhiteSpace(texto) ||
                s.Usuario.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.PosicionActual);
    }

    private List<SerieUsuario> SeriesAplicadas()
    {
        return series
            .Where(s => usuariosAplicados.Contains(s.UsuarioId))
            .OrderBy(s => s.PosicionActual)
            .ToList();
    }

    private List<EventoGrafica> EventosAplicados()
    {
        if (!eventos.Any())
        {
            return new();
        }

        var desde = Math.Clamp(rangoDesdeAplicado, 0, eventos.Count - 1);
        var hasta = Math.Clamp(rangoHastaAplicado, desde, eventos.Count - 1);
        return eventos
            .Skip(desde)
            .Take(hasta - desde + 1)
            .ToList();
    }

    private IEnumerable<PuntoSerie> PuntosVisibles(SerieUsuario serie)
    {
        return serie.Puntos
            .Skip(rangoDesdeAplicado)
            .Take(CantidadEventosAplicados());
    }

    private void ToggleSelectorParticipantes()
    {
        selectorParticipantesAbierto = !selectorParticipantesAbierto;
    }

    private void CambiarSeleccionBorrador(int usuarioId, ChangeEventArgs e)
    {
        var seleccionado = e.Value is bool valor && valor;
        if (seleccionado)
        {
            usuariosBorrador.Add(usuarioId);
        }
        else
        {
            usuariosBorrador.Remove(usuarioId);
        }
    }

    private void CambiarColorUsuario(SerieUsuario serie, ChangeEventArgs e)
    {
        var color = e.Value?.ToString()?.Trim();
        if (!EsColorHexValido(color))
        {
            return;
        }

        serie.Color = color!;
        coloresPersonalizados[serie.UsuarioId] = color!;
    }

    private static bool EsColorHexValido(string? color)
    {
        return color is { Length: 7 } &&
            color[0] == '#' &&
            color.Skip(1).All(Uri.IsHexDigit);
    }

    private void SeleccionarLideresBorrador()
    {
        usuariosBorrador = series
            .OrderBy(s => s.PosicionActual)
            .Take(5)
            .Select(s => s.UsuarioId)
            .ToHashSet();
    }

    private void SeleccionarTodosBorrador()
    {
        usuariosBorrador = series
            .Select(s => s.UsuarioId)
            .ToHashSet();
    }

    private void LimpiarSeleccionBorrador()
    {
        usuariosBorrador.Clear();
    }

    private void CambiarRangoDesde(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var indice))
        {
            return;
        }

        rangoDesdeBorrador = indice;
        if (rangoHastaBorrador < rangoDesdeBorrador)
        {
            rangoHastaBorrador = rangoDesdeBorrador;
        }
    }

    private void CambiarRangoHasta(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var indice))
        {
            return;
        }

        rangoHastaBorrador = indice;
        if (rangoDesdeBorrador > rangoHastaBorrador)
        {
            rangoDesdeBorrador = rangoHastaBorrador;
        }
    }

    private void GenerarGrafica()
    {
        if (!usuariosBorrador.Any())
        {
            mensajeValidacion = "Selecciona al menos un participante.";
            graficaGenerada = false;
            return;
        }

        if (!eventos.Any())
        {
            mensajeValidacion = "Todavía no hay partidos finalizados.";
            graficaGenerada = false;
            return;
        }

        usuariosAplicados = usuariosBorrador.ToHashSet();
        modoAplicado = modoBorrador;
        rangoDesdeAplicado = Math.Min(rangoDesdeBorrador, rangoHastaBorrador);
        rangoHastaAplicado = Math.Max(rangoDesdeBorrador, rangoHastaBorrador);
        selectorParticipantesAbierto = false;
        mensajeValidacion = "";
        graficaGenerada = true;
        CalcularEscala();
    }

    private void CalcularEscala()
    {
        var puntos = SeriesAplicadas()
            .SelectMany(PuntosVisibles)
            .ToList();

        maxPuntosGrafica = Math.Max(
            1,
            modoAplicado == "Partido"
                ? puntos.DefaultIfEmpty().Max(p => p?.PuntosEvento ?? 0)
                : puntos.DefaultIfEmpty().Max(p => p?.PuntosAcumulados ?? 0));
    }

    private string ResumenSeleccionBorrador()
    {
        if (!usuariosBorrador.Any())
        {
            return "Seleccionar participantes";
        }

        if (usuariosBorrador.Count == series.Count)
        {
            return $"Todos ({series.Count})";
        }

        var nombres = series
            .Where(s => usuariosBorrador.Contains(s.UsuarioId))
            .OrderBy(s => s.PosicionActual)
            .Take(2)
            .Select(s => s.Usuario)
            .ToList();

        return usuariosBorrador.Count <= 2
            ? string.Join(", ", nombres)
            : $"{string.Join(", ", nombres)} y {usuariosBorrador.Count - 2} más";
    }

    private string PuntosSvg(SerieUsuario serie)
    {
        var puntos = PuntosGrafica(serie);
        return string.Join(
            " ",
            puntos.Select((p, i) =>
                $"{F(X(i, puntos.Count))},{F(Y(p))}"));
    }

    private List<PuntoGrafica> PuntosGrafica(SerieUsuario serie)
    {
        var eventosAplicados = EventosAplicados();
        var puntos = PuntosVisibles(serie)
            .Select((punto, indice) => new PuntoGrafica
            {
                Punto = punto,
                Evento = eventosAplicados[indice],
                Valor = modoAplicado == "Partido"
                    ? punto.PuntosEvento
                    : modoAplicado == "Posicion"
                        ? punto.Posicion
                        : punto.PuntosAcumulados
            })
            .ToList();

        if (modoAplicado != "Posicion")
        {
            puntos.Insert(0, new PuntoGrafica
            {
                EsInicio = true,
                Valor = 0
            });
        }

        return puntos;
    }

    private static double X(int indice, int cantidad)
    {
        if (cantidad <= 1)
        {
            return 519;
        }

        return 64 + (910d * indice / (cantidad - 1));
    }

    private double Y(PuntoGrafica punto)
    {
        if (modoAplicado == "Posicion")
        {
            var maxPosicion = Math.Max(2, series.Count);
            return 44 + (266d * (punto.Valor - 1) / (maxPosicion - 1));
        }

        return 310 - (266d * punto.Valor / maxPuntosGrafica);
    }

    private IEnumerable<TickVertical> TicksVerticales()
    {
        const int total = 5;

        if (modoAplicado == "Posicion")
        {
            var maxPosicion = Math.Max(1, series.Count);
            return Enumerable.Range(0, total)
                .Select(i =>
                {
                    var posicion = 1 + (int)Math.Round(
                        (maxPosicion - 1) * i / (double)(total - 1));
                    return new TickVertical
                    {
                        Y = 44 + (266d * i / (total - 1)),
                        Texto = $"#{posicion}"
                    };
                });
        }

        return Enumerable.Range(0, total)
            .Select(i => new TickVertical
            {
                Y = 44 + (266d * i / (total - 1)),
                Texto = ((int)Math.Round(
                    maxPuntosGrafica * (total - 1 - i) /
                    (double)(total - 1))).ToString()
            });
    }

    private IEnumerable<TickHorizontal> TicksHorizontales()
    {
        var visibles = EventosAplicados();
        if (!visibles.Any())
        {
            return Enumerable.Empty<TickHorizontal>();
        }

        var incluyeInicio = modoAplicado != "Posicion";
        var totalPuntos = visibles.Count + (incluyeInicio ? 1 : 0);
        var cantidad = Math.Min(6, totalPuntos);
        var indices = Enumerable.Range(0, cantidad)
            .Select(i => cantidad == 1
                ? 0
                : (int)Math.Round(
                    (totalPuntos - 1) * i /
                    (double)(cantidad - 1)))
            .Distinct()
            .ToList();

        return indices.Select(i =>
        {
            if (incluyeInicio && i == 0)
            {
                return new TickHorizontal
                {
                    X = X(i, totalPuntos),
                    Linea1 = "Inicio",
                    Linea2 = "0 puntos"
                };
            }

            var evento = visibles[i - (incluyeInicio ? 1 : 0)];
            return new TickHorizontal
            {
                X = X(i, totalPuntos),
                Linea1 = $"Partido {evento.Indice + 1}",
                Linea2 = $"{Abreviar(evento.Local, 8)} - {Abreviar(evento.Visitante, 8)}"
            };
        });
    }

    private ResumenSerieRango ResumenRango(SerieUsuario serie)
    {
        var inicio = rangoDesdeAplicado > 0
            ? serie.Puntos[rangoDesdeAplicado - 1]
            : null;
        var fin = serie.Puntos[rangoHastaAplicado];
        var posicionInicio = serie.Puntos[rangoDesdeAplicado].Posicion;
        var movimiento = posicionInicio == fin.Posicion
            ? $"#{fin.Posicion} ="
            : posicionInicio > fin.Posicion
                ? $"#{posicionInicio} ↑ #{fin.Posicion}"
                : $"#{posicionInicio} ↓ #{fin.Posicion}";

        return new ResumenSerieRango
        {
            PuntosGanados = fin.PuntosAcumulados -
                (inicio?.PuntosAcumulados ?? 0),
            Exactos = fin.ExactosAcumulados -
                (inicio?.ExactosAcumulados ?? 0),
            ConPuntos = fin.ConPuntosAcumulados -
                (inicio?.ConPuntosAcumulados ?? 0),
            Movimiento = movimiento
        };
    }

    private string ValorFinalTexto(SerieUsuario serie)
    {
        var punto = serie.Puntos[rangoHastaAplicado];
        return modoAplicado switch
        {
            "Partido" => $"{punto.PuntosEvento} puntos en el último partido",
            "Rendimiento" => $"{punto.PuntosAcumulados} puntos acumulados",
            _ => $"Posición #{punto.Posicion}"
        };
    }

    private string TextoPunto(
        SerieUsuario serie,
        PuntoGrafica punto)
    {
        if (punto.EsInicio)
        {
            return $"{serie.Usuario}: inicia con 0 puntos";
        }

        var valor = modoAplicado switch
        {
            "Partido" => $"{punto.Punto?.PuntosEvento ?? 0} puntos en el partido",
            "Rendimiento" => $"{punto.Punto?.PuntosAcumulados ?? 0} puntos acumulados",
            _ => $"posición #{punto.Punto?.Posicion ?? 0}"
        };
        return $"{serie.Usuario}: {valor} después de {punto.Evento?.Local} vs {punto.Evento?.Visitante}";
    }

    private string TituloGrafica()
    {
        return modoAplicado switch
        {
            "Rendimiento" => "Evolución de puntos",
            "Partido" => "Puntos por partido",
            _ => "Posición histórica"
        };
    }

    private string DescripcionRango()
    {
        var visibles = EventosAplicados();
        if (!visibles.Any())
        {
            return "";
        }

        return $"Del partido {visibles.First().Indice + 1} al {visibles.Last().Indice + 1}";
    }

    private int CantidadEventosAplicados()
    {
        return eventos.Any()
            ? Math.Max(0, rangoHastaAplicado - rangoDesdeAplicado + 1)
            : 0;
    }

    private static string NombreEvento(EventoGrafica evento)
    {
        return $"Partido {evento.Indice + 1}: {evento.Local} vs {evento.Visitante}";
    }

    private static string Abreviar(string texto, int maximo)
    {
        return texto.Length <= maximo
            ? texto
            : texto[..Math.Max(1, maximo - 1)] + ".";
    }

    private static string F(double valor)
    {
        return valor.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private sealed class EventoGrafica
    {
        public int Indice { get; set; }
        public DateTime Fecha { get; set; }
        public string Fase { get; set; } = "";
        public string Local { get; set; } = "";
        public string Visitante { get; set; } = "";
    }

    private sealed class SerieUsuario
    {
        public int UsuarioId { get; set; }
        public string Usuario { get; set; } = "";
        public string Color { get; set; } = "";
        public int PosicionActual { get; set; }
        public int PuntosActuales { get; set; }
        public List<PuntoSerie> Puntos { get; set; } = new();
    }

    private sealed class PuntoSerie
    {
        public int PuntosEvento { get; set; }
        public int PuntosAcumulados { get; set; }
        public int Posicion { get; set; }
        public int ExactosAcumulados { get; set; }
        public int GanadoresAcumulados { get; set; }
        public int GolesAcumulados { get; set; }
        public int DiferenciasAcumuladas { get; set; }
        public int ClasificacionAcumulada { get; set; }
        public int PodioAcumulado { get; set; }
        public int ConPuntosAcumulados { get; set; }
    }

    private sealed class PuntoGrafica
    {
        public PuntoSerie? Punto { get; set; }
        public EventoGrafica? Evento { get; set; }
        public double Valor { get; set; }
        public bool EsInicio { get; set; }
    }

    private sealed class TickVertical
    {
        public double Y { get; set; }
        public string Texto { get; set; } = "";
    }

    private sealed class TickHorizontal
    {
        public double X { get; set; }
        public string Linea1 { get; set; } = "";
        public string Linea2 { get; set; } = "";
    }

    private sealed class ResumenSerieRango
    {
        public int PuntosGanados { get; set; }
        public int Exactos { get; set; }
        public int ConPuntos { get; set; }
        public string Movimiento { get; set; } = "";
    }
}
